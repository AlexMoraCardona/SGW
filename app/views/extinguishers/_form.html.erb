<div class="conesst-page">
    <div class="conesst-card">
        <div class="conesst-card-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-fire-extinguisher fs-5"></i>
                <div>
                    <h4 class="mb-0">
                        LISTA DE CHEQUEO INSPECCIÓN DE EXTINTORES
                    </h4>
                    <small class="text-muted">
                        Registro de las condiciones encontradas durante la inspección
                    </small>
                </div>
            </div>
        </div>
        <div class="conesst-card-body">
            <%= form_with model: @extinguisher do |form| %>
                <% if @extinguisher.errors.any? %>
                    <div class="alert alert-danger mb-4" role="alert">
                        <div class="fw-semibold mb-2">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Se encontraron los siguientes errores:
                        </div>
                        <ul class="mb-0">
                            <% @extinguisher.errors.full_messages.each do |error| %>
                                <li><%= error %></li>
                            <% end %>
                        </ul>
                    </div>
                <% end %>
                <div class="mb-4">
                    <div class="border rounded p-3">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-info-circle"></i>
                            <div class="fw-semibold">
                                Información general
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <%= form.label :nro, "Número del extintor", class: "form-label fw-semibold" %>
                                <%= form.number_field :nro, class: "form-control", required: true %>
                            </div>
                            <div class="col-12 col-md-8">
                                <%= form.label :ability, "Capacidad", class: "form-label fw-semibold" %>
                                <%= form.text_field :ability, class: "form-control", required: true %>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mb-4">
                    <div class="border rounded p-3">
                        <div class="fw-semibold mb-3">
                            <i class="bi bi-tag me-1"></i>
                            Tipo de extintor
                        </div>
                        <div class="row g-2">
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="form-check">
                                    <%= form.radio_button :type_extinguisher, 0, required: true, class: "form-check-input" %>
                                    <%= form.label :type_extinguisher_0, "Extintor H2O", class: "form-check-label" %>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="form-check">
                                    <%= form.radio_button :type_extinguisher, 1, required: true, class: "form-check-input" %>
                                    <%= form.label :type_extinguisher_1, "Extintor CO2", class: "form-check-label" %>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="form-check">
                                    <%= form.radio_button :type_extinguisher, 2, required: true, class: "form-check-input" %>
                                    <%= form.label :type_extinguisher_2, "Extintor Multiproposito ABC", class: "form-check-label" %>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="form-check">
                                    <%= form.radio_button :type_extinguisher, 3, required: true, class: "form-check-input" %>
                                    <%= form.label :type_extinguisher_3, "Extintor Solkaflam", class: "form-check-label" %>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="form-check">
                                    <%= form.radio_button :type_extinguisher, 4, required: true, class: "form-check-input" %>
                                    <%= form.label :type_extinguisher_4, "Extintor Clase D", class: "form-check-label" %>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="form-check">
                                    <%= form.radio_button :type_extinguisher, 5, required: true, class: "form-check-input" %>
                                    <%= form.label :type_extinguisher_5, "Extintor Tipo K", class: "form-check-label" %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mb-4">
                    <div class="border rounded p-3">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                            <div>
                                <div class="fw-semibold">
                                    <i class="bi bi-clipboard-check me-1"></i>
                                    Lista de verificación
                                </div>
                                <small class="text-muted">
                                    Seleccione una opción para cada condición inspeccionada.
                                </small>
                            </div>
                            <div class="small text-muted">
                                NA = No aplica · NT = No tiene · B = Bueno · M = Malo
                            </div>
                        </div>
                        <div class="row g-3">
                            <% inspection_fields = [
                                [:ring, "Anillo de verificación"],
                                [:pressure_gauge, "Manómetro"],
                                [:barrette, "Pasador de seguridad"],
                                [:handle, "Manija de descarga"],
                                [:valve, "Válvula"],
                                [:hose, "Manguera"],
                                [:nozzle, "Boquilla"],
                                [:cylindrical_body, "Cuerpo cilíndrico"],
                                [:decal, "Instrucciones / Decal"],
                                [:medium, "Medio extintor"],
                                [:signaling, "Señalización"],
                                [:location, "Ubicación"]
                            ] %>
                            <% inspection_fields.each do |field, label| %>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <div class="border rounded p-3 h-100">
                                        <div class="form-label fw-semibold mb-2">
                                            <%= label %>
                                        </div>
                                        <div class="d-flex flex-wrap gap-3">
                                            <div class="form-check">
                                                <%= form.radio_button field, 0, required: true, class: "form-check-input" %>
                                                <%= form.label "#{field}_0", "NA", class: "form-check-label" %>
                                            </div>
                                            <div class="form-check">
                                                <%= form.radio_button field, 1, required: true, class: "form-check-input" %>
                                                <%= form.label "#{field}_1", "NT", class: "form-check-label" %>
                                            </div>
                                            <div class="form-check">
                                                <%= form.radio_button field, 2, required: true, class: "form-check-input" %>
                                                <%= form.label "#{field}_2", "B", class: "form-check-label" %>
                                            </div>
                                            <div class="form-check">
                                                <%= form.radio_button field, 3, required: true, class: "form-check-input" %>
                                                <%= form.label "#{field}_3", "M", class: "form-check-label" %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                </div>
                <div class="mb-4">
                    <div class="border rounded p-3">
                        <div class="fw-semibold mb-3">
                            <i class="bi bi-geo-alt me-1"></i>
                            Ubicación y próxima recarga
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <%= form.label :area_location, "Área de ubicación", class: "form-label fw-semibold" %>
                                <%= form.text_field :area_location, class: "form-control", required: true %>
                            </div>
                            <div class="col-12 col-md-6">
                                <%= form.label :date_vec_carga, "Fecha próxima recarga", class: "form-label fw-semibold" %>
                                <%= form.date_field :date_vec_carga, class: "form-control", required: true %>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mb-4">
                    <div class="border rounded p-3">
                        <div class="fw-semibold mb-3">
                            <i class="bi bi-chat-left-text me-1"></i>
                            Observaciones
                        </div>
                        <%= form.label :observation, "Observaciones de la inspección", class: "form-label fw-semibold" %>
                        <%= form.text_field :observation, class: "form-control", required: true %>
                    </div>
                </div>
                <div class="conesst-actions mt-4">
                    <%= form.submit t('common.submit'), class: "conesst-btn conesst-btn-primary" %>
                    <%= link_to request.referer || root_path, class: "conesst-btn" do %>
                        <i class="bi bi-arrow-left me-1"></i>
                        Retornar
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
</div>
