<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <h2 class="conesst-card-header-title">
          <i class="bi bi-person-badge"></i>
          Equipo investigador
        </h2>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @inves_user do |form| %>
        <% if @inves_user.errors.any? %>
          <div class="alert alert-danger conesst-form-errors" role="alert">
            <strong>
              <i class="bi bi-exclamation-triangle"></i>
              Se encontraron los siguientes errores:
            </strong>
            <ul class="mb-0 mt-2">
              <% @inves_user.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="simulacrum-form-section">
          <div class="simulacrum-form-section-title">
            <i class="bi bi-person-plus"></i>
            <span>Agregar investigador</span>
          </div>
          <div class="simulacrum-form-grid">
            <div class="simulacrum-form-field">
              <%= form.label :user_id, class: "simulacrum-form-label" do %>
                <i class="bi bi-person"></i>
                <span>Investigador</span>
                <i
                  class="bi bi-question-circle"
                  data-bs-toggle="tooltip"
                  data-bs-placement="top"
                  title="Seleccione el investigador que hará parte del equipo de investigación."
                ></i>
              <% end %>
              <% usuarios_empresa = User.usuarios_empresa %>
              <% if usuarios_empresa.present? %>
                <%= form.collection_select(:user_id, usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccionar investigador --" }, {class: "form-select simulacrum-form-control", required: true}) %>
              <% else %>
                <div class="alert alert-warning mb-0">
                  <i class="bi bi-exclamation-triangle"></i>
                  No hay usuarios disponibles para seleccionar como investigador.
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <%= form.hidden_field :investigation_id, value: params[:id].to_s %>
        <div class="conesst-actions simulacrum-form-actions">
          <button type="submit" class="conesst-btn conesst-btn-primary">
            <i class="bi bi-check-circle"></i>
            <span><%= t('common.submit') %></span>
          </button>
          <%= link_to :back, class: "conesst-btn conesst-btn-warning", title: "Regresar" do %>
            <i class="bi bi-arrow-left"></i>
            <span>Retornar</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <% if @inves_users.present? %>
    <div class="conesst-card mt-3">
      <div class="conesst-card-header">
        <div class="conesst-card-header-content">
          <h2 class="conesst-card-header-title">
            <i class="bi bi-people"></i>
            Equipo investigador registrado
          </h2>
          <span class="badge rounded-pill text-bg-light">
            <%= @inves_users.size %>
          </span>
        </div>
      </div>
      <div class="conesst-card-body">
        <div class="conesst-table-wrapper">
          <table class="conesst-table">
            <thead>
              <tr>
                <th scope="col">Investigador</th>
                <th scope="col">Cargo</th>
                <th scope="col">Firmar</th>
                <% if Current.user.level > 0 && Current.user.level < 3 %>
                  <th scope="col">Eliminar</th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% @inves_users.each do |investigador| %>
                <tr>
                  <td data-label="Investigador">
                    <div class="d-flex align-items-center gap-2">
                      <span class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center"
                            style="width:32px; height:32px;">
                        <i class="bi bi-person text-secondary"></i>
                      </span>
                      <span>
                        <%= User.label_name(investigador.user_id) %>
                      </span>
                    </div>
                  </td>
                  <td data-label="Cargo">
                    <%= investigador.post.presence || "No registrado" %>
                  </td>
                  <td data-label="Firmar">
                    <% if investigador.firm == 0 %>
                      <%= link_to firma_inves_path(investigador.id), class: "conesst-btn conesst-btn-warning", title: "Firmar investigación" do %>
                        <i class="bi bi-pen"></i>
                        <span><%= t('common.firmar') %></span>
                      <% end %>
                    <% else %>
                      <span class="badge rounded-pill text-bg-success">
                        <i class="bi bi-check-circle"></i>
                        <%= investigador.date_firm %>
                      </span>
                    <% end %>
                  </td>
                  <% if Current.user.level > 0 && Current.user.level < 3 %>
                    <td data-label="Eliminar">
                      <%= button_to investigador, method: :delete, class: "conesst-btn conesst-btn-danger", title: "Eliminar investigador", form: {data: {turbo_confirm: "¿Está seguro de eliminar este investigador del equipo?"}} do %>
                        <i class="bi bi-trash"></i>
                        <span>Eliminar</span>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% else %>
    <div class="conesst-card mt-3">
      <div class="conesst-card-body">
        <div class="simulacrum-empty">
          <i class="bi bi-info-circle"></i>
          <span>
            Aún no se han agregado investigadores al equipo.
          </span>
        </div>
      </div>
    </div>
  <% end %>
</div>
