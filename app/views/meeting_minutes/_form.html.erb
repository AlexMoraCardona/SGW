<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-journal-text fs-5"></i>
        <div>
          <h4 class="mb-0">Acta de reunión</h4>
          <small class="text-muted">
            Registro y documentación de la reunión
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @meeting_minute do |form| %>
        <%= form.hidden_field :entity_id, value: @entity.id if @entity.present? %>
        <%= form.hidden_field :evaluation_id, value: @evaluation.id if @evaluation.present? %>
        <%= form.hidden_field :user_id, value: Current.user.id if Current.present? %>
        <%= form.hidden_field :elaborated, value: Current.user.name if Current.present? %>
        <%= form.hidden_field :code, value: @template.reference if @template.present? %>
        <%= form.hidden_field :vers, value: @template.version.to_i if @template.present? %>
        <div class="row g-3 mb-4">
          <div class="col-12 col-md-6">
            <%= form.label :version, class: "form-label fw-semibold" %>
            <%= form.select :version, [['Acta de Asesoría', 0], ['Acta del COPASST', 1], ['Acta de la Brigada de Emergencia', 2], ['Acta del Comité de Convivencia', 3]], {}, class: "form-select" %>
          </div>
        </div>
        <div class="conesst-card mb-4">
          <div class="conesst-card-header">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-info-circle fs-5"></i>
              <div>
                <h5 class="mb-0">Información general</h5>
                <small class="text-muted">
                  Datos básicos de la reunión
                </small>
              </div>
            </div>
          </div>
          <div class="conesst-card-body">
            <div class="row g-3">
              <div class="col-12 col-md-4">
                <%= form.label :date, class: "form-label fw-semibold" %>
                <%= form.date_field :date, class: "form-control" %>
              </div>
              <div class="col-12 col-md-4">
                <%= form.label :area_process_committee, class: "form-label fw-semibold" %>
                <%= form.select :area_process_committee, [['Sin seleccionar', 'Sin seleccionar'], ['SG-SST', 'SG-SST']], {}, class: "form-select" %>
              </div>
              <div class="col-12">
                <%= form.label :objective_meeting, class: "form-label fw-semibold" %>
                <%= form.text_field :objective_meeting, class: "form-control" %>
              </div>
              <div class="col-12 col-md-6">
                <%= form.label :meeting_type, class: "form-label fw-semibold" %>
                <%= form.select :meeting_type, [['Sin seleccionar', 'Sin seleccionar'], ['Comité', 'Comité'], ['Asesoría', 'Asesoría'], ['Auditoría', 'Auditoría']], {}, class: "form-select" %>
              </div>
              <div class="col-12 col-md-6">
                <%= form.label :place, class: "form-label fw-semibold" %>
                <%= form.text_field :place, class: "form-control" %>
              </div>
              <div class="col-12 col-md-6">
                <%= form.label :start_time, class: "form-label fw-semibold" %>
                <%= form.time_field :start_time, class: "form-control" %>
              </div>
              <div class="col-12 col-md-6">
                <%= form.label :end_time, class: "form-label fw-semibold" %>
                <%= form.time_field :end_time, class: "form-control" %>
              </div>
            </div>
          </div>
        </div>
        <% if @meeting_attendees.present? %>
          <div class="conesst-card mb-4">
            <div class="conesst-card-header">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people fs-5"></i>
                <div>
                  <h5 class="mb-0">Asistentes</h5>
                  <small class="text-muted">
                    Personas convocadas a la reunión
                  </small>
                </div>
              </div>
            </div>
            <div class="conesst-card-body">
              <%= render partial: 'asistentes' %>
            </div>
          </div>
        <% end %>
        <div class="conesst-card mb-4">
          <div class="conesst-card-header">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-list-ol fs-5"></i>
              <div>
                <h5 class="mb-0">Orden del día</h5>
                <small class="text-muted">
                  Temas programados para la reunión
                </small>
              </div>
            </div>
          </div>
          <div class="conesst-card-body">
            <%= form.label :order_day, class: "form-label fw-semibold" %>
            <%= form.rich_text_area :order_day %>
          </div>
        </div>
        <div class="conesst-card mb-4">
          <div class="conesst-card-header">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-chat-left-text fs-5"></i>
              <div>
                <h5 class="mb-0">Temas tratados</h5>
                <small class="text-muted">
                  Desarrollo y contenido de la reunión
                </small>
              </div>
            </div>
          </div>
          <div class="conesst-card-body">
            <%= form.label :Issues, "Temas tratados", class: "form-label fw-semibold" %>
            <%= form.rich_text_area :Issues %>
          </div>
        </div>
        <div class="conesst-card mb-4">
          <div class="conesst-card-header">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-chat-square-text fs-5"></i>
              <div>
                <h5 class="mb-0">Proposiciones y varios</h5>
                <small class="text-muted">
                  Otros asuntos tratados durante la reunión
                </small>
              </div>
            </div>
          </div>
          <div class="conesst-card-body">
            <%= form.label :miscellaneous_propositions, "Proposiciones y varios", class: "form-label fw-semibold" %>
            <%= form.rich_text_area :miscellaneous_propositions %>
          </div>
        </div>
        <% if @meeting_commitments.present? %>
          <div class="conesst-card mb-4">
            <div class="conesst-card-header">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check2-square fs-5"></i>
                <div>
                  <h5 class="mb-0">Compromisos</h5>
                  <small class="text-muted">
                    Compromisos establecidos durante la reunión
                  </small>
                </div>
              </div>
            </div>
            <div class="conesst-card-body">
              <%= render partial: 'commitments' %>
            </div>
          </div>
        <% end %>
        <div class="conesst-card mb-4">
          <div class="conesst-card-header">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-clock-history fs-5"></i>
              <div>
                <h5 class="mb-0">Cierre de la reunión</h5>
              </div>
            </div>
          </div>
          <div class="conesst-card-body">
            <p class="mb-0">
              Agotada la reunión, se da por terminada siendo las:
              <span class="text-muted">
                <%= @meeting_minute.end_time if @meeting_minute.present? %>
              </span>
            </p>
          </div>
        </div>
        <div class="conesst-card mb-4">
          <div class="conesst-card-header">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-pen fs-5"></i>
              <div>
                <h5 class="mb-0">Firmantes</h5>
                <small class="text-muted">
                  Para constancia de la reunión
                </small>
              </div>
            </div>
          </div>
          <div class="conesst-card-body">
            <p class="mb-3">
              Para constancia firman:
            </p>
            <% if @assistants.present? %>
              <%= render partial: 'firmantes' %>
            <% end %>
          </div>
        </div>
        <div class="mb-4">
          <div class="small text-muted">
            Elaboró
          </div>
          <div class="fw-semibold">
            <%= Current.user.name %>
          </div>
        </div>
        <div class="conesst-actions">
          <%= form.submit t('common.submit'), class: "conesst-btn conesst-btn-primary" %>
          <%= link_to meeting_minutes_path, class: "conesst-btn" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>