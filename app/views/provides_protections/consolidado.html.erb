<div class="conesst-page">
  <div class="mb-3">
    <%= link_to root_path, class: "d-inline-block" do %>
      <%= image_tag "LogoConesst202305232.png", width: 100, height: 100,  alt: "CONESST" %>
    <% end %>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-shield-check fs-5"></i>
        <div>
          <h5 class="mb-0">
            Consolidado de elementos de protección personal entregados
          </h5>
          <small class="text-muted">
            Información consolidada de los elementos entregados al colaborador
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <div class="conesst-table-wrapper">
        <table class="conesst-table">
          <thead>
            <tr>
              <th>NOMBRE Y APELLIDO</th>
              <th>N° DE DOCUMENTO</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td data-label="NOMBRE Y APELLIDO">
                <%= @user.name %>
              </td>
              <td data-label="N° DE DOCUMENTO">
                <%= @user.nro_document %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-list-check fs-5"></i>
        <div>
          <h5 class="mb-0">Detalle</h5>
          <small class="text-muted">
            Elementos de protección personal entregados
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <div class="conesst-table-wrapper">
        <table class="conesst-table">
          <thead>
            <tr>
              <th>DESCRIPCIÓN</th>
              <th class="text-center">CANTIDAD</th>
              <th class="text-center">FECHA DE ENTREGA</th>
            </tr>
          </thead>
          <tbody>
            <% @provides_protections.each do |provides_protection| %>
              <% items = ProvidesProtectionItem.consulta(provides_protection.id) %>
              <% items.each do |item| %>
                <tr>
                  <td data-label="DESCRIPCIÓN">
                    <%= item.protection_element.name %>
                  </td>
                  <td data-label="CANTIDAD" class="text-center">
                    <%= item.cant %>
                  </td>
                  <td data-label="FECHA DE ENTREGA" class="text-center">
                    <%= item.date_entrega %>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="conesst-actions">
    <%= link_to provides_protections_path(entity_id: Current.user.entity.to_i), class: "conesst-btn" do %>
      <i class="bi bi-arrow-left me-1"></i>
      Retornar
    <% end %>
  </div>
</div>