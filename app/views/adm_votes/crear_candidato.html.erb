<div class="conesst-page">
    <div class="container-fluid px-2 px-md-3">
        <div class="mb-3">
            <%= link_to root_path, class: "navbar-brand" do %>
                <%= image_tag 'LogoConesst202305232.png', width: 100, height: 100 %>
            <% end %>
        </div>

        <div class="conesst-card mb-4">
            <div class="conesst-card-header">
                <div class="conesst-card-header-content">
                    <h2 class="conesst-card-header-title">
                        <i class="bi bi-person-gear me-2"></i>
                        Configuración de Candidatos
                    </h2>
                    <p class="conesst-card-header-subtitle">
                        Registre y configure los candidatos de la votación.
                    </p>
                </div>
            </div>

            <div class="card-body p-3 p-md-4">
                <%= form_with model: @candidate_vote do |form| %>
                    <% if @candidate_vote.errors.any? %>
                        <div class="alert alert-danger" role="alert">
                            <ul class="mb-0">
                                <% @candidate_vote.errors.full_messages.each do |error| %>
                                    <li><%= error %></li>
                                <% end %>
                            </ul>
                        </div>
                    <% end %>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <%= form.label :user_id, class: "form-label fw-semibold" do %>
                                Candidato
                                <%= image_tag 'ayuda.png', width: 20, height: 20, data: { bs_toggle: "tooltip" }, title: "Seleccione el candidato." %>
                            <% end %>

                            <%= form.collection_select :user_id, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "Seleccione un candidato" }, { class: "form-select", required: true } %>
                        </div>
                        <div class="col-12 col-md-6">
                            <%= form.label :observations, class: "form-label fw-semibold" do %>
                                <%= t('.observations') %>
                                <%= image_tag 'ayuda.png', width: 20, height: 20, data: { bs_toggle: "tooltip" }, title: "Ingrese las observaciones del candidato." %>
                            <% end %>

                            <%= form.text_field :observations, class: "form-control" %>
                        </div>

                        <div class="col-12 col-md-6">
                            <%= form.label :avatar_candidate, "Fotografía del candidato", class: "form-label fw-semibold" %>

                            <%= form.file_field :avatar_candidate, class: "form-control", accept: "image/*", capture: "environment" %>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Vista previa</label>

                            <div class="d-flex align-items-center">
                                <% if @candidate_vote.avatar_candidate.attached? && @candidate_vote.avatar_candidate.image? %>
                                    <%= image_tag @candidate_vote.avatar_candidate, class: "avatar-mini", data: { previews_target: "preview" } %>
                                <% else %>
                                    <%= image_tag "avatar.jpg", class: "avatar-mini" %>
                                <% end %>
                            </div>
                        </div>
                    </div>

                    <%= form.hidden_field :adm_vote_id, value: @adm_vote.id if @adm_vote.present? %>
                    <div class="conesst-actions mt-4">
                        <%= form.button type: "submit", class: "conesst-btn conesst-btn-primary" do %>
                            <i class="bi bi-save me-1"></i>
                            <%= t('common.submit') %>
                        <% end %>

                        <%= link_to adm_votes_path(entity_id: @adm_vote.entity_id), class: "conesst-btn btn-sm btn-outline-secondary" do %>
                            <i class="bi bi-arrow-left me-1"></i>
                            Retornar
                        <% end %>
                    </div>
                <% end %>
            </div>
        </div>

        <div class="conesst-card mb-4">
            <div class="conesst-card-header">
                <div class="conesst-card-header-content">
                    <h2 class="conesst-card-header-title">
                        <i class="bi bi-people me-2"></i>
                        Candidatos Configurados
                    </h2>
                    <p class="conesst-card-header-subtitle">
                        Consulte, edite o elimine los candidatos registrados.
                    </p>
                </div>
            </div>

            <div class="card-body p-2 p-md-4">
                <% if @candidate_votes.present? %>

                    <%# Tabla para computadores %>
                    <div class="d-none d-md-block">
                        <div class="conesst-table-wrapper">
                            <table class="table table-hover align-middle conesst-table mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">Avatar</th>
                                        <th scope="col">Nombre</th>
                                        <th scope="col">Cargo</th>
                                        <th scope="col" class="text-center">Editar</th>
                                        <th scope="col" class="text-center">Eliminar</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% @candidate_votes.each do |candidate_vote| %>
                                        <tr>
                                            <td>
                                                <% if candidate_vote.avatar_candidate.attached? && candidate_vote.avatar_candidate.image? %>
                                                    <%= image_tag candidate_vote.avatar_candidate,
                                                        class: "avatar-mini" %>
                                                <% else %>
                                                    <%= image_tag "avatar.jpg", class: "avatar-mini" %>
                                                <% end %>
                                            </td>

                                            <td><%= candidate_vote.user&.name %></td>
                                            <td><%= candidate_vote.activity %></td>

                                            <td class="text-center">
                                                <%= link_to edit_candidate_vote_path(candidate_vote.id), class: "conesst-btn conesst-btn-primary btn-sm" do %>
                                                    <i class="bi bi-pencil-square me-1"></i>
                                                    <%= t('common.edit') %>
                                                <% end %>
                                            </td>

                                            <td class="text-center">
                                                <%= button_to candidate_vote, method: :delete, class: "btn btn-sm btn-outline-danger", form: { class: "d-inline" }, data: { turbo_confirm: "¿Está seguro de eliminar este candidato?" } do %>
                                                    <i class="bi bi-trash me-1"></i>
                                                    Eliminar
                                                <% end %>
                                            </td>
                                        </tr>
                                    <% end %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <%# Tarjetas para celulares: evita la separación entre etiquetas y valores %>
                    <div class="d-md-none">
                        <div class="row g-3">
                            <% @candidate_votes.each do |candidate_vote| %>
                                <div class="col-12">
                                    <div class="card h-100 border shadow-sm">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center gap-3 mb-3">
                                                <% if candidate_vote.avatar_candidate.attached? && candidate_vote.avatar_candidate.image? %>
                                                    <%= image_tag candidate_vote.avatar_candidate, class: "avatar-mini flex-shrink-0" %>
                                                <% else %>
                                                    <%= image_tag "avatar.jpg", class: "avatar-mini flex-shrink-0" %>
                                                <% end %>

                                                <div class="min-w-0">
                                                    <div class="fw-bold text-break">
                                                        <%= candidate_vote.user&.name %>
                                                    </div>
                                                    <div class="text-muted small text-break">
                                                        <%= candidate_vote.activity.presence || "Cargo no especificado" %>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex flex-wrap gap-2">
                                                <%= link_to edit_candidate_vote_path(candidate_vote.id), class: "conesst-btn conesst-btn-primary btn-sm" do %>
                                                    <i class="bi bi-pencil-square me-1"></i>
                                                    Editar
                                                <% end %>

                                                <%= button_to candidate_vote, method: :delete, class: "btn btn-sm btn-outline-danger", form: { class: "d-inline" }, data: { turbo_confirm: "¿Está seguro de eliminar este candidato?" } do %>
                                                    <i class="bi bi-trash me-1"></i>
                                                    Eliminar
                                                <% end %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>

                <% else %>
                    <div class="text-center py-4">
                        <i class="bi bi-person-x fs-1 text-muted"></i>
                        <p class="text-muted mt-2 mb-0">
                            No hay candidatos configurados.
                        </p>
                    </div>
                <% end %>
            </div>
        </div>
    </div>
</div>