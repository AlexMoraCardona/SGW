<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-body">
      <%= form_with model: @audit_report do |form| %>
        <% if @audit_report.errors.any? %>
          <div class="alert alert-danger audit-report-form-errors" role="alert">
            <div class="fw-semibold mb-2">
                <i class="bi bi-exclamation-triangle me-1"></i>
                No fue posible guardar el informe.
            </div>
            <ul class="mb-0">
              <% @audit_report.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <%= form.hidden_field :entity_id, value: params[:entity_id].to_i if params[:entity_id].present? %>
        <%= form.hidden_field :code, value: @template.reference if @template.present? %>
        <%= form.hidden_field :version, value: @template.version.to_i if @template.present? %>

        <div class="audit-report-form-section">
          <div class="audit-report-form-section-title">
            <i class="bi bi-people"></i>
            <span>Responsables de la auditoría</span>
          </div>
          <div class="audit-report-form-grid">
            <div class="audit-report-form-field">
              <%= form.label :user_representante, "Representante Legal", class: "audit-report-form-label" do %>
                <span>
                  <i class="bi bi-person-badge"></i>
                  Representante Legal
                </span>
                <button type="button" class="audit-report-help" data-bs-toggle="tooltip" data-bs-html="true" title="Seleccione el nombre del Representante Legal.">
                  <%= image_tag "ayuda.png", width: 22, height: 22, alt: "Ayuda" %>
                </button>
              <% end %>
              <%= form.collection_select :user_representante, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccionar representante --" }, { class: "form-select audit-report-form-control" } %>
            </div>
            <div class="audit-report-form-field">
              <%= form.label :user_audit, "Auditor SST", class: "audit-report-form-label" do %>
                <span>
                  <i class="bi bi-person-check"></i>
                  Auditor SST
                </span>
                <button type="button" class="audit-report-help" data-bs-toggle="tooltip" data-bs-html="true" title="Seleccione el nombre del Auditor.">
                  <%= image_tag "ayuda.png", width: 22, height: 22, alt: "Ayuda" %>
                </button>
              <% end %>
              <%= form.collection_select :user_audit, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccionar auditor --" }, { class: "form-select audit-report-form-control" } %>
            </div>
          </div>
        </div>
        <div class="audit-report-form-section">
          <div class="audit-report-form-section-title">
            <i class="bi bi-calendar3"></i>
            <span>Fecha de la auditoría</span>
          </div>
          <div class="audit-report-form-field audit-report-date-field">
            <%= form.label :date_audit, "Fecha de auditoría", class: "audit-report-form-label" do %>
                <span>
                    <i class="bi bi-calendar-event"></i>
                    Fecha de auditoría
                </span>
            <% end %>
            <%= form.date_field :date_audit,  class: "form-control audit-report-form-control" %>
          </div>
        </div>
        <div class="audit-report-form-section">
          <div class="audit-report-form-section-title">
            <i class="bi bi-check2-circle"></i>
            <span>Conclusiones</span>
          </div>
          <div class="audit-report-form-field">
            <%= form.label :conclusions, "Conclusiones", class: "audit-report-form-label" do %>
                <span>
                    <i class="bi bi-check-circle"></i>
                    Conclusiones de la auditoría
                </span>
            <% end %>
            <%= form.text_area :conclusions, rows: 6, class: "form-control audit-report-form-control audit-report-textarea" %>
          </div>
        </div>
        <div class="audit-report-form-section">
          <div class="audit-report-form-section-title">
            <i class="bi bi-chat-left-text"></i>
            <span>Observaciones</span>
          </div>
          <div class="audit-report-form-field">
            <%= form.label :observations, "Observaciones", class: "audit-report-form-label" do %>
                <span>
                    <i class="bi bi-chat-text"></i>
                    Observaciones de la auditoría
                </span>
            <% end %>
            <%= form.text_area :observations, rows: 6, class: "form-control audit-report-form-control audit-report-textarea" %>
          </div>
        </div>
        <div class="conesst-actions audit-report-form-actions">
          <%= form.button type: "submit", class: "conesst-btn conesst-btn-primary", title: t('common.submit') do %>
            <i class="bi bi-check-circle"></i>
            <span><%= t('common.submit') %></span>
          <% end %>
          <%= link_to :back, class: "conesst-btn conesst-btn-warning", title: "Retornar" do %>
            <i class="bi bi-arrow-left"></i>
            <span>Retornar</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
