<% if @entity.present? %>
    <div class="audit-company-header">
        <div class="audit-company-title-row">
            <i class="bi bi-building audit-company-icon"></i>
            <div class="audit-company-title">
                <%= @entity.business_name %>
            </div>
        </div>
        <div class="audit-company-nit">
            NIT:
            <%= EvaluationRuleDetail.miles(@entity.identification_number) if @entity.identification_number.present? %><%=
                "-#{@entity.verification_digit}" if @entity.verification_digit.present?
            %>
        </div>
    </div>
<% end %>
<% if @audit_reports.present? %>
    <div class="conesst-actions mb-3">
        <%= link_to new_audit_report_path(entity_id: @entity.id), class: "conesst-btn conesst-btn-primary" do %>
            <i class="bi bi-plus-circle"></i>
            <span><%= t('.create_audit_report') %></span>
        <% end %>
    </div>
    <% @audit_reports.each do |audit_report| %>
        <div class="conesst-card conesst-audit-card mb-4">
            <div class="conesst-card-header">
                <div class="audit-header">
                    <div>
                        <div class="audit-label">
                            <i class="bi bi-clipboard2-check"></i>
                            Auditoría interna del SG-SST
                        </div>
                        <h3 class="conesst-card-header-title">
                            Informe de auditoría interna
                        </h3>
                    </div>
                    <div class="audit-date">
                        <i class="bi bi-calendar3"></i>
                        <span>
                            <%= audit_report.date_audit %>
                        </span>
                    </div>
                </div>
            </div>
            <div class="conesst-card-body">
                <div class="conesst-actions">
                    <%= link_to crear_item_auditoria_interna_path(audit_report.id), class: "conesst-btn conesst-btn-warning" do %>
                        <i class="bi bi-plus-square"></i>
                        <span>
                            <%= t('common.create_item_auditoria_interna_audit_report') %>
                        </span>
                    <% end %>
                    <%= link_to audit_report_path(audit_report.id), class: "conesst-btn conesst-btn-warning" do %>
                        <i class="bi bi-eye"></i>
                        <span>
                            <%= t('common.show_audit_report') %>
                        </span>
                    <% end %>
                    <%= link_to edit_audit_report_path(audit_report.id), class: "conesst-btn conesst-btn-warning" do %>
                        <i class="bi bi-pencil-square"></i>
                        <span>
                            <%= t('common.edit') %>
                        </span>
                    <% end %>
                    <%= link_to ver_auditoria_interna_pdf_path(audit_report.id, format: 'pdf'), class: "conesst-btn conesst-btn-success", target: "_blank" do %>
                        <i class="bi bi-file-earmark-pdf"></i>
                        <span>PDF</span>
                    <% end %>
                </div>
                <div class="conesst-section-title">
                    <i class="bi bi-pen"></i>
                    Firmas del informe
                </div>
                <div class="conesst-info-card">
                    <div class="conesst-info-card-title">
                        <i class="bi bi-person-badge"></i>
                        <%= t('.user_representante') %>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <div class="conesst-data-label">
                                <%= t('.user_representante') %>
                            </div>
                            <div class="conesst-data-value">
                                <%= audit_report.name_user(audit_report.user_representante) %>
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="conesst-data-label">
                                <%= t('.firm_representante') %>
                            </div>
                            <div class="conesst-data-value">
                                <%= audit_report.label_firm(audit_report.firm_representante) %>
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="conesst-data-label">
                                <%= t('.date_firm_representante') %>
                            </div>
                            <div class="conesst-data-value">
                                <%= audit_report.date_firm_representante %>
                            </div>
                        </div>
                        <div class="col-12 col-md-2 d-flex align-items-end">
                            <% if audit_report.firm_representante.to_i == 0 %>
                                <%= link_to firmar_representante_audi_path(audit_report.id, 1), class: "conesst-btn conesst-btn-warning" do %>
                                    <i class="bi bi-pen"></i>
                                    <span>
                                        <%= t('common.firmar') %>
                                    </span>
                                <% end %>
                            <% end %>
                        </div>
                    </div>
                </div>
                <div class="conesst-info-card mt-3">
                    <div class="conesst-info-card-title">
                        <i class="bi bi-person-check"></i>
                        <%= t('.user_audit') %>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <div class="conesst-data-label">
                                <%= t('.user_audit') %>
                            </div>
                            <div class="conesst-data-value">
                                <%= audit_report.name_user(audit_report.user_audit) %>
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="conesst-data-label">
                                <%= t('.firm_audit') %>
                            </div>
                            <div class="conesst-data-value">
                                <%= audit_report.label_firm(audit_report.firm_audit) %>
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="conesst-data-label">
                                <%= t('.date_firm_audit') %>
                            </div>
                            <div class="conesst-data-value">
                                <%= audit_report.date_firm_audit %>
                            </div>
                        </div>
                        <div class="col-12 col-md-2 d-flex align-items-end">
                            <% if audit_report.firm_audit.to_i == 0 %>
                                <%= link_to firmar_auditor_path(audit_report.id, 2), class: "conesst-btn conesst-btn-warning" do %>
                                    <i class="bi bi-pen"></i>
                                    <span>
                                        <%= t('common.firmar') %>
                                    </span>
                                <% end %>
                            <% end %>
                        </div>
                    </div>
                </div>
                <div class="conesst-section-title mt-4">
                    <div>
                        <i class="bi bi-search"></i>
                        Hallazgos
                    </div>
                    <% if @audit_report_items.present? %>
                        <span class="conesst-section-badge">
                            <%= @audit_report_items.where(audit_report_id: audit_report.id).count %>
                        </span>
                    <% end %>
                </div>
                <% if @audit_report_items.present? && @audit_report_items.where(audit_report_id: audit_report.id).present? %>
                    <div class="conesst-table-wrapper">
                        <table class="table conesst-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Tipo de hallazgo</th>
                                    <th>Proceso</th>
                                    <th>Hallazgo</th>
                                    <th class="text-center">Editar</th>
                                    <th class="text-center">Eliminar</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% @audit_report_items.where(audit_report_id: audit_report.id).each do |audit_report_item| %>
                                    <tr>
                                        <td class="conesst-table-id">
                                            <%= audit_report_item.id %>
                                        </td>
                                        <td>
                                            <span class="conesst-finding-badge">
                                                <%= AuditReportItem.label_type_finding(audit_report_item.type_finding) %>
                                            </span>
                                        </td>
                                        <td>
                                            <%= audit_report_item.process %>
                                        </td>
                                        <td class="conesst-finding-text">
                                            <%= audit_report_item.finding %>
                                        </td>
                                        <td class="text-center">
                                            <%= link_to edit_audit_report_item_path(audit_report_item), class: "conesst-btn conesst-btn-primary conesst-btn-icon", title: t('common.edit') do %>
                                                <i class="bi bi-pencil-square"></i>
                                            <% end %>
                                        </td>
                                        <td class="text-center">
                                            <%= button_to audit_report_item, method: :delete, class: "conesst-btn conesst-btn-danger conesst-btn-icon", title: "Eliminar", form: {data: {turbo_confirm: "¿Está seguro de eliminar este hallazgo?"}} do %>
                                                <i class="bi bi-trash"></i>
                                            <% end %>
                                        </td>
                                    </tr>
                                <% end %>
                            </tbody>
                        </table>
                    </div>
                <% else %>
                    <div class="conesst-empty">
                        <i class="bi bi-clipboard-x"></i>
                        <div>
                            No hay hallazgos registrados para esta auditoría.
                        </div>
                    </div>
                <% end %>
            </div>
        </div>
    <% end %>
<% else %>
    <div class="conesst-card">
        <div class="conesst-card-body text-center">
            <div class="conesst-empty">
                <i class="bi bi-clipboard-plus"></i>
                <h4>
                    No hay informes de auditoría
                </h4>
                <p>
                    Puede crear el primer informe de auditoría interna
                    para esta empresa.
                </p>
                <%= link_to new_audit_report_path(entity_id: @entity.id), class: "conesst-btn conesst-btn-primary" do %>
                    <i class="bi bi-plus-circle"></i>
                    <span><%= t('common.create_audit_report') %></span>
                <% end %>
            </div>
        </div>
    </div>
<% end %>

