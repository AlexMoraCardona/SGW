<div class="conesst-page">
    <div class="conesst-logo-container">
        <%= link_to root_path, class: "navbar-brand" do %>
            <%= image_tag "LogoConesst202305232.png", class: "conesst-logo", alt: "CONESST" %>
        <% end %>
    </div>
    <div class="conesst-header">
        <div>
            <h1 class="conesst-title">
                <i class="bi bi-clipboard2-check me-1"></i>
                Informe Plan de Mejoramiento SG-SST
            </h1>
            <p class="conesst-subtitle">
                Consulta y seguimiento del plan de mejoramiento de la entidad
            </p>
        </div>
    </div>
    <div class="conesst-card">
        <div class="conesst-card-header">
            <div class="conesst-card-header-content">
                <h2 class="conesst-card-header-title">
                    <i class="bi bi-building me-1"></i>
                    Selección de empresa
                </h2>
            </div>
        </div>
        <div class="conesst-card-body">
            <% if params[:entity_id].present? || @entity.present? %>
                <%= render "improvement_plans" %>
            <% else %>
                <%= form_with model: @entity, method: :get, local: true do |form| %>
                    <div class="row">
                        <div class="col-12 col-md-8 col-lg-7">
                            <div class="mb-3">
                                <%= form.label :entity_id, "Empresa", class: "form-label fw-semibold" %>
                                <% if @entities.present? %>
                                    <%= form.collection_select(:entity_id, @entities.order(id: :asc), :id, :business_name, {prompt: "-- Seleccionar Entidad --"}, {class: "form-select select2"}) %>
                                <% else %>
                                    <div class="form-control bg-light">
                                        <%= @entity.business_name %>
                                    </div>
                                    <%= form.hidden_field :entity_id, value: @entity.id %>
                                <% end %>
                            </div>
                        </div>
                    </div>
                    <div class="conesst-actions">
                        <%= form.button type: "submit", class: "conesst-btn conesst-btn-primary" do %>
                            <i class="bi bi-search"></i>
                            Consultar
                        <% end %>
                    </div>
                <% end %>
            <% end %>
        </div>
    </div>
</div>
