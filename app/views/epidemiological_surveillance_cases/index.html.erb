<div class="container-fluid px-2 px-md-4 py-3">
  <div align="left"; class="container col-12">
    <a class="navbar-brand" href="/">
        <%= image_tag 'LogoConesst202305232.png',:width => "100",  :height=>"100" %>
    </a>
  </div>
  <div class="card shadow-sm">
    <div class="card-header bg-light">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div>
          <h5 class="mb-1">
            <i class="bi bi-clipboard2-pulse me-2"></i>
            Casos del SVE
          </h5>
          <small class="text-muted">
            <%= @epidemiological_surveillance_program.name %>
          </small>
        </div>
        <div>
          <%= link_to(epidemiological_surveillance_program_path(@epidemiological_surveillance_program), class: "btn btn-outline-secondary btn-sm") do %>
            <i class="bi bi-arrow-left me-1"></i>
            Volver al programa
          <% end %>
        </div>
      </div>
    </div>
    <div class="card-body">
      <% if @epidemiological_surveillance_cases.any? %>
        <div class="table-responsive">
          <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="text-center">
                  Caso
                </th>
                <th>
                  Trabajador
                </th>
                <th>
                  Fecha apertura
                </th>
                <th class="text-center">
                  Origen
                </th>
                <th class="text-center">
                  Estado
                </th>
                <th>
                  Responsable
                </th>
                <th class="text-center">
                  Acciones
                </th>
              </tr>
            </thead>
            <tbody>
              <% @epidemiological_surveillance_cases.each do |sve_case| %>
                <tr>
                  <td class="text-center fw-semibold">
                    #<%= sve_case.id %>
                  </td>
                  <td>
                    <%= sve_case.user&.name || "No registrado" %>
                  </td>
                  <td>
                    <%= sve_case.opened_at&.strftime("%d/%m/%Y %H:%M") || "No registrada" %>
                  </td>
                  <td class="text-center">
                    <% case sve_case.source_type when "survey" %>
                      <span class="badge bg-info text-dark">
                        <i class="bi bi-ui-checks me-1"></i>
                        Encuesta
                      </span>
                    <% when "event" %>
                      <span class="badge bg-warning text-dark">
                          <i class="bi bi-exclamation-triangle me-1"></i>
                          Evento
                      </span>
                    <% else %>
                      <span class="badge bg-secondary">
                        Otro
                      </span>
                    <% end %>
                  </td>
                  <td class="text-center">
                      <% case sve_case.status when "identified" %>
                        <span class="badge bg-secondary">
                          Identificado
                        </span>
                      <% when "in_evaluation" %>
                        <span class="badge bg-warning text-dark">
                            En evaluación
                        </span>
                      <% when "in_follow_up" %>
                        <span class="badge bg-primary">
                            En seguimiento
                        </span>
                      <% when "closed" %>
                          <span class="badge bg-success">
                              Cerrado
                          </span>
                      <% when "not_case" %>
                          <span class="badge bg-dark">
                              No es caso
                          </span>
                      <% else %>
                        <span class="badge bg-secondary">
                            Sin estado
                        </span>
                      <% end %>
                  </td>
                  <td>
                    <%= sve_case.responsible&.name || "Sin asignar" %>
                  </td>
                  <td class="text-center">
                    <%= link_to(epidemiological_surveillance_program_epidemiological_surveillance_case_path(@epidemiological_surveillance_program, sve_case), class: "btn btn-outline-primary btn-sm", title: "Ver caso", data: { bs_toggle: "tooltip" }) do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-clipboard-x display-4 text-muted"></i>
          <h6 class="mt-3">No hay casos registrados</h6>
          <p class="text-muted mb-0">Los casos seleccionados desde las encuestas aparecerán aquí.</p>
        </div>
      <% end %>
    </div>
    <div class="card-footer bg-light">
      <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted">
          Total de casos:
          <strong><%= @epidemiological_surveillance_cases.size %></strong>
        </span>
      </div>
    </div>
  </div>
</div>