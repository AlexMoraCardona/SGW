          <%= @kit.recomendaciones if @kit.recomendaciones.present? %>
        </div>
      </div>
    </div>
    <% if @kit.kit_fotos.attached? %>
      <div class="conesst-card mb-4">
        <div class="conesst-card-header">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-paperclip fs-5"></i>
            <div>
              <h5 class="mb-0">Archivos adjuntos</h5>
              <small class="text-muted">
                Fotografías y archivos asociados al botiquín
              </small>
            </div>
          </div>
        </div>
        <div class="conesst-card-body">
          <div class="row g-3" data-controller="previews">
            <% @kit.kit_fotos.each do |file| %>
              <div class="col-12 col-sm-6 col-lg-4">
                <div class="border rounded h-100">
                  <div class="border-bottom p-2 text-break">
                    <span class="small fw-semibold">
                      <%= file.filename %>
                    </span>
                  </div>
                  <div class="p-3 text-center">
                    <% if file.image? %>
                      <%= image_tag file, data: { previews_target: "preview" }, class: "img-fluid rounded mb-3" %>
                    <% elsif file.video? %>
                      <%= video_tag url_for(file), controls: true, class: "w-100 rounded mb-3" %>
                    <% elsif file.audio? %>
                      <audio controls class="w-100 mb-3">
                        <source src="<%= url_for(file) %>">
                      </audio>
                    <% else %>
                      <div class="py-4">
                        <i class="bi bi-file-earmark fs-1"></i>
                        <div class="mt-2 text-break">
                          <%= file.filename %>
                        </div>
                      </div>
                    <% end %>
                    <%= link_to rails_blob_path(file, disposition: "attachment"), class: "conesst-btn conesst-btn-success" do %>
                      <i class="bi bi-download me-1"></i>
                      Descargar
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-pen fs-5"></i>
          <div>
            <h5 class="mb-0">
              Firma del responsable de la inspección
            </h5>
            <small class="text-muted">
              Información y autorización del responsable
            </small>
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <div class="border rounded p-3 h-100">
              <div class="small text-muted mb-1">
                Nombre
              </div>
              <div class="fw-semibold">
                <%= @kit.user.name %>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="border rounded p-3 h-100">
              <div class="small text-muted mb-1">
                Cargo
              </div>
              <div class="fw-semibold">
                <%= @kit.post %>
              </div>
            </div>
          </div>
          <div class="col-12">
            <div class="border rounded p-3">
              <div class="small text-muted mb-2">
                Firma
              </div>
              <% if @kit.firm_user == 1 %>
                <% if @kit.user.firm.attached? %>
                  <% if @kit.user.firm.image? %>
                    <div class="text-center mt-2">
                      <%= image_tag @kit.user.firm, class: "img-fluid rounded", style: "max-height:150px;" %>
                    </div>
                  <% end %>
                <% else %>
                  <div class="border rounded p-4 text-center text-muted">
                    <i class="bi bi-exclamation-circle me-1"></i>
                    No existe firma registrada.
                  </div>
                <% end %>
              <% else %>
                <div class="border-bottom mt-5"></div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-actions mt-4">
      <%= link_to request.referer || root_path, class: "conesst-btn" do %>
        <i class="bi bi-arrow-left me-1"></i>
        Retornar
      <% end %>
    </div>
  <% end %>
</div>