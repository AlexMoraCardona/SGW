<% if @entity.present? %>
  <div class="conesst-page">
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
          <div>
            <h4 class="mb-1">
              <i class="bi bi-building me-2"></i>
              <%= @entity.business_name %>
            </h4>
            <small class="text-muted">
              <i class="bi bi-card-text me-1"></i>
              NIT:
              <%= EvaluationRuleDetail.miles(@entity.identification_number) if @entity.identification_number.present? %>
              <% if @entity.verification_digit.present? %>
                -<%= @entity.verification_digit %>
              <% end %>
            </small>
          </div>
          <div>
            <%= link_to new_kit_path(entity_id: @entity.id), class: "conesst-btn conesst-btn-primary" do %>
              <i class="bi bi-plus-circle me-1"></i>
              <%= t('common.create_kit') %>
            <% end %>
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <% if @kits.present? %>
          <div class="conesst-table-wrapper">
            <table class="conesst-table">
              <thead>
                <tr>
                  <th>Fecha creación</th>
                  <th>Área</th>
                  <th>Responsable</th>
                  <th>Firma</th>
                  <th class="text-center">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% @kits.each do |kit| %>
                  <tr>
                    <td data-label="Fecha creación">
                      <%= kit.date_creation %>
                    </td>
                    <td data-label="Área">
                      <%= kit.area %>
                    </td>
                    <td data-label="Responsable">
                      <%= kit.user.name %>
                    </td>
                    <td data-label="Firma">
                      <% if kit.firm_user == 0 %>
                        <%= link_to firmar_kit_kits_path(kit.id, 1), class: "conesst-btn conesst-btn-warning" do %>
                          <i class="bi bi-pen me-1"></i>
                          <%= t('common.firmar') %>
                        <% end %>
                      <% else %>
                        <span class="small">
                          <i class="bi bi-check-circle text-success me-1"></i>
                          <%= kit.date_firm_user %>
                        </span>
                      <% end %>
                    </td>
                    <td data-label="Acciones">
                      <div class="d-flex flex-wrap justify-content-center gap-2">
                        <%= link_to kit_adjunto_kits_path(kit.id), class: "conesst-btn conesst-btn-success" do %>
                          <i class="bi bi-paperclip me-1"></i>
                          Adjunto
                        <% end %>
                        <%= link_to kit_foto_path(kit.id), class: "conesst-btn" do %>
                          <i class="bi bi-camera me-1"></i>
                          Foto
                        <% end %>
                        <%= link_to kit_path(kit.id), class: "conesst-btn conesst-btn-primary" do %>
                          <i class="bi bi-eye me-1"></i>
                          <%= t('common.show_kit') %>
                        <% end %>
                        <%= link_to edit_kit_path(kit.id), class: "conesst-btn conesst-btn-warning" do %>
                          <i class="bi bi-pencil-square me-1"></i>
                          <%= t('common.edit_kit') %>
                        <% end %>
                        <%= link_to kit_pdf_kits_path(kit.id, format: 'pdf'), class: "conesst-btn conesst-btn-success" do %>
                          <i class="bi bi-file-earmark-pdf me-1"></i>
                          PDF
                        <% end %>
                        <%= button_to kit_path(kit), method: :delete,  class: "btn btn-sm btn-danger", form: {data: {turbo_confirm: "¿Está seguro de eliminar este registro? Esta acción no se puede deshacer."}} do %>
                              <i class="bi bi-trash me-1"></i>
                                Eliminar
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-4 text-muted">
            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
            <div>No hay inspecciones de botiquín registradas.</div>
          </div>
        <% end %>
      </div>
    </div>
    <div class="conesst-actions">
      <%= link_to request.referer || root_path, class: "conesst-btn" do %>
        <i class="bi bi-arrow-left me-1"></i>
        Retornar
      <% end %>
    </div>
  </div>
<% end %>
