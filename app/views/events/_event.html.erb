<tr>
    <td><%= event.date_new %></td>
    <td><%= event.user.name %></td>
    <td><%= event.entity.business_name %></td>
    <td style="text-align:center;"><%= Event.labelsino(event.work_accident) %></td>
    <td style="text-align:center;"><%= Event.labelsino(event.mortal_accident) %></td>
    <td style="text-align:center;"><%= Event.labelsino(event.occupational_disease) %></td>
    <td><%= link_to event, class: "btn btn-sm btn-primary text-nowrap" do %>
            <i class="bi bi-eye-fill me-1"></i><%= t('common.show') %>
        <% end %>
    </td>
    <td><%= link_to edit_event_path(event), class: "btn btn-warning btn-sm text-nowrap" do %> 
            <i class="bi bi-pencil-square me-1"></i><%= t('common.edit') %>
        <% end %>
    </td>
    <td><% if Current.user.level > 0 &&  Current.user.level < 3 %>
            <%= button_to event, method: :delete, class: "btn btn-danger btn-sm text-nowrap", form_class: "w-100", data: {turbo_confirm: "¿Está seguro de eliminar este registro? Esta acción no se puede deshacer." } do %>
                <i class="bi bi-trash me-1"></i><%= t('common.delete') %>
            <% end %>
        <% end %>
    </td>
</tr>

