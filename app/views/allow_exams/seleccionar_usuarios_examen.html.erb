<div class="conesst-page">
  <div class="conesst-logo-container">
    <%= link_to root_path, class: "d-inline-block" do %>
      <%= image_tag "LogoConesst202305232.png", class: "conesst-logo", alt: "CONESST" %>
    <% end %>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div>
          <h2 class="conesst-card-header-title">
            <i class="bi bi-people me-2"></i>
            Seleccionar los participantes
          </h2>
          <p class="conesst-card-header-subtitle mb-0">
            Seleccione los usuarios que serán citados al examen
          </p>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_tag citar_usuarios_examen_path, method: :post do %>
        <div class="mb-3">
          <%= label_tag :ids, "Usuarios", class: "form-label fw-semibold" %>
          <%= select_tag :ids, options_from_collection_for_select(@users, :id, :name), multiple: true, class: "form-select select2", prompt: "-- Seleccione los usuarios --" %>
        </div>
        <%= hidden_field_tag :allow_exam_id, @allow_exam.id %>
        <div class="conesst-actions mt-4">
          <%= submit_tag "Crear citación", id: "citaciones", class: "conesst-btn conesst-btn-primary spin" %>
        </div>
      <% end %>
    </div>
  </div>
</div>