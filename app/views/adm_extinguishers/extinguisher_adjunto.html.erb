<div class="conesst-page">
  <% if @extinguisher.present? %>
    <% if @extinguisher.extinguisher_fotos.attached? %>
      <div class="conesst-card mb-4">
        <div class="conesst-card-header">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-paperclip fs-5"></i>
            <div>
              <h4 class="mb-0">
                Archivos adjuntos
              </h4>
              <small class="text-muted">
                Archivos asociados al extintor Nro:
                <%= @extinguisher.nro %>
              </small>
            </div>
          </div>
        </div>
        <div class="conesst-card-body">
          <div class="row g-3" data-controller="previews">
            <% @extinguisher.extinguisher_fotos.each do |file| %>
              <div class="col-12 col-md-6 col-lg-4">
                <% if file.image? %>
                  <div class="border rounded p-3 h-100">
                    <div class="text-center">
                      <div class="small fw-semibold text-break mb-3">
                        <%= file.blob.filename %>
                      </div>
                      <%= image_tag file, data: {previews_target: "preview"}, class: "img-fluid rounded mb-3" %>
                    </div>
                    <div class="d-flex flex-wrap justify-content-center align-items-center gap-2">
                      <%= link_to rails_blob_path(file, disposition: "attachment"), class: "conesst-btn conesst-btn-success" do %>
                        <i class="bi bi-download me-1"></i>
                        Descargar
                      <% end %>
                      <%= link_to purge_attachment_path(file), data: {turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar este registro? Esta acción no se puede deshacer."}, class: "btn btn-sm btn-danger" do %>
                        <i class="bi bi-trash me-1"></i>
                        Borrar
                      <% end %>
                    </div>
                  </div>
                <% elsif file.video? %>
                  <div class="border rounded p-3 h-100">
                    <div class="text-center">
                      <div class="small fw-semibold text-break mb-3">
                        <%= file.blob.filename %>
                      </div>
                      <%= video_tag url_for(file), controls: true, class: "img-fluid rounded mb-3" %>
                    </div>
                    <div class="d-flex flex-wrap justify-content-center align-items-center gap-2">
                      <%= link_to rails_blob_path(file, disposition: "attachment"), class: "conesst-btn conesst-btn-success" do %>
                        <i class="bi bi-download me-1"></i>
                        Descargar
                      <% end %>
                      <%= link_to purge_attachment_path(file), data: {turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar este registro? Esta acción no se puede deshacer."}, class: "btn btn-sm btn-danger" do %>
                        <i class="bi bi-trash me-1"></i>
                        Borrar
                      <% end %>
                    </div>
                  </div>
                <% elsif file.audio? %>
                  <div class="border rounded p-3 h-100">
                    <div class="text-center">
                      <div class="small fw-semibold text-break mb-3">
                        <%= file.blob.filename %>
                      </div>
                      <%= audio_tag url_for(file), controls: true, class: "w-100 mb-3" %>
                    </div>
                    <div class="d-flex flex-wrap justify-content-center align-items-center gap-2">
                      <%= link_to rails_blob_path(file, disposition: "attachment"), class: "conesst-btn conesst-btn-success" do %>
                        <i class="bi bi-download me-1"></i>
                        Descargar
                      <% end %>
                      <%= link_to purge_attachment_path(file), data: {turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar este registro? Esta acción no se puede deshacer."}, class: "btn btn-sm btn-danger" do %>
                        <i class="bi bi-trash me-1"></i>
                        Borrar
                      <% end %>
                    </div>
                  </div>
                <% else %>
                  <div class="border rounded p-3 h-100">
                    <div class="text-center mb-3">
                      <i class="bi bi-file-earmark fs-3 d-block mb-2"></i>
                      <div class="text-break">
                        <%= link_to file.filename, url_for(file), class: "text-decoration-none" %>
                      </div>
                    </div>
                    <div class="d-flex flex-wrap justify-content-center align-items-center gap-2">
                      <%= link_to rails_blob_path(file, disposition: "attachment"), class: "conesst-btn conesst-btn-success" do %>
                        <i class="bi bi-download me-1"></i>
                        Descargar
                      <% end %>
                      <%= link_to purge_attachment_path(file), data: {turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar este registro? Esta acción no se puede deshacer."}, class: "btn btn-sm btn-danger" do %>
                        <i class="bi bi-trash me-1"></i>
                        Borrar
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-cloud-arrow-up fs-5"></i>
          <div>
            <h4 class="mb-0">
              Adjuntar archivos
            </h4>
            <small class="text-muted">
              Seleccione una o varias fotografías o archivos para asociarlos al extintor
            </small>
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <%= form_for @extinguisher do |f| %>
          <div class="row g-3">
            <div class="col-12">
              <%= f.label :extinguisher_fotos, "Archivos adjuntos", class: "form-label fw-semibold" %>
              <%= f.file_field :extinguisher_fotos, multiple: true, class: "form-control" %>
              <div class="form-text mt-2">
                Puede seleccionar varios archivos.
              </div>
            </div>
          </div>
          <div class="conesst-actions mt-4">
            <%= f.submit "Subir Archivos", class: "conesst-btn conesst-btn-primary" %>
            <%= link_to request.referer || root_path, class: "conesst-btn" do %>
              <i class="bi bi-arrow-left me-1"></i>
              Retornar
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>