<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-fire-extinguisher fs-5"></i>
        <div>
          <h4 class="mb-0">
            Crear inspección de extintor
          </h4>
          <small class="text-muted">
            Registre la información básica de la inspección
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @adm_extinguisher do |form| %>
        <% if @adm_extinguisher.errors.any? %>
          <div class="alert alert-danger mb-4" role="alert">
            <div class="fw-semibold mb-2">
              <i class="bi bi-exclamation-triangle me-1"></i>
              Se encontraron los siguientes errores:
            </div>
            <ul class="mb-0">
              <% @adm_extinguisher.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="row g-3">
          <div class="col-12 col-md-5 col-lg-4">
            <div class="d-flex align-items-center gap-2 mb-2">
              <label class="form-label fw-semibold mb-0">
                Fecha
              </label>
              <button type="button" class="btn btn-sm btn-light" data-bs-toggle="tooltip" data-bs-html="true" title="Ingrese la fecha.">
                <%= image_tag "ayuda.png", width: 25, height: 25, alt: "Ayuda" %>
              </button>
            </div>
            <%= form.date_field :date_creation, class: "form-control" %>
          </div>
          <div class="col-12 col-md-7 col-lg-6">
            <div class="d-flex align-items-center gap-2 mb-2">
              <label class="form-label fw-semibold mb-0">
                Dependencia a inspeccionar
              </label>
              <button type="button" class="btn btn-sm btn-light" data-bs-toggle="tooltip" data-bs-html="true" title="Ingrese la dependencia a inspeccionar.">
                <%= image_tag "ayuda.png", width: 25, height: 25, alt: "Ayuda" %>
              </button>
            </div>
            <%= form.text_field :area, class: "form-control" %>
          </div>
        </div>
        <%= form.hidden_field :entity_id, value: params[:entity_id].to_i %>
        <%= form.hidden_field :user_id, value: Current.user.id.to_i %>
        <%= form.hidden_field :code, value: @template.reference if @template.present? %>
        <%= form.hidden_field :version, value: @template.version.to_i if @template.present? %>
        <div class="conesst-actions mt-4">
          <%= form.submit t('common.submit'),  class: "conesst-btn conesst-btn-primary" %>
          <%= link_to request.referer || root_path, class: "conesst-btn" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>