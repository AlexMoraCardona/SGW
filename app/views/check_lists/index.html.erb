<div class="conesst-page" style="width: 100%; max-width: 100%; box-sizing: border-box; overflow-x: hidden;">
  <div class="conesst-logo-container">
    <%= link_to root_path, class: "d-inline-block" do %>
      <%= image_tag "LogoConesst202305232.png", class: "conesst-logo", alt: "CONESST" %>
    <% end %>
  </div>
  <div class="conesst-card mb-4" style="width: 100%; max-width: 100%; min-width: 0;">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div style="min-width: 0;">
          <h2 class="conesst-card-header-title">
            <i class="bi bi-clipboard-check me-2"></i>
            Configuración Listas de Chequeo
          </h2>
          <p class="conesst-card-header-subtitle mb-0">
            Administración y configuración de listas de chequeo
          </p>
        </div>
      </div>
    </div>
    <div class="conesst-card-body" style="width: 100%; max-width: 100%; min-width: 0; box-sizing: border-box;">
      <div class="conesst-actions mt-0 mb-3">
        <%= link_to t('common.create_check_list'), new_check_list_path, class: "conesst-btn conesst-btn-primary" %>
      </div>
      <div class="conesst-table-wrapper" style="display: block; width: 100%; max-width: 100%; min-width: 0; overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch;">
        <table class="conesst-table" style="margin: 0;">
          <thead>
            <tr>
              <th><%= t('.id') %></th>
              <th><%= t('.name') %></th>
              <th><%= t('.state') %></th>
              <th><%= t('common.edit') %></th>
              <th>Adicionar item</th>
            </tr>
          </thead>
          <tbody>
            <%= render partial: 'check_list', collection: @check_lists %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="conesst-card" style="width: 100%; max-width: 100%; min-width: 0;">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div style="min-width: 0;">
          <h2 class="conesst-card-header-title">
            <i class="bi bi-list-check me-2"></i>
            Listas de Chequeo
          </h2>
          <p class="conesst-card-header-subtitle mb-0">
            Consulta y administración de listas de chequeo
          </p>
        </div>
      </div>
    </div>
    <div class="conesst-card-body" style="width: 100%; max-width: 100%; min-width: 0; box-sizing: border-box;">
      <div class="conesst-actions mt-0 mb-3">
        <%= link_to "Crear lista", new_list_path, class: "conesst-btn conesst-btn-primary" %>
      </div>
      <div class="conesst-table-wrapper" style="display: block; width: 100%; max-width: 100%; min-width: 0; overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch;">
        <table class="conesst-table" style="margin: 0;">
          <thead>
            <tr>
              <th>Nro</th>
              <th>Fecha</th>
              <th>Empresa</th>
              <th>Nombre lista</th>
              <th>Ver</th>
              <th>Eliminar</th>
              <th>PDF</th>
            </tr>
          </thead>
          <tbody>
            <% if @lists.present? %>
              <%= render partial: 'list', collection: @lists %>
            <% else %>
              <tr>
                <td colspan="7" class="text-center py-4">
                  <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                  No hay listas de chequeo registradas.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>