<div class="conesst-page">
    <div class="conesst-header">
        <div class="conesst-logo-container">
            <%= link_to root_path, class: "navbar-brand" do %>
                <%= image_tag "LogoConesst202305232.png", class: "conesst-logo",  alt: "CONESST" %>
            <% end %>
        </div>
    </div>
    <div class="conesst-card">
        <div class="conesst-card-header">
            <div class="conesst-card-header-content">
                <h2 class="conesst-card-header-title">
                    <i class="bi bi-clipboard-check me-2"></i>
                    Revisión por la alta dirección
                </h2>
            </div>
        </div>
        <div class="conesst-card-body">
            <% if params[:entity_id].present? || @entity.present? %>
                <%= render "direction_reviews" %>
            <% else %>
                <%= form_with model: @entity, method: :get do |form| %>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-building me-1"></i>
                            Selección de empresa
                        </div>
                        <div class="conesst-form-grid">
                            <div class="conesst-form-group">
                                <%= form.label :entity_id, class: "conesst-form-label" do %>
                                    <span>Empresa</span>
                                    <%= image_tag "ayuda.png", width: 22, height: 22, class: "conesst-help-icon", data: {bs_toggle: "tooltip", bs_html: "true", bs_placement: "top"}, title: "Seleccione la empresa para consultar la revisión por la alta dirección." %>
                                <% end %>
                                <% if @entities.present? %>
                                    <%= form.collection_select(:entity_id, @entities.order(id: :asc), :id, :business_name, { prompt: "-- Seleccionar empresa --" }, { class: "form-select select2" }) %>
                                <% else %>
                                    <div class="conesst-form-control-static">
                                        <%= @entity.business_name %>
                                    </div>
                                    <%= form.hidden_field :entity_id, value: @entity.id %>
                                <% end %>
                            </div>
                        </div>
                    </div>
                    <div class="conesst-actions conesst-form-actions">
                        <%= form.button type: "submit", class: "conesst-btn conesst-btn-primary" do %>
                            <i class="bi bi-search me-1"></i>
                            Consultar
                        <% end %>
                    </div>
                <% end %>
            <% end %>
        </div>
    </div>
</div>
