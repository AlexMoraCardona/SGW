<div class="container-fluid px-2 px-md-3 mb-4">
  <!-- ============================================================
       ENCABEZADO / AYUDA DE LA EVIDENCIA
       ============================================================ -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-light border-0 py-3 px-3 px-md-4">
      <div class="d-flex align-items-center">
        <div class="bg-white rounded-circle shadow-sm p-2 me-3">
          <i class="bi bi-people fs-5 text-secondary"></i>
        </div>
        <div>
          <h5 class="mb-1 fw-bold text-dark">
            Funcionarios relacionados
          </h5>
          <small class="text-muted">
            Registro de funcionarios asociados a la evidencia
          </small>
        </div>
      </div>
    </div>
    <% if @evidence.present? && @evidence.template.filing.present? %>
      <div class="card-body">
        <div class="alert alert-info border-0 rounded-3 mb-0">
          <div class="d-flex align-items-start">
            <i class="bi bi-info-circle fs-5 me-2"></i>
            <div>
              <div class="fw-semibold mb-1">
                Instrucciones para diligenciar
              </div>
              <div class="small">
                <%= @evidence.template.filing %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <!-- ============================================================
       FORMULARIO
       ============================================================ -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-light border-0 py-3 px-3 px-md-4">
      <div class="d-flex align-items-center">
        <i class="bi bi-person-plus fs-5 text-secondary me-2"></i>
        <div>
          <h5 class="mb-0 fw-bold text-dark">
            Agregar funcionario
          </h5>
          <small class="text-muted">
            Complete la información solicitada
          </small>
        </div>
      </div>
    </div>
    <div class="card-body p-3 p-md-4">
      <%= form_with model: @participant do |form| %>
        <!-- ======================================================
             ERRORES
             ====================================================== -->
        <% if @participant.errors.any? %>
          <div class="alert alert-danger rounded-3 border-0">
            <div class="d-flex align-items-start">
              <i class="bi bi-exclamation-triangle fs-5 me-2"></i>
              <div>
                <div class="fw-bold mb-1">
                  No fue posible guardar el registro
                </div>
                <ul class="mb-0 ps-3">
                  <% @participant.errors.full_messages.each do |error| %>
                    <li>
                      <%= error %>
                    </li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>
        <!-- ======================================================
             FORMATO 2, 4, 6
             ====================================================== -->
        <% if [2, 4, 6].include?(@evidence.template.format_number) %>
          <div class="row g-4">
            <div class="col-12 col-lg-6">
              <div class="form-floating">
                <%= form.collection_select :user_id, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccionar funcionario --" }, { class: "form-select", required: true } %>
                <%= form.label :user_id, "Funcionario" %>
              </div>
            </div>
            <div class="col-12 col-lg-6">
              <label class="form-label fw-semibold d-block">
                <i class="bi bi-person-check me-1"></i>
                ¿Es colaborador?
              </label>
              <div class="d-flex gap-4 mt-2">
                <div class="form-check">
                  <%= form.radio_button :collaborator, 0, class: "form-check-input", id: "participant_collaborator_no" %>
                  <%= form.label :collaborator, "NO",  value: 0, for: "participant_collaborator_no", class: "form-check-label" %>
                </div>
                <div class="form-check">
                  <%= form.radio_button :collaborator, 1, class: "form-check-input", id: "participant_collaborator_yes" %>
                  <%= form.label :collaborator, "SI", value: 1, for: "participant_collaborator_yes", class: "form-check-label" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
        <!-- ======================================================
             FORMATO 10
             ====================================================== -->
        <% if @evidence.template.format_number == 10 %>
          <div class="row g-4">
            <div class="col-12 col-lg-6">
              <label class="form-label fw-semibold d-block">
                <i class="bi bi-file-earmark-check me-1"></i>
                Reporte de actividad ARL
              </label>
              <div class="d-flex gap-4">
                <div class="form-check">
                  <%= form.radio_button :arl_activity_report, 0, class: "form-check-input", id: "arl_activity_report_no" %>
                  <%= form.label :arl_activity_report, "NO", value: 0, for: "arl_activity_report_no", class: "form-check-label" %>
                </div>
                <div class="form-check">
                  <%= form.radio_button :arl_activity_report, 1, class: "form-check-input", id: "arl_activity_report_yes" %>
                  <%= form.label :arl_activity_report, "SI", value: 1, for: "arl_activity_report_yes", class: "form-check-label" %>
                </div>
              </div>
            </div>
            <div class="col-12 col-lg-6">
              <label class="form-label fw-semibold d-block">
                <i class="bi bi-plus-circle me-1"></i>
                Cotiza 10 puntos adicionales
              </label>
              <div class="d-flex gap-4">
                <div class="form-check">
                  <%= form.radio_button :quote_10_aditional_points, 0, class: "form-check-input", id: "quote_10_points_no" %>
                  <%= form.label :quote_10_aditional_points, "NO", value: 0, for: "quote_10_points_no", class: "form-check-label" %>
                </div>
                <div class="form-check">
                  <%= form.radio_button :quote_10_aditional_points, 1, class: "form-check-input", id: "quote_10_points_yes" %>
                  <%= form.label :quote_10_aditional_points, "SI", value: 1, for: "quote_10_points_yes", class: "form-check-label" %>
                </div>
              </div>
            </div>
