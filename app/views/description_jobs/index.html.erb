<div class="conesst-page" style="width: 100%; max-width: 100%; min-width: 0; box-sizing: border-box; overflow-x: hidden;">
  <div class="conesst-logo-container">
    <%= link_to root_path, class: "d-inline-block" do %>
      <%= image_tag "LogoConesst202305232.png", class: "conesst-logo", alt: "CONESST" %>
    <% end %>
  </div>
  <div class="conesst-card mb-4" style="width: 100%; max-width: 100%; min-width: 0;">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div style="min-width: 0;">
          <h2 class="conesst-card-header-title">
            <i class="bi bi-person-vcard me-2"></i>
            Descripción de Cargos
          </h2>
          <p class="conesst-card-header-subtitle mb-0">
            Consulta y administración de las descripciones de cargos por entidad.
          </p>
        </div>
      </div>
    </div>
    <div class="conesst-card-body" style="width: 100%; max-width: 100%; min-width: 0; box-sizing: border-box;">
      <% if params[:entity_id].present? %>
        <div style="width: 100%; max-width: 100%; min-width: 0;">
          <%= render 'description_jobs' %>
        </div>
      <% else %>
        <div class="mb-3">
          <div class="text-muted small mb-3">
            Selecciona una entidad para consultar sus descripciones de cargos.
          </div>
          <%= form_with model: @entity, method: :get, local: true do |form| %>
            <div class="row g-3">
              <div class="col-12">
                <%= form.label :entity_id, "Entidad", class: "form-label fw-semibold" %>
                <%= form.collection_select :entity_id, @entities.order(id: :asc), :id, :business_name, { prompt: "-- Seleccionar entidad --" }, {class: "form-select select2 w-100", required: true} %>
              </div>
            </div>
            <div class="conesst-actions mt-4">
              <button type="submit" class="conesst-btn conesst-btn-primary">
                <i class="bi bi-search me-2"></i>
                Consultar
              </button>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>