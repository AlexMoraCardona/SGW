<div class="conesst-page">
  <div class="conesst-header">
    <div>
      <h2 class="conesst-title">
        <i class="bi bi-journal-text me-1"></i>
        Guion de Simulacro
      </h2>
      <% if @entity.present? %>
        <p class="conesst-subtitle">
          <i class="bi bi-building me-1"></i>
          <strong>
            <%= @entity.business_name %>
          </strong>
          <% if @entity.identification_number.present? %>
            <span class="conesst-header-separator">·</span>
            <span class="conesst-header-nit">
              NIT:
              <%= EvaluationRuleDetail.miles(@entity.identification_number) %>
              <% if @entity.verification_digit.present? %>
                -<%= @entity.verification_digit %>
              <% end %>
            </span>
          <% end %>
        </p>
      <% end %>
    </div>
  </div>
  <%= form_with model: @mock_script do |form| %>
    <% if @mock_script.errors.any? %>
      <div class="alert alert-danger conesst-form-alert" role="alert">
        <div class="fw-bold mb-1">
          <i class="bi bi-exclamation-triangle me-1"></i>
          No fue posible guardar el guion.
        </div>
        <ul class="mb-0">
          <% @mock_script.errors.full_messages.each do |error| %>
            <li>
              <%= error %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="conesst-card mb-3">
      <div class="conesst-card-header">
        <h3 class="conesst-card-header-title">
          <i class="bi bi-calendar-event me-1"></i>
          Información del simulacro
        </h3>
      </div>
      <div class="conesst-card-body">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <%= form.label :date_script, "Fecha", class: "conesst-form-label" %>
            <%= form.date_field :date_script, class: "form-control conesst-form-control" %>
          </div>
          <div class="col-12 col-md-6">
            <%= form.label :time_script, "Hora", class: "conesst-form-label" %>
            <%= form.time_field :time_script, class: "form-control conesst-form-control" %>
          </div>
          <div class="col-12">
            <%= form.label :space_for, "Realizar un simulacro de evacuación por", class: "conesst-form-label" %>
            <%= form.text_field :space_for, class: "form-control conesst-form-control", placeholder: "Ejemplo: sismo, incendio, emergencia..." %>
          </div>
          <div class="col-12">
            <%= form.label :type_emergency, "Tipo de emergencia", class: "conesst-form-label" %>
            <%= form.text_field :type_emergency, class: "form-control conesst-form-control", placeholder: "Indique el tipo de emergencia" %>
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card mb-3">
      <div class="conesst-card-header">
        <h3 class="conesst-card-header-title">
          <i class="bi bi-people me-1"></i>
          Responsables del simulacro
        </h3>
      </div>
      <div class="conesst-card-body">
        <div class="row g-3">
          <div class="col-12">
            <%= form.label :name_coordinator, "Nombre del coordinador", class: "conesst-form-label" %>
            <%= form.text_field :name_coordinator, class: "form-control conesst-form-control", placeholder: "Nombre completo del coordinador" %>
          </div>
          <div class="col-12 col-md-6">
            <%= form.label :name_brigade, "Nombre líder brigada", class: "conesst-form-label" %>
            <%= form.text_field :name_brigade, class: "form-control conesst-form-control", placeholder: "Nombre completo" %>
          </div>
          <div class="col-12 col-md-6">
            <%= form.label :name_evacuation, "Nombre líder evacuación", class: "conesst-form-label" %>
            <%= form.text_field :name_evacuation, class: "form-control conesst-form-control", placeholder: "Nombre completo" %>
          </div>
          <div class="col-12">
            <%= form.label :external_soport, "Apoyo externo", class: "conesst-form-label" %>
            <%= form.text_field :external_soport, class: "form-control conesst-form-control", placeholder: "Entidad o persona de apoyo externo" %>
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card mb-3">
      <div class="conesst-card-header">
        <h3 class="conesst-card-header-title">
          <i class="bi bi-diagram-3 me-1"></i>
          Roles y funciones de los brigadistas
        </h3>
      </div>
      <div class="conesst-card-body">
        <div class="conesst-form-group">
          <%= form.label :officer_committee, "Encargado comité de emergencias", class: "conesst-form-label" %>
          <%= form.rich_text_area :officer_committee, class: "conesst-rich-text" %>
        </div>
        <div class="conesst-form-group">
          <%= form.label :coordinator_drill, "Encargado coordinación general del simulacro", class: "conesst-form-label" %>
          <%= form.rich_text_area :coordinator_drill, class: "conesst-rich-text" %>
        </div>
        <div class="conesst-form-group">
          <%= form.label :alert_activation, "Encargado activación de alerta y alarma", class: "conesst-form-label" %>
          <%= form.rich_text_area :alert_activation, class: "conesst-rich-text" %>
        </div>
        <div class="conesst-form-group">
          <%= form.label :evacuation_count, "Encargado evacuación general y conteo de personas", class: "conesst-form-label" %>
          <%= form.rich_text_area :evacuation_count, class: "conesst-rich-text" %>
        </div>
        <div class="conesst-form-group">
          <%= form.label :evacuation_first, "Encargado evacuación primer piso", class: "conesst-form-label" %>
          <%= form.rich_text_area :evacuation_first, class: "conesst-rich-text" %>
        </div>
        <div class="conesst-form-group">
          <%= form.label :evacuation_second, "Encargado evacuación segundo piso", class: "conesst-form-label" %>
          <%= form.rich_text_area :evacuation_second, class: "conesst-rich-text" %>
        </div>
        <div class="conesst-form-group">
          <%= form.label :withdraw_kit, "Encargado retiro de botiquín", class: "conesst-form-label" %>
          <%= form.rich_text_area :withdraw_kit, class: "conesst-rich-text" %>
        </div>
        <div class="conesst-form-group">
          <%= form.label :withdraw_stretcher, "Encargado retiro de camilla", class: "conesst-form-label" %>
          <%= form.rich_text_area :withdraw_stretcher, class: "conesst-rich-text" %>
        </div>
        <div class="conesst-form-group">
          <%= form.label :withdraw_extinguisher, "Encargado retiro de extintor", class: "conesst-form-label" %>
          <%= form.rich_text_area :withdraw_extinguisher, class: "conesst-rich-text" %>
        </div>
        <div class="conesst-form-group">
          <%= form.label :verification, "Encargado verificación del estado estructural de las instalaciones", class: "conesst-form-label" %>
          <%= form.rich_text_area :verification, class: "conesst-rich-text" %>
        </div>
        <div class="conesst-form-group">
          <%= form.label :return_indication, "Encargado indicación de retorno a sus lugares de trabajo", class: "conesst-form-label" %>
          <%= form.rich_text_area :return_indication, class: "conesst-rich-text" %>
        </div>
      </div>
    </div>
    <div class="conesst-card mb-3">
      <div class="conesst-card-header">
        <h3 class="conesst-card-header-title">
          <i class="bi bi-signpost-2 me-1"></i>
          Información de evacuación
        </h3>
      </div>
      <div class="conesst-card-body">
        <div class="conesst-form-group">
          <%= form.label :routes_evacuation, "Rutas de evacuación", class: "conesst-form-label" %>
          <%= form.rich_text_area :routes_evacuation, class: "conesst-rich-text" %>
        </div>
        <div class="conesst-form-group">
          <%= form.label :emergency_exit, "Salidas de emergencia", class: "conesst-form-label" %>
          <%= form.rich_text_area :emergency_exit, class: "conesst-rich-text" %>
        </div>
        <div class="conesst-form-group">
          <%= form.label :emergency_resources, "Recursos de emergencia", class: "conesst-form-label" %>
          <%= form.rich_text_area :emergency_resources, class: "conesst-rich-text" %>
        </div>
      </div>
    </div>
    <%= form.hidden_field :user_asesor, value: @user_asesor.id.to_i if @user_asesor.present? %>
    <%= form.hidden_field :user_representante, value: @user_representante.id.to_i if @user_representante.present? %>
    <%= form.hidden_field :entity_id, value: @entity.id if @entity.present? %>
    <%= form.hidden_field :code, value: @template.reference if @template.present? %>
    <%= form.hidden_field :version, value: @template.version.to_i if @template.present? %>
    <div class="conesst-actions conesst-form-actions">
      <%= form.button type: "submit", class: "conesst-btn conesst-btn-primary" do %>
        <i class="bi bi-check-circle"></i>
        <span>
          <%= t('common.submit') %>
        </span>
      <% end %>
      <%= link_to :back, class: "conesst-btn conesst-btn-secondary" do %>
        <i class="bi bi-arrow-left"></i>
        <span>
          Retornar
        </span>
      <% end %>
    </div>
  <% end %>
</div>
