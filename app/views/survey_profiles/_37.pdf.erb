                title: "EDAD",
                data: @datos_edad,
                count: @cant_edad,
                label: :labeledad,
                filename: "Edad"
            },

            {
                number: 3,
                title: "ESTADO CIVIL",
                data: @datos_estado_civil,
                count: @cant_estado_civil,
                label: :labelestadocivil,
                filename: "Estado Civil"
            },

            {
                number: 4,
                title: "TIENE HIJOS",
                data: @datos_hijos,
                count: @cant_hijos,
                label: :labelhijos,
                filename: "Tiene Hijos"
            },

            {
                number: 5,
                title: "NÚMERO DE HIJOS",
                data: @datos_numero_hijos,
                count: @cant_numero_hijos,
                label: :labelnumerohijos,
                filename: "Número de Hijos"
            },

            {
                number: 6,
                title: "PERSONAS A CARGO",
                data: @datos_personas_cargo,
                count: @cant_personas_cargo,
                label: :labelpersonasacargo,
                filename: "Personas a Cargo"
            },

            {
                number: 7,
                title: "CIUDAD - MUNICIPIO",
                data: @datos_ciudad,
                count: @cant_ciudad,
                label: :labelciudad,
                filename: "Ciudad - Municipio"
            },

            {
                number: 8,
                title: "TENENCIA DE VIVIENDA",
                data: @datos_vivienda,
                count: @cant_vivienda,
                label: :labelvivienda,
                filename: "Tenencia de Vivienda"
            },

            {
                number: 9,
                title: "ESTRATO",
                data: @datos_estrato,
                count: @cant_estrato,
                label: :labelestrato,
                filename: "Estrato"
            },

            {
                number: 10,
                title: "NIVEL DE ESCOLARIDAD",
                data: @datos_nivel,
                count: @cant_nivel,
                label: :labelnivel,
                filename: "Nivel de Escolaridad"
            },

            {
                number: 11,
                title: "PROMEDIO SALARIO",
                data: @datos_salario,
                count: @cant_salario,
                label: :labelsalario,
                filename: "Promedio Salario"
            },

            {
                number: 12,
                title: "TIPO DE CONTRATO",
                data: @datos_contrato,
                count: @cant_contrato,
                label: :labelcontrato,
                filename: "Tipo de Contrato"
            },

            {
                number: 13,
                title: "TURNO DE TRABAJO",
                data: @datos_turno_trabajo,
                count: @cant_turno_trabajo,
                label: :labelturno,
                filename: "Turno de Trabajo"
            },

            {
                number: 14,
                title: "ENTIDAD BANCARIA",
                data: @datos_banco,
                count: @cant_banco,
                label: :labelbanco,
                filename: "Entidad Bancaria"
            },

            {
                number: 15,
                title: "SERVICIOS BÁSICOS",
                data: @datos_servicios,
                count: @cant_servicios,
                label: :labelservicios,
                filename: "Servicios Básicos"
            },

            {
                number: 16,
                title: "EPS",
                data: @datos_eps,
                count: @cant_eps,
                label: :labeleps,
                filename: "EPS"
            },

            {
                number: 17,
                title: "FONDO DE PENSIÓN",
                data: @datos_pension,
                count: @cant_pension,
                label: :labelpension,
                filename: "Fondo de Pensión"
            },

            {
                number: 18,
                title: "ARL",
                data: @datos_arl,
                count: @cant_arl,
                label: :labelarl,
                filename: "ARL"
            },

            {
                number: 19,
                title: "FONDO DE CESANTÍAS",
                data: @datos_cesantia,
                count: @cant_cesantia,
                label: :labelcesantia,
                filename: "Cesantía"
            },

            {
                number: 20,
                title: "¿Vive con personas que tengan alguna discapacidad?",
                data: @datos_discapacidad,
                count: @cant_discapacidad,
                label: :labeldiscapacitadas,
                filename: "Discapacidad"
            },

            {
                number: 21,
                title: "TIPO DE DISCAPACIDAD",
                data: @datos_tipo_discapacidad,
                count: @cant_tipo_discapacidad,
                label: :labeltipodiscapacitadas,
