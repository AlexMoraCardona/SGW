<div class="container-fluid px-2 px-md-3 mb-4">
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <!-- Encabezado -->
    <div class="card-header bg-light border-0 py-3 px-3 px-md-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <div class="d-flex align-items-center">
          <div class="bg-white rounded-circle shadow-sm p-2 me-3">
            <i class="bi bi-shield-check fs-5 text-secondary"></i>
          </div>
          <div>
            <h5 class="mb-1 fw-bold text-dark">
              Informes de Inspección de Seguridad
            </h5>
            <small class="text-muted">
              Informes de las inspecciones de seguridad realizadas
            </small>
          </div>
        </div>
        <span class="badge rounded-pill text-bg-secondary px-3 py-2">
          <i class="bi bi-file-earmark-text me-1"></i>
          <%= @safety_inspections.to_a.count %>
        </span>
      </div>
    </div>
    <!-- Contenido -->
    <div class="card-body p-0">
      <% if @safety_inspections.present? %>
        <!-- ==================================================
             VISTA PC / TABLET
             ================================================== -->
        <div class="table-responsive d-none d-md-block">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="px-4 py-3">
                  <i class="bi bi-calendar3 me-1"></i>
                  Fecha
                </th>
                <th class="py-3">
                  <i class="bi bi-diagram-3 me-1"></i>
                  Área
                </th>
                <th class="py-3">
                  <i class="bi bi-geo-alt me-1"></i>
                  Lugar
                </th>
                <th class="text-center py-3" style="width: 150px;">
                  Acción
                </th>
              </tr>
            </thead>
            <tbody>
              <% @safety_inspections.each do |safety| %>
                <tr>
                  <!-- Fecha -->
                  <td class="px-4">
                    <span class="text-muted">
                      <i class="bi bi-calendar-event me-1"></i>
                      <%= safety.date_inspection %>
                    </span>
                  </td>
                  <!-- Área -->
                  <td>
                    <div class="fw-semibold text-dark">
                      <i class="bi bi-building text-secondary me-2"></i>
                      <%= safety.area_inspection %>
                    </div>
                  </td>
                  <!-- Lugar -->
                 <td>
                    <div class="text-secondary">
                      <i class="bi bi-geo-alt me-2"></i>
                      <%= safety.place_inspection %>
                    </div>
                  </td>
                  <!-- Acción -->
                  <td class="text-center">
                    <%= link_to pdf_informe_inspeccion_path(safety.id, format: 'pdf'), class: "btn btn-sm btn-outline-danger rounded-pill px-3", target: "_blank", rel: "noopener", title: "Ver informe en PDF" do %>
                      <i class="bi bi-file-earmark-pdf me-1"></i>
                      Ver PDF
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <!-- ==================================================
             VISTA CELULAR
             ================================================== -->
        <div class="d-md-none">
          <% @safety_inspections.each do |safety| %>
            <div class="border-bottom p-3">
              <div class="d-flex align-items-start gap-3">
                <!-- Icono -->
                <div class="bg-light rounded-3 p-2 flex-shrink-0">
                  <i class="bi bi-shield-check fs-5 text-secondary"></i>
                </div>
                <!-- Información -->
                <div class="flex-grow-1">
                  <div class="fw-semibold text-dark mb-2">
                    <%= safety.area_inspection %>
                  </div>
                  <div class="small text-muted mb-1">
                    <i class="bi bi-calendar3 me-1"></i>
                    <%= safety.date_inspection %>
                  </div>
                  <div class="small text-muted mb-3">
                    <i class="bi bi-geo-alt me-1"></i>
                    <%= safety.place_inspection %>
                  </div>
                  <%= link_to pdf_informe_inspeccion_path(safety.id, format: 'pdf'), class: "btn btn-sm btn-outline-danger rounded-pill px-3", target: "_blank", rel: "noopener" do %>
                    <i class="bi bi-file-earmark-pdf me-1"></i>
                    Ver informe PDF
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <!-- ==================================================
             ESTADO VACÍO
             ================================================== -->
        <div class="text-center py-5 px-3">
          <div class="mb-3">
            <i class="bi bi-shield-x display-5 text-muted"></i>
          </div>
          <h6 class="fw-bold text-secondary mb-1">
            No hay informes de inspección
          </h6>
          <p class="text-muted small mb-0">
            No se encontraron informes de inspección de seguridad asociados a esta evaluación.
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
