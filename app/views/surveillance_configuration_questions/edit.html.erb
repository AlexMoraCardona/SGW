<div class="container-fluid py-3">
  <div class="container col-12 col-lg-10 col-xl-9">
    <div class="mb-3">
      <%= link_to surveillance_configuration_path(@surveillance_configuration), class: "btn btn-outline-secondary btn-sm" do %>
        <i class="bi bi-arrow-left me-1"></i>
        Volver a configuración
      <% end %>
    </div>
    <div class="card shadow-sm border-0">
      <div class="card-header bg-light">
        <div class="d-flex align-items-center">
          <i class="bi bi-pencil-square fs-4 me-2"></i>
          <div>
            <h4 class="mb-0">
              Editar pregunta
            </h4>
            <small class="text-muted">
              Configuración SVE:
              <%= @surveillance_configuration.name %>
            </small>
          </div>
        </div>
      </div>
      <div class="card-body">
        <div class="alert alert-info">
          <i class="bi bi-question-circle me-1"></i>
          <strong>Pregunta:</strong>
          <%= @surveillance_configuration_question.question %>
        </div>
        <%= render "form" %>
      </div>
    </div>
  </div>
</div>
