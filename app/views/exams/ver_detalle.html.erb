<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-file-earmark-text fs-4"></i>
          <div>
            <h2 class="conesst-card-header-title mb-0">
              Ficha Técnica
            </h2>
            <div class="conesst-card-header-subtitle">
              Información general de la evaluación
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <div class="row g-3">
        <div class="col-12">
          <div class="small text-muted">
            Evaluación
          </div>
          <div class="fw-semibold fs-5">
            <%= @adm_exam.name %>
          </div>
        </div>
        <div class="col-12">
          <div class="small text-muted">
            Descripción
          </div>
          <div class="fw-semibold">
            <%= @adm_exam.description %>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="small text-muted">
            <i class="bi bi-list-ol me-1"></i>
            Número de preguntas
          </div>
          <div class="fw-semibold fs-5">
            <%= @adm_exam.cant_questions %>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="small text-muted">
            <i class="bi bi-percent me-1"></i>
            Porcentaje mínimo aprobación
          </div>
          <div class="fw-semibold fs-5">
            <%= @adm_exam.percentage_min %>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="small text-muted">
            <i class="bi bi-arrow-repeat me-1"></i>
            Número de intentos
          </div>
          <div class="fw-semibold fs-5">
            <%= @adm_exam.cant_attempts %>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="small text-muted">
            <i class="bi bi-clock me-1"></i>
            Tiempo máximo evaluación
          </div>
          <div class="fw-semibold fs-5">
            <%= @adm_exam.time_max %>
          </div>
        </div>
      </div>
      <div class="conesst-actions mt-4">
        <%= link_to :back, class: "conesst-btn conesst-btn-primary" do %>
          <i class="bi bi-arrow-left me-1"></i>
          Retornar
        <% end %>
      </div>
    </div>
  </div>
</div>