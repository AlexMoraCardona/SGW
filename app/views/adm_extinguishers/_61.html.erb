<div class="conesst-page">
  <div class="mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <% if @adm_extinguisher.present? %>
        <%= link_to adm_extinguishers_path(entity_id: @adm_extinguisher.entity_id), class: "conesst-btn" do %>
          <i class="bi bi-arrow-left me-1"></i>
          Retornar
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-fire-extinguisher fs-5"></i>
        <div>
          <h4 class="mb-0">
            Inspección de extintores
          </h4>
          <small class="text-muted">
            Consulta de las condiciones encontradas durante la inspección
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <div class="row g-3 mt-1">
        <div class="col-12 col-md-6">
          <div class="border rounded p-3 h-100">
            <div class="small text-muted mb-1">
              <i class="bi bi-calendar3 me-1"></i>
              Fecha
            </div>
            <div class="fw-semibold">
              <%= @adm_extinguisher.date_creation if @adm_extinguisher.present? %>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="border rounded p-3 h-100">
            <div class="small text-muted mb-1">
              <i class="bi bi-building me-1"></i>
              Área
            </div>
            <div class="fw-semibold">
              <%= @adm_extinguisher.area if @adm_extinguisher.present? %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-list-check fs-5"></i>
        <div>
          <h5 class="mb-0">
            Inspección de extintores
          </h5>
          <small class="text-muted">
            Estado de los componentes y condiciones del extintor
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <% if @extinguishers.present? %>
        <div class="conesst-table-wrapper">
          <table class="conesst-table">
            <thead>
              <tr>
<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Número
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Tipo, Clase
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Capacidad
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Anillo Verificación
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Manómetro
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Pasador Seguridad
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Manija Descarga
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Válvula
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Manguera
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Boquilla
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Cuerpo Cilíndrico
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Instrucciones
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Soporte
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Señalización
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Ubicación
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Área de ubicación
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Próxima recarga
</th>

<th style="writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; height: 150px; min-width: 40px; text-align: center; vertical-align: middle;">
    Observaciones
</th>

<th style="text-align: center; vertical-align: middle; min-width: 100px;">
    Acciones
</th>
              </tr>
            </thead>
            <tbody>
              <% @extinguishers.each do |extinguisher| %>
                <tr>
                  <td data-label="Número">
                    <%= extinguisher.nro %>
                  </td>
                  <td data-label="Tipo, Clase">
                    <%= Extinguisher.label_type(extinguisher.type_extinguisher) %>
                  </td>
                  <td data-label="Capacidad">
                    <%= extinguisher.ability %>
                  </td>
                  <td data-label="Anillo Verificación">
                    <%= Extinguisher.label(extinguisher.ring) %>
                  </td>
                  <td data-label="Manómetro">
                    <%= Extinguisher.label(extinguisher.pressure_gauge) %>
                  </td>
                  <td data-label="Pasador Seguridad">
                    <%= Extinguisher.label(extinguisher.barrette) %>
                  </td>
                  <td data-label="Manija Descarga">
                    <%= Extinguisher.label(extinguisher.handle) %>
                  </td>
                  <td data-label="Válvula">
                    <%= Extinguisher.label(extinguisher.valve) %>
                  </td>
                  <td data-label="Manguera">
                    <%= Extinguisher.label(extinguisher.hose) %>
                  </td>
                  <td data-label="Boquilla">
                    <%= Extinguisher.label(extinguisher.nozzle) %>
                  </td>
                  <td data-label="Cuerpo Cilíndrico">
                    <%= Extinguisher.label(extinguisher.cylindrical_body) %>
                  </td>
                  <td data-label="Instrucciones">
                    <%= Extinguisher.label(extinguisher.decal) %>
                  </td>
                  <td data-label="Soporte">
                    <%= Extinguisher.label(extinguisher.medium) %>
                  </td>
                  <td data-label="Señalización">
                    <%= Extinguisher.label(extinguisher.signaling) %>
                  </td>
                  <td data-label="Ubicación">
                    <%= Extinguisher.label(extinguisher.location) %>
                  </td>
                  <td data-label="Área de ubicación">
                    <%= extinguisher.area_location %>
                  </td>
                  <td data-label="Próxima recarga">
                    <%= extinguisher.date_vec_carga %>
                  </td>
                  <td data-label="Observaciones">
                    <%= extinguisher.observation %>
                  </td>
                  <td data-label="Acciones">
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                      <%= link_to extinguisher_adjunto_adm_extinguishers_path(extinguisher.id), class: "conesst-btn conesst-btn-primary" do %>
                        <i class="bi bi-paperclip me-1"></i>
                        <%= t('common.adjunto') %>
                      <% end %>
                      <%= link_to extinguisher_foto_path(extinguisher.id), class: "conesst-btn" do %>
                        <i class="bi bi-camera me-1"></i>
                        Foto
                      <% end %>
                      <%= link_to edit_extinguisher_path(extinguisher),  class: "conesst-btn conesst-btn-warning" do %>
                        <i class="bi bi-pencil-square me-1"></i>
                        Editar
                      <% end %>
                      <%= button_to extinguisher, method: :delete, class: "btn btn-sm btn-danger", form: {data: {turbo_confirm: "¿Está seguro de eliminar este registro? Esta acción no se puede deshacer."}} do %>
                        <i class="bi bi-trash me-1"></i>
                        Eliminar
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-light border mb-0">
          <i class="bi bi-info-circle me-1"></i>
          No existen extintores registrados para esta inspección.
        </div>
      <% end %>
    </div>
  </div>
  <% if @extinguishers.present? %>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-paperclip fs-5"></i>
          <div>
            <h5 class="mb-0">
              Archivos adjuntos
            </h5>
            <small class="text-muted">
              Fotografías y archivos asociados a cada extintor
            </small>
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <% @extinguishers.each do |extinguisher| %>
          <% if extinguisher.extinguisher_fotos.attached? %>
            <div class="conesst-card mb-4">
              <div class="conesst-card-header">
                <div class="d-flex align-items-center gap-2">
                  <i class="bi bi-fire-extinguisher"></i>
                  <div>
                    <h6 class="mb-0">
                      Extintor Nro:
                      <%= extinguisher.nro %>
                    </h6>
                    <small class="text-muted">
                      Archivos asociados al extintor
                    </small>
                  </div>
                </div>
              </div>
              <div class="conesst-card-body">
                <div class="row g-3" data-controller="previews">
                  <% extinguisher.extinguisher_fotos.each do |file| %>
                    <div class="col-12 col-md-6 col-lg-4">
                      <% if file.image? %>
                        <div class="border rounded p-3 h-100 text-center">
                          <div class="small fw-semibold mb-3 text-break">
                            <%= file.blob.filename %>
                          </div>
                          <%= image_tag file, data: {previews_target: "preview"}, class: "img-fluid rounded mb-3" %>
                          <div>
                            <%= link_to rails_blob_path(file, disposition: "attachment"), class: "conesst-btn conesst-btn-success" do %>
                              <i class="bi bi-download me-1"></i>
                              Descargar archivo
                            <% end %>
                          </div>
                        </div>
                      <% elsif file.video? %>
                        <div class="border rounded p-3 h-100 text-center">
                          <div class="small fw-semibold mb-3 text-break">
                            <%= file.blob.filename %>
                          </div>
                          <%= video_tag url_for(file), controls: true, class: "img-fluid rounded mb-3" %>
                          <div>
                            <%= link_to rails_blob_path(file, disposition: "attachment"),
                                        class: "conesst-btn conesst-btn-success" do %>
                              <i class="bi bi-download me-1"></i>
                              Descargar archivo
                            <% end %>
                          </div>
                        </div>
                      <% elsif file.audio? %>
                        <div class="border rounded p-3 h-100 text-center">
                          <div class="small fw-semibold mb-3 text-break">
                            <%= file.blob.filename %>
                          </div>
                          <%= audio_tag url_for(file), controls: true, class: "w-100 mb-3" %>
                          <div>
                            <%= link_to rails_blob_path(file, disposition: "attachment"),
                                        class: "conesst-btn conesst-btn-success" do %>
                              <i class="bi bi-download me-1"></i>
                              Descargar archivo
                            <% end %>
                          </div>
                        </div>
                      <% else %>
                        <div class="border rounded p-3 h-100 text-center">
                          <div class="mb-3 text-break">
                            <i class="bi bi-file-earmark fs-3 d-block mb-2"></i>
                            <%= link_to file.filename, url_for(file), class: "text-decoration-none" %>
                          </div>
                          <%= link_to rails_blob_path(file, disposition: "attachment"),
                                      class: "conesst-btn conesst-btn-success" do %>
                            <i class="bi bi-download me-1"></i>
                            Descargar archivo
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-pen fs-5"></i>
        <div>
          <h5 class="mb-0">
            Responsable de la inspección
          </h5>
          <small class="text-muted">
            Información y firma de quien realiza la inspección
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <div class="text-center">
        <div class="mb-2">
          <strong>
            <u>
              <%= @adm_extinguisher.user.name if @adm_extinguisher.present? %>
            </u>
          </strong>
        </div>
        <div class="small text-muted mb-4">
          Nombre de quien realiza la inspección
        </div>
        <% if @adm_extinguisher.firm_user == 1 %>
          <% if @adm_extinguisher.user.firm.attached? %>
            <% if @adm_extinguisher.user.firm.image? %>
              <div class="mb-3">
                <div class="small text-muted mb-2">
                  Firma
                </div>
                <%= image_tag @adm_extinguisher.user.firm, class: "firma img-fluid" %>
              </div>
            <% end %>
          <% end %>
          <div>
            <strong>Cargo:</strong>
            <%= @adm_extinguisher.post if @adm_extinguisher.present? %>
          </div>
        <% else %>
          <div class="mb-3">
            Firma:
            ______________________________________________
          </div>
          <div>
            <strong>Cargo:</strong>
            <%= @adm_extinguisher.post if @adm_extinguisher.present? %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="conesst-actions mt-4">
    <%= link_to adm_extinguishers_path(entity_id: @adm_extinguisher.entity_id), class: "conesst-btn" do %>
      <i class="bi bi-arrow-left me-1"></i>
      Retornar
    <% end %>
  </div>
</div>