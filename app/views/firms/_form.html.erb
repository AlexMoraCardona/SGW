<div class="container-fluid py-3 px-2 px-md-4">
  <div class="card shadow-sm border-0 mx-auto" style="max-width: 1100px;">
    <!-- Encabezado -->
    <div class="card-header bg-light border-bottom py-3">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <div>
          <h4 class="mb-1">
            <i class="bi bi-pen me-2"></i>
            Firma de documento
          </h4>
          <small class="text-muted">
            Configuración y autorización de firma del documento
          </small>
        </div>
        <span class="badge bg-secondary">
          <i class="bi bi-file-earmark-text me-1"></i>
          Firma
        </span>
      </div>
    </div>
    <div class="card-body p-3 p-md-4">
      <%= form_with model: @firm do |form| %>
        <!-- Errores -->
        <% if @firm.errors.any? %>
          <div class="alert alert-danger">
            <div class="fw-semibold mb-2">
              <i class="bi bi-exclamation-triangle me-1"></i>
              Se encontraron los siguientes errores:
            </div>
            <ul class="mb-0">
              <% @firm.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <!-- Información del funcionario -->
        <% if Current.user.level > 0 && Current.user.level < 4 %>
          <div class="card border-0 bg-light mb-4">
            <div class="card-header bg-light border-bottom">
              <h5 class="mb-0">
                <i class="bi bi-person-badge me-2"></i>
                Información del funcionario
              </h5>
            </div>
            <div class="card-body">
              <div class="row g-3">
                <!-- Funcionario -->
                <div class="col-12 col-md-5">
                  <%= form.label :user_id, class: "form-label fw-semibold" do %>
                    <i class="bi bi-person me-1"></i>
                    Funcionario
                  <% end %>
                  <%= form.collection_select(:user_id, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "Seleccione un funcionario" }, { class: "form-select" }) %>
                </div>
                <!-- Representante legal -->
                <div class="col-12 col-md-3">
                  <%= form.label :legal_representative, class: "form-label fw-semibold d-block" do %>
                    <i class="bi bi-person-check me-1"></i>
                    Representante legal
                  <% end %>
                  <div class="d-flex flex-wrap gap-3 pt-2">
                    <div class="form-check">
                      <%= form.radio_button :legal_representative, 0, class: "form-check-input", id: "firm_legal_representative_no" %>
                      <%= form.label :legal_representative, "NO",  value: 0, for: "firm_legal_representative_no",  class: "form-check-label" %>
                    </div>
                    <div class="form-check">
                      <%= form.radio_button :legal_representative, 1, class: "form-check-input", id: "firm_legal_representative_yes" %>
                      <%= form.label :legal_representative, "SI", value: 1, for: "firm_legal_representative_yes", class: "form-check-label" %>
                    </div>
                  </div>
                </div>
                <!-- Cargo -->
                <div class="col-12 col-md-4">
                  <%= form.label :post, class: "form-label fw-semibold" do %>
                    <i class="bi bi-briefcase me-1"></i>
                    Cargo / Rol
                  <% end %>
                  <%= form.select(
                        :post,
                        [
                          ['', ''],
                          ['Representante Legal', 'Representante Legal'],
                          ['Responsable SG-SST', 'Responsable SG-SST'],
                          ['Asesor externo SG-SST', 'Asesor externo SG-SST'],
                          ['REPRESENTANTE EMPLEADOR', 'REPRESENTANTE EMPLEADOR'],
                          ['SUPLENTE REPRESENTANTE EMPLEADOR', 'SUPLENTE REPRESENTANTE EMPLEADOR'],
                          ['REPRESENTANTE EMPLEADOS', 'REPRESENTANTE EMPLEADOS'],
                          ['SUPLENTE REPRESENTANTE EMPLEADOS', 'SUPLENTE REPRESENTANTE EMPLEADOS'],
                          ['Presidente COPASST', 'Presidente COPASST'],
                          ['Secretario(a) COPASST', 'Secretario COPASST'],
                          ['Vigía SG-SST', 'Vigía SG-SST'],
                          ['Colaborador', 'Colaborador'],
                          ['COLABORADOR', 'COLABORADOR']
                        ],
                        {},
                        { class: "form-select" }
                      ) %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
        <!-- Autorización de firma -->
        <div class="card border-0 bg-light mb-4">
          <div class="card-header bg-light border-bottom">
            <h5 class="mb-0">
              <i class="bi bi-pen me-2"></i>
              Autorización de firma
            </h5>
          </div>
          <div class="card-body">
            <div class="row g-3 align-items-end">
              <!-- Autorizar firma -->
              <div class="col-12 col-md-5">
                <%= form.label :authorize_firm, class: "form-label fw-semibold d-block" do %>
                  <i class="bi bi-check2-square me-1"></i>
                  ¿Autorizar firma del documento?
                <% end %>
                <div class="d-flex flex-wrap gap-3 pt-2">
                  <div class="form-check">
                    <%= form.radio_button :authorize_firm, 0, class: "form-check-input", id: "firm_authorize_no" %>
                    <%= form.label :authorize_firm, "NO", value: 0, for: "firm_authorize_no", class: "form-check-label" %>
                  </div>
                  <div class="form-check">
                    <%= form.radio_button :authorize_firm,  1,  class: "form-check-input", id: "firm_authorize_yes" %>
                    <%= form.label :authorize_firm, "SI", value: 1, for: "firm_authorize_yes", class: "form-check-label" %>
                  </div>
                </div>
              </div>
              <!-- Fecha -->
              <div class="col-12 col-md-4">
                <%= form.label :date_authorize_firm, class: "form-label fw-semibold" do %>
                  <i class="bi bi-calendar-event me-1"></i>
                  Fecha de autorización
                <% end %>
                <%= form.date_field :date_authorize_firm,  class: "form-control", max: Date.current %>
              </div>
            </div>
          </div>
        </div>
        <!-- Botonera -->
        <div class="border-top pt-3">
          <div class="d-flex flex-column flex-sm-row justify-content-center align-items-stretch align-items-sm-center gap-2">
            <%= form.submit t('common.submit'), class: "btn btn-primary px-4" %>
            <%= link_to :back, class: "btn btn-outline-secondary px-4" do %>
              <i class="bi bi-arrow-left me-1"></i>
              Retornar
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>