<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-shield-check fs-5"></i>
        <div>
          <h4 class="mb-0">
            Entrega de Elementos de Protección Personal
          </h4>
          <small class="text-muted">
            Registro de responsable y colaborador de la entrega de EPP
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @provides_protection do |form| %>
        <% @provides_protection.errors.full_messages.each do |error| %>
          <div class="alert alert-danger mb-3" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <%= error %>
          </div>
        <% end %>
        <div class="row g-4">
          <div class="col-12 col-md-6">
            <%= form.label :user_responsible, "Usuario Responsable de la entrega de los EPP", class: "form-label fw-semibold" %>
            <div class="d-flex align-items-center gap-2">
              <%= form.collection_select :user_responsible, User.usuarios_empresa.order(id: :asc), :id, :name, {}, { class: "form-select" } %>
              <button type="button"
                      class="btn btn-light flex-shrink-0"
                      data-bs-toggle="tooltip"
                      data-bs-html="true"
                      title="Seleccione el nombre del Usuario Responsable.">
                <%= image_tag "ayuda.png", width: 25, height: 25, alt: "Ayuda" %>
              </button>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <%= form.label :user_colaborador, "Usuario Colaborador", class: "form-label fw-semibold" %>
            <div class="d-flex align-items-center gap-2">
              <%= form.collection_select :user_colaborador, User.usuarios_empresa.order(id: :asc), :id, :name, {}, { class: "form-select" } %>
              <button type="button"
                      class="btn btn-light flex-shrink-0"
                      data-bs-toggle="tooltip"
                      data-bs-html="true"
                      title="Seleccione el nombre del Usuario Colaborador.">
                <%= image_tag "ayuda.png", width: 25, height: 25, alt: "Ayuda" %>
              </button>
            </div>
          </div>
        </div>
        <%= form.hidden_field :entity_id, value: params[:entity_id].to_i %>
        <% if @template.present? %>
          <%= form.hidden_field :code, value: @template.reference %>
          <%= form.hidden_field :version, value: @template.version.to_i %>
        <% end %>
        <div class="conesst-actions mt-4">
          <%= form.submit t("common.submit"), class: "conesst-btn conesst-btn-primary" %>
          <%= link_to :back, class: "conesst-btn" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>