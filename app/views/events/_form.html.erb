                                        <%= form.radio_button :laboral_inhability, 0, class: "form-check-input", data: {action: "change->event-form#toggleLaboralInhability" } %>
                                        <%= form.label :laboral_inhability, "NO", value: 0, class: "form-check-label" %>
                                    </div>
                                    <div class="form-check">
