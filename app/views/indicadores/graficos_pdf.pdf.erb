            <h3 class="display-5"><strong>Frecuencia de Accidentalidad</strong></h3>
        </div> 
        <div><br></div>
        <table style="width: 100%;">
            <tr style="border:1px solid black;width: 100%;">
                <td style="border:1px solid black; width: 30%;padding: 10px;">
                    <strong>Definición:</strong> 
                </td>
                <td style="border:1px solid black; width: 70%;padding: 10px;">
                    <%= @indicador_frecuencia_accidentalidad.description %>
                </td>
            </tr>
            <tr style="border:1px solid black;width: 100%;">
                <td style="border:1px solid black; width: 30%;padding: 10px;">
                    <strong>Periodicidad:</strong> 
                </td>
                <td style="border:1px solid black; width: 70%;padding: 10px;">
                    <%= Indicator.label_periodicidad(@indicador_frecuencia_accidentalidad.periodicity) %>
                </td>
            </tr>
            <tr style="border:1px solid black;width: 100%;">
                <td style="border:1px solid black; width: 30%;padding: 10px;">
                    <strong>Límites:</strong> 
                </td>
                <td style="border:1px solid black; width: 70%;padding: 10px;">
                    <%= @indicador_frecuencia_accidentalidad.limit_one %>-<%= @indicador_frecuencia_accidentalidad.limit_two %>
                </td>
            </tr>
            <tr style="border:1px solid black;width: 100%;">
