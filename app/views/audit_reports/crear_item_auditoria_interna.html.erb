<div class="conesst-page">
    <div class="conesst-header">
        <div>
            <h1 class="conesst-title">
                <i class="bi bi-clipboard2-plus"></i>
                Hallazgo de auditoría
            </h1>
            <div class="conesst-subtitle">
                <i class="bi bi-search"></i>
                Registro de hallazgos de auditoría interna del SG-SST
            </div>
        </div>
    </div>
    <div class="conesst-card">
        <div class="conesst-card-header">
            <div class="conesst-card-header-content">
                <h2 class="conesst-card-header-title">
                    <i class="bi bi-pencil-square"></i>
                    Información del hallazgo
                </h2>
            </div>
        </div>
        <div class="conesst-card-body">
            <%= form_with model: @audit_report_item do |form| %>
                <% if @audit_report_item.errors.any? %>
                    <div class="alert alert-danger" role="alert">
                        <div class="fw-bold mb-2">
                            <i class="bi bi-exclamation-triangle"></i>
                            Se encontraron los siguientes errores:
                        </div>
                        <ul class="mb-0">
                            <% @audit_report_item.errors.full_messages.each do |error| %>
                                <li>
                                    <%= error %>
                                </li>
                            <% end %>
                        </ul>
                    </div>
                <% end %>
                <%= form.hidden_field :audit_report_id, value: params[:id].to_i %>
                <div class="row g-3">
                    <div class="col-12 col-md-5">
                        <div class="conesst-form-field">
                            <div class="conesst-form-label">
                                <span>
                                    <i class="bi bi-bookmark"></i>
                                    <%= t('.type_finding') %>
                                </span>
                                <button type="button" class="conesst-help-btn" data-bs-toggle="tooltip" data-bs-html="true" title="Seleccionar el tipo de hallazgo.">
                                    <%= image_tag 'ayuda.png', width: 22, height: 22, alt: "Ayuda" %>
                                </button>
                            </div>
                            <%= form.select :type_finding, [['Conformidad', 0], ['No conformidad', 1], ['Observación', 2]], {}, class: "form-select" %>
                        </div>
                    </div>
                    <div class="col-12 col-md-7">
                        <div class="conesst-form-field">
                            <div class="conesst-form-label">
                                <i class="bi bi-arrow-repeat"></i>
                                <%= form.label :type_action %>
                            </div>
                            <div class="conesst-radio-group">
                                <label class="conesst-radio-option">
                                    <%= form.radio_button :type_action, 0 %>
                                    <span>
                                        Preventiva
                                    </span>
                                </label>
                                <label class="conesst-radio-option">
                                    <%= form.radio_button :type_action, 1 %>
                                    <span>
                                        Correctiva
                                    </span>
                                </label>
                                <label class="conesst-radio-option">
                                    <%= form.radio_button :type_action, 2 %>
                                    <span>
                                        Mejora
                                    </span>
                                </label>
                                <label class="conesst-radio-option">
                                    <%= form.radio_button :type_action, 3 %>
                                    <span>
                                        No aplica
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="conesst-form-field mt-3">
                    <div class="conesst-form-label">
                        <span>
                            <i class="bi bi-diagram-3"></i>
                            <%= t('.process') %>
                        </span>
                        <button type="button" class="conesst-help-btn" data-bs-toggle="tooltip" data-bs-html="true" title="Especificar el proceso.">
                            <%= image_tag 'ayuda.png', width: 22, height: 22, alt: "Ayuda" %>
                        </button>
                    </div>
                    <%= form.text_field :process, class: "form-control", placeholder: "Especificar el proceso" %>
                </div>
                <div class="conesst-form-field mt-3">
                    <div class="conesst-form-label">
                        <span>
                            <i class="bi bi-search"></i>
                            <%= t('.finding') %>
                        </span>
                        <button type="button" class="conesst-help-btn" data-bs-toggle="tooltip" data-bs-html="true" title="Especificar el hallazgo.">
                            <%= image_tag 'ayuda.png', width: 22, height: 22, alt: "Ayuda" %>
                        </button>
                    </div>
                    <%= form.text_area :finding, class: "form-control", rows: 4, placeholder: "Describa el hallazgo encontrado" %>
                </div>
                <div class="conesst-actions">
                    <button type="submit"
                            class="conesst-btn conesst-btn-primary">
                        <i class="bi bi-check-circle"></i>
                        <span>
                            <%= t('common.submit') %>
                        </span>
                    </button>
                    <%= link_to audit_reports_path(entity_id: Current.user.entity), class: "conesst-btn conesst-btn-secondary" do %>
                        <i class="bi bi-arrow-left"></i>
                        <span>
                            Retornar
                        </span>
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
    <% if @standar_detail_items.present? %>
        <div class="conesst-card mt-4">
            <div class="conesst-card-header">
                <div class="conesst-card-header-content">
                    <h2 class="conesst-card-header-title">
                        <i class="bi bi-journal-text"></i>
                        Consulta estándares
                    </h2>
                </div>
            </div>
            <div class="conesst-card-body">
                <div class="conesst-table-wrapper">
                    <table class="conesst-table">
                        <thead>
                            <tr>
                                <th>
                                    Ciclo
                                </th>
                                <th>
                                    Item
                                </th>
                                <th>
                                    Descripción
                                </th>
                                <th class="text-center">
                                    Criterio / Modo de verificación
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <% @standar_detail_items.each do |standar_detail_item| %>
                                <% if standar_detail_item.standar_detail.standar.rule_id == 3 %>
                                    <tr>
                                        <td>
                                            <%= Standar.label_cycle(standar_detail_item.standar_detail.standar.cycle) %>
                                        </td>
                                        <td>
                                            <strong>
                                                <%= standar_detail_item.item_nro %>
                                            </strong>
                                        </td>
                                        <td>
                                            <%= standar_detail_item.description %>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="conesst-help-btn conesst-help-btn-large" data-bs-toggle="popover" title="<%= standar_detail_item.description %>" data-bs-content="CRITERIO: <%= standar_detail_item.criterion %> MODO DE VERIFICACIÓN: <%= standar_detail_item.verification_mode %>">
                                                <%= image_tag 'ayuda.png', width: 22, height: 22, alt: "Consultar criterio" %>
                                            </button>
                                        </td>
                                    </tr>
                                <% end %>
                            <% end %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    <% end %>
</div>
