<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div class="conesst-card-header-title">
          <i class="bi bi-check2-square me-2"></i>
          Administración de campaña para votación
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @adm_vote do |form| %>
        <% if @adm_vote.errors.any? %>
          <div class="alert alert-danger" role="alert">
            <div class="fw-bold mb-1">
              <i class="bi bi-exclamation-triangle me-1"></i>
              Se encontraron los siguientes errores:
            </div>
            <ul class="mb-0">
              <% @adm_vote.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="conesst-form-grid conesst-form-grid-2">
          <div class="conesst-form-group">
            <%= form.label :date_initial, class: "conesst-form-label" do %>
              <span>
                <%= t(".date_initial") %>
                <%= image_tag "ayuda.png", width: 22, height: 22, class: "ms-1", data: {bs_toggle: "tooltip", bs_html: "true"}, title: "Indicar la fecha de inicio de las votaciones." %>
              </span>
            <% end %>
            <%= form.date_field :date_initial, class: "form-control", required: true %>
          </div>
          <div class="conesst-form-group">
            <%= form.label :date_final, class: "conesst-form-label" do %>
              <span>
                <%= t(".date_final") %>
                <%= image_tag "ayuda.png", width: 22, height: 22, class: "ms-1", data: {bs_toggle: "tooltip", bs_html: "true"}, title: "Indicar la fecha final de las votaciones." %>
              </span>
            <% end %>
            <%= form.date_field :date_final, class: "form-control", required: true %>
          </div>
        </div>
        <div class="conesst-form-grid conesst-form-grid-2">
          <div class="conesst-form-group">
            <%= form.label :total_candidates, class: "conesst-form-label" do %>
              <span>
                <%= t(".total_candidates") %>
                <%= image_tag "ayuda.png", width: 22, height: 22, class: "ms-1", data: {bs_toggle: "tooltip", bs_html: "true"}, title: "Indicar el número de candidatos a participar." %>
              </span>
            <% end %>
            <%= form.number_field :total_candidates, class: "form-control" %>
          </div>
          <div class="conesst-form-group">
            <%= form.label :votes_max, class: "conesst-form-label" do %>
              <span>
                <%= t(".votes_max") %>
                <%= image_tag "ayuda.png", width: 22, height: 22, class: "ms-1", data: {bs_toggle: "tooltip", bs_html: "true"}, title: "Indicar el número máximo de votos por usuario hábil." %>
              </span>
            <% end %>
            <%= form.number_field :votes_max, class: "form-control" %>
          </div>
        </div>
        <div class="conesst-form-group">
          <%= form.label :titulo_vote, class: "conesst-form-label" do %>
            <span>
              <%= t(".titulo_vote") %>
              <%= image_tag "ayuda.png", width: 22, height: 22, class: "ms-1", data: {bs_toggle: "tooltip", bs_html: "true"}, title: "Indicar el título de la campaña electiva y fecha." %>
            </span>
          <% end %>
          <%= form.text_field :titulo_vote, class: "form-control" %>
        </div>
        <div class="conesst-form-group">
          <%= form.label :observation, class: "conesst-form-label" do %>
            <span>
              <%= t(".observation") %>
              <%= image_tag "ayuda.png", width: 22, height: 22, class: "ms-1", data: {bs_toggle: "tooltip", bs_html: "true"}, title: "Indicar observaciones si se tienen." %>
            </span>
          <% end %>
          <%= form.text_field :observation, class: "form-control" %>
        </div>
        <% if params[:entity_id].present? %>
          <%= form.hidden_field :entity_id, value: params[:entity_id].to_i %>
        <% end %>
        <div class="conesst-actions mt-4">
          <button type="submit" class="conesst-btn conesst-btn-primary">
            <i class="bi bi-check-circle"></i>
            <span><%= t("common.submit") %></span>
          </button>
          <%= link_to :back, class: "conesst-btn conesst-btn-secondary" do %>
            <i class="bi bi-arrow-left"></i>
            <span>Retornar</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>