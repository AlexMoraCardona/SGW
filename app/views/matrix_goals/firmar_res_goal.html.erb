<div class="container py-4">
  <div align="left"; class="container col-12">
      <a class="navbar-brand" href="/">
          <%= image_tag 'LogoConesst202305232.png',:width => "100",  :height=>"100" %>
      </a>
  </div>
  <div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
      <h4 class="mb-0"><i class="bi bi-pen-fill"></i>Firma del Responsable SST</h4>
    </div>

    <div class="card-body">
      <%= form_with model: @matrix_goal do |form| %>
        <% if @matrix_goal.errors.any? %>
          <div class="alert alert-danger">
            <h5 class="mb-3"><i class="bi bi-exclamation-triangle-fill"></i> Se encontraron los siguientes errores: </h5>
            <ul class="mb-0">
              <% @matrix_goal.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="row mb-4">
          <div class="col-12">
            <div class="card border-primary">
              <div class="card-header bg-light">
                <strong>
                  <i class="bi bi-person-workspace"></i>
                  Responsable SST
                </strong>
              </div>
              <div class="card-body">
                <h5 class="text-primary mb-0">
                  <%= @matrix_goal.name_user(@matrix_goal.user_responsible) %>
                </h5>
              </div>
            </div>
          </div>
        </div>
        <div class="row mb-4">
          <div class="col-12">
            <label class="form-label fw-bold"><i class="bi bi-pencil-square"></i> Firma autorizada del Responsable SST </label>
            <div class="d-flex flex-column flex-sm-row gap-4 mt-2">
              <div class="form-check">
                <%= form.radio_button :firm_responsible, 0, class: "form-check-input" %>
                <%= form.label :firm_responsible_0, "No", class: "form-check-label" %>
              </div>
              <div class="form-check">
                <%= form.radio_button :firm_responsible, 1, class: "form-check-input" %>
                <%= form.label :firm_responsible_1, "Sí", class: "form-check-label" %>
              </div>
            </div>
          </div>
        </div>
        <%= form.hidden_field :date_firm_responsible, value: Time.current %>
        <hr>
        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
          <%= button_tag type: "submit", class: "btn btn-success" do %>
            <i class="bi bi-check-circle"></i><%= t('common.submit') %>
          <% end %>
          <%= link_to :back, class: "btn btn-secondary" do %>
            <i class="bi bi-arrow-left-circle"></i>Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
