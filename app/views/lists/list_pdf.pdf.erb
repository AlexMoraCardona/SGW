<head>
  <meta charset="utf-8">
  <%= wicked_pdf_stylesheet_link_tag "pdf_conesst" %>
</head>
<head>
  <meta charset="utf-8">
</head>
<div class="pdf-document">
  <div class="pdf-title">
    LISTA DE CHEQUEO
  </div>
  <table class="pdf-info-table">
    <tr>
      <td class="pdf-col-25 pdf-label">
        Lista de chequeo
      </td>
      <td class="pdf-col-75 pdf-value">
        <%= @list.check_list.name %>
      </td>
    </tr>
    <tr>
      <td class="pdf-label">
        Empresa
      </td>
      <td class="pdf-value">
        <%= @list.entity.business_name %>
      </td>
    </tr>
    <tr>
      <td class="pdf-label">
        Fecha de realización
      </td>
      <td class="pdf-value">
        <%= @list.created_at.strftime("%Y-%m-%d") %>
      </td>
    </tr>
  </table>
  <div class="pdf-space"></div>
  <% if @lists.present? %>
    <table class="pdf-table pdf-table-blue">
      <thead>
        <tr>
          <th class="pdf-col-10">
            Ítem
          </th>
          <th class="pdf-col-30">
            Verificación
          </th>
          <th class="pdf-col-10">
            Cumple
          </th>
          <th class="pdf-col-10">
            No cumple
          </th>
          <th class="pdf-col-10">
            No aplica
          </th>
          <th class="pdf-col-30">
            Observaciones
          </th>
        </tr>
      </thead>
      <tbody>
        <% @lists.group_by(&:clasification).each do |cla, det| %>
          <% nivel = CheckListItem.label_clasification(cla) %>
          <tr>
            <td colspan="6" class="pdf-section-title">
              <%= nivel %>
            </td>
          </tr>
          <% det.each do |d| %>
            <tr>
              <td>
                <%= d.check_list_item.item %>
              </td>
              <td>
                <%= d.check_list_item.name %>
              </td>
              <td class="pdf-cell-center">
                <% if d.state == 0 %>
                  <strong>X</strong>
                <% end %>
              </td>
              <td class="pdf-cell-center">
                <% if d.state == 1 %>
                  <strong>X</strong>
                <% end %>
              </td>
              <td class="pdf-cell-center">
                <% if d.state == 2 %>
                  <strong>X</strong>
                <% end %>
              </td>
              <td>
                <%= d.observation %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="pdf-section-title">
      No se encontraron registros para esta lista de chequeo.
    </div>
  <% end %>
</div>
