<div class="pdf-space"></div>
<div class="pdf-section-title">
    Compromisos acordados en esta reunión
</div>
<table class="pdf-table">
    <tr>
        <th class="pdf-cell-left pdf-col-30">
            Compromiso
        </th>
        <th class="pdf-cell-left pdf-col-25">
            Responsable
        </th>
        <th class="pdf-cell-left pdf-col-25">
            Fecha acordada para compromiso
        </th>
        <th class="pdf-cell-left pdf-col-20">
            Resultado esperado
        </th>
    </tr>
    <% @meeting_commitments.each do |meeting_commitment| %>
        <tr>
            <td class="pdf-cell-left pdf-col-30">
                <%= meeting_commitment.commitment %>
            </td>
            <td class="pdf-cell-left pdf-col-25">
                <%= meeting_commitment.responsible %>
            </td>
            <td class="pdf-cell-left pdf-col-25">
                <%= meeting_commitment.date_commitment %>
            </td>
            <td class="pdf-cell-left pdf-col-20">
                <%= meeting_commitment.state_commitment %>
            </td>
        </tr>
    <% end %>
</table>
<div class="pdf-space"></div>