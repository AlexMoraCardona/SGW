<tr>
  <td><%= check_list.id %></td>
  <td><%= check_list.name %></td>
  <td><%= CheckList.label_state(check_list.state) %></td>
  <td>
    <%= link_to edit_check_list_path(check_list), class: "conesst-btn conesst-btn-primary" do %>
      <i class="bi bi-pencil-square me-1"></i>
      <%= t('common.edit') %>
    <% end %>
  </td>
  <td>
    <%= link_to new_check_list_item_path(check_list.id), class: "conesst-btn conesst-btn-primary" do %>
      <i class="bi bi-plus-circle me-1"></i>
      Item
    <% end %>
  </td>
</tr>