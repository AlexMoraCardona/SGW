<div class="container-fluid px-3 px-md-4 py-3">
    <div class="container mb-3">
        <div class="d-flex justify-content-center justify-content-md-start align-items-center">
            <a href="/" aria-label="Inicio CONESST">
                <%= image_tag 'LogoConesst202305232.png', class: 'conesst-logo', alt: 'Logo CONESST' %>
            </a>
        </div>
    </div>


    <div class="container">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light border-0 px-3 px-md-4 py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clipboard2-pulse fs-4 text-primary"></i>
                    <h5 class="mb-0 fw-bold">
                        REPORTE INTERNO DE ACCIDENTES E INCIDENTES
                    </h5>
                </div>
            </div>
            <div class="card-body p-3 p-md-4">
                <% if params[:entity_id].present? || @entity.present? %>
                    <%= render 'internal_report' %>
                <% else %>
                    <%= form_with model: @entity, method: :get, local: true do |form| %>
                        <div class="row g-3 align-items-end">
                            <div class="col-12">
                                <%= form.label :entity_id, 'Empresa', class: 'form-label fw-semibold' %>
                                <% if @entities.present? %>
                                    <%= form.collection_select :entity_id, @entities.order(id: :asc), :id, :business_name, { prompt: '-- Seleccionar empresa --' }, {class: 'form-select', required: true} %>
                                <% else %>
                                    <p class="form-control bg-light mb-0">
                                        <%= @entity.business_name %>
                                    </p>
                                    <%= form.hidden_field :entity_id, value: @entity.id %>
                                <% end %>
                            </div>
                            <div class="col-12 d-flex justify-content-center justify-content-md-start mt-4">
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="bi bi-search me-2"></i>
                                    Consultar
                                </button>
                            </div>
                        </div>
                    <% end %>
                <% end %>
            </div>
        </div>
    </div>
</div>