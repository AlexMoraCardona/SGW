<div class="container-fluid py-3">
  <div align="left"; class="container col-12">
    <a class="navbar-brand" href="/">
        <%= image_tag 'LogoConesst202305232.png',:width => "100",  :height=>"100" %>
    </a>
  </div>
  <div class="card shadow-sm border-0">

    <!-- ENCABEZADO -->

    <div class="card-header bg-light">

      <div class="d-flex flex-column flex-md-row
                  justify-content-between
                  align-items-md-center
                  gap-3">

        <div>

          <h4 class="mb-1">
            <i class="bi bi-clipboard2-pulse me-2"></i>
            <%= @surveillance_survey.name %>
          </h4>

          <small class="text-muted">
            Encuesta de vigilancia epidemiológica
          </small>

        </div>

        <div>

          <% if @surveillance_survey.active? %>

            <span class="badge bg-success fs-6">
              <i class="bi bi-check-circle me-1"></i>
              Activa
            </span>

          <% else %>

            <span class="badge bg-secondary fs-6">
              <i class="bi bi-x-circle me-1"></i>
              Inactiva
            </span>

          <% end %>

          <span class="badge bg-primary fs-6 ms-1">
            Versión <%= @surveillance_survey.version %>
          </span>

        </div>

      </div>

    </div>


    <div class="card-body">

      <!-- INFORMACIÓN GENERAL -->

      <div class="row g-4">

        <div class="col-12 col-lg-8">

          <label class="form-label fw-semibold text-muted">
            Descripción
          </label>

          <div>
            <%= @surveillance_survey.description.presence ||
                "Sin descripción registrada." %>
          </div>

        </div>


        <div class="col-12 col-lg-4">

          <label class="form-label fw-semibold text-muted">
            Programa SVE
          </label>

          <div>
            <%= @epidemiological_surveillance_program.name %>
          </div>

        </div>

      </div>


      <hr class="my-4">


      <!-- PREGUNTAS -->

      <div class="d-flex flex-column flex-md-row
                  justify-content-between
                  align-items-md-center
                  gap-2 mb-3">

        <div>

          <h5 class="mb-1">
            <i class="bi bi-list-check me-2"></i>
            Preguntas de la encuesta
          </h5>

          <small class="text-muted">
            <%= @surveillance_questions.count %>
            pregunta(s) configurada(s)
          </small>

        </div>

      </div>


      <% if @surveillance_questions.any? %>

        <div class="row">

          <% @surveillance_questions.each do |question| %>

            <div class="col-12 mb-3">

              <div class="card border">

                <div class="card-body">

                  <div class="d-flex align-items-start gap-2">

                    <span class="badge bg-secondary rounded-pill">
                      <%= question.position %>
                    </span>

                    <div class="flex-grow-1">

                      <div class="fw-semibold">

                        <%= question.question %>

                        <% if question.required? %>

                          <span class="text-danger"
                                title="Pregunta obligatoria">
                            *
                          </span>

                        <% end %>

                      </div>


                      <div class="mt-2">


<% if question.question_type == "open_text" %>

  <span class="badge bg-light text-dark border">
    <i class="bi bi-input-cursor-text me-1"></i>
    Campo de texto
  </span>


<% elsif question.question_type == "boolean" %>

  <span class="badge bg-light text-dark border">
    <i class="bi bi-toggle-on me-1"></i>
    Sí / No
  </span>


<% elsif question.question_type == "single_choice" %>

  <span class="badge bg-light text-dark border">
    <i class="bi bi-ui-radios me-1"></i>
    Una opción
  </span>


<% elsif question.question_type == "multiple_choice" %>

  <span class="badge bg-light text-dark border">
    <i class="bi bi-ui-checks me-1"></i>
    Múltiples opciones
  </span>

<% end %>




                      </div>


                      <!-- OPCIONES -->

                      <% if question.surveillance_question_options.any? %>

                        <div class="mt-3">

                          <small class="text-muted fw-semibold">
                            Opciones:
                          </small>

                          <div class="d-flex flex-wrap gap-2 mt-2">

                            <% question.surveillance_question_options
                                      .select(&:active?)
                                      .sort_by(&:position)
                                      .each do |option| %>

                              <span class="badge bg-light text-dark border">

                                <%= option.option_text %>

                              </span>

                            <% end %>

                          </div>

                        </div>

                      <% end %>

                    </div>

                  </div>

                </div>

              </div>

            </div>

          <% end %>

        </div>

      <% else %>

        <div class="alert alert-warning">

          <i class="bi bi-exclamation-triangle me-2"></i>

          Esta encuesta todavía no tiene preguntas configuradas.

        </div>

      <% end %>


      <hr class="my-4">


      <!-- BOTONERA -->

      <div class="d-flex flex-wrap
                  justify-content-center
                  gap-2">

        <%= link_to(
              edit_epidemiological_surveillance_program_surveillance_survey_path(
                @epidemiological_surveillance_program,
                @surveillance_survey
              ),
              class: "btn btn-outline-primary"
            ) do %>

          <i class="bi bi-pencil-square me-1"></i>
          Editar

        <% end %>


        <%= link_to(
              epidemiological_surveillance_program_surveillance_survey_surveillance_questions_path(
                @epidemiological_surveillance_program,
                @surveillance_survey
              ),
              class: "btn btn-outline-dark"
            ) do %>

          <i class="bi bi-list-check me-1"></i>
          Administrar preguntas

        <% end %>


        <% if @surveillance_survey.active? &&
              @surveillance_questions.any? %>

          <%= link_to(
                new_epidemiological_surveillance_program_surveillance_survey_surveillance_survey_response_path(
                  @epidemiological_surveillance_program,
                  @surveillance_survey
                ),
                class: "btn btn-success"
              ) do %>

            <i class="bi bi-clipboard2-check me-1"></i>
            Aplicar encuesta

          <% end %>

          <%= link_to(
      epidemiological_surveillance_program_surveillance_survey_surveillance_survey_responses_path(
        @epidemiological_surveillance_program,
        @surveillance_survey
      ),
      class: "btn btn-outline-info"
    ) do %>

  <i class="bi bi-clipboard2-data me-1"></i>
  Encuestas realizadas

<% end %>


        <% end %>


        <%= link_to(
              epidemiological_surveillance_program_surveillance_surveys_path(
                @epidemiological_surveillance_program
              ),
              class: "btn btn-outline-secondary"
            ) do %>

          <i class="bi bi-arrow-left me-1"></i>
          Volver

        <% end %>

      </div>

    </div>

  </div>

</div>
