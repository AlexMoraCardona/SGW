<!DOCTYPE html>
<html>
<head>

  <meta charset="UTF-8">

  <title>
    Caso SVE #<%= @epidemiological_surveillance_case.id %>
  </title>

  <style>

    body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 10px;
      color: #212529;
    }

    h1 {
      font-size: 18px;
      margin-bottom: 5px;
    }

    h2 {
      font-size: 13px;
      margin-top: 18px;
      margin-bottom: 8px;
    }

    h3 {
      font-size: 11px;
      margin-top: 12px;
    }

    .header {
      border-bottom: 2px solid #333;
      padding-bottom: 8px;
      margin-bottom: 15px;
    }

    .section {
      margin-bottom: 15px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      border: 1px solid #ccc;
      padding: 5px;
      vertical-align: top;
    }

    th {
      background: #f2f2f2;
      font-weight: bold;
    }

    .label {
      font-weight: bold;
      color: #666;
    }

    .badge {
      font-weight: bold;
    }

    .muted {
      color: #777;
    }

    .page-break {
      page-break-before: always;
    }

  </style>

</head>

<body>

  <%= yield %>

</body>
</html>