<% if @entity.present? %>
  <div class="conesst-page">
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-building fs-5"></i>
          <div>
            <h4 class="mb-0">
              <%= @entity.business_name %>
            </h4>
            <small class="text-muted">
              NIT:
              <%= EvaluationRuleDetail.miles(@entity.identification_number) if @entity.identification_number.present? %>
              <% if @entity.verification_digit.present? %>
                -<%= @entity.verification_digit %>
              <% end %>
            </small>
          </div>
        </div>
        <div class="mt-3 mt-md-0">
          <%= link_to new_adm_extinguisher_path(entity_id: @entity.id), class: "conesst-btn conesst-btn-primary" do %>
            <i class="bi bi-plus-circle me-1"></i>
            <%= t('common.create_adm_extinguisher') %>
          <% end %>
        </div>
      </div>
      <div class="conesst-card-body">
        <% if @adm_extinguishers.present? %>
          <div class="conesst-table-wrapper">
            <table class="conesst-table">
              <thead>
                <tr>
                  <th class="text-center">Fecha creación</th>
                  <th class="text-center">Área</th>
                  <th class="text-center">Responsable</th>
                  <th class="text-center">Firma</th>
                  <th class="text-center">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% @adm_extinguishers.each do |adm_extinguisher| %>
                  <tr>
                    <td data-label="Fecha creación" class="text-center">
                      <%= adm_extinguisher.date_creation %>
                    </td>
                    <td data-label="Área" class="text-center">
                      <%= adm_extinguisher.area %>
                    </td>
                    <td data-label="Responsable" class="text-center">
                      <%= adm_extinguisher.user.name %>
                    </td>
                    <td data-label="Firma" class="text-center">
                      <% if adm_extinguisher.firm_user == 0 %>
                        <%= link_to firmar_extinguisher_adm_extinguishers_path(adm_extinguisher.id, 1), class: "conesst-btn conesst-btn-warning" do %>
                          <i class="bi bi-pen me-1"></i>
                          <%= t('common.firmar') %>
                        <% end %>
                      <% else %>
                        <span class="small">
                          <%= adm_extinguisher.date_firm_user %>
                        </span>
                      <% end %>
                    </td>
                    <td data-label="Acciones" class="text-center">
                      <div class="d-flex flex-wrap justify-content-center gap-2">
                        <%= link_to crear_item_extinguisher_adm_extinguishers_path(adm_extinguisher.id), class: "conesst-btn conesst-btn-primary" do %>
                          <i class="bi bi-list-check me-1"></i>
                          <%= t('common.crear_item_extinguisher') %>
                        <% end %>
                        <%= link_to edit_adm_extinguisher_path(adm_extinguisher), class: "conesst-btn conesst-btn-warning" do %>
                          <i class="bi bi-pencil-square me-1"></i>
                          Editar
                        <% end %>
                        <%= link_to adm_extinguisher, class: "conesst-btn" do %>
                          <i class="bi bi-eye me-1"></i>
                          <%= t('common.show_adm_extinguisher') %>
                        <% end %>
                        <%= link_to ver_extinguisher_adm_extinguishers_path(adm_extinguisher.id, format: :pdf), class: "conesst-btn conesst-btn-success" do %>
                          <i class="bi bi-file-earmark-pdf me-1"></i>
                          PDF
                        <% end %>
                        <%= button_to adm_extinguisher, method: :delete, class: "btn btn-sm btn-danger", form: {data: {turbo_confirm: "¿Está seguro de eliminar este registro? Esta acción no se puede deshacer."}} do %>
                          <i class="bi bi-trash me-1"></i>
                          Eliminar
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="alert alert-light border mb-0">
            <i class="bi bi-info-circle me-1"></i>
            No existen inspecciones de extintores registradas para esta empresa.
          </div>
        <% end %>
      </div>
    </div>
    <div class="conesst-actions">
      <%= link_to request.referer || root_path, class: "conesst-btn" do %>
        <i class="bi bi-arrow-left me-1"></i>
        Retornar
      <% end %>
    </div>
  </div>
<% end %>