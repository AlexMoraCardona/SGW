<style>
  .analysis-list-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 10px 12px 25px;
  }

  /* Encabezado de empresa */
  .analysis-company-card {
    background: #fff;
    border: 1px solid #e9ecef;
    border-radius: 12px;
    padding: 15px 18px;
    margin-bottom: 15px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .analysis-company-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: #343a40;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .analysis-company-title i {
    color: #00aae4;
  }

  .analysis-company-nit {
    font-weight: 500;
    color: #6c757d;
  }

  /* Barra de acciones */
  .analysis-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 15px;
  }

  .analysis-btn-create {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 0;
    border-radius: 7px;
    padding: 7px 13px;
    font-size: 0.85rem;
    font-weight: 500;
    background: #00aae4;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }

  .analysis-btn-create:hover {
    background: #008fc1;
    color: #fff;
  }

  /* Tarjeta de la tabla */
  .analysis-table-card {
    background: #fff;
    border: 1px solid #e9ecef;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    overflow: hidden;
  }

  .analysis-table-wrapper {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .analysis-table {
    width: 100%;
    min-width: 900px;
    margin: 0;
    vertical-align: middle;
  }

  .analysis-table thead th {
    background: #f1f3f5;
    color: #343a40;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 10px 8px;
    border-bottom: 2px solid #dee2e6;
    white-space: nowrap;
    text-align: center;
    vertical-align: middle;
  }

  .analysis-table tbody td {
    font-size: 0.82rem;
    padding: 9px 8px;
    color: #495057;
    text-align: center;
    vertical-align: middle;
    white-space: nowrap;
  }

  .analysis-table tbody tr:hover {
    background-color: #f8f9fa;
  }

  /* Botones */
  .analysis-table .analysis-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 58px;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .analysis-table .analysis-btn i {
    font-size: 0.82rem;
  }

  .analysis-btn-step {
    background: #ffc107;
    border-color: #ffc107;
    color: #212529;
  }

  .analysis-btn-step:hover {
    background: #e0a800;
    border-color: #e0a800;
    color: #212529;
  }

  .analysis-btn-sign {
    background: #ffc107;
    border-color: #ffc107;
    color: #212529;
  }

  .analysis-btn-sign:hover {
    background: #e0a800;
    border-color: #e0a800;
    color: #212529;
  }

  .analysis-btn-view {
    background: #00aae4;
    border-color: #00aae4;
    color: #fff;
  }

  .analysis-btn-view:hover {
    background: #008fc1;
    border-color: #008fc1;
    color: #fff;
  }

  .analysis-btn-edit {
    background: #ffc107;
    border-color: #ffc107;
    color: #212529;
  }

  .analysis-btn-edit:hover {
    background: #e0a800;
    border-color: #e0a800;
    color: #212529;
  }

  .analysis-btn-pdf {
    background: #198754;
    border-color: #198754;
    color: #fff;
  }

  .analysis-btn-pdf:hover {
    background: #146c43;
    border-color: #146c43;
    color: #fff;
  }

  .analysis-date {
    font-weight: 500;
    color: #495057;
  }

  /* Indicador de desplazamiento en móvil */
  .analysis-scroll-hint {
    display: none;
    padding: 7px 12px;
    font-size: 0.72rem;
    color: #6c757d;
    background: #f8f9fa;
    border-top: 1px solid #e9ecef;
    text-align: center;
  }

  @media (max-width: 767.98px) {

    .analysis-list-container {
      padding: 8px 8px 20px;
    }

    .analysis-company-card {
      padding: 12px;
      margin-bottom: 12px;
    }

    .analysis-company-title {
      font-size: 1rem;
    }

    .analysis-actions {
      justify-content: center;
      margin-bottom: 12px;
    }

    .analysis-btn-create {
      width: auto;
      padding: 7px 12px;
      font-size: 0.8rem;
    }

    .analysis-table {
      min-width: 900px;
    }

    .analysis-table thead th {
      font-size: 0.72rem;
      padding: 8px 6px;
    }

    .analysis-table tbody td {
      font-size: 0.75rem;
      padding: 8px 6px;
    }

    .analysis-table .analysis-btn {
      font-size: 0.7rem;
      padding: 5px 7px;
    }

    .analysis-scroll-hint {
      display: block;
    }
  }
</style>

<div class="analysis-list-container">

<% if @entity.present? %> <div class="analysis-company-card"> <h2 class="analysis-company-title"> <i class="bi bi-building me-1"></i>
<%= @entity.business_name %>


    <% if @entity.identification_number.present? %>
      <span class="analysis-company-nit">
        · NIT:
        <%= EvaluationRuleDetail.miles(@entity.identification_number) %>
        <% if @entity.verification_digit.present? %>
          -<%= @entity.verification_digit %>
        <% end %>
      </span>
    <% end %>
  </h2>
</div>


<% end %>

<% if Current.user.level > 0 && Current.user.level < 4 %> <div class="analysis-actions">
<%= link_to new_analysis_risk_path, class: "analysis-btn-create" do %> <i class="bi bi-plus-circle"></i> <span>Crear análisis</span>
<% end %> </div>
<% end %>

  <div class="analysis-table-card">


<div class="analysis-table-wrapper">
  <table class="table table-hover analysis-table mb-0">

    <thead>
      <tr>
        <th>Fecha</th>
        <th>Área</th>
        <th>Usuario elaboró</th>
        <th>Crear paso</th>
        <th>Firmar</th>
        <th>Ver</th>
        <th><%= t('common.edit') %></th>
        <th>PDF</th>
      </tr>
    </thead>

    <tbody>
      <% @analysis_risks.each do |analysis_risk| %>

        <tr>

          <td>
            <% if analysis_risk.date_analysis.present? %>
              <span class="analysis-date">
                <%= analysis_risk.date_analysis.strftime("%F") %>
              </span>
            <% end %>
          </td>

          <td>
            <%= AnalysisRisk.label_area(analysis_risk.code_area) %>
          </td>

          <td>
            <%= AnalysisRisk.label_user(analysis_risk.user_elaborated) %>
          </td>

          <td>
            <% if Current.user.level > 0 && Current.user.level < 3 %>
              <%= link_to crear_item_paso_path(analysis_risk),
                          class: "btn analysis-btn analysis-btn-step",
                          title: "Crear paso" do %>
                <i class="bi bi-plus-circle"></i>
                <span>Crear paso</span>
              <% end %>
            <% end %>
          </td>

          <td>
            <% if analysis_risk.firm_user_elaborated == 0 %>

              <%= link_to firma_analisis_path(analysis_risk),
                          class: "btn analysis-btn analysis-btn-sign",
                          title: "Firmar análisis" do %>
                <i class="bi bi-pen"></i>
                <span>Firmar</span>
              <% end %>

            <% else %>

              <% if analysis_risk.date_user_elaborated.present? %>
                <span class="analysis-date">
                  <%= analysis_risk.date_user_elaborated.strftime("%F") %>
                </span>
              <% end %>

            <% end %>
          </td>

          <td>
            <%= link_to analysis_risk_path(analysis_risk),
                        class: "btn analysis-btn analysis-btn-view",
                        title: "Ver análisis" do %>
              <i class="bi bi-eye"></i>
              <span>Ver</span>
            <% end %>
          </td>

          <td>
            <% if Current.user.level > 0 && Current.user.level < 3 %>
              <%= link_to edit_analysis_risk_path(analysis_risk.id),
                          class: "btn analysis-btn analysis-btn-edit",
                          title: "Editar análisis" do %>
                <i class="bi bi-pencil-square"></i>
                <span>Editar</span>
              <% end %>
            <% end %>
          </td>

          <td>
            <%= link_to ver_analysis_risk_path(analysis_risk.id, format: 'pdf'),
                        class: "btn analysis-btn analysis-btn-pdf",
                        title: "Generar PDF" do %>
              <i class="bi bi-file-earmark-pdf"></i>
              <span>PDF</span>
            <% end %>
          </td>

        </tr>

      <% end %>
    </tbody>

  </table>
</div>

<div class="analysis-scroll-hint">
  <i class="bi bi-arrow-left-right me-1"></i>
  Desliza horizontalmente para ver todas las opciones
</div>


  </div>

</div>
