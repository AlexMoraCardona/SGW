<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div class="conesst-card-header-title">
          <i class="bi bi-chat-left-text me-2"></i>
          Presentación de queja al Comité de Convivencia Laboral
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @complaint do |form| %>
        <% if @complaint.errors.any? %>
          <div class="alert alert-danger" role="alert">
            <div class="fw-bold mb-1">
              <i class="bi bi-exclamation-triangle me-1"></i>
              Se encontraron los siguientes errores:
            </div>
            <ul class="mb-0">
              <% @complaint.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="conesst-form-group mb-3">
          <div class="conesst-form-label">
            <i class="bi bi-person me-1"></i>
            Colaborador
          </div>
          <div class="form-control bg-light">
            <%= Current.user.name %>
          </div>
        </div>
        <div class="conesst-form-group mb-3">
          <%= form.label :user_interpose_complaint, class: "conesst-form-label" do %>
            <span>
              Persona contra quien se interpone la queja
              <%= image_tag "ayuda.png", width: 22, height: 22, class: "ms-1", data: {bs_toggle: "tooltip", bs_html: "true"}, title: "Seleccione la persona contra quien se interpone la queja." %>
            </span>
          <% end %>
          <%= form.collection_select(:user_interpose_complaint, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccionar persona --" }, { class: "form-select", required: true }) %>
        </div>
        <div class="conesst-form-group mb-3">
          <%= form.label :relationship_facts, class: "conesst-form-label" do %>
            RELACIÓN DE LOS HECHOS MOTIVO DE LA QUEJA
          <% end %>
          <div class="alert alert-light border small mb-2">
            <strong>1.1.</strong>
            Describa todos los elementos en los que se identifiquen las
            circunstancias de tiempo (cuándo), modo (cómo), lugar (dónde)
            y cualquier otra que considere pertinente. De ser necesario
            el Comité podrá solicitarle ampliación de la información aquí descrita.
          </div>
          <%= form.text_area :relationship_facts, class: "form-control", rows: 6, required: true %>
        </div>
        <div class="conesst-form-group mb-3">
          <%= form.label :observation, "Observaciones", class: "conesst-form-label" %>
          <%= form.text_area :observation, class: "form-control", rows: 4 %>
        </div>
        <div class="conesst-form-group mb-3">
          <%= form.label :have_proof, "¿Cuenta con pruebas?", class: "conesst-form-label" %>
          <div class="d-flex flex-wrap gap-4 mt-2">
            <div class="form-check">
              <%= form.radio_button :have_proof, 0, class: "form-check-input", id: "have_proof_no" %>
              <%= form.label :have_proof, "NO", value: 0, class: "form-check-label", for: "have_proof_no" %>
            </div>
            <div class="form-check">
              <%= form.radio_button :have_proof, 1, class: "form-check-input", id: "have_proof_si" %>
              <%= form.label :have_proof, "SI", value: 1, class: "form-check-label", for: "have_proof_si" %>
            </div>
          </div>
        </div>
        <div class="conesst-form-group mb-3">
          <%= form.label :firm_complaint, "¿Autoriza la firma de la queja?", class: "conesst-form-label" %>
          <div class="d-flex flex-wrap gap-4 mt-2">
            <div class="form-check">
              <%= form.radio_button :firm_complaint, 0, class: "form-check-input", id: "firm_complaint_no" %>
              <%= form.label :firm_complaint, "NO", value: 0, class: "form-check-label", for: "firm_complaint_no" %>
            </div>
            <div class="form-check">
              <%= form.radio_button :firm_complaint, 1, class: "form-check-input", id: "firm_complaint_si" %>
              <%= form.label :firm_complaint, "SI", value: 1, class: "form-check-label", for: "firm_complaint_si" %>
            </div>
          </div>
          <div class="alert alert-warning mt-3 mb-0 small">
            <i class="bi bi-info-circle me-1"></i>
            Por favor recuerde autorizar firma, el Comité no acepta quejas anónimas.
          </div>
        </div>
        <div class="conesst-form-group mb-3">
          <%= form.label :files_complaint, "Adjuntar archivos", class: "conesst-form-label" %>
          <div class="border rounded p-3 bg-light">
            <%= form.file_field :files_complaint, multiple: true, class: "form-control" %>
            <div class="text-muted small mt-2">
              Puede seleccionar uno o varios archivos como soporte de la queja.
            </div>
          </div>
        </div>
        <%= form.hidden_field :date_complaint, value: Time.now %>
        <%= form.hidden_field :user_complaint, value: Current.user.id %>
        <% if @template.present? %>
          <%= form.hidden_field :code, value: @template.reference %>
          <%= form.hidden_field :version, value: @template.version.to_i %>
        <% end %>
        <div class="conesst-actions mt-4">
          <button type="submit" class="conesst-btn conesst-btn-primary">
            <i class="bi bi-send"></i>
            <span><%= t("common.submit") %></span>
          </button>
          <%= link_to home_path, class: "conesst-btn conesst-btn-secondary" do %>
            <i class="bi bi-arrow-left"></i>
            <span>Retornar</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>