<div class="conesst-page">
  <div class="mb-3">
    <%= link_to root_path, class: "d-inline-block" do %>
      <%= image_tag("LogoConesst202305232.png", width: 100, height: 100, alt: "CONESST") %>
    <% end %>
  </div>
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-pen fs-5"></i>
        <div>
          <h3 class="mb-0">
            Documentos pendientes por firmar
          </h3>
          <small class="text-muted">
            Consulte y gestione las evidencias y documentos que requieren su firma.
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <div class="mb-5">
        <div class="mb-3">
          <h5 class="mb-1">
            <i class="bi bi-camera me-1"></i>
            Evidencias pendientes por firmar
          </h5>
          <div class="small text-body-secondary fw-normal">
            Evidencias que requieren autorización.
          </div>
        </div>
        <% if @firmas_pendientes.present? %>
          <div class="conesst-table-wrapper">
            <table class="conesst-table table-hover">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Evidencia</th>
                  <th>Ver</th>
                  <th>Firmar</th>
                </tr>
              </thead>
              <tbody>
                <% @firmas_pendientes.each do |firm| %>
                  <% @evidencia = Evidence.buscar_una_evidencia(firm.evidence_id) %>
                  <% if @evidencia.present? %>
                    <tr>
                      <td data-label="Fecha">
                        <%= @evidencia.date %>
                      </td>
                      <td data-label="Evidencia">
                        <%= @evidencia.template.name %>
                      </td>
                      <td data-label="Ver">
                        <%= link_to(ver_evidencia_evaluation_rule_detail_path(@evidencia.id), class: "conesst-btn conesst-btn-primary") do %>
                          <i class="bi bi-eye me-1"></i>
                          <%= t('common.veritem') %>
                        <% end %>
                      </td>
                      <td data-label="Firmar">
                        <% if firm.authorize_firm == 0 %>
                          <%= link_to(firma_pendiente_path(firm), class: "conesst-btn conesst-btn-warning") do %>
                            <i class="bi bi-pen me-1"></i>
                            <%= t('common.firmar') %>
                          <% end %>
                        <% else %>
                          <span class="small text-success">
                            <i class="bi bi-check-circle me-1"></i>
                            <%= firm.date_authorize_firm %>
                          </span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-4">
            <i class="bi bi-check2-circle display-6 text-muted"></i>
            <p class="text-muted mt-2 mb-0">
              No se encontraron evidencias pendientes por firma.
            </p>
          </div>
        <% end %>
      </div>
      <% if @actas_pendientes.present? %>
        <div class="mb-5">
          <div class="mb-3">
            <h5 class="mb-1">
              <i class="bi bi-journal-text me-1"></i>
              Actas pendientes por firmar
            </h5>
            <div class="small text-body-secondary fw-normal">
              Actas que requieren su firma.
            </div>
          </div>
          <div class="conesst-table-wrapper">
            <table class="conesst-table table-hover">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Acta Número</th>
                  <th>Clasificación Acta</th>
                  <th>Ver</th>
                  <th>Firmar</th>
                </tr>
              </thead>
              <tbody>
                <% @actas_pendientes.each do |acta| %>
                  <% @meeting_minute = MeetingMinute.buscar_una_acta(acta.meeting_minute_id) %>
                  <% if @meeting_minute.present? %>
                    <tr>
                      <td data-label="Fecha">
                        <%= @meeting_minute.date %>
                      </td>
                      <td data-label="Acta Número">
                        <%= @meeting_minute.record_number %>
                      </td>
                      <td data-label="Clasificación">
                        <%= MeetingMinute.label_clasificacion(@meeting_minute.version) %>
                      </td>
                      <td data-label="Ver">
                        <%= link_to(meeting_minute_path(@meeting_minute.id), class: "conesst-btn conesst-btn-primary") do %>
                          <i class="bi bi-eye me-1"></i>
                          <%= t('common.veritem') %>
                        <% end %>
                      </td>
                      <td data-label="Firmar">
                        <% if acta.firm_assistant == 0 %>
                          <%= link_to(firma_pendiente_acta_path(acta), class: "conesst-btn conesst-btn-warning") do %>
                            <i class="bi bi-pen me-1"></i>
                            <%= t('common.firmar') %>
                          <% end %>
                        <% else %>
                          <span class="small text-success">
                            <i class="bi bi-check-circle me-1"></i>
                            <%= acta.date_firm %>
                          </span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
