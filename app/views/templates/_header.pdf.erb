<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
            color: #212529;
        }
        /* ============================
           ENCABEZADO PRINCIPAL
        ============================ */
        .encabezado-principal {
            width: 100%;
            border: 1px solid #b5b2b2;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .encabezado-principal td {
            vertical-align: middle;
        }

        /* LOGO */
        .logo {
            width: 20%;
            text-align: center;
            padding: 8px;
            border-right: 1px solid #d5d5d5;
        }

        .logo img {
            width: 90px;
            height: 90px;
            object-fit: contain;
            display: block;
            margin: 0 auto;
        }

        /* TITULO */
        .titulo {
            width: 80%;
            text-align: center;
            padding: 10px 15px;
        }

        .empresa {
            font-size: 19px;
            font-weight: bold;
            text-transform: uppercase;
            line-height: 1.3;
            margin-bottom: 5px;
        }

        .nombre-formato {
            font-size: 16px;
            font-weight: bold;
            text-transform: uppercase;
            line-height: 1.35;
        }

        /* ============================
           INFORMACIÓN DEL DOCUMENTO
        ============================ */

        .informacion {
            width: 100%;
            border: 1px solid #b5b2b2;
            border-top: none;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .informacion td {
            padding: 7px 9px;
            font-size: 13px;
            vertical-align: middle;
            border-right: 1px solid #d5d5d5;
            border-bottom: 1px solid #d5d5d5;
        }

        .informacion tr:last-child td {
            border-bottom: none;
        }

        .informacion td:last-child {
            border-right: none;
        }

        .etiqueta {
            width: 20%;
            font-weight: bold;
            background: #f3f3f3;
        }

        .valor {
            width: 30%;
            font-weight: normal;
        }

        .pagina-documento {
            font-weight: bold;
        }
    </style>
</head>

<body>
    <table class="encabezado-principal">
        <tr>
            <td class="logo">
                <% if @entity&.logo.present? %>
                    <%= image_tag(Evaluation.wicked_blob_path(@entity.logo),  width: 90, height: 90, alt: "Logo") %>
                <% end %>
            </td>
            <td class="titulo">
                <div class="empresa">
                    <%= @entity&.business_name %>
                </div>
                <div class="empresa">
                    NIT: <%= @entity&.identification_number %>-<%= @entity&.verification_digit if @entity&.verification_digit %>
                </div>
                <div class="nombre-formato">
                    <%= @template&.name %>
                </div>
            </td>
        </tr>
    </table>
    <table class="informacion">
        <tr>
            <td class="etiqueta">Código</td>
            <td class="valor">
                <%= @template&.reference %>
            </td>
            <td class="etiqueta">Versión</td>
            <td class="valor">
                <%= @template&.version %>
            </td>
        </tr>
        <tr>
            <td class="etiqueta">Fecha de elaboración</td>
            <td class="valor">
                <%
                    fecha_template = @template&.date
                    fecha_empresa  = @entity&.created_at

                    fecha_elaboracion =
                        if fecha_template.present? && fecha_empresa.present?
                            fecha_template.to_date < fecha_empresa.to_date ?
                              fecha_empresa.to_date :
                              fecha_template.to_date
                        elsif fecha_template.present?
                            fecha_template.to_date
                        elsif fecha_empresa.present?
                            fecha_empresa.to_date
                        end

                    meses = [
                        "Enero", "Febrero", "Marzo", "Abril",
                        "Mayo", "Junio", "Julio", "Agosto",
                        "Septiembre", "Octubre", "Noviembre", "Diciembre"
                    ]
                %>

                <% if fecha_elaboracion.present? %>
                    <%= meses[fecha_elaboracion.month - 1] %>
                    <%= fecha_elaboracion.year %>
                <% end %>
            </td>
            <td class="etiqueta">Página</td>
            <td class="valor">
                <span id="pagina-documento" class="pagina-documento">
                    1 de 1
                </span>
            </td>
        </tr>
    </table>
    <script>
        function obtenerParametros() {
            var parametros = {};
            var query = window.location.search.substring(1);

            if (!query) {
                return parametros;
            }

            var pares = query.split('&');

            for (var i = 0; i < pares.length; i++) {
                var par = pares[i].split('=');

                if (par.length === 2) {
                    parametros[decodeURIComponent(par[0])] =
                        decodeURIComponent(par[1]);
                }
            }

            return parametros;
        }

        function actualizarPagina() {
            var parametros = obtenerParametros();

            var pagina = parametros['page'];
            var total = parametros['topage'];

            if (pagina && total) {
                var elemento =
                    document.getElementById('pagina-documento');

                if (elemento) {
                    elemento.innerHTML =
                        pagina + ' de ' + total;
                }
            }
        }

        window.onload = function() {
            actualizarPagina();
        };
    </script>
</body>
</html>
