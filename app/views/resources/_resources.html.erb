<div class="container py-4">
  <div align="left"; class="container col-12">
      <a class="navbar-brand" href="/">
          <%= image_tag 'LogoConesst202305232.png',:width => "100",  :height=>"100" %>
      </a>
  </div>

  <% if @entity.present? %>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body text-center">
        <h2 class="fw-bold text-primary mb-0">
          <i class="bi bi-building"></i>
          <%= @entity.business_name %>
        </h2>
      </div>
    </div>
  <% end %>

  <% if @resources.present? %>
    <% if Current.user.level > 0 && Current.user.level < 3 %>
      <div class="mb-4">
        <%= link_to new_resource_path(entity_id: @entity.id), class: "btn btn-success" do %>
          <i class="bi bi-plus-circle"></i>
          <%= t('.create_resource') %>
        <% end %>
      </div>
    <% end %>
    <% @resources.each do |resource| %>
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
          <div class="row align-items-center">
            <div class="col-md-8">
              <h4 class="mb-0">
                <i class="bi bi-calendar3"></i>
                MATRIZ ASIGNACIÓN DE RECURSOS PARA EL SG-SST <%= resource.year %>
              </h4>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
              <div class="d-grid d-md-flex justify-content-md-end gap-2">
                <% if Current.user.level > 0 && Current.user.level < 4 %>
                  <%= link_to crear_item_resource_resources_path(resource.id), class: "btn btn-warning btn-sm" do %>
                    <i class="bi bi-plus-square"></i>
                    <%= t('common.create_item_resource') %>
                  <% end %>
                <% end %>
                <%= link_to resource_path(resource.id),
                    class: "btn btn-info btn-sm text-white" do %>
                  <i class="bi bi-eye"></i>
                  <%= t('common.show_resource') %>
                <% end %>
                <%= link_to ver_resource_resources_path(resource.id, format: :pdf),
                    class: "btn btn-danger btn-sm" do %>
                  <i class="bi bi-file-earmark-pdf"></i>
                  PDF
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <div class="card-body">
          <div class="row mb-4">
            <div class="col-md-4">
              <strong>Fecha de creación</strong><br>
              <span class="text-muted">
                <%= resource.created_at.strftime("%d/%m/%Y") %>
              </span>
            </div>
          </div>
          <hr>
          <h5 class="text-primary mb-3">
            <i class="bi bi-person-badge"></i>
            Representante Legal
          </h5>
          <div class="row gy-3">
            <div class="col-md-3">
              <strong><%= t('.user_legal_representative') %></strong><br>
              <%= resource.name_user(resource.user_legal_representative) %>
            </div>
            <div class="col-md-3">
              <strong><%= t('.firm_legal_representative') %></strong><br>
              <%= resource.label_firm(resource.firm_legal_representative) %>
            </div>
            <div class="col-md-3">
              <strong><%= t('.date_firm_legal_representative') %></strong><br>
              <%= resource.date_firm_legal_representative %>
            </div>
            <div class="col-md-3 d-flex align-items-end">
              <% if resource.firm_legal_representative.to_i == 0 %>
                <%= link_to firmar_rep_resources_path(resource.id,1),
                    class:"btn btn-outline-warning w-100" do %>
                  <i class="bi bi-pen"></i>
                  <%= t('common.firmar') %>
                <% end %>
              <% end %>
            </div>
          </div>
          <hr>
          <h5 class="text-success mb-3">
            <i class="bi bi-person-workspace"></i>
            Asesor SST
          </h5>
          <div class="row gy-3">
            <div class="col-md-3">
              <strong><%= t('.user_adviser_sst') %></strong><br>
              <%= resource.name_user(resource.user_adviser_sst) %>
            </div>
            <div class="col-md-3">
              <strong><%= t('.firm_adviser_sst') %></strong><br>
              <%= resource.label_firm(resource.firm_adviser_sst) %>
            </div>
            <div class="col-md-3">
              <strong><%= t('.date_firm_adviser_sst') %></strong><br>
              <%= resource.date_firm_adviser_sst %>
            </div>
            <div class="col-md-3 d-flex align-items-end">
              <% if resource.firm_adviser_sst.to_i == 0 %>
                <%= link_to firmar_adv_resources_path(resource.id,2),
                    class:"btn btn-outline-warning w-100" do %>
                  <i class="bi bi-pen"></i>
                  <%= t('common.firmar') %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="card shadow-sm">
      <div class="card-body text-center">
        <h5 class="text-secondary mb-4">
          No existen asignaciones de recursos registradas.
        </h5>
        <%= link_to new_resource_path(entity_id: @entity.id),
            class: "btn btn-success" do %>
          <i class="bi bi-plus-circle"></i>
          <%= t('.create_resource') %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>