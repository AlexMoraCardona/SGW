<div class="container-fluid py-3">
  <div align="left"; class="container col-12">
    <a class="navbar-brand" href="/">
        <%= image_tag 'LogoConesst202305232.png',:width => "100",  :height=>"100" %>
    </a>
  </div>
  <!-- ENCABEZADO -->
  <div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

      <div class="d-flex flex-column flex-md-row
                  justify-content-between
                  align-items-md-center
                  gap-3">

        <div>

          <div class="d-flex align-items-center">

            <i class="bi bi-ui-checks fs-3 me-2"></i>

            <h4 class="mb-0">
              Encuestas del programa SVE
            </h4>

          </div>

          <div class="text-muted mt-1">

            <strong>
              <%= @epidemiological_surveillance_program.code %>
            </strong>

            -
            <%= @epidemiological_surveillance_program.name %>

          </div>

        </div>

        <!-- NUEVA ENCUESTA -->
        <div>

          <%= link_to(
                new_epidemiological_surveillance_program_surveillance_survey_path(
                  @epidemiological_surveillance_program
                ),
                class: "btn btn-primary"
              ) do %>

            <i class="bi bi-plus-circle me-1"></i>
            Nueva encuesta

          <% end %>

        </div>

      </div>

    </div>

  </div>


  <!-- LISTADO DE ENCUESTAS -->

  <% if @surveillance_surveys.present? %>

    <div class="row g-3">

      <% @surveillance_surveys.each do |survey| %>

        <div class="col-12 col-md-6 col-xl-4">

          <div class="card h-100 shadow-sm border-0">

            <div class="card-body d-flex flex-column">

              <!-- TÍTULO -->

              <div class="d-flex justify-content-between
                          align-items-start gap-2 mb-3">

                <h5 class="card-title mb-0">

                  <i class="bi bi-ui-checks-grid me-1"></i>

                  <%= survey.name %>

                </h5>

                <% if survey.active? %>

                  <span class="badge bg-success">
                    Activa
                  </span>

                <% else %>

                  <span class="badge bg-secondary">
                    Inactiva
                  </span>

                <% end %>

              </div>


              <!-- DESCRIPCIÓN -->

              <% if survey.description.present? %>

                <p class="text-muted small mb-3">

                  <%= survey.description %>

                </p>

              <% else %>

                <p class="text-muted small mb-3">
                  Sin descripción registrada.
                </p>

              <% end %>


              <!-- INFORMACIÓN -->

              <div class="small mb-3">

                <div class="mb-1">

                  <i class="bi bi-tag me-1"></i>

                  <strong>Versión:</strong>

                  <%= survey.version %>

                </div>


                <div>

                  <i class="bi bi-list-check me-1"></i>

                  <strong>Preguntas:</strong>

                  <%= survey.surveillance_questions.count %>

                </div>

              </div>


              <!-- BOTONERA -->

              <div class="mt-auto">

                <div class="d-flex flex-wrap
                            justify-content-center
                            gap-2">

                  <!-- VER -->

                  <%= link_to(
                        epidemiological_surveillance_program_surveillance_survey_path(
                          @epidemiological_surveillance_program,
                          survey
                        ),
                        class: "btn btn-outline-primary btn-sm",
                        title: "Ver encuesta"
                      ) do %>

                    <i class="bi bi-eye"></i>
                    Ver

                  <% end %>


                  <!-- EDITAR -->

                  <%= link_to(
                        edit_epidemiological_surveillance_program_surveillance_survey_path(
                          @epidemiological_surveillance_program,
                          survey
                        ),
                        class: "btn btn-outline-secondary btn-sm",
                        title: "Editar encuesta"
                      ) do %>

                    <i class="bi bi-pencil"></i>
                    Editar

                  <% end %>


                  <!-- PREGUNTAS -->

<%= link_to(
      epidemiological_surveillance_program_surveillance_survey_surveillance_questions_path(
        @epidemiological_surveillance_program,
        survey
      ),
      class: "btn btn-outline-success btn-sm",
      title: "Administrar preguntas"
    ) do %>

  <i class="bi bi-list-check"></i>
  Preguntas

<% end %>

                  <!-- ELIMINAR -->

                  <%= button_to(
                        epidemiological_surveillance_program_surveillance_survey_path(
                          @epidemiological_surveillance_program,
                          survey
                        ),
                        method: :delete,
                        class: "btn btn-outline-danger btn-sm",
                        form: {
                          data: {
                            turbo_confirm: "¿Está seguro de eliminar esta encuesta?"
                          }
                        },
                        title: "Eliminar encuesta"
                      ) do %>

                    <i class="bi bi-trash"></i>
                    Eliminar

                  <% end %>

                </div>

              </div>

            </div>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <!-- SIN ENCUESTAS -->

    <div class="card shadow-sm border-0">

      <div class="card-body text-center py-5">

        <i class="bi bi-ui-checks display-4 text-muted"></i>

        <h5 class="mt-3">
          No hay encuestas registradas
        </h5>

        <p class="text-muted">
          Este programa todavía no tiene encuestas configuradas.
        </p>

        <%= link_to(
              new_epidemiological_surveillance_program_surveillance_survey_path(
                @epidemiological_surveillance_program
              ),
              class: "btn btn-primary"
            ) do %>

          <i class="bi bi-plus-circle me-1"></i>
          Crear primera encuesta

        <% end %>

      </div>

    </div>

  <% end %>


  <!-- VOLVER -->

  <div class="d-flex justify-content-center mt-4">

    <%= link_to(
          epidemiological_surveillance_program_path(
            @epidemiological_surveillance_program
          ),
          class: "btn btn-outline-primary"
        ) do %>

      <i class="bi bi-arrow-left me-1"></i>
      Volver al programa

    <% end %>

  </div>

</div>