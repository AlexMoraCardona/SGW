<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-person-check fs-4"></i>
          <div>
            <h2 class="conesst-card-header-title mb-0">
              Participantes Aprobados
            </h2>
            <div class="conesst-card-header-subtitle">
              Consulta de participantes que aprobaron la evaluación
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <% aprobados = @dets.select { |det| det.resul == "Aprobado" } %>
      <% if aprobados.present? %>
        <div class="conesst-table-wrapper d-none d-md-block">
          <table class="conesst-table table-hover">
            <thead>
              <tr>
                <th>Evaluación nro.</th>
                <th>Fecha</th>
                <th>Participante</th>
                <th>Respuestas correctas</th>
                <th>Respuestas incorrectas</th>
                <th>Porcentaje</th>
                <th>Intentos realizados</th>
              </tr>
            </thead>
            <tbody>
              <% aprobados.each do |det| %>
                <tr>
                  <td>
                    <span class="fw-semibold">
                      <%= det.id %>
                    </span>
                  </td>
                  <td>
                    <%= det.created_at.strftime("%Y-%m-%d %I:%M %p") %>
                  </td>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <i class="bi bi-person-circle"></i>
                      <span>
                        <%= det.user.name %>
                      </span>
                    </div>
                  </td>
                  <td>
                    <span class="badge text-bg-success">
                      <%= det.total_good %>
                    </span>
                  </td>
                  <td>
                    <span class="badge text-bg-danger">
                      <%= det.total_bad %>
                    </span>
                  </td>
                  <td>
                    <span class="badge text-bg-primary">
                      <%= det.final_percentage %>
                    </span>
                  </td>
                  <td>
                    <span class="fw-semibold">
                      <%= Exam.intentos(det.user_id, det.allow_exam_id) %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="d-md-none">
          <% aprobados.each do |det| %>
            <div class="conesst-card mb-3">
              <div class="conesst-card-header">
                <div class="d-flex justify-content-between align-items-center gap-2">
                  <div>
                    <div class="small text-muted">
                      Evaluación nro.
                    </div>
                    <div class="fw-semibold">
                      <%= det.id %>
                    </div>
                  </div>
                  <span class="badge text-bg-success">
                    Aprobado
                  </span>
                </div>
              </div>
              <div class="conesst-card-body">
                <div class="mb-3">
                  <div class="small text-muted">
                    <i class="bi bi-calendar3 me-1"></i>
                    Fecha
                  </div>
                  <div class="fw-semibold">
                    <%= det.created_at.strftime("%Y-%m-%d %I:%M %p") %>
                  </div>
                </div>
                <div class="mb-3">
                  <div class="small text-muted">
                    <i class="bi bi-person me-1"></i>
                    Participante
                  </div>
                  <div class="fw-semibold">
                    <%= det.user.name %>
                  </div>
                </div>
                <div class="row g-3">
                  <div class="col-6">
                    <div class="small text-muted">
                      Correctas
                    </div>
                    <span class="badge text-bg-success mt-1">
                      <%= det.total_good %>
                    </span>
                  </div>
                  <div class="col-6">
                    <div class="small text-muted">
                      Incorrectas
                    </div>
                    <span class="badge text-bg-danger mt-1">
                      <%= det.total_bad %>
                    </span>
                  </div>
                  <div class="col-6">
                    <div class="small text-muted">
                      Porcentaje
                    </div>
                    <span class="badge text-bg-primary mt-1">
                      <%= det.final_percentage %>
                    </span>
                  </div>
                  <div class="col-6">
                    <div class="small text-muted">
                      Intentos
                    </div>
                    <div class="fw-semibold mt-1">
                      <%= Exam.intentos(det.user_id, det.allow_exam_id) %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-person-x fs-1 text-muted"></i>
          <h5 class="mt-3">
            No hay participantes aprobados
          </h5>
          <p class="text-muted mb-0">
            No se encontraron participantes que hayan aprobado esta evaluación.
          </p>
        </div>
      <% end %>
      <div class="conesst-actions mt-4">
        <%= link_to :back, class: "conesst-btn conesst-btn-primary" do %>
          <i class="bi bi-arrow-left me-1"></i>
          Retornar
        <% end %>
      </div>
    </div>
  </div>
</div>