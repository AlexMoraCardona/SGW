<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-pen fs-5"></i>
        <div>
          <h5 class="mb-0">Firmas de los asistentes</h5>
          <small class="text-muted">
            Firmas y datos de los participantes del acta
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <div class="row g-4">
        <% @assistants.each do |firm| %>
          <div class="col-12 col-md-6 col-lg-4">
            <div class="border rounded p-3 h-100 text-center">
              <div class="mb-3">
                <% if firm.firm_assistant == 1 && firm.user.firm.attached? && firm.user.firm.image? %>
                  <div class="d-flex justify-content-center align-items-end" style="height: 70px;">
                    <%= image_tag firm.user.firm, class: "firma", alt: "Firma de #{firm.user.name}" %>
                  </div>
                <% else %>
                  <div style="height: 70px;"></div>
                <% end %>
                <div class="mt-1">
                  ______________________
                </div>
              </div>
              <div class="fw-semibold">
                <%= firm.user.name %>
              </div>
              <div class="small text-muted mt-1">
                <%= firm.post %>
              </div>
              <div class="small text-muted mt-1">
                <%= firm.user.document.abbreviation %>:
                <%= Firm.miles(firm.user.nro_document) %>
              </div>
              <% if firm.user.level == 2 %>
                <div class="small text-muted mt-1">
                  Licencia: <%= firm.user.license %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>