<div class="container-fluid px-2 px-md-4 py-3">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light border-bottom">
            <div class="d-flex align-items-center">
                <i class="bi bi-bullseye me-2 fs-5"></i>
                <h5 class="mb-0">
                      Objetivo y Meta
                </h5>   
            </div>
        </div>
        <div class="card-body">
            <%= form_with model: @matrix_goal_item do |form| %>
                <% if @matrix_goal_item.errors.any? %>
                    <div class="alert alert-danger" role="alert">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                            <div>
                                <strong>
                                    Se encontraron los siguientes errores:
                                </strong>
                                <ul class="mb-0 mt-2">
                                    <% @matrix_goal_item.errors.full_messages.each do |error| %>
                                        <li>
                                            <%= error %>
                                        </li>
                                    <% end %>
                                </ul>
                            </div>
                        </div>
                    </div>
                <% end %>
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-8">
                        <%= form.label :indicator_id, "Seleccionar Indicador", class: "form-label fw-semibold" %>
                        <%= form.collection_select :indicator_id, Indicator.all.order(id: :asc), :id, :name, { prompt: "-- Seleccionar Indicador --" }, { class: "form-select" } %>
                    </div>
                    <div class="col-12 col-md-4">
                        <%= form.label :meta, "Meta (%)",  class: "form-label fw-semibold" %>
                        <%= form.number_field :meta, in: 0.00..100.0,  step: 0.01,  class: "form-control",  placeholder: "Ejemplo: 95.00" %>
                        <div class="form-text">
                            Valor entre 0 y 100.
                        </div>
                    </div>
                </div>
                <div class="mb-4">
                    <%= form.label :objetives, "Objetivo", class: "form-label fw-semibold" %>
                    <%= form.text_area :objetives, class: "form-control", rows: 4, placeholder: "Ingrese el objetivo..." %>
                </div>
                <%= form.hidden_field :matrix_goal_id, value: params[:id].to_i %>
                <hr class="my-4">
                <div class="border-top pt-3 mt-4">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i>
                            <%= t('common.submit') %>
                        </button>
                        <%= link_to matrix_goals_path(entity_id: Current.user.entity), class:"btn btn-secondary" do %>
                            <i class="bi bi-arrow-left-circle"></i>
                            Retornar
                        <% end %>
                    </div>
                </div>
            <% end %>
        </div>
    </div>
    <!-- ========================================================= -->
    <!-- LISTADO DE OBJETIVOS Y METAS -->
    <!-- ========================================================= -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light border-bottom">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <h5 class="mb-0">
                    <i class="bi bi-list-check me-2"></i>
                    Objetivos y Metas
                </h5>
                <% if @matrix_goal_items.present? %>
                    <span class="badge bg-secondary align-self-start align-self-md-center">
                        <%= @matrix_goal_items.size %> registros
                    </span>
                <% end %>
            </div>
        </div>
        <div class="card-body p-2 p-md-3">
            <% if @matrix_goal_items.present? %>
                <div class="table-responsive">
                    <table class="table table-hover table-bordered  align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="text-center text-nowrap">
                                      OBJETIVO
                                </th>
                                <th scope="col"  class="text-center text-nowrap">
                                      META
                                </th>
                                <th scope="col"  class="text-center text-nowrap">
                                    INDICADOR
                                </th>
                                <th scope="col"  class="text-center text-nowrap">
                                    <i class="bi bi-pencil-square"></i>
                                    Editar
                                </th>
                                <th scope="col" class="text-center text-nowrap">
                                    <i class="bi bi-trash"></i>
                                    Eliminar
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <% @matrix_goal_items.each do |matrix_goal_item| %>
                                <tr>
                                    <td>
                                        <%= matrix_goal_item.objetives %>
                                    </td>
                                    <td class="text-center text-nowrap">
                                        <span class="badge bg-primary">
                                            <%= matrix_goal_item.meta %> %
                                        </span>
                                    </td>
                                    <td>
                                        <% if matrix_goal_item.indicator_id.to_i > 0 &&  matrix_goal_item.indicator.present? %>
                                            <%= matrix_goal_item.indicator.name %>
                                        <% else %>
                                            <span class="text-muted">
                                                Sin indicador
                                            </span>
                                        <% end %>
                                    </td>
                                    <td class="text-center">
                                        <%= link_to edit_matrix_goal_item_path(matrix_goal_item), class: "btn btn-sm btn-warning", title: t('common.edit'), data: { bs_toggle: "tooltip" } do %>
                                            <i class="bi bi-pencil-square"></i>
                                            <span class="d-none d-lg-inline ms-1">
                                                <%= t('common.edit') %>
                                            </span>
                                        <% end %>
                                    </td>
                                    <td class="text-center">
                                        <%= button_to matrix_goal_item, method: :delete, class: "btn btn-sm btn-danger", title: "Eliminar", data: {bs_toggle: "tooltip", turbo_confirm: "¿Está seguro de eliminar este objetivo y meta?"} do %>
                                            <i class="bi bi-trash"></i>
                                            <span class="d-none d-lg-inline ms-1">
                                                Eliminar
                                            </span>
                                        <% end %>
                                    </td>
                                </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>
            <% else %>
                <div class="text-center py-5">
                    <i class="bi bi-info-circle fs-1 text-muted"></i>
                    <h6 class="mt-3 text-muted">
                        No hay objetivos y metas registrados.
                    </h6>
                </div>
            <% end %>
        </div>
    </div>
</div>
