<div class="conesst-card mb-3">
  <div class="conesst-card-body">
    <div class="mb-2">
      <strong>
        <i class="bi bi-card-text me-1"></i>
        Identificación
      </strong>
      <div>
        <%= entity.identification_number %>
      </div>
    </div>
    <div class="mb-2">
      <strong>
        <i class="bi bi-building me-1"></i>
        Empresa
      </strong>
      <div>
        <%= highlight entity.business_name, params.dig(:q, :business_name_cont) %>
      </div>
    </div>
    <div class="mb-2">
      <strong>Nombre</strong>
      <div>
        <%= entity.first_name %>
        <%= entity.second_name %>
      </div>
    </div>
    <div class="mb-2">
      <strong>Apellidos</strong>
      <div>
        <%= entity.surname %>
        <%= entity.second_surname %>
      </div>
    </div>
    <div class="conesst-actions mt-3">
      <%= link_to edit_entity_path(entity), class: "conesst-btn conesst-btn-primary" do %>
        <i class="bi bi-pencil-square me-1"></i>
        <%= t('common.edit') %>
      <% end %>
    </div>
  </div>
</div>