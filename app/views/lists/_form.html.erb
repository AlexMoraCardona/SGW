<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div>
          <div class="conesst-card-header-title">
            <i class="bi bi-clipboard-check me-2"></i>
            Lista de chequeo
          </div>
          <div class="conesst-card-header-subtitle">
            Seleccione la lista de chequeo que desea aplicar
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @list do |form| %>
        <% @list.errors.full_messages.each do |error| %>
          <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <%= error %>
          </div>
        <% end %>
        <div class="mb-3">
          <%= form.label :check_list_id, "Lista de chequeo", class: "form-label fw-semibold" %>
          <%= form.collection_select :check_list_id, @check_lists.order(id: :asc), :id, :name, { prompt: "-- Seleccionar Lista --" }, { class: "form-select select2" } %>
        </div>
        <%= form.hidden_field :entity_id, value: Current.user.entity.to_i %>
        <div class="conesst-actions mt-4">
          <%= form.button type: "submit", class: "conesst-btn conesst-btn-primary" do %>
            <i class="bi bi-check-circle me-1"></i>
            <%= t('common.submit') %>
          <% end %>
          <%= link_to check_lists_path, class: "conesst-btn conesst-btn-primary" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>