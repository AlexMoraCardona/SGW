<div class="container col-11 card p-5">
    <br>
    <%= form_with model: @matrix_danger_risk do |form| %>
        <% @matrix_danger_risk.errors.full_messages.each do |error| %>
            <div class="alert alert-danger" role="alert">
                <%= error%> <%= alert %>
            </div>
        <% end %>

        <table>
            <tr>
                <td>
                    <h4>Asesor SST</h4> 
                    <%= MatrixDangerRisk.name_user(@matrix_danger_risk.user_adviser_sst) %>
                </td>
            </tr>
            <tr>
                <td>
                    <h4>Firma autorizada del Asesor SST</h4> 
                    <%= form.radio_button :firm_adviser_sst, 0 %>
                    <label for="no">No</label>&nbsp;&nbsp; 
                    <%= form.radio_button :firm_adviser_sst, 1 %>
                    <label for="si">Si</label>&nbsp;&nbsp;   
                </td>
            </tr>
        </table>
        <%= form.hidden_field :date_firm_adviser_sst, :value => Time.now, class: "form-control" %>
        <br>    
        <div class="d-grid gap-2 d-md-flex">
            <%= form.button type: :submit, class: "btn btn-success" do %>
              <i class="bi bi-check-circle"></i>
            Guardar
            <% end %>

            <%= link_to :back, class: "btn btn-secondary" do %>
            <i class="bi bi-arrow-left-circle"></i>
            Retornar
            <% end %>
        </div>

    <% end %>
</div>        
<br>
