<div class="container-fluid px-2 px-md-4 py-3">
    <div class="card shadow-sm mx-auto" style="max-width: 900px;">
        <div class="card-header bg-light border-bottom">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-check fs-4 text-primary"></i>
                <h5 class="mb-0">Responsables de la Matriz</h5>
            </div>
        </div>
        <div class="card-body p-3 p-md-4">
            <%= form_with model: @matrix_protection do |form| %>
                <!-- Errores -->
                <% if @matrix_protection.errors.any? %>
                    <div class="alert alert-danger" role="alert">
                        <div class="fw-bold mb-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            Se encontraron los siguientes errores:
                        </div>
                        <ul class="mb-0 ps-3">
                            <% @matrix_protection.errors.full_messages.each do |error| %>
                                <li><%= error %></li>
                            <% end %>
                        </ul>
                    </div>
                <% end %>
                <!-- Representante Legal -->
                <div class="mb-4">
                    <label class="form-label fw-semibold d-flex align-items-center gap-2">
                        <h5 class="text-primary mb-3">
                            <i class="bi bi-person-badge"></i>
                            Representante Legal
                            <span data-bs-toggle="tooltip" title="Seleccione el nombre del Representante Legal." class="text-secondary" style="cursor: help;">
                                <i class="bi bi-question-circle"></i>
                            </span>
                        </h5>
                    </label>
                    <%= form.collection_select(:user_legal_representative, User.usuarios_empresa.order(id: :asc), :id, :name, {}, { class: "form-select" }) %>
                </div>
                <!-- Asesor SST -->
                <div class="mb-4">
                    <label class="form-label fw-semibold d-flex align-items-center gap-2">
                        <h5 class="text-success mb-3">
                            <i class="bi bi-person-workspace"></i>
                            Asesor SST
                            <span data-bs-toggle="tooltip" title="Seleccione el nombre del Asesor SST." class="text-secondary" style="cursor: help;">
                              <i class="bi bi-question-circle"></i>
                            </span>
                        </h5>
                    </label>
                    <%= form.collection_select(:user_adviser_sst, User.usuarios_empresa.order(id: :asc), :id, :name, {}, { class: "form-select" }) %>
                </div>
                <!-- Responsable SST -->
                <div class="mb-4">
                    <label class="form-label fw-semibold d-flex align-items-center gap-2">
                        <h5 class="text-danger mb-3">
                            <i class="bi bi-person-check"></i>
                            Responsable SST
                            <span data-bs-toggle="tooltip" title="Seleccione el nombre del Responsable SST." class="text-secondary" style="cursor: help;">
                              <i class="bi bi-question-circle"></i>
                            </span>
                        </h5>
                    </label>
                    <%= form.collection_select(:user_responsible_sst, User.usuarios_empresa.order(id: :asc), :id, :name, {}, { class: "form-select" }) %>
                </div>
                <!-- Campos ocultos -->
                <%= form.hidden_field :entity_id, value: params[:entity_id].to_i %>
                <%= form.hidden_field :code, value: @template.reference if @template.present? %>
                <%= form.hidden_field :version, value: @template.version.to_i if @template.present? %>
                <%= form.hidden_field :date_create, value: @template.date if @template.present? %>
                <%= form.hidden_field :date_update, value: @template.date_updated if @template.present? %>
                <!-- Botonera -->
                <div class="border-top pt-3 mt-4">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i>
                            <%= t('common.submit') %>
                        </button>
                        <%= link_to matrix_protections_path(entity_id: Current.user.entity), class:"btn btn-secondary" do %>
                            <i class="bi bi-arrow-left-circle"></i>
                            Retornar
                        <% end %>
                    </div>
                </div>
            <% end %>
        </div>
    </div>
</div>

