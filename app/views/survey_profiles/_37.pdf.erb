            },

            {
                number: 22,
                title: "USO DEL TIEMPO LIBRE",
                data: @datos_tiempo,
                count: @cant_tiempo,
                label: :labeltiempo,
                filename: "Uso Tiempo Libre"
            },

            {
                number: 23,
                title: "LE HAN DIAGNOSTICADO ALGUNA ENFERMEDAD",
                data: @datos_enfermedad,
                count: @cant_enfermedad,
                label: :labelenfermedad,
                filename: "Diagnosticado Enfermedad"
            },

            {
                number: 24,
                title: "FUMA",
                data: @datos_fuma,
                count: @cant_fuma,
                label: :labelfuma,
                filename: "Fuma"
            },

            {
                number: 25,
                title: "CUAL CIGARRILLO",
                data: @datos_cual_fuma,
                count: @cant_cual_fuma,
                label: :labelcualcigarrillo,
                filename: "Cual Cigarrillo"
            },

            {
                number: 26,
                title: "CONSUME BEBIDAS ALCOHÓLICAS",
                data: @datos_bebida,
                count: @cant_bebida,
                label: :labelbebida,
                filename: "Bebidas"
            },

            {
                number: 27,
                title: "PRACTICA ALGÚN DEPORTE",
                data: @datos_deporte,
                count: @cant_deporte,
                label: :labeldeporte,
                filename: "Deporte"
            },

            {
                number: 28,
                title: "TIPO DE SANGRE",
                data: @datos_sangre,
                count: @cant_sangre,
                label: :labelsangre,
                filename: "Tipo Sangre"
            },

            {
                number: 29,
                title: "ÁREA DE TRABAJO",
                data: @datos_area,
                count: @cant_area,
                label: :labelarea,
                filename: "Area"
            },

            {
                number: 30,
                title: "MEDIO DE TRANSPORTE",
                data: @datos_transporte,
                count: @cant_transporte,
                label: :labelmediotransporte,
                filename: "Medio de Transporte"
            }

        ]
    %>


    <!-- =====================================================
         VARIABLES
         ===================================================== -->

    <% variables_sociodemograficas.each do |variable| %>

        <% if variable[:data].present? %>

            <div class="pdf-variable">

                <div class="pdf-variable-title">
                    <%= variable[:number] %>.
                    <%= variable[:title] %>
                </div>


                <%
                    datos_grafico = []

                    variable[:data].each do |dato|

                        etiqueta = Profile.public_send(
                            variable[:label],
                            dato[0]
                        )

                        if variable[:count].to_i > 0

                            porcentaje =
                                ((dato[1] * 100.0) /
                                variable[:count]).round(2)

                            datos_grafico << [
                                etiqueta,
                                porcentaje
                            ]

                        end

                    end
                %>


                <table class="pdf-variable-layout">

                    <tr>

                        <!-- ==============================
                             TABLA
                             ============================== -->

                        <td class="pdf-variable-table-cell">

                            <table class="pdf-data-table">

                                <thead>

                                    <tr>
                                        <th colspan="2">
                                            <%= variable[:title] %>
                                        </th>
                                    </tr>

                                </thead>

                                <tbody>

                                    <% variable[:data].each do |dato| %>

                                        <tr>

                                            <td>
                                                <%= Profile.public_send(
                                                    variable[:label],
                                                    dato[0]
                                                ) %>
                                            </td>

                                            <td class="pdf-data-number">
                                                <%= dato[1] %>
                                            </td>

                                        </tr>

                                    <% end %>

                                    <tr class="pdf-total-row">

                                        <td>
                                            Total
                                        </td>

                                        <td class="pdf-data-number">
                                            <%= variable[:count] %>
                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </td>


                        <!-- ==============================
                             GRÁFICO
                             ============================== -->

                        <td class="pdf-variable-chart-cell">

                            <div class="pdf-chart">

                                <%= pie_chart datos_grafico,
                                    title: variable[:title],
                                    download: {
                                        filename: variable[:filename],
                                        background: "#FFFFFF"
                                    },
                                    height: "270px",
                                    width: "100%",
                                    xtitle: "Tipo de acción",
                                    ytitle: "Cantidad",
                                    prefix: "Cantidad: ",
                                    suffix: "%" %>

                            </div>

                        </td>

                    </tr>

                </table>

            </div>

        <% end %>

    <% end %>



<!-- =========================================================
     FIRMAS
     ========================================================= -->

<div class="pdf-signatures">

  <table class="pdf-signatures-table">
    <tr>

      <!-- ===================================================
           ELABORÓ
           =================================================== -->
      <td class="pdf-signature-cell">

        <div class="pdf-signature">

          <div class="pdf-signature-label">
            Elaboró:
          </div>

          <div class="pdf-signature-space"></div>

          <% if @survey_profile.firm_elaboro == 1 %>

            <% if @user_elaboro.firm.attached? %>

              <% if @user_elaboro.firm.image? %>

                <%= image_tag(
                      Evaluation.wicked_blob_path(@user_elaboro.firm),
                      class: "pdf-signature-image"
                    ) %>

                <div class="pdf-signature-line">
                  ______________________________________
                </div>

              <% else %>

                <div class="pdf-signature-line">
                  ______________________________________
                </div>

              <% end %>

            <% else %>

              <div class="pdf-signature-line">
                ______________________________________
              </div>

            <% end %>

          <% else %>

            <div class="pdf-signature-line">
              ______________________________________
            </div>

          <% end %>


          <div class="pdf-signature-name">
            <strong>
              <%= @user_elaboro.name %>
            </strong>
          </div>

          <div class="pdf-signature-role">
            Asesor SG-SST
          </div>

          <div class="pdf-signature-document">
            <%= @user_elaboro.document.abbreviation %>:
            <%= Firm.miles(@user_elaboro.nro_document) %>
          </div>

        </div>

      </td>


      <!-- ===================================================
           APROBÓ
           =================================================== -->
      <td class="pdf-signature-cell">

        <div class="pdf-signature">

          <div class="pdf-signature-label">
            Aprobó:
          </div>

          <div class="pdf-signature-space"></div>

          <% if @survey_profile.firm_aprobo == 1 %>

            <% if @user_aprobo.firm.attached? %>

              <% if @user_aprobo.firm.image? %>

                <%= image_tag(
                      Evaluation.wicked_blob_path(@user_aprobo.firm),
                      class: "pdf-signature-image"
                    ) %>

                <div class="pdf-signature-line">
                  ______________________________________
                </div>

              <% else %>

                <div class="pdf-signature-line">
                  ______________________________________
                </div>

              <% end %>

            <% else %>

              <div class="pdf-signature-line">
                ______________________________________
              </div>

            <% end %>

          <% else %>

            <div class="pdf-signature-line">
              ______________________________________
            </div>

          <% end %>


          <div class="pdf-signature-name">
            <strong>
              <%= @user_aprobo.name %>
            </strong>
          </div>

          <div class="pdf-signature-role">
            Representante Legal
          </div>

          <div class="pdf-signature-document">
            <%= @user_aprobo.document.abbreviation %>:
            <%= Firm.miles(@user_aprobo.nro_document) %>
          </div>

        </div>

      </td>

    </tr>
  </table>

</div>


</div>

