<div class="conesst-page audit-report-page">
    <div class="conesst-card audit-report-card">
        <div class="conesst-card-body p-0">
            <div class="audit-report-info">
                <div class="audit-report-info-item">
                    <div class="audit-report-info-title">
                        <i class="bi bi-bullseye"></i>
                        OBJETIVO DE LA AUDITORÍA
                    </div>
                    <div class="audit-report-info-text">
                        Verificar el cumplimiento de la Resolución 0312 de 2019
                    </div>
                </div>
                <div class="audit-report-info-item">
                    <div class="audit-report-info-title">
                        <i class="bi bi-arrows-fullscreen"></i>
                        ALCANCE DE LA AUDITORÍA
                    </div>
                    <div class="audit-report-info-text">
                        Evaluar la planificación, desarrollo y aplicación del Sistema
                        de Gestión de la Seguridad y Salud en el Trabajo (SG-SST);
                    </div>
                </div>
                <div class="audit-report-info-item">
                    <div class="audit-report-info-title">
                        <i class="bi bi-journal-check"></i>
                        CRITERIOS DE LA AUDITORÍA
                    </div>
                    <ul class="audit-report-criteria">
                        <li>Decreto 1072 de 2015</li>
                        <li>Resolución 0312 de 2019</li>
                        <li>Plan de Trabajo anual</li>
                        <li>Plan de Capacitación</li>
                        <li>Matriz de Peligros y riesgos</li>
                        <li>Plan de preparación y atención de emergencias</li>
                    </ul>
                </div>
                <div class="audit-report-info-item">
                    <div class="audit-report-info-title">
                        <i class="bi bi-people"></i>
                        EQUIPO AUDITOR
                    </div>
                    <div class="audit-report-info-text">
                        <%= @user_audit.name if @user_audit.present? %>
                    </div>
                </div>
                <div class="audit-report-info-item">
                    <div class="audit-report-info-title">
                        <i class="bi bi-calendar3"></i>
                        FECHA DE AUDITORÍA
                    </div>
                    <div class="audit-report-info-text">
                        <%= @audit_report.date_audit if @audit_report.present? %>
                    </div>
                </div>
            </div>
            <div class="audit-report-section-title">
                <i class="bi bi-clipboard2-check"></i>
                RESULTADOS DE AUDITORÍA
            </div>
            <div class="conesst-table-wrapper audit-report-table-wrapper">
                <table class="conesst-table audit-report-results-table">
                    <thead>
                        <tr>
                            <th>PROCESO</th>
                            <th>TIPO DE HALLAZGO</th>
                            <th>TIPO DE ACCIÓN</th>
                            <th>HALLAZGO</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if @audit_report_items.present? %>
                            <% @audit_report_items.each do |audit_report_item| %>
                                <tr>
                                    <td data-label="Proceso">
                                        <%= audit_report_item.process %>
                                    </td>
                                    <td data-label="Tipo de hallazgo">
                                        <%= AuditReportItem.label_type_finding(audit_report_item.type_finding) %>
                                    </td>
                                    <td data-label="Tipo de acción">
                                        <%= AuditReportItem.label_type_action(audit_report_item.type_action) %>
                                    </td>
                                    <td data-label="Hallazgo">
                                        <%= audit_report_item.finding %>
                                    </td>
                                </tr>
                            <% end %>
                        <% else %>
                            <tr>
                                <td colspan="4" class="audit-report-empty">
                                    <i class="bi bi-info-circle"></i>
                                    No se han registrado hallazgos para esta auditoría.
                                </td>
                            </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>
            <div class="audit-report-text-section">
                <div class="audit-report-text-title">
                    <i class="bi bi-check2-circle"></i>
                    CONCLUSIONES
                </div>
                <div class="audit-report-text-content">
                    <%= @audit_report.conclusions %>
                </div>
            </div>
            <div class="audit-report-text-section">
                <div class="audit-report-text-title">
                    <i class="bi bi-lightbulb"></i>
                    OBSERVACIONES GENERALES Y OPORTUNIDADES DE MEJORA
                </div>
                <div class="audit-report-text-content">
                    <%= @audit_report.observations %>
                </div>
            </div>
            <div class="audit-report-attachments">
                <div class="audit-report-text-title">
                    <i class="bi bi-paperclip"></i>
                    ARCHIVOS ADJUNTOS
                </div>
                <div class="audit-report-attachments-body">
                    <% if @audit_report_items.present? %>
                        <% @audit_report_items.each do |audit_report_item| %>
                            <% if audit_report_item.finding_evidences.attached? %>
                                <div class="audit-report-evidence-group" data-controller="previews">
                                    <div class="audit-report-evidence-title">
                                        <i class="bi bi-file-earmark-text"></i>
                                        <%= audit_report_item.finding %>
                                    </div>
                                    <% audit_report_item.finding_evidences.each do |file| %>
                                        <div class="audit-report-file">
                                            <% if file.image? %>
                                                <div class="audit-report-image-container">
                                                    <%= image_tag file, data: {previews_target: "preview"}, class: "audit-report-image", alt: file.filename.to_s %>
                                                </div>
                                            <% elsif file.video? %>
                                                <div class="audit-report-media">
                                                    <%= video_tag url_for(file), controls: true, class: "audit-report-video" %>
                                                </div>
                                            <% elsif file.audio? %>
                                                <div class="audit-report-media">
                                                    <%= audio_tag url_for(file), controls: true, class: "audit-report-audio" %>
                                                </div>
                                            <% else %>
                                                <%= link_to url_for(file), class: "audit-report-file-link", target: "_blank", rel: "noopener" do %>
                                                    <i class="bi bi-file-earmark-arrow-down"></i>
                                                    <span><%= file.filename %></span>
                                                <% end %>
                                            <% end %>
                                        </div>
                                    <% end %>
                                </div>
                            <% end %>
                        <% end %>
                    <% else %>
                        <div class="audit-report-no-files">
                            <i class="bi bi-paperclip"></i>
                            No hay archivos adjuntos.
                        </div>
                    <% end %>
                </div>
            </div>
            <div class="audit-report-signatures">
                <% if @user_audit.present? %>
                    <div class="audit-report-signature">
                        <div class="audit-report-signature-title">
                            Firma del auditor líder
                        </div>
                        <div class="audit-report-signature-space">
                            <% if @audit_report.firm_audit == 1 && @user_audit.firm.attached? && @user_audit.firm.image? %>
                                <%= image_tag @user_audit.firm, class: "audit-report-signature-image", alt: "Firma del auditor" %>
                            <% end %>
                            <div class="audit-report-signature-line"></div>
                        </div>
                        <div class="audit-report-signature-name">
                            <%= @user_audit.name %>
                        </div>
                        <div class="audit-report-signature-data">
                            <%= CompanyPosition.name_cargo(@user_audit.activity) %>
                        </div>
                        <div class="audit-report-signature-data">
                            <%= @user_audit.document.abbreviation %>:
                            <%= Firm.miles(@user_audit.nro_document) %>
                        </div>
                        <div class="audit-report-signature-date">
                            Fecha firma:
                            <%= @audit_report.date_firm_audit if @audit_report.date_firm_audit %>
                        </div>
                    </div>
                <% end %>
                <% if @user_representante.present? %>
                    <div class="audit-report-signature">
                        <div class="audit-report-signature-title">
                            Firma del Representante Legal
                        </div>
                        <div class="audit-report-signature-space">
                            <% if @audit_report.firm_representante == 1 && @user_representante.firm.attached? && @user_representante.firm.image? %>
                                <%= image_tag @user_representante.firm, class: "audit-report-signature-image", alt: "Firma del representante legal" %>
                            <% end %>
                            <div class="audit-report-signature-line"></div>
                        </div>
                        <div class="audit-report-signature-name">
                            <%= @user_representante.name %>
                        </div>
                        <div class="audit-report-signature-data">
                            <%= CompanyPosition.name_cargo(@user_representante.activity) %>
                        </div>
                        <div class="audit-report-signature-data">
                            <%= @user_representante.document.abbreviation %>:
                            <%= Firm.miles(@user_representante.nro_document) %>
                        </div>
                        <div class="audit-report-signature-date">
                            Fecha firma:
                            <%= @audit_report.date_firm_representante if @audit_report.date_firm_representante %>
                        </div>
                    </div>
                <% end %>
            </div>
        </div>
    </div>
</div>
