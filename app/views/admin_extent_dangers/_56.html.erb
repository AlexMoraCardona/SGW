<div class="container-fluid px-2 px-md-4 py-3">
  <% if @form_preventions.present? %>
    <!-- ======================================================= -->
    <!-- TÍTULO -->
    <!-- ======================================================= -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
      <div>
        <h2 class="h6 fw-semibold mb-1">
          <i class="bi bi-shield-check me-1 text-primary"></i>
          Medidas de prevención y control
        </h2>
        <p class="text-muted small mb-0">
          Identificación de peligros, efectos y medidas de intervención
        </p>
      </div>
      <span class="badge rounded-pill text-bg-light border">
        <%= @form_preventions.size %>
        <%= @form_preventions.size == 1 ? "registro" : "registros" %>
      </span>
    </div>
    <!-- ======================================================= -->
    <!-- VISTA PC / TABLET -->
    <!-- ======================================================= -->
    <div class="d-none d-lg-block">
      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="text-center">
                  No.
                </th>
                <th>
                  Tipo de peligro
                </th>
                <th>
                  Descripción del peligro
                </th>
                <th>
                  Efectos en la salud
                </th>
                <th>
                  Medidas de intervención
                </th>
                <th class="text-center">
                  Expuesto
                </th>
                <% if Current.user.level > 0 && Current.user.level < 3 %>
                  <th class="text-center">
                    Acción
                  </th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% @form_preventions.each_with_index do |form_prevention, index| %>
                <tr>
                  <td class="text-center fw-semibold">
                    <%= index + 1 %>
                  </td>
                  <td>
                    <span class="fw-semibold">
                      <%= form_prevention.clasification_danger_detail.clasification_danger.name %>
                    </span>
                  </td>
                  <td class="text-break">
                    <%= form_prevention.clasification_danger_detail.name %>
                  </td>
                  <td class="text-break">
                    <%= DangerDetailRisk.label_risk(form_prevention.clasification_danger_detail.id) %>
                  </td>
                  <td class="text-break">
                    <%= DangerPrevention.label_prevention(form_prevention.clasification_danger_detail.id) %>
                  </td>
                  <td class="text-center">
                    <% if form_prevention.exposed == 1 %>
                      <span class="badge rounded-pill text-bg-danger px-3">
                        <i class="bi bi-person-fill-exclamation me-1"></i>
                        Sí
                      </span>
                    <% else %>
                      <span class="badge rounded-pill text-bg-light border text-secondary">
                        No
                      </span>
                    <% end %>
                  </td>
                  <% if Current.user.level > 0 && Current.user.level < 3 %>
                    <td class="text-center">
                      <%= link_to actualizar_form_prevention_path(form_prevention.id), class: "btn btn-sm btn-outline-primary", title: "Editar medida", data: { bs_toggle: "tooltip" } do %>
                        <i class="bi bi-pencil-square"></i>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <!-- ======================================================= -->
    <!-- VISTA CELULAR -->
    <!-- ======================================================= -->
    <div class="d-lg-none">
      <% @form_preventions.each_with_index do |form_prevention, index| %>
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-body p-3">
            <!-- Encabezado -->
            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
              <div class="d-flex align-items-center gap-2">
                <div class="text-primary fs-4">
                  <i class="bi bi-shield-check"></i>
                </div>
                <div>
                  <div class="small text-muted">
                    Registro
                  </div>
                  <div class="fw-semibold">
                    No. <%= index + 1 %>
                  </div>
                </div>
              </div>
              <% if form_prevention.exposed == 1 %>
                <span class="badge rounded-pill text-bg-danger">
                  <i class="bi bi-person-fill-exclamation me-1"></i>
                  Expuesto
                </span>
              <% else %>
                <span class="badge rounded-pill text-bg-light border text-secondary">
                  No expuesto
                </span>
              <% end %>
            </div>
            <!-- Información -->
            <div class="bg-light rounded p-3">
              <div class="mb-3">
                <div class="small text-muted mb-1">
                  <i class="bi bi-exclamation-triangle me-1"></i>
                  Tipo de peligro
                </div>
                <div class="fw-semibold text-break">
                  <%= form_prevention.clasification_danger_detail.clasification_danger.name %>
                </div>
              </div>
              <div class="mb-3">
                <div class="small text-muted mb-1">
                  <i class="bi bi-card-text me-1"></i>
                  Descripción del peligro
                </div>
                <div class="text-break">
                  <%= form_prevention.clasification_danger_detail.name %>
                </div>
              </div>
              <div class="mb-3">
                <div class="small text-muted mb-1">
                  <i class="bi bi-heart-pulse me-1"></i>
                  Efectos en la salud
                </div>
                <div class="text-break">
                  <%= DangerDetailRisk.label_risk(form_prevention.clasification_danger_detail.id) %>
                </div>
              </div>
              <div>
                <div class="small text-muted mb-1">
                  <i class="bi bi-shield-check me-1"></i>
                  Medidas de intervención
                </div>
                <div class="text-break">
                  <%= DangerPrevention.label_prevention(form_prevention.clasification_danger_detail.id) %>
                </div>
              </div>
            </div>
            <!-- Botonera -->
            <% if Current.user.level > 0 && Current.user.level < 3 %>
              <div class="d-flex justify-content-center mt-3">
                <%= link_to actualizar_form_prevention_path(form_prevention.id), class: "btn btn-sm btn-outline-primary px-3" do %>
                  <i class="bi bi-pencil-square me-1"></i>
                  Editar
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- ======================================================= -->
    <!-- SIN REGISTROS -->
    <!-- ======================================================= -->
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center py-5 px-3">
        <div class="text-muted fs-1 mb-3">
          <i class="bi bi-shield-x"></i>
        </div>
        <h3 class="h6 fw-semibold">
          No hay medidas registradas
        </h3>
        <p class="text-muted small mb-0">
          No se encontraron medidas de prevención y control
          diligenciadas para esta entidad.
        </p>
      </div>
    </div>
  <% end %>
  <!-- ========================================================= -->
  <!-- RESPONSABLE -->
  <!-- ========================================================= -->
  <% if @admin_extent_danger.present? %>
    <div class="card border-0 shadow-sm mt-4">
      <div class="card-body p-3 p-md-4">
        <div class="row">
          <div class="col-12 col-md-6">
            <div class="border-top pt-3 mt-2">
              <div class="fw-semibold text-break">
                <%= @admin_extent_danger.user.name %>
              </div>
              <div class="text-muted small">
                Nombre del usuario encargado de llenar el formulario
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
