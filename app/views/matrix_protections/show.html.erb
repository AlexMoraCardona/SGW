<div class="container-fluid mb-4">
    <div align="left"; class="container col-12">
        <a class="navbar-brand" href="/">
            <%= image_tag 'LogoConesst202305232.png',:width => "100",  :height=>"100" %>
        </a>
    </div>
    <div class="row align-items-center">
        <div class="col-12 col-lg-2 text-center mb-3 mb-lg-0">
            <% if @entity.logo.present? %>
                <%= image_tag @entity.logo, class: "img-fluid", style: "max-height:90px;" %>
            <% end %>
        </div>
        <div class="col-12 col-lg-7 text-center">
            <h3 class="fw-bold mb-2">
                MATRIZ DE ELEMENTOS DE PROTECCIÓN PERSONAL
            </h3>
            <h5 class="mb-1">
                <%=@entity.business_name %>
            </h5>
            <small class="text-muted">
                NIT: <%= @entity.identification_number %>-<%= @entity.verification_digit if @entity.verification_digit.present? %>
            </small>
        </div>
        <div class="col-12 col-lg-3">
            <div class="row">
                <div class="col-7 fw-bold">Fecha creación:</div>
                <div class="col-5"><%= @template.date %></div>
            </div>
            <div class="row">
                <div class="col-7 fw-bold">Actualización:</div>
                <div class="col-5"><%= @template.date_updated %></div>
            </div>
            <div class="row">
                <div class="col-7 fw-bold">Versión:</div>
                <div class="col-5"><%= @template.version %></div>
            </div>
            <div class="row">
                <div class="col-7 fw-bold">Código:</div>
                <div class="col-5"><%= @template.reference %></div>
            </div>
        </div>
    </div>
</div>
<hr>
<div class="card shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Área/Oficio</th>
                        <th>Equipo de protección </th>
                        <th>Parte de cuerpo a proteger </th>
                        <th>Imagen </th>
                        <th>Norma </th>
                        <th>Durabilidad</th>
                        <th>Ficha Técnica</th>
                        <th>Formato de Entrega</th>
                        <th>Inducción al personal </th>
                    </tr>   
                </thead>
                <% @matrix_protection_items.each do |matrix_protection_item| %>             
                    <tbody>
                        <tr>
                            <td><%= matrix_protection_item.areas %></td>
                            <td><%= matrix_protection_item.protection_element.name %></td>
                            <td><%= matrix_protection_item.protection_element.body_protect %></td>
                            <td>
                                <% if matrix_protection_item.protection_element.img_elem.attached? %>
                                    <% if matrix_protection_item.protection_element.img_elem.image? %> 
                                        <%= image_tag matrix_protection_item.protection_element.img_elem, data: {previews_target: "preview"}, class: "image_peq" %>
                                    <% end %>
                                <% else %> 
                                    <%= image_tag("avatar.jpg", class: "avatar-mini") %>
                                <% end %>
                            </td>
                            <td><%= matrix_protection_item.protection_element.rule_protection %></td>
                            <td><%= matrix_protection_item.durability %></td>
                            <td><%= MatrixProtectionItem.label(matrix_protection_item.date_sheet) %></td>
                            <td><%= MatrixProtectionItem.label(matrix_protection_item.delivery_format) %></td>
                            <td><%= MatrixProtectionItem.label(matrix_protection_item.personal_induction) %></td>
                        </tr> 
                    </body>
                <% end %>
            </table>
        </div>
    </div>
    <hr class="my-5">
    <div class="container-fluid">
        <div class="row text-center align-items-start">
            <!-- Representante Legal -->
            <div class="col-12 col-md-4 mb-5">
            <div style="height: 90px; display: flex; align-items: center; justify-content: center;">
                <% if @matrix_protection.firm_legal_representative == 1 && @rep.present? && @rep.firm.attached? && @rep.firm.image? %>
                        <%= image_tag @rep.firm, style: "max-height:90px; max-width:100%; object-fit:contain;" %>
                <% end %>
            </div>
            <hr class="my-1">
            <strong>
                <%= @rep.name %>
            </strong>
            <br>
            <small class="text-muted">
                Representante Legal
            </small>
        </div>
        <!-- Asesor SST -->
        <div class="col-12 col-md-4 mb-5">
            <div style="height: 90px; display: flex; align-items: center; justify-content: center;">
                <% if @matrix_protection.firm_adviser_sst == 1 && @adv.present? && @adv.firm.attached? && @adv.firm.image? %>
                    <%= image_tag @adv.firm, style: "max-height:90px; max-width:100%; object-fit:contain;" %>
                <% end %>
            </div>
            <hr class="my-1">
            <strong>
                <%= @adv.name %>
            </strong>
            <br>
            <small class="text-muted">
                Asesor SG-SST
            </small>
        </div>
        <!-- Responsable SG-SST -->
        <div class="col-12 col-md-4 mb-5">
            <div style="height: 90px; display: flex; align-items: center; justify-content: center;">
                <% if @matrix_protection.firm_responsible_sst == 1 && @res.present? && @res.firm.attached? && @res.firm.image? %>
                    <%= image_tag @res.firm, style: "max-height:90px; max-width:100%; object-fit:contain;" %>
                <% end %>
            </div>
            <hr class="my-1">
            <strong>
                <%= @res.name %>
            </strong>
            <br>
            <small class="text-muted">
                Responsable SG-SST
            </small>
        </div>
    </div>
</div>
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <%= link_to matrix_protections_path(entity_id: @matrix_protection.entity.id), class:"btn btn-secondary" do %>
                <i class="bi bi-arrow-left-circle"></i>Retornar
            <% end %>
            <%= link_to ver_matrix_protection_matrix_protections_path(@matrix_protection.id, format: 'pdf'), class:"btn btn-danger" do %>
                <i class="bi bi-file-earmark-pdf"></i>PDF
            <% end %> 
        </div>
    </div>
</div>
