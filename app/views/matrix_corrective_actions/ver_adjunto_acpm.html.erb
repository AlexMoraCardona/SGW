<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light fw-semibold text-center text-md-start">
        <i class="bi bi-images me-2"></i>
            REGISTRO FOTOGRÁFICO Y ARCHIVOS
    </div>
    <div class="card-body">
        <% if @matrix_action_item.present? %>
            <% if @matrix_action_item.matrix_action_item_files.attached? %>
                <div data-controller="previews">
                    <div class="row g-4">
                        <% @matrix_action_item.matrix_action_item_files.each do |file| %>
                            <div class="col-12 col-sm-6 col-lg-4">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-body d-flex flex-column">
                                        <% if file.image? %>
                                            <div class="text-center mb-3">
                                                <%= image_tag file, data: { previews_target: "preview" }, class: "img-fluid rounded", style: "max-height: 300px; width: 100%; object-fit: contain;" %>
                                            </div>
                                        <% elsif file.video? %>
                                            <div class="ratio ratio-16x9 mb-3">
                                                <%= video_tag url_for(file), controls: true, class: "rounded" %>
                                            </div>
                                        <% elsif file.audio? %>
                                            <div class="text-center mb-3">
                                                <i class="bi bi-file-earmark-music display-3 text-secondary"></i>
                                            </div>
                                            <div class="mt-auto">
                                                <%= audio_tag url_for(file), controls: true, class: "w-100" %>
                                            </div>
                                        <% else %>
                                            <div class="text-center mb-3">
                                                <i class="bi bi-file-earmark-text display-3 text-secondary"></i>
                                            </div>
                                            <div class="text-center text-break">
                                                <%= link_to file.filename, url_for(file), target: "_blank", class: "text-decoration-none" %>
                                            </div>
                                        <% end %>
                                        <div class="text-center mt-2">
                                            <small class="text-muted text-break">
                                                <%= file.filename %>
                                            </small>
                                        </div>
                                        <% if Current.user.level > 0 && Current.user.level < 4 %>
                                                <div class="text-center mt-3">
                                                    <%= link_to purge_attachment_path(file), data: {'turbo-method': :delete, 'turbo-confirm': '¿Está seguro de eliminar el archivo?'}, class: "btn btn-outline-danger btn-sm" do %>
                                                        <i class="bi bi-trash me-1"></i>
                                                        Borrar archivo
                                                    <% end %>
                                                </div>
                                        <% end %>
                                    </div>
                                </div>
                            </div>
                        <% end %>
                    </div>
                </div>
            <% else %>
                <div class="text-center text-muted py-4">
                    <i class="bi bi-folder2-open display-5"></i>
                    <p class="mt-2 mb-0">
                            No hay archivos adjuntos.
                    </p>
                </div>
            <% end %>
        <% end %>
      </div>
</div>


<!-- BOTONERA -->
<div class="border-top pt-4 pb-3">

  <div class="d-flex flex-column flex-md-row justify-content-center  align-items-stretch gap-2">
        <%= link_to :back, class: "btn btn-secondary px-4" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
        <% end %>
  </div>
</div>
