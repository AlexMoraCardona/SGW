<div class="container-fluid mb-4">
    <div class="col-12 col-lg-2 text-center mb-3 mb-lg-0">
        <%= link_to root_path, class: "navbar-brand" do %>
            <%= image_tag "LogoConesst202305232.png", class: "img-fluid", style: "max-height:100px;" %>
        <% end %>
    </div>
    <div class="row align-items-center">
        <div class="col-12 col-lg-2 text-center mb-3 mb-lg-0">
            <% if @matrix_danger_risk.entity.logo.present? %>
                <%= image_tag @matrix_danger_risk.entity.logo, class: "img-fluid", style: "max-height:90px;" %>
            <% end %>
        </div>
        <div class="col-12 col-lg-7 text-center">
            <h3 class="fw-bold mb-2">
                MATRIZ DE IDENTIFICACIÓN DE PELIGROS, EVALUACIÓN Y VALORACIÓN DE LOS RIESGOS
            </h3>
            <h5 class="mb-1">
                <%= @matrix_danger_risk.entity.business_name %>
            </h5>
            <small class="text-muted"> 
                NIT: <%= @matrix_danger_risk.entity.identification_number %>-<%= @matrix_danger_risk.entity.verification_digit if @matrix_danger_risk.entity.verification_digit.present? %>
            </small>
            <small class="text-muted"> 
                <h6>Fecha de creación: <%= @matrix_danger_risk.date_create if @matrix_danger_risk.date_create.present? %> - Fecha de última actualización: <%= @matrix_danger_risk.date_update if @matrix_danger_risk.date_update.present? %></h6>
            </small>
        </div>
        <div class="col-12 col-lg-3">
            <div class="row">
                <div class="col-7 fw-bold">Fecha creación:</div>
                <div class="col-5"><%= @template.date %></div>
            </div>
            <div class="row">
                <div class="col-7 fw-bold">Actualización:</div>
                <div class="col-5"><%= @template.date_updated %></div>
            </div>
            <div class="row">
                <div class="col-7 fw-bold">Versión:</div>
                <div class="col-5"><%= @template.version %></div>
            </div>
            <div class="row">
                <div class="col-7 fw-bold">Código:</div>
                <div class="col-5"><%= @template.reference %></div>
            </div>
        </div>
    </div>
</div>
<hr>
<div class="card shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <td rowspan="2"; style="text-align:center;"><strong>Nro</strong></TD>
                        <td rowspan="2"; style="text-align:center;"><strong>Fecha Creación</strong></TD>
                        <td rowspan="2"; style="text-align:center;"><strong>PROCESO</strong></TD>
                        <td rowspan="2"; style="text-align:center;"><strong>CARGO</strong></TD>
                        <td rowspan="2"; style="text-align:center;"><strong>ZONA/LUGAR</strong></TD>
                        <td rowspan="2"; style="text-align:center;"><strong>ACTIVIDAD</strong></TD>
                        <td rowspan="2"; style="text-align:center;"><strong>TAREAS</strong></TD>
                        <td rowspan="2"; style="text-align:center;"><strong>RUTINARIA: SI o NO</strong></TD>
                        <td colspan="2"; style="text-align:center;"><strong>PELIGRO</strong></TD>
                        <td rowspan="2"; style="text-align:center;"><strong>EFECTOS POSIBLES EN LA SALUD</strong></TD>
                        <td colspan="3"; style="text-align:center;"><strong>CONTROLES EXISTENTES</strong></TD>
                        <td colspan="7"; style="text-align:center;"><strong>EVALUACIÓN DEL RIESGO</strong></td>
                        <td style="text-align:center;"><strong>VALORACIÓN DEL RIESGO</strong></td>
                        <td colspan="5"; style="text-align:center;"><strong>MEDIDAS DE INTERVENCIÓN</strong></TD>
                        <td rowspan="2"; style="text-align:center;"><strong>EDITAR</strong></TD>
                        <td rowspan="2"; style="text-align:center;"><strong>ELIMINAR</strong></TD>
                    </tr>            
                    <tr>
                        <td style="text-align:center;"><strong>CLASIFICACIÓN</strong></TD>
                        <td style="text-align:center;"><strong>DESCRIPCIÓN</strong></TD>
                        <td style="text-align:center;"><strong>FUENTE</strong></TD>
                        <td style="text-align:center;"><strong>MEDIO</strong></TD>
                        <td style="text-align:center;"><strong>INDIVIDUO</strong></TD>
                        <td style="text-align:center;"><strong>NIVEL DE DEFICIENCIA (ND)</strong></TD>
                        <td style="text-align:center;"><strong>NIVEL DE EXPOSICIÓN (NE)</strong></TD>
                        <td style="text-align:center;"><strong>NIVEL DE PROBABILIDAD (ND*NE)</strong></TD>
                        <td style="text-align:center;"><strong>INTERPRETACIÓN DEL NIVEL DE PROBABILIDAD</strong></TD>
                        <td style="text-align:center;"><strong>NIVEL DE CONSECUENCIA</strong></TD>
                        <td style="text-align:center;"><strong>NIVEL DE RIESGO E INTERVENCIÓN (NR)</strong></TD>
                        <td style="text-align:center;"><strong>INTERPRETACIÓN DEL NIVEL DE RIESGO</strong></TD>
                        <td style="text-align:center;"><strong>ACEPTABILIDAD DEL RIESGO</strong></TD>
                        <td style="text-align:center;"><strong>ELIMINACIÓN</strong></TD>
                        <td style="text-align:center;"><strong>SUSTITUCIÓN</strong></TD>
                        <td style="text-align:center;"><strong>CONTROL DE INGENIERÍA</strong></TD>
                        <td style="text-align:center;"><strong>CONTROLES ADMINISTRATIVAS, SEÑALIZACIÓN, ADVERTENCIA</strong></TD>
                        <td style="text-align:center;"><strong>EQUIPOS/ELEMENTOS DE PROTECCIÓN PERSONAL</strong></TD>
                    </tr>            
                </thead>
                <% @nro = 0 %>
                <% @matrix_danger_items.each do |item| %>  
                    <body>
                        <% @nro += 1 %>            
                        <tr>
                            <td style="text-align:center;"><%= @nro %></td>
                            <td><%= item.created_at.strftime("%F") %></td>
                            <td><%= item.source_information %></td>
                            <td><%=  CompanyPosition.name_cargo(item.type_cargo)  %></td>
                            <td><%= item.origin %></td>
                            <td><%= item.activity %></td>
                            <td><%= item.task %></td>
                            <td><%= item.label_type_task(item.type_task) %></td>
                            <td><%= item.clasification_danger_detail.clasification_danger.name if item.clasification_danger_detail_id.to_i > 0  %></td>
                            <td><%= item.clasification_danger_detail.name if item.clasification_danger_detail_id.present? && item.clasification_danger_detail_id.to_i > 0 %></td>
                            <td><%= item.possible_effects_health %></td>

                   
                            <td><%= item.description_existing_control_origin  %></td>
                            <td><%= item.description_existing_control_medium  %></td>
                            <td><%= item.description_existing_control_person  %></td>
                            <% if item.deficiency_level == 10  %>
                                <td style="text-align:center;">Muy Alto - <%= item.deficiency_level  %></td>
                            <% end  %>    
                            <% if item.deficiency_level == 6  %>
                                <td style="text-align:center;">Alto - <%= item.deficiency_level  %></td>
                            <% end  %>    
                            <% if item.deficiency_level == 2  %>
                                <td style="text-align:center;">Medio - <%= item.deficiency_level  %></td>
                            <% end  %>    
                            <% if item.deficiency_level < 2  %>
                                <td style="text-align:center;">Bajo - <%= item.deficiency_level  %></td>
                            <% end  %>    
                            <% if item.exposure_level == 4  %>
                                <td style="text-align:center;">Continua - <%= item.exposure_level  %></td>
                            <% end  %>    
                            <% if item.exposure_level == 3  %>
                                <td style="text-align:center;">Frecuente - <%= item.exposure_level  %></td>
                            <% end  %>    
                            <% if item.exposure_level == 2  %>
                                <td style="text-align:center;">Ocasional - <%= item.exposure_level  %></td>
                            <% end  %>    
                            <% if item.exposure_level < 2  %>
                                <td style="text-align:center;">Esporádica - <%= item.exposure_level  %></td>
                            <% end  %> 
                            <% if item.interpretation == 'MUY ALTO'  %>
                                <td style="text-align:center;"><%= item.probability_level  %></td>
                                <td style="text-align:center;"><%= item.interpretation  %></td>
                            <% end  %> 
                            <% if item.interpretation == 'ALTO'  %>
                                <td style="text-align:center;"><%= item.probability_level  %></td>
                                <td style="text-align:center;"><%= item.interpretation  %></td>
                            <% end  %> 
                            <% if item.interpretation == 'MEDIO'  %>
                                <td style="text-align:center;"><%= item.probability_level  %></td>
                                <td style="text-align:center;"><%= item.interpretation  %></td>
                            <% end  %> 
                            <% if item.interpretation == 'BAJO'  %>
                                <td style="text-align:center;"><%= item.probability_level  %></td>
                                <td style="text-align:center;"><%= item.interpretation  %></td>
                            <% end  %> 
                            <% if item.consequence_level == 100  %>
                                <td style="text-align:center;">Mortal o Catastrófico - <%= item.consequence_level  %></td>
                            <% end  %>    
                            <% if item.consequence_level == 60  %>
                                <td style="text-align:center;">Muy Grave - <%= item.consequence_level  %></td>
                            <% end  %>    
                            <% if item.consequence_level == 25  %>
                                <td style="text-align:center;">Grave - <%= item.consequence_level  %></td>
                            <% end  %>    
                            <% if item.consequence_level < 25  %>
                                <td style="text-align:center;">Leve - <%= item.consequence_level  %></td>
                            <% end  %>    
                            <% if item.risk_level_interpretation.to_s == 'I No Aceptable'  %>
                                <td style="text-align:center;"><%= item.level_risk_intervention  %></td>
                                <td><%= item.risk_acceptability  %></td>
                                <td style="text-align:center;background-color:#F03553"><%= item.risk_level_interpretation %></td>
                            <% end  %>    
                            <% if item.risk_level_interpretation.to_s == 'II No Aceptable'  %>
                                <td style="text-align:center;"><%= item.level_risk_intervention  %></td>
                                <td><%= item.risk_acceptability  %></td>
                                <td style="text-align:center; background-color:#D98F3B;"><%= item.risk_level_interpretation %></td>
                            <% end  %>    

                            <% if item.risk_level_interpretation.to_s == 'III Aceptable'  %>
                                <td style="text-align:center;"><%= item.level_risk_intervention  %></td>
                                <td><%= item.risk_acceptability  %></td>
                                <td style="text-align:center;; background-color:#F0E835"><%= item.risk_level_interpretation %></td>
                            <% end  %>    
                            <% if item.risk_level_interpretation.to_s == 'IV Aceptable'  %>
                                <td style="text-align:center;"><%= item.level_risk_intervention  %></td>
                                <td><%= item.risk_acceptability  %></td>
                                <td style="text-align:center; background-color:#038018;"><%= item.risk_level_interpretation %></td>
                            <% end  %>  
                            <td style="text-align:center"><%= item.intervention_measures_elimination  %></td>
                            <td style="text-align:center""><%= item.intervention_measures_replacement  %></td>
                            <td><%= item.intervention_measures_engineering_control  %></td>
                            <td><%= item.intervention_measures_acsw  %></td>
                            <td><%= item.intervention_measures_ppee  %></td>
                            <td style=" text-align:center;">
                                <% if Current.user.level > 0 && Current.user.level < 4 %>
                                    <%= link_to edit_matrix_danger_item_path(item), class:"btn btn-warning btn-sm", title: "Editar", data: { bs_toggle: "tooltip" } do %>
                                        <i class="bi bi-pencil-square"></i>
                                    <% end %>                    
                                <% end %>    
                            </td>
                            <td style="text-align:center;">
                                <% if Current.user.level > 0 && Current.user.level < 4 %>
                                    <%= button_to item, method: :delete, title: "Eliminar", class:"btn btn-danger btn-sm", form: {data: {turbo_confirm:"¿Desea eliminar este registro? Esta acción no se puede deshacer.", bs_toggle: "tooltip"}} do %>
                                        <i class="bi bi-trash"></i>
                                    <% end %>
                                <% end %>    
                            </td>
                        </tr>
                    </body>                        
                <% end %>
            </table>
        </div>
    </div>
    <hr class="my-5">
    <div class="container-fluid">
        <div class="row text-center align-items-start">
        <!-- Representante Legal -->
        <div class="col-12 col-md-6 mb-5">
            <div style="height: 90px; display: flex; align-items: center; justify-content: center;">
                <% if @matrix_danger_risk.firm_legal_representative == 1 && @rep.present? && @rep.firm.attached? && @rep.firm.image? %>
                    <%= image_tag @rep.firm, style: "max-height:90px; max-width:100%; object-fit:contain;" %>
                <% end %>
            </div>
            <hr class="my-1">
            <strong>
                <%= MatrixDangerRisk.name_user(@matrix_danger_risk.user_legal_representative) %>
            </strong>
            <br>
            <small class="text-muted">
                Representante Legal
            </small>
        </div>
        <!-- Asesor SST -->
        <div class="col-12 col-md-6 mb-5">
            <div style="height: 90px; display: flex; align-items: center; justify-content: center;">
                <% if @matrix_danger_risk.firm_adviser_sst == 1 && @adv.present? && @adv.firm.attached? && @adv.firm.image? %>
                    <%= image_tag @adv.firm, style: "max-height:90px; max-width:100%; object-fit:contain;" %>
                <% end %>
            </div>
            <hr class="my-1">
            <strong>
                <%= MatrixDangerRisk.name_user(@matrix_danger_risk.user_adviser_sst) %>
            </strong>
            <br>
            <small class="text-muted">
                Asesor SG-SST
            </small>
        </div>
    </div>
</div>
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <%= link_to matrix_danger_risk_path(@matrix_danger_risk.id), class:"btn btn-secondary" do %>
                <i class="bi bi-arrow-left-circle"></i>Retornar
            <% end %>
        </div>
    </div>
</div>
