<div class="container-fluid py-3">
  <div class="card border-0 shadow-sm mx-auto" style="max-width: 1200px;">
    <!-- ENCABEZADO -->
    <div class="card-header bg-light border-bottom py-3">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <div>
          <h4 class="mb-1 fw-bold text-dark">
            <i class="bi bi-person-gear me-2"></i>
            Actualizar información del funcionario
          </h4>
          <p class="mb-0 text-muted small">
            Edite la información relacionada con la participación del funcionario en la evidencia.
          </p>
        </div>
        <% if @evidence.present? %>
          <div class="text-md-end">
            <span class="badge rounded-pill text-bg-secondary px-3 py-2">
              <i class="bi bi-file-earmark-text me-1"></i>
              <%= @evidence.template.name %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
    <!-- FORMULARIO -->
    <div class="card-body p-3 p-md-4">
      <%= form_with model: @participant do |form| %>
        <!-- ERRORES -->
        <% if @participant.errors.any? %>
          <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-start">
              <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
              <div>
                <strong>
                  No fue posible guardar la información.
                </strong>
                <ul class="mb-0 mt-2">
                  <% @participant.errors.full_messages.each do |error| %>
                    <li><%= error %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>
        <!-- INFORMACIÓN DE PARTICIPACIÓN -->
        <div class="mb-4">
          <div class="d-flex align-items-center mb-3">
            <div class="bg-light rounded-circle p-2 me-2">
              <i class="bi bi-person-check text-secondary"></i>
            </div>
            <div>
              <h5 class="mb-0 fw-bold">
                Información de participación
              </h5>
              <small class="text-muted">
                Seleccione las condiciones correspondientes al funcionario.
              </small>
            </div>
          </div>
          <div class="row g-3">
            <!-- VOTACIÓN DEL JURADO -->
            <div class="col-12 col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <%= form.label :jury_voting, class: "form-label fw-semibold mb-2" do %>
                  <i class="bi bi-check2-square me-1 text-secondary"></i>
                  Votación del jurado
                <% end %>
                <div class="d-flex gap-2 flex-wrap">
                  <%= form.radio_button :jury_voting, 0, class: "btn-check",  id: "participant_jury_voting_no" %>
                  <%= form.label :jury_voting, "NO", value: 0, for: "participant_jury_voting_no", class: "btn btn-outline-secondary px-4" %>
                  <%= form.radio_button :jury_voting, 1, class: "btn-check", id: "participant_jury_voting_si" %>
                  <%= form.label :jury_voting, "SÍ", value: 1, for: "participant_jury_voting_si", class: "btn btn-outline-success px-4" %>
                </div>
              </div>
            </div>
            <!-- CANDIDATO -->
            <div class="col-12 col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <%= form.label :candidate, class: "form-label fw-semibold mb-2" do %>
                  <i class="bi bi-person-badge me-1 text-secondary"></i>
                  Candidato
                <% end %>
                <div class="d-flex gap-2 flex-wrap">
                  <%= form.radio_button :candidate, 0,  class: "btn-check", id: "participant_candidate_no" %>
                  <%= form.label :candidate, "NO",  value: 0, for: "participant_candidate_no", class: "btn btn-outline-secondary px-4" %>
                  <%= form.radio_button :candidate, 1, class: "btn-check", id: "participant_candidate_si" %>
                  <%= form.label :candidate, "SÍ", value: 1, for: "participant_candidate_si", class: "btn btn-outline-success px-4" %>
                </div>
              </div>
            </div>
            <!-- REPRESENTANTE DE LOS TRABAJADORES -->
            <div class="col-12 col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <%= form.label :workers_representative, class: "form-label fw-semibold mb-2" do %>
                  <i class="bi bi-people me-1 text-secondary"></i>
                  Representante de los trabajadores
                <% end %>
                <div class="d-flex gap-2 flex-wrap">
                  <%= form.radio_button :workers_representative, 0, class: "btn-check", id: "participant_workers_representative_no" %>
                  <%= form.label :workers_representative, "NO", value: 0, for: "participant_workers_representative_no", class: "btn btn-outline-secondary px-4" %>
                  <%= form.radio_button :workers_representative, 1, class: "btn-check", id: "participant_workers_representative_si" %>
                  <%= form.label :workers_representative, "SÍ", value: 1, for: "participant_workers_representative_si", class: "btn btn-outline-success px-4" %>
                </div>
              </div>
            </div>
            <!-- REPRESENTANTE DE LA EMPRESA -->
            <div class="col-12 col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <%= form.label :company_representative, class: "form-label fw-semibold mb-2" do %>
                  <i class="bi bi-building me-1 text-secondary"></i>
                  Representante de la empresa
                <% end %>
                <div class="d-flex gap-2 flex-wrap">
                  <%= form.radio_button :company_representative, 0,  class: "btn-check", id: "participant_company_representative_no" %>
                  <%= form.label :company_representative, "NO", value: 0, for: "participant_company_representative_no", class: "btn btn-outline-secondary px-4" %>
                  <%= form.radio_button :company_representative, 1, class: "btn-check", id: "participant_company_representative_si" %>
                  <%= form.label :company_representative, "SÍ", value: 1, for: "participant_company_representative_si", class: "btn btn-outline-success px-4" %>
                </div>
              </div>
            </div>
            <!-- ELIGE / SELECCIONA -->
            <div class="col-12 col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <%= form.label :choose, class: "form-label fw-semibold mb-2" do %>
                  <i class="bi bi-hand-index-thumb me-1 text-secondary"></i>
                  Seleccionado / elegido
                <% end %>
                <div class="d-flex gap-2 flex-wrap">
                  <%= form.radio_button :choose, 0, class: "btn-check", id: "participant_choose_no" %>
                  <%= form.label :choose, "NO", value: 0, for: "participant_choose_no", class: "btn btn-outline-secondary px-4" %>
                  <%= form.radio_button :choose, 1, class: "btn-check", id: "participant_choose_si" %>
                  <%= form.label :choose, "SÍ", value: 1, for: "participant_choose_si", class: "btn btn-outline-success px-4" %>
                </div>
              </div>
            </div>
            <!-- PERSONAL DE BRIGADA -->
            <div class="col-12 col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <%= form.label :brigade_personnel, class: "form-label fw-semibold mb-2" do %>
                  <i class="bi bi-shield-check me-1 text-secondary"></i>
                  Personal de brigada
                <% end %>
                <div class="d-flex gap-2 flex-wrap">
                  <%= form.radio_button :brigade_personnel, 0, class: "btn-check", id: "participant_brigade_personnel_no" %>
                  <%= form.label :brigade_personnel, "NO", value: 0, for: "participant_brigade_personnel_no", class: "btn btn-outline-secondary px-4" %>
                  <%= form.radio_button :brigade_personnel, 1, class: "btn-check", id: "participant_brigade_personnel_si" %>
                  <%= form.label :brigade_personnel, "SÍ", value: 1, for: "participant_brigade_personnel_si", class: "btn btn-outline-success px-4" %>
                </div>
              </div>
            </div>
            <!-- COLABORADOR -->
            <div class="col-12 col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <%= form.label :collaborator, class: "form-label fw-semibold mb-2" do %>
                  <i class="bi bi-person-workspace me-1 text-secondary"></i>
                  Colaborador
                <% end %>
                <div class="d-flex gap-2 flex-wrap">
                  <%= form.radio_button :collaborator, 0, class: "btn-check", id: "participant_collaborator_no" %>
                  <%= form.label :collaborator, "NO", value: 0, for: "participant_collaborator_no", class: "btn btn-outline-secondary px-4" %>
                  <%= form.radio_button :collaborator, 1, class: "btn-check", id: "participant_collaborator_si" %>
                  <%= form.label :collaborator, "SÍ", value: 1, for: "participant_collaborator_si", class: "btn btn-outline-success px-4" %>
                </div>
              </div>
            </div>
            <!-- RESPONSABLE SG-SST -->
            <div class="col-12 col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <%= form.label :responsible_ssst, class: "form-label fw-semibold mb-2" do %>
                  <i class="bi bi-person-check me-1 text-secondary"></i>
                  Responsable del SG-SST
                <% end %>
                <div class="d-flex gap-2 flex-wrap">
                  <%= form.radio_button :responsible_ssst, 0, class: "btn-check", id: "participant_responsible_ssst_no" %>
                  <%= form.label :responsible_ssst, "NO", value: 0, for: "participant_responsible_ssst_no", class: "btn btn-outline-secondary px-4" %>
                  <%= form.radio_button :responsible_ssst, 1, class: "btn-check", id: "participant_responsible_ssst_si" %>
                  <%= form.label :responsible_ssst, "SÍ", value: 1, for: "participant_responsible_ssst_si", class: "btn btn-outline-success px-4" %>
                </div>
              </div>
            </div>
            <!-- REPORTE ARL -->
            <div class="col-12 col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <%= form.label :arl_activity_report, class: "form-label fw-semibold mb-2" do %>
                  <i class="bi bi-file-earmark-check me-1 text-secondary"></i>
                  Reporte de actividad a la ARL
                <% end %>
                <div class="d-flex gap-2 flex-wrap">
                  <%= form.radio_button :arl_activity_report, 0, class: "btn-check", id: "participant_arl_activity_report_no" %>
                  <%= form.label :arl_activity_report, "NO", value: 0, for: "participant_arl_activity_report_no", class: "btn btn-outline-secondary px-4" %>
                  <%= form.radio_button :arl_activity_report, 1, class: "btn-check", id: "participant_arl_activity_report_si" %>
                  <%= form.label :arl_activity_report, "SÍ", value: 1, for: "participant_arl_activity_report_si", class: "btn btn-outline-success px-4" %>
                </div>
              </div>
            </div>
            <!-- 10 PUNTOS ADICIONALES -->
            <div class="col-12 col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <%= form.label :quote_10_aditional_points, class: "form-label fw-semibold mb-2" do %>
                  <i class="bi bi-plus-circle me-1 text-secondary"></i>
                  10 puntos adicionales
                <% end %>
                <div class="d-flex gap-2 flex-wrap">
                  <%= form.radio_button :quote_10_aditional_points, 0, class: "btn-check", id: "participant_quote_10_aditional_points_no" %>
                  <%= form.label :quote_10_aditional_points, "NO", value: 0, for: "participant_quote_10_aditional_points_no", class: "btn btn-outline-secondary px-4" %>
                  <%= form.radio_button :quote_10_aditional_points, 1, class: "btn-check", id: "participant_quote_10_aditional_points_si" %>
                  <%= form.label :quote_10_aditional_points, "SÍ", value: 1, for: "participant_quote_10_aditional_points_si", class: "btn btn-outline-success px-4" %>
                </div>
              </div>
            </div>
            <!-- DESIGNACIÓN REPRESENTANTE LEGAL -->
            <div class="col-12 col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <%= form.label :designating_by_legal_representative, class: "form-label fw-semibold mb-2" do %>
                  <i class="bi bi-person-vcard me-1 text-secondary"></i>
                  Designación por representante legal
                <% end %>
                <div class="d-flex gap-2 flex-wrap">
                  <%= form.radio_button :designating_by_legal_representative, 0, class: "btn-check", id: "participant_designating_by_legal_representative_no" %>
                  <%= form.label :designating_by_legal_representative, "NO", value: 0, for: "participant_designating_by_legal_representative_no", class: "btn btn-outline-secondary px-4" %>
                  <%= form.radio_button :designating_by_legal_representative, 1, class: "btn-check", id: "participant_designating_by_legal_representative_si" %>
                  <%= form.label :designating_by_legal_representative, "SÍ", value: 1, for: "participant_designating_by_legal_representative_si", class: "btn btn-outline-success px-4" %>
                </div>
              </div>
            </div>
            <!-- PRESIDENTE COPASST -->
            <div class="col-12 col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <%= form.label :joint_committee_president, class: "form-label fw-semibold mb-2" do %>
                  <i class="bi bi-person-badge me-1 text-secondary"></i>
                  Presidente del COPASST
                <% end %>
                <div class="d-flex gap-2 flex-wrap">
                  <%= form.radio_button :joint_committee_president, 0, class: "btn-check", id: "participant_joint_committee_president_no" %>
                  <%= form.label :joint_committee_president, "NO", value: 0, for: "participant_joint_committee_president_no", class: "btn btn-outline-secondary px-4" %>
                  <%= form.radio_button :joint_committee_president, 1, class: "btn-check", id: "participant_joint_committee_president_si" %>
                  <%= form.label :joint_committee_president, "SÍ", value: 1, for: "participant_joint_committee_president_si", class: "btn btn-outline-success px-4" %>
                </div>
              </div>
            </div>
            <!-- SECRETARIO COPASST -->
            <div class="col-12 col-md-6">
              <div class="border rounded-3 p-3 h-100">
                <%= form.label :joint_committee_secretary, class: "form-label fw-semibold mb-2" do %>
                  <i class="bi bi-person-lines-fill me-1 text-secondary"></i>
                  Secretario del COPASST
                <% end %>
                <div class="d-flex gap-2 flex-wrap">
                  <%= form.radio_button :joint_committee_secretary, 0, class: "btn-check", id: "participant_joint_committee_secretary_no" %>
                  <%= form.label :joint_committee_secretary, "NO", value: 0, for: "participant_joint_committee_secretary_no", class: "btn btn-outline-secondary px-4" %>
                  <%= form.radio_button :joint_committee_secretary, 1, class: "btn-check", id: "participant_joint_committee_secretary_si" %>
                  <%= form.label :joint_committee_secretary, "SÍ", value: 1, for: "participant_joint_committee_secretary_si", class: "btn btn-outline-success px-4" %>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- INFORMACIÓN DE ACTIVIDAD -->
        <div class="border-top pt-4 mb-4">
          <div class="d-flex align-items-center mb-3">
            <div class="bg-light rounded-circle p-2 me-2">
              <i class="bi bi-briefcase text-secondary"></i>
            </div>
            <div>
              <h5 class="mb-0 fw-bold">
                Información de actividad
              </h5>
              <small class="text-muted">
                Información relacionada con la actividad desarrollada.
              </small>
            </div>
          </div>
          <div class="row g-3">
            <!-- NÚMERO DE VOTOS -->
            <div class="col-12 col-md-6">
              <%= form.label :number_votes, class: "form-label fw-semibold" do %>
                <i class="bi bi-123 me-1 text-secondary"></i>
                Número de votos
              <% end %>
              <%= form.number_field :number_votes, class: "form-control", min: 0 %>
            </div>
            <!-- EMPLEADOS ACTIVIDAD -->
            <div class="col-12 col-md-6">
              <%= form.label :employees_activity, class: "form-label fw-semibold" do %>
                <i class="bi bi-people me-1 text-secondary"></i>
                Empleados en la actividad
              <% end %>
              <%= form.text_field :employees_activity,  class: "form-control" %>
            </div>
            <!-- ACTIVIDAD REPORTADA -->
            <div class="col-12">
              <%= form.label :reported_activity, class: "form-label fw-semibold" do %>
                <i class="bi bi-list-check me-1 text-secondary"></i>
                Actividad reportada
              <% end %>
              <%= form.select :reported_activity,
                [
                  ['Trabajos en minería con servicio en socavones o en subterráneos.', 'Trabajos en minería con servicio en socavones o en subterráneos.'],
                  ['Trabajos con exposición a altas temperaturas.', 'Trabajos con exposición a altas temperaturas.'],
                  ['Trabajos con exposición a radiaciones ionizantes.', 'Trabajos con exposición a radiaciones ionizantes.'],
                  ['Trabajos con exposición a sustancias comprobadamente cancerígenas.', 'Trabajos con exposición a sustancias comprobadamente cancerígenas.'],
                  ['Actividades de los técnicos aeronáuticos.', 'Actividades de los técnicos aeronáuticos.'],
                  ['Cuerpos de Bomberos - Función específica en operaciones de extinción de incendios.', 'Cuerpos de Bomberos - Función específica en operaciones de extinción de incendios.'],
                  ['INPEC - Actividad dedicada a la custodia y vigilancia de los internos.', 'INPEC - Actividad dedicada a la custodia y vigilancia de los internos.']
                ],
                { include_blank: "-- Seleccionar actividad --" },
                class: "form-select" %>
            </div>
          </div>
        </div>
        <!-- INFORMACIÓN DEL CARGO -->
        <div class="border-top pt-4 mb-4">
          <div class="d-flex align-items-center mb-3">
            <div class="bg-light rounded-circle p-2 me-2">
              <i class="bi bi-mortarboard text-secondary"></i>
            </div>
            <div>
              <h5 class="mb-0 fw-bold">
               Información adicional
              </h5>
              <small class="text-muted">
                Información complementaria del funcionario.
              </small>
            </div>
          </div>
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <%= form.label :degree, class: "form-label fw-semibold" do %>
                <i class="bi bi-award me-1 text-secondary"></i>
                Cargo / título / profesión
              <% end %>
              <%= form.text_field :degree, class: "form-control" %>
            </div>
            <div class="col-12 col-md-6">
              <%= form.label :post_copasst, class: "form-label fw-semibold" do %>
                <i class="bi bi-person-workspace me-1 text-secondary"></i>
                Cargo en COPASST
              <% end %>
              <%= form.text_field :post_copasst, class: "form-control" %>
            </div>
          </div>
        </div>
        <!-- BOTONERA -->
        <div class="border-top pt-4">
          <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
            <%= link_to :back, class: "btn btn-outline-secondary px-4" do %>
              <i class="bi bi-arrow-left me-1"></i>
              Retornar
            <% end %>
            <button type="submit" class="btn btn-primary px-4">
              <i class="bi bi-check-circle me-1"></i>
              <%= t('common.submit') %>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
