<div class="container-fluid px-3 px-md-4 px-lg-5 py-3">
  <div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white py-3">
      <h2 class="mb-0 text-center text-md-start">
        <i class="bi bi-bar-chart-line me-2"></i>
        <%= @indicator.name %>
      </h2>
    </div>
    <div class="card-body p-3 p-md-4">
      <div class="mb-4">
        <label class="form-label fw-bold mb-1">
          <%= t(".description") %>
        </label>
        <div class="bg-light border rounded p-3">
          <%= @indicator.description %>
        </div>
      </div>
      <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
          <div class="border rounded p-3 h-100">
            <label class="form-label fw-bold mb-1">
              <%= t(".cycle_id") %>
            </label>
            <div>
              <%= @cycles.find(@indicator.cycle_id).name %>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="border rounded p-3 h-100">
            <label class="form-label fw-bold mb-1">
              <%= t(".periodicity") %>
            </label>

            <div>
              <%= Indicator.label_periodicidad(@indicator.periodicity) %>
            </div>
          </div>
        </div>
      </div>
      <div class="mb-4">
        <label class="form-label fw-bold mb-1">
          <%= t(".formula") %>
        </label>
        <div class="bg-light border rounded p-3">
          <%= @indicator.formula %>
        </div>
      </div>
      <div class="mb-4">
        <label class="form-label fw-bold mb-1">
          <%= t(".interpretation") %>
        </label>
        <div class="bg-light border rounded p-3">
          <%= @indicator.interpretation %>
        </div>
      </div>
      <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
          <div class="border rounded p-3 h-100">
            <label class="form-label fw-bold mb-1">
              <%= t(".limit_one") %>
            </label>
            <div>
              <%= @indicator.limit_one %>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="border rounded p-3 h-100">
            <label class="form-label fw-bold mb-1">
              <%= t(".limit_two") %>
            </label>
            <div>
              <%= @indicator.limit_two %>
            </div>
          </div>
        </div>
      </div>
      <div class="mb-4">
        <label class="form-label fw-bold mb-1">
          <%= t(".information_source") %>
        </label>
        <div class="bg-light border rounded p-3">
          <%= @indicator.information_source %>
        </div>
      </div>
      <div class="mb-4">
        <label class="form-label fw-bold mb-1">
          <%= t(".responsible_management") %>
        </label>
        <div class="bg-light border rounded p-3">
          <%= @indicator.responsible_management %>
        </div>
      </div>
      <div class="mb-4">
        <label class="form-label fw-bold mb-1">
          <%= t(".type_indicator") %>
        </label>
        <div class="bg-light border rounded p-3">
          <%= @indicator.type_indicator %>
        </div>
      </div>
      <div class="mb-4">
        <label class="form-label fw-bold mb-1">
          <%= t(".person_result") %>
        </label>
        <div class="bg-light border rounded p-3">
          <%= @indicator.person_result %>
        </div>
      </div>
      <div class="border-top pt-4 mt-4">
        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center justify-content-md-start">
          <%= link_to indicators_path,
                class: "btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-2 px-4" do %>
            <i class="bi bi-arrow-left"></i>
            <span><%= t("common.return") %></span>
          <% end %>
          <% if Current.user.level > 0 && Current.user.level < 3 %>
            <%= link_to edit_indicator_path(@indicator),
                  class: "btn btn-warning d-inline-flex align-items-center justify-content-center gap-2 px-4" do %>
              <i class="bi bi-pencil-square"></i>
              <span><%= t("common.edit") %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
