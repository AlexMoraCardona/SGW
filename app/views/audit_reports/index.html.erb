<div class="conesst-logo-container">
    <a href="/" aria-label="Inicio CONESST">
        <%= image_tag 'LogoConesst202305232.png',
            class: 'conesst-logo',
            alt: 'Logo CONESST' %>
    </a>
</div>
<div class="conesst-page">
    <div class="conesst-header">
        <div>
            <h2 class="conesst-title">
                <i class="bi bi-clipboard2-check me-1"></i>
                Informe Auditoría Interna
            </h2>
            <p class="conesst-subtitle">
                Consulta y gestión de informes de auditoría interna
            </p>
        </div>
    </div>
    <% if params[:entity_id].present? || @entity.present? %>
        <%= render 'audit_reports' %>
    <% else %>
        <div class="conesst-card">
            <div class="conesst-card-header">
                <h3 class="conesst-card-header-title">
                    <i class="bi bi-building me-1"></i>
                    Seleccionar empresa
                </h3>
            </div>
            <div class="conesst-card-body">
                <%= form_with model: @entity, method: :get do |form| %>
                    <div class="row">
                        <div class="col-12 col-md-8 col-lg-7">
                            <label class="conesst-label">
                                Empresa
                            </label>
                            <% if @entities.present? %>
                                <%= form.collection_select(:entity_id, @entities.order(id: :asc), :id, :business_name, { prompt: '-- Seleccionar entidad --' }, {class: 'form-select conesst-select'}) %>
                            <% else %>
                                <div class="conesst-entity-name">
                                    <i class="bi bi-building"></i>
                                    <span>
                                        <%= @entity.business_name %>
                                    </span>
                                </div>
                                <%= form.hidden_field(:entity_id, value: @entity.id) %>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-actions">
                        <button type="submit" class="btn conesst-btn conesst-btn-primary">
                            <i class="bi bi-search"></i>
                            <span>Consultar</span>
                        </button>
                    </div>
                <% end %>
            </div>
        </div>
    <% end %>
</div>