<div class="conesst-page">
  <div class="conesst-logo-container">
    <%= link_to root_path, class: "d-inline-block" do %>
      <%= image_tag(
            'LogoConesst202305232.png', class: 'conesst-logo', alt: 'CONESST') %>
    <% end %>
  </div>
  <div class="conesst-header">
    <div class="conesst-card-header-content">
      <div class="conesst-card-header-title">
        <i class="bi bi-clipboard2-check me-2"></i>
        Evaluaciones
      </div>
      <div class="conesst-card-header-subtitle">
        Consulta y gestión de evaluaciones
      </div>
    </div>
  </div>
  <% if params[:entity_id].present? %>
    <%= render 'exam' %>
  <% else %>
    <div class="conesst-card">
      <div class="conesst-card-header">
        <div class="conesst-card-header-content">
          <div class="conesst-card-header-title">
            <i class="bi bi-building me-2"></i>
            Seleccionar entidad
          </div>
          <div class="conesst-card-header-subtitle">
            Seleccione la entidad para consultar las evaluaciones
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <%= form_with model: @entity, method: :get do |form| %>
          <% if Current.user.level == 1 %>
            <div class="conesst-form-section">
              <div class="conesst-form-section-title">
                <i class="bi bi-building me-2"></i>
                Entidad
              </div>
              <div class="conesst-form-grid">
                <div class="conesst-form-group">
                  <%= form.label :entity_id, "Entidad", class: "conesst-form-label" %>
                  <%= form.collection_select(:entity_id, @entities, :id, :business_name, { prompt: "-- Seleccionar entidad --" }, { class: "form-select select2" }) %>
                </div>
              </div>
            </div>
          <% else %>
            <div class="conesst-form-section">
              <div class="conesst-form-section-title">
                <i class="bi bi-building-check me-2"></i>
                Entidad asociada
              </div>
              <div class="conesst-form-grid">
                <div class="conesst-form-group">
                  <label class="conesst-form-label">
                    Entidad
                  </label>
                  <div class="conesst-form-control-static">
                    <i class="bi bi-building me-2"></i>
                    <span class="text-break">
                      <%= @entities.business_name %>
                    </span>
                  </div>
                  <%= form.hidden_field(:entity_id, value: @entities.id.to_i) %>
                </div>
              </div>
            </div>
          <% end %>
          <div class="conesst-form-actions">
            <button type="submit" class="conesst-btn conesst-btn-primary">
              <i class="bi bi-search"></i>
              Consultar
            </button>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
