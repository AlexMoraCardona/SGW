<div class="conesst-page">
    <div class="conesst-card">
        <div class="conesst-card-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-bicycle fs-5"></i>
                <div>
                    <h5 class="mb-0">Formato lista de chequeo MOTO</h5>
                    <small class="text-muted">
                        Prechequeo operacional de motocicleta
                    </small>
                </div>
            </div>
        </div>
        <div class="conesst-card-body">
            <div class="mb-4">
                <p class="mb-2">
                    Los prechequeos operacionales son una herramienta útil para revisar
                    tu vehículo antes de salir para evitar varadas, o accidentes que
                    pongan en riesgo tu vida o la de los demás, por esto en SURA
                    queremos proporcionarte este formato para apoyarte en realizar
                    un trayecto más seguro y tener toda la información cumpliendo
                    lo estipulado en el
                    <strong>Plan Estratégico de Seguridad Vial (PESV)</strong>.
                </p>
            </div>
            <%= form_with model: @moto_checklist do |form| %>
                <% if @moto_checklist.errors.any? %>
                    <div class="alert alert-danger" role="alert">
                        <div class="fw-bold mb-2">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Se encontraron los siguientes errores:
                        </div>
                        <ul class="mb-0">
                            <% @moto_checklist.errors.full_messages.each do |error| %>
                                <li><%= error %></li>
                            <% end %>
                        </ul>
                    </div>
                <% end %>
                <div class="conesst-section-title mb-3">
                    <i class="bi bi-person-vcard me-1"></i>
                    1. INFORMACIÓN GENERAL DEL USUARIO Y DE LA MOTO
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        <div class="fw-semibold small text-muted">
                            Nombre del conductor
                        </div>
                        <div class="form-control bg-light">
                            <%= @user.name %>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="fw-semibold small text-muted">
                            Número de documento de identidad
                        </div>
                        <div class="form-control bg-light">
                            <%= @user.nro_document %>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <%= form.label :plate_moto, "Placa de la moto", class: "form-label fw-semibold" %>
                        <%= form.text_field :plate_moto, class: "form-control", required: true, autocomplete: "off" %>
                    </div>
                    <div class="col-12 col-md-6">
                        <%= form.label :mileage, "Kilometraje", class: "form-label fw-semibold" %>
                        <%= form.text_field :mileage, class: "form-control", required: true, autocomplete: "off" %>
                    </div>
                </div>
                <div class="conesst-section-title mb-3">
                    <i class="bi bi-person-check me-1"></i>
                    2. CONDICIONES DEL USUARIO
                </div>
                <div class="mb-4">
                    <p>
                        Para garantizar una movilidad segura, es necesario revisar tu
                        estado de salud para conducir en condiciones óptimas y revisar
                        que lleves contigo todos los Elementos de Protección Personal.
                    </p>
                </div>
                <div class="conesst-form-section mb-4">
                    <div class="fw-semibold mb-2">
                        ¿Estás en condiciones de salud y descanso para usar el vehículo
                        (sin malestar, mareos, fiebre, sueño u otros síntomas)?
                    </div>
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        <div class="form-check">
                            <%= form.radio_button :health_conditions, 0, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :health_conditions_0, "SI", class: "form-check-label fw-semibold" %>
                        </div>
                        <div class="form-check">
                            <%= form.radio_button :health_conditions, 1, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :health_conditions_1, "NO", class: "form-check-label fw-semibold" %>
                        </div>
                    </div>
                    <%= form.label :health_conditions_obs, "Observaciones / hallazgos", class: "form-label fw-semibold" %>
                    <%= form.text_field :health_conditions_obs, class: "form-control" %>
                </div>
                <div class="conesst-form-section mb-4">
                    <div class="fw-semibold mb-2">
                        ¿Llevas el equipo de protección personal requerido
                        (casco reglamentario, prendas con reflectivos ubicados en el
                        casco, piernas, brazos y espalda)? En lo posible, complementa
                        tu protección usando chaqueta y botas de motociclista,
                        rodilleras y guantes.
                    </div>
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        <div class="form-check">
                            <%= form.radio_button :protective_equipment, 0, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :protective_equipment_0, "SI", class: "form-check-label fw-semibold" %>
                        </div>
                        <div class="form-check">
                            <%= form.radio_button :protective_equipment, 1, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :protective_equipment_1, "NO", class: "form-check-label fw-semibold" %>
                        </div>
                    </div>
                    <%= form.label :protective_equipment_obs, "Observaciones / hallazgos", class: "form-label fw-semibold" %>
                    <%= form.text_field :protective_equipment_obs, class: "form-control" %>
                </div>
                <div class="conesst-section-title mb-3">
                    <i class="bi bi-bicycle me-1"></i>
                    3. CONDICIONES DEL VEHÍCULO
                </div>
                <div class="mb-4">
                    <p>
                        Conocer el estado de las condiciones principales de los
                        vehículos que conduces se vuelve fundamental para evitar un
                        incidente. En caso de que algún elemento descrito dentro de
                        la lista de chequeo no cumpla, deberás informarlo al
                        responsable de SST en tu empresa, quien deberá definir si el
                        vehículo se podrá movilizar.
                    </p>
                </div>
                <div class="conesst-form-section mb-4">
                    <div class="fw-semibold">
                        Estado de llantas
                    </div>
                    <div class="small text-muted mb-3">
                        Verifica la profundidad del labrado, presión, cortaduras o
                        protuberancia.
                    </div>
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        <div class="form-check">
                            <%= form.radio_button :tire_condition, 0, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :tire_condition_0, "SI", class: "form-check-label fw-semibold" %>
                        </div>
                        <div class="form-check">
                            <%= form.radio_button :tire_condition, 1, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :tire_condition_1, "NO", class: "form-check-label fw-semibold" %>
                        </div>
                    </div>
                    <%= form.label :tire_condition_obs, "Observaciones / hallazgos", class: "form-label fw-semibold" %>
                    <%= form.text_field :tire_condition_obs, class: "form-control" %>
                </div>
                <div class="conesst-form-section mb-4">
                    <div class="fw-semibold">
                        Luces
                    </div>
                    <div class="small text-muted mb-3">
                        Verifica el funcionamiento correcto de luces altas y bajas,
                        posición, direccionales y freno.
                    </div>
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        <div class="form-check">
                            <%= form.radio_button :lights_condition, 0, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :lights_condition_0, "SI", class: "form-check-label fw-semibold" %>
                        </div>
                        <div class="form-check">
                            <%= form.radio_button :lights_condition, 1, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :lights_condition_1, "NO", class: "form-check-label fw-semibold" %>
                        </div>
                    </div>
                    <%= form.label :lights_condition_obs, "Observaciones / hallazgos", class: "form-label fw-semibold" %>
                    <%= form.text_field :lights_condition_obs, class: "form-control" %>
                </div>
                <div class="conesst-form-section mb-4">
                    <div class="fw-semibold">
                        Bocina
                    </div>
                    <div class="small text-muted mb-3">
                        Verifica su funcionamiento.
                    </div>
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        <div class="form-check">
                            <%= form.radio_button :horn_condition, 0, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :horn_condition_0, "SI", class: "form-check-label fw-semibold" %>
                        </div>
                        <div class="form-check">
                            <%= form.radio_button :horn_condition, 1, required: true, checked: false,  class: "form-check-input" %>
                            <%= form.label :horn_condition_1, "NO", class: "form-check-label fw-semibold" %>
                        </div>
                    </div>
                    <%= form.label :horn_condition_obs, "Observaciones / hallazgos", class: "form-label fw-semibold" %>
                    <%= form.text_field :horn_condition_obs, class: "form-control" %>
                </div>
                <div class="conesst-form-section mb-4">
                    <div class="fw-semibold">
                        Espejos
                    </div>
                    <div class="small text-muted mb-3">
                        Revisa y posiciona correctamente los espejos.
                    </div>
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        <div class="form-check">
                            <%= form.radio_button :mirrors_condition, 0, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :mirrors_condition_0, "SI", class: "form-check-label fw-semibold" %>
                        </div>
                        <div class="form-check">
                            <%= form.radio_button :mirrors_condition, 1, required: true, checked: false, class: "form-check-label fw-semibold" %>
                            <%= form.label :mirrors_condition_1, "NO", class: "form-check-label fw-semibold" %>
                        </div>
                    </div>
                    <%= form.label :mirrors_condition_obs, "Observaciones / hallazgos", class: "form-label fw-semibold" %>
                    <%= form.text_field :mirrors_condition_obs, class: "form-control" %>
                </div>
                <div class="conesst-form-section mb-4">
                    <div class="fw-semibold">
                        Niveles de líquidos
                    </div>
                    <div class="small text-muted mb-3">
                        Revisa los niveles de aceite, líquido de frenos y refrigerante
                        (si aplica).
                    </div>
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        <div class="form-check">
                            <%= form.radio_button :liquids_condition, 0, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :liquids_condition_0, "SI", class: "form-check-label fw-semibold" %>
                        </div>
                        <div class="form-check">
                            <%= form.radio_button :liquids_condition, 1, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :liquids_condition_1, "NO", class: "form-check-label fw-semibold" %>
                        </div>
                    </div>
                    <%= form.label :liquids_condition_obs, "Observaciones / hallazgos", class: "form-label fw-semibold" %>
                    <%= form.text_field :liquids_condition_obs, class: "form-control" %>
                </div>
                <div class="conesst-form-section mb-4">
                    <div class="fw-semibold">
                        Fugas de fluidos
                    </div>
                    <div class="small text-muted mb-3">
                        Revisa que no existan fugas ni humedades en el motor,
                        suspensión, frenos y líquido refrigerante (si aplica).
                    </div>
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        <div class="form-check">
                            <%= form.radio_button :fluids_condition, 0, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :fluids_condition_0, "SI", class: "form-check-label fw-semibold" %>
                        </div>
                        <div class="form-check">
                            <%= form.radio_button :fluids_condition, 1, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :fluids_condition_1, "NO", class: "form-check-label fw-semibold" %>
                        </div>
                    </div>
                    <%= form.label :fluids_condition_obs, "Observaciones / hallazgos", class: "form-label fw-semibold" %>
                    <%= form.text_field :fluids_condition_obs, class: "form-control" %>
                </div>
                <div class="conesst-form-section mb-4">
                    <div class="fw-semibold">
                        Estado de frenos
                    </div>
                    <div class="small text-muted mb-3">
                        Verifica la tensión del pedal y el estado de las pastillas.
                    </div>
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        <div class="form-check">
                            <%= form.radio_button :brakes_condition, 0, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :brakes_condition_0, "SI", class: "form-check-label fw-semibold" %>
                        </div>
                        <div class="form-check">
                            <%= form.radio_button :brakes_condition, 1, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :brakes_condition_1, "NO", class: "form-check-label fw-semibold" %>
                        </div>
                    </div>
                    <%= form.label :brakes_condition_obs, "Observaciones / hallazgos", class: "form-label fw-semibold" %>
                    <%= form.text_field :brakes_condition_obs, class: "form-control" %>
                </div>
                <div class="conesst-form-section mb-4">
                    <div class="fw-semibold">
                        Transmisión
                    </div>
                    <div class="small text-muted mb-3">
                        Verifica la tensión de la cadena y lubricación.
                    </div>
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        <div class="form-check">
                            <%= form.radio_button :transmission_condition, 0, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :transmission_condition_0, "SI", class: "form-check-label fw-semibold" %>
                        </div>
                        <div class="form-check">
                            <%= form.radio_button :transmission_condition, 1, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :transmission_condition_1, "NO", class: "form-check-label fw-semibold" %>
                        </div>
                    </div>
                    <%= form.label :transmission_condition_obs, "Observaciones / hallazgos", class: "form-label fw-semibold" %>
                    <%= form.text_field :transmission_condition_obs, class: "form-control" %>
                </div>
                <div class="conesst-form-section mb-4">
                    <div class="fw-semibold">
                        Documentos
                    </div>
                    <div class="small text-muted mb-3">
                        Verifica la tarjeta de propiedad, SOAT y revisión técnico
                        mecánica (si aplica).
                    </div>
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        <div class="form-check">
                            <%= form.radio_button :documents_condition, 0, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :documents_condition_0, "SI", class: "form-check-label fw-semibold" %>
                        </div>
                        <div class="form-check">
                            <%= form.radio_button :documents_condition, 1, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :documents_condition_1, "NO", class: "form-check-label fw-semibold" %>
                        </div>
                    </div>
                    <%= form.label :documents_condition_obs, "Observaciones / hallazgos", class: "form-label fw-semibold" %>
                    <%= form.text_field :documents_condition_obs, class: "form-control" %>
                </div>
                <div class="conesst-form-section mb-4">
                    <div class="fw-semibold">
                        Kit de prevención
                    </div>
                    <div class="small text-muted mb-3">
                        Revisa las herramientas y el impermeable.
                    </div>
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        <div class="form-check">
                            <%= form.radio_button :kit_condition, 0, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :kit_condition_0, "SI", class: "form-check-label fw-semibold" %>
                        </div>
                        <div class="form-check">
                            <%= form.radio_button :kit_condition, 1, required: true, checked: false, class: "form-check-input" %>
                            <%= form.label :kit_condition_1, "NO", class: "form-check-label fw-semibold" %>
                        </div>
                    </div>
                    <%= form.label :kit_condition_obs, "Observaciones / hallazgos", class: "form-label fw-semibold" %>
                    <%= form.text_field :kit_condition_obs, class: "form-control" %>
                </div>
                <%= form.hidden_field :entity_id, value: @entity.id.to_i if @entity.present? %>
                <%= form.hidden_field :user_id, value: @user.id.to_i if @user.present? %>
                <%= form.hidden_field :date_list, value: Time.now if Current.user.present? %>
                <%= form.hidden_field :time_list, value: Time.now if Current.user.present? %>
                <%= form.hidden_field :user_autoriza, value: @user_autoriza.id.to_i if @user_autoriza.present? %>
                <%= form.hidden_field :code, value: @template.reference if @template.present? %>
                <%= form.hidden_field :version, value: @template.version.to_i if @template.present? %>
                <div class="conesst-actions mt-4">
                    <%= form.submit t('common.submit'), class: "conesst-btn conesst-btn-primary" %>
                    <%= link_to moto_checklists_path, class: "conesst-btn" do %>
                        <i class="bi bi-arrow-left me-1"></i>
                        Retornar
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
</div>