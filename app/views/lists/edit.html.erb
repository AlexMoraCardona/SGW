<div class="conesst-page">
  <div class="conesst-card mb-3">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div>
          <div class="conesst-card-header-title">
            <i class="bi bi-clipboard-check me-2"></i>
            <%= t('.title') %>
          </div>
          <div class="conesst-card-header-subtitle">
            Registro de verificación de la lista de chequeo
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="conesst-card">
    <div class="conesst-card-body">
      <%= form_with model: @list do |form| %>
        <% @list.errors.full_messages.each do |error| %>
          <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <%= error %>
          </div>
        <% end %>
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <%= form.label :state, "Estado", class: "form-label fw-semibold" %>
            <%= form.select :state, [['Cumple', 0], ['No cumple', 1], ['No aplica', 2]], {}, { class: "form-select" } %>
          </div>
          <div class="col-12">
            <%= form.label :observation, "Observación", class: "form-label fw-semibold" %>
            <%= form.text_field :observation, class: "form-control",  placeholder: "Ingrese una observación si es necesario" %>
          </div>
        </div>
        <%= form.hidden_field :entity_id, value: Current.user.entity.to_i %>
        <div class="conesst-actions mt-4">
          <%= form.button type: "submit", class: "conesst-btn conesst-btn-primary" do %>
            <i class="bi bi-check-circle me-1"></i>
            <%= t('common.submit') %>
          <% end %>
          <%= link_to check_lists_path, class: "conesst-btn conesst-btn-primary" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>