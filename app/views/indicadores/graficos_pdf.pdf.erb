                    <strong>Interpretación:</strong> 
                </td>
                <td style="border:1px solid black; width: 70%;padding: 10px;">
                    <%= @indicador_frecuencia_accidentalidad.interpretation %>
                </td>
            </tr>
            <tr style="border:1px solid black;width: 100%;">
                <td style="border:1px solid black; width: 30%;padding: 10px;">
                    <strong>Fuente de la información:</strong>
                </td>
                <td style="border:1px solid black; width: 70%;padding: 10px;">
                    <%= @indicador_frecuencia_accidentalidad.information_source %>
                </td>
            </tr>
            <tr style="border:1px solid black;width: 100%;">
                <td style="border:1px solid black; width: 30%;padding: 10px;">
                    <strong>Responsable de la gestión:</strong> 
                </td>
                <td style="border:1px solid black; width: 70%;padding: 10px;">
                    <%= @indicador_frecuencia_accidentalidad.responsible_management %>
                </td>
            </tr>
