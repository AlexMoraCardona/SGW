<head>
    <meta charset="utf-8">
    <%= wicked_pdf_stylesheet_link_tag "application" %>

    <style>
        @page {
            size: Letter landscape;
            margin: 10mm 7mm 10mm 7mm;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 8px;
            color: #000;
            margin: 0;
            padding: 0;
        }

        .pdf-container {
            width: 100%;
            margin: 0;
            padding: 0;
        }

        /* ==============================
           TABLA PRINCIPAL
           ============================== */

        .training-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin: 0;
            padding: 0;
        }

        .training-table th,
        .training-table td {
            border: 1px solid #000;
            padding: 4px 3px;
            vertical-align: middle;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        .training-table thead {
            display: table-header-group;
        }

        .training-table tbody {
            display: table-row-group;
        }

        .training-table tr {
            page-break-inside: avoid;
        }

        /* ==============================
           ENCABEZADOS
           ============================== */

        .objective-title {
            width: 9%;
            text-align: center;
            font-weight: bold;
            vertical-align: middle;
        }

        .objective-text {
            width: 91%;
            text-align: justify;
            font-size: 8px;
            line-height: 1.25;
            padding: 6px !important;
        }

        .column-header {
            text-align: center;
            font-weight: bold;
            font-size: 7px;
            line-height: 1.15;
            background: #eeeeee;
            vertical-align: middle !important;
        }

        /* ==============================
           ANCHOS DE COLUMNAS
           Total = 100%
           ============================== */

        .col-number {
            width: 4%;
            text-align: center;
        }

        .col-topic {
            width: 11%;
        }

        .col-duration {
            width: 7%;
            text-align: center;
        }

        .col-goal {
            width: 14%;
        }

        .col-scope {
            width: 10%;
        }

        .col-resources {
            width: 10%;
        }

        .col-responsible {
            width: 10%;
        }

        .col-date {
            width: 7%;
            text-align: center;
        }

        .col-coverage {
            width: 8%;
            text-align: center;
        }

        .col-workers {
            width: 8%;
            text-align: center;
        }

        .col-observations {
            width: 11%;
        }

        /* ==============================
           DATOS
           ============================== */

        .center {
            text-align: center;
        }

        .text-justify {
            text-align: justify;
        }

        .nowrap {
            white-space: nowrap;
        }

        /* ==============================
           FIRMAS
           ============================== */

        .signatures {
            width: 100%;
            margin-top: 12px;
            page-break-inside: avoid;
        }

        .signature-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .signature-table td {
            border: 1px solid #000;
            text-align: center;
            vertical-align: middle;
            padding: 4px;
        }

        .signature-space {
            height: 55px;
        }

        .signature-image {
            height: 50px;
            max-width: 180px;
            object-fit: contain;
        }

        .signature-name {
            font-size: 8px;
            font-weight: normal;
            line-height: 1.2;
            height: 25px;
            vertical-align: middle;
        }

        .signature-empty {
            height: 25px;
        }
    </style>
</head>

<div class="pdf-container">

    <table class="training-table">

        <colgroup>
            <col class="col-number">
            <col class="col-topic">
            <col class="col-duration">
            <col class="col-goal">
            <col class="col-scope">
            <col class="col-resources">
            <col class="col-responsible">
            <col class="col-date">
            <col class="col-coverage">
            <col class="col-workers">
            <col class="col-observations">
        </colgroup>

        <thead>

            <!-- OBJETIVO GENERAL -->
            <tr>
                <th class="objective-title">
                    OBJETIVO
                </th>

                <th colspan="10" class="objective-text">
                    Generar un proceso educacional estratégico aplicado de manera
                    organizada y sistémica, para proveer, actualizar y ampliar los
                    conocimientos y desarrollar habilidades que cubran la totalidad
                    de requerimientos para el desempeño de puestos y mejoramiento
                    de áreas específicas de la Organización.
                </th>
            </tr>

            <!-- ENCABEZADOS -->
            <tr>
                <th class="column-header">
                    Nro.
                </th>

                <th class="column-header">
                    TEMA DE<br>CAPACITACIÓN
                </th>

                <th class="column-header">
                    DURACIÓN
                </th>

                <th class="column-header">
                    OBJETIVO
                </th>

                <th class="column-header">
                    ALCANCE
                </th>

                <th class="column-header">
                    RECURSOS
                </th>

                <th class="column-header">
                    RESPONSABLE
                </th>

                <th class="column-header">
                    FECHA
                </th>

                <th class="column-header">
                    % DE COBERTURA<br>
                    EN CAPACITACIONES
                </th>

                <th class="column-header">
                    % DE TRABAJADORES<br>
                    CAPACITADOS
                </th>

                <th class="column-header">
                    OBSERVACIONES
                </th>
            </tr>

        </thead>

        <tbody>

            <% @training_items.each do |training_item| %>

                <tr>

                    <td class="center">
                        <%= training_item.consecutive %>
                    </td>

                    <td>
                        <%= training_item.training_topic %>
                    </td>

                    <td class="center">
                        <%= training_item.duration %>
                    </td>

                    <td class="text-justify">
                        <%= training_item.goals %>
                    </td>

                    <td class="text-justify">
                        <%= training_item.scope %>
                    </td>

                    <td class="text-justify">
                        <%= training_item.resources %>
                    </td>

                    <td>
                        <%= training_item.responsible %>
                    </td>

                    <td class="center">
                        <%= training_item.date_training %>
                    </td>

                    <td class="center">
                        <%= training_item.training_coverage_percentage %>
                    </td>

                    <td class="center">
                        <%= training_item.percentage_trained_workers %>
                    </td>

                    <td class="text-justify">
                        <%= training_item.observation %>
                    </td>

                </tr>

            <% end %>

        </tbody>

    </table>


    <!-- ==============================
         FIRMAS
         ============================== -->

    <div class="signatures">

        <table class="signature-table">

            <colgroup>
                <col style="width: 36%">
                <col style="width: 36%">
                <col style="width: 28%">
            </colgroup>

            <!-- ESPACIO PARA FIRMAS -->
            <tr>

                <td class="signature-space">

                    <% if @training.firm_legal_representative == 1 %>

                        <% if @rep.present? %>

                            <% if @rep.firm.attached? %>

                                <% if @rep.firm.image? %>

                                    <%= image_tag(
                                        Evaluation.wicked_blob_path(@rep.firm),
                                        class: "signature-image"
                                    ) %>

                                <% end %>

                            <% end %>

                        <% end %>

                    <% end %>

                </td>


                <td class="signature-space">

                    <% if @training.firm_adviser_sst == 1 %>

                        <% if @adv.present? %>

                            <% if @adv.firm.attached? %>

                                <% if @adv.firm.image? %>

                                    <%= image_tag(
                                        Evaluation.wicked_blob_path(@adv.firm),
                                        class: "signature-image"
                                    ) %>

                                <% end %>

                            <% end %>

                        <% end %>

                    <% end %>

                </td>


                <td class="signature-space">
                </td>

            </tr>


            <!-- NOMBRES -->
            <tr>

                <td class="signature-name">
                    <%= @training.name_user(
                        @training.user_legal_representative
                    ) %>
                    <br>
                    Representante Legal
                </td>


                <td class="signature-name">
                    <%= @training.name_user(
                        @training.user_adviser_sst
                    ) %>
                    <br>
                    Asesor SST
                </td>


                <td class="signature-empty">
                </td>

            </tr>

        </table>

    </div>

</div>
