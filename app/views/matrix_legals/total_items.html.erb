<% if @matrix_legal_items.present? %>
    <div class="container-fluid px-2 px-md-3">
        <div class="card shadow-sm border-0">
             <div class="card-header bg-light border-bottom">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                    <h5 class="mb-0">
                        <i class="bi bi-journal-text me-2"></i>
                        Matriz Legal
                    </h5>
                    <span class="badge bg-secondary align-self-start align-self-md-center">
                        <%= @matrix_legal_items.size %> registros
                    </span>

                    <%= link_to :back, class: "btn btn-secondary" do %>
                            <i class="bi bi-arrow-left-circle"></i>Retornar
                    <% end %>
                </div>
            </div>
            <div class="card-body p-2 p-md-3">
                 <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="text-center text-nowrap">
                                    <i class="bi bi-pencil-square me-1"></i>
                                    Editar
                                </th>
                                <th scope="col" class="text-center text-nowrap">
                                    <i class="bi bi-trash me-1"></i>
                                    Eliminar
                                </th>
                                <th scope="col" class="text-nowrap">
                                    <%= t('.year') %>
                                </th>
                                <th scope="col" class="text-nowrap">
                                    <%= t('.risk_factor') %>
                                </th>
                                <th scope="col" class="text-nowrap">
                                    <%= t('.issuing_entity') %>
                                </th>
                                <th scope="col" class="text-nowrap">
                                    <%= t('.requirement') %>
                                </th>
                                <th scope="col" class="text-nowrap">
                                    <%= t('.rule_name') %>
                                </th>
                                <th scope="col" class="text-nowrap">
                                    <%= t('.applicable_article') %>
                                </th>
                                <th scope="col" class="text-nowrap">
                                    <%= t('.apply') %>
                                </th>
                                <th scope="col" class="text-nowrap">
                                    <%= t('.evidence_compliance') %>
                                </th> 
                                <th scope="col" class="text-nowrap">
                                    <%= t('.responsible') %>
                                </th>
                                <th scope="col" class="text-nowrap">
                                    <%= t('.meets') %>
                                </th>
                                <th scope="col" class="text-nowrap">
                                    <%= t('.description_compliance') %>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <% @matrix_legal_items.where(meets: params[:format].to_i).each do |matrix_legal_item| %>
                                <tr>
                                    <td class="text-center">
                                        <%= link_to edit_matrix_legal_item_path(matrix_legal_item), class: "btn btn-sm btn-warning", title: t('common.edit'), data: { bs_toggle: "tooltip" } do %>
                                            <i class="bi bi-pencil"></i>
                                            <span class="d-none d-lg-inline ms-1">
                                                <%= t('common.edit') %>
                                            </span>
                                        <% end %>
                                    </td>
                                    <td class="text-center">
                                        <%= button_to matrix_legal_item_path(matrix_legal_item), method: :delete, class: "btn btn-sm btn-danger", title: "Eliminar", data: {bs_toggle: "tooltip", turbo_confirm: "¿Está seguro de eliminar este registro?" } do %>
                                            <i class="bi bi-trash"></i>
                                            <span class="d-none d-lg-inline ms-1">
                                                Eliminar
                                            </span>
                                        <% end %>
                                    </td>
                                    <td class="text-nowrap">
                                          <%= matrix_legal_item.year %>
                                    </td>
                                    <td>
                                        <%= matrix_legal_item.risk_factor %>
                                    </td>
                                    <td>
                                        <%= matrix_legal_item.issuing_entity %>
                                    </td>
                                    <td>
                                        <%= matrix_legal_item.requirement %>
                                    </td>
                                    <td>
                                        <%= matrix_legal_item.rule_name %>
                                    </td>
                                    <td>
                                        <%= matrix_legal_item.applicable_article %>
                                    </td>
                                    <td class="text-center text-nowrap">
                                        <%= matrix_legal_item.label_apply(matrix_legal_item.apply) %>
                                    </td>
                                    <td>
                                        <%= matrix_legal_item.evidence_compliance %>
                                    </td>
                                    <td>
                                        <%= matrix_legal_item.responsible %>
                                    </td>
                                    <td class="text-center text-nowrap">
                                        <%= matrix_legal_item.label_meets(matrix_legal_item.meets) %>
                                    </td>
                                    <td>
                                        <%= matrix_legal_item.description_compliance %>
                                    </td>
                                </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <%= link_to :back, class: "btn btn-secondary" do %>
        <i class="bi bi-arrow-left-circle"></i>Retornar
    <% end %>

<% end %>


