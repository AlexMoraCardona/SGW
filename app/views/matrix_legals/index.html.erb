<div class="container py-4">
  <% if params[:entity_id].present? || @entity.present? %>
    <%= render 'matrix_legal' %>
  <% else %>
    <!-- Encabezado -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body">
        <div class="row align-items-center">
          <div class="col-12 col-lg-2 text-center mb-3 mb-lg-0">
            <%= link_to root_path, class: "navbar-brand" do %>
              <%= image_tag "LogoConesst202305232.png", class: "img-fluid", style: "max-height:100px;" %>
            <% end %>
          </div>
          <div class="col-12 col-lg-10 text-center">
            <h2 class="fw-bold text-primary mb-2">
              Matriz Legal
            </h2>
            <p class="text-muted mb-0">
              Seleccione la empresa para consultar la información.
            </p>
          </div>
        </div>
      </div>
    </div>
    <!-- Formulario -->
    <div class="card shadow-sm">
      <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
          <i class="bi bi-building"></i>
          Selección de Empresa
        </h5>
      </div>
      <div class="card-body">
        <%= form_with model: @entity, method: :get do |form| %>
          <div class="row">
            <div class="col-12">
              <%= form.label :entity_id, "Empresa", class: "form-label fw-semibold" %>
              <% if @entities.present? %>
                    <%= form.collection_select :entity_id, @entities.order(id: :asc), :id, :business_name, { prompt: "-- Seleccionar Empresa --" }, { class: "form-select select2" } %>
              <% else %>
                   <input type="text" class="form-control" value="<%= @entity.business_name %>" readonly>
                   <%= form.hidden_field :entity_id, value: @entity.id %>
              <% end %>
            </div>
          </div>
          <hr>
          <!-- Botonera -->
          <div class="d-flex flex-column flex-md-row justify-content-center gap-2">
            <button type="submit" class="btn btn-success">
              <i class="bi bi-search"></i>
              Consultar
            </button>
            <%= link_to root_path, class: "btn btn-secondary" do %>
                <i class="bi bi-house-door-fill"></i>
                Inicio
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div> 
