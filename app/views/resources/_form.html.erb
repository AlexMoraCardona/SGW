<div class="container py-4">
  <div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
      <h4 class="mb-0">
        <i class="bi bi-cash-stack"></i>
        Asignación de Recursos para el SG-SST
      </h4>
    </div>
    <div class="card-body">
      <%= form_with model: @resource do |form| %>
        <% if @resource.errors.any? %>
          <div class="alert alert-danger">
            <h6 class="fw-bold">
              <i class="bi bi-exclamation-triangle-fill"></i>
              Se encontraron los siguientes errores:
            </h6>
            <hr>
            <ul class="mb-0">
              <% @resource.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <!-- Año -->
        <div class="row mb-4">
          <div class="col-12 col-md-3">
            <label class="form-label fw-semibold">
              Año
              <button type="button" class="btn btn-link p-0 ms-1"  data-bs-toggle="tooltip" title="Ingrese el año.">
                <%= image_tag "ayuda.png", width: 22, height: 22 %>
              </button>
            </label>
            <%= form.number_field :year, class: "form-control", required: true %>
          </div>
        </div>
        <!-- Representante Legal -->
        <div class="mb-4">
          <label class="form-label fw-semibold">
            Representante Legal
            <button type="button"
                    class="btn btn-link p-0 ms-1"
                    data-bs-toggle="tooltip"
                    title="Seleccione el nombre del Representante Legal.">
              <%= image_tag "ayuda.png", width: 22, height: 22 %>
            </button>
          </label>
          <%= form.collection_select :user_legal_representative,
                User.usuarios_empresa.order(id: :asc), :id, :name,  { prompt: "-- Seleccionar Representante Legal --" }, { class: "form-select select2" } %>
        </div>
        <!-- Asesor SST -->
        <div class="mb-4">
          <label class="form-label fw-semibold">
            Asesor SST
            <button type="button" class="btn btn-link p-0 ms-1" data-bs-toggle="tooltip" title="Seleccione el nombre del Asesor SST.">
              <%= image_tag "ayuda.png", width: 22, height: 22 %>
            </button>
          </label>
          <%= form.collection_select :user_adviser_sst, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccionar Asesor SST --" }, { class: "form-select select2" } %>
        </div>
        <!-- Responsable SST -->
        <div class="mb-4">
          <label class="form-label fw-semibold">
            Responsable SST
            <button type="button" class="btn btn-link p-0 ms-1" data-bs-toggle="tooltip" title="Seleccione el nombre del Responsable SST.">
              <%= image_tag "ayuda.png", width: 22, height: 22 %>
            </button>
          </label>
          <%= form.collection_select :user_responsible_sst, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccionar Responsable SST --" }, { class: "form-select select2" } %>
        </div>
        <!-- Campos ocultos -->
        <%= form.hidden_field :entity_id,
            value: params[:entity_id].to_i %>
        <% if @template.present? %>
          <%= form.hidden_field :code, value: @template.reference %>
          <%= form.hidden_field :version, value: @template.version.to_i %>
        <% end %>
        <hr>
        <!-- Botonera -->
        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
          <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i>
            <%= t('common.submit') %>
          </button>
          <%= link_to :back, class: "btn btn-secondary" do %>
            <i class="bi bi-arrow-left-circle"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>