<div class="conesst-page">
  <div class="conesst-card conesst-password-card">
    <div class="conesst-header">
      <div class="conesst-header-content">
        <div class="conesst-header-icon conesst-password-icon">
          <i class="bi bi-key-fill"></i>
        </div>
        <div>
          <h2 class="conesst-title">
            Solicitud cambio de clave
          </h2>

          <p class="conesst-subtitle">
            Ingresa tus datos para solicitar el cambio de clave.
          </p>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with url: "/sessions/generarclave/path",
                    method: :post,
                    local: true,
                    data: { turbo: false } do |form| %>
        <div class="mb-3">
          <%= form.label :usu, "Usuario", class: "form-label" %>
          <%= form.text_field :usu, class: "form-control", required: true, autocomplete: "username", placeholder: "Usuario" %>
        </div>
        <div class="mb-3">
          <%= form.label :doc, "Documento", class: "form-label" %>
          <%= form.text_field :doc, class: "form-control", required: true, autocomplete: "off", inputmode: "numeric", placeholder: "Documento" %>
        </div>
        <div class="conesst-turnstile-wrapper">
          <div class="cf-turnstile"
               data-sitekey="<%= Rails.application.credentials.dig(
                 :cloudflare_turnstile,
                 :recovery_site_key
               ) %>"
               data-theme="light">
          </div>
        </div>
        <div class="conesst-actions">
          <%= form.submit t('common.submitclave'), class: "btn conesst-btn-primary" %>
          <%= link_to root_path, class: "btn conesst-btn-secondary", data: { turbo: false } do %>
            <i class="bi bi-arrow-left me-1"></i>
            Cancelar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer></script>
