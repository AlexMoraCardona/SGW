<% if @entity.present? %>
    <div class="conesst-page">
        <div class="conesst-card mb-3">
            <div class="conesst-card-header">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3">
                    <div>
                        <h3 class="mb-1">
                            <%= @entity.business_name %>
                        </h3>
                        <small class="text-muted">
                            NIT:
                            <%= EvaluationRuleDetail.miles(@entity.identification_number) if @entity.identification_number.present? %>
                            <% if @entity.verification_digit.present? %>
                                -<%= @entity.verification_digit %>
                            <% end %>
                        </small>
                    </div>
                    <div class="conesst-actions">
                        <%= link_to new_safety_inspection_path(entity_id: @entity.id), class: "conesst-btn conesst-btn-primary" do %>
                            <i class="bi bi-plus-circle me-1"></i>
                            <%= t('common.create_safety_inspection') %>
                        <% end %>
                    </div>
                </div>
            </div>
            <div class="conesst-card-body">
                <% if @safety_inspections.present? %>
                    <div class="conesst-card d-none d-md-block">
                        <div class="conesst-card-body p-0">
                            <div class="conesst-table-wrapper">
                                <table class="conesst-table table-hover">
                                    <thead>
                                        <tr>
                                            <th scope="col">
                                                Formato de inspección de seguridad del:
                                            </th>
                                            <th scope="col">
                                                Lugar de la inspección:
                                            </th>
                                            <th scope="col">
                                                Área de trabajo:
                                            </th>
                                            <th scope="col">
                                                <%= t('.user_responsible') %>
                                            </th>
                                            <th scope="col">
                                                Firma
                                            </th>
                                            <th scope="col">
                                                Acciones
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% @safety_inspections.each do |safety_inspection| %>
                                            <tr>
                                                <td>
                                                    <%= safety_inspection.date_inspection %>
                                                </td>
                                                <td>
                                                    <%= safety_inspection.place_inspection %>
                                                </td>
                                                <td>
                                                    <%= safety_inspection.area_inspection %>
                                                </td>
                                                <td>
                                                    <%= safety_inspection.name_user(safety_inspection.user_responsible) %>
                                                </td>
                                                <td>
                                                    <% if safety_inspection.firm_responsible.to_i == 0 %>
                                                        <%= link_to firmar_responsable_inspeccion_path(safety_inspection.id, 2), class: "conesst-btn conesst-btn-warning" do %>
                                                            <i class="bi bi-pen me-1"></i>
                                                            <%= t('common.firmar') %>
                                                        <% end %>
                                                    <% else %>
                                                        <span class="conesst-status conesst-status-success">
                                                            <i class="bi bi-check-circle me-1"></i>
                                                            <%= safety_inspection.date_firm_responsible %>
                                                        </span>
                                                    <% end %>
                                                </td>
                                                <td>
                                                    <div class="conesst-actions">
                                                        <%= link_to situacion_condicion_path(safety_inspection.id), class: "conesst-btn conesst-btn-primary" do %>
                                                            <i class="bi bi-search me-1"></i>
                                                            Ver situación o condición
                                                        <% end %>
                                                        <%= link_to safety_inspection_path(safety_inspection.id), class: "conesst-btn" do %>
                                                            <i class="bi bi-eye me-1"></i>
                                                            <%= t('common.show_safety_inspection') %>
                                                        <% end %>
                                                        <%= link_to edit_safety_inspection_path(safety_inspection.id), class: "conesst-btn conesst-btn-warning" do %>
                                                            <i class="bi bi-pencil me-1"></i>
                                                            <%= t('common.edit') %>
                                                        <% end %>
                                                        <%= link_to ver_informe_inspeccion_path(safety_inspection.id), class: "conesst-btn" do %>
                                                            <i class="bi bi-file-text me-1"></i>
                                                            Ver informe
                                                        <% end %>
                                                        <%= link_to pdf_informe_inspeccion_path(safety_inspection.id, format: 'pdf'), class: "conesst-btn conesst-btn-success" do %>
                                                            <i class="bi bi-file-earmark-pdf me-1"></i>
                                                            Ver informe PDF
                                                        <% end %>
                                                        <% if Current.user.level > 0 && Current.user.level < 3 %>
                                                            <%= button_to safety_inspection, method: :delete, class: "conesst-btn conesst-btn-danger", form_class: "d-inline", data: {turbo_confirm: "¿Está seguro de eliminar este registro? Esta acción no se puede deshacer."} do %>
                                                                <i class="bi bi-trash me-1"></i>
                                                                Eliminar
                                                            <% end %>
                                                        <% end %>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% end %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="d-md-none">
                        <% @safety_inspections.each do |safety_inspection| %>
                            <div class="conesst-card mb-3">
                                <div class="conesst-card-body">
                                    <div class="mb-3">
                                        <div class="small text-muted">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            Fecha de inspección
                                        </div>
                                        <div class="fw-semibold">
                                            <%= safety_inspection.date_inspection %>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="small text-muted">
                                            <i class="bi bi-geo-alt me-1"></i>
                                            Lugar de la inspección
                                        </div>
                                        <div>
                                            <%= safety_inspection.place_inspection %>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="small text-muted">
                                            <i class="bi bi-building me-1"></i>
                                            Área de trabajo
                                        </div>
                                        <div>
                                            <%= safety_inspection.area_inspection %>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="small text-muted">
                                            <i class="bi bi-person me-1"></i>
                                            <%= t('.user_responsible') %>
                                        </div>
                                        <div>
                                            <%= safety_inspection.name_user(
                                                safety_inspection.user_responsible
                                            ) %>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="small text-muted">
                                            <i class="bi bi-pen me-1"></i>
                                            Firma
                                        </div>
                                        <% if safety_inspection.firm_responsible.to_i == 0 %>
                                            <%= link_to firmar_responsable_inspeccion_path(safety_inspection.id, 2), class: "conesst-btn conesst-btn-warning" do %>
                                                <i class="bi bi-pen me-1"></i>
                                                <%= t('common.firmar') %>
                                            <% end %>
                                        <% else %>
                                            <span class="conesst-status conesst-status-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                <%= safety_inspection.date_firm_responsible %>
                                            </span>
                                        <% end %>
                                    </div>
                                    <div>
                                        <div class="small text-muted mb-2">
                                            <i class="bi bi-list-check me-1"></i>
                                            Acciones
                                        </div>
                                        <div class="conesst-actions">
                                            <%= link_to situacion_condicion_path(safety_inspection.id), class: "conesst-btn conesst-btn-primary" do %>
                                                <i class="bi bi-search me-1"></i>
                                                Ver situación o condición
                                            <% end %>
                                            <%= link_to safety_inspection_path(safety_inspection.id), class: "conesst-btn" do %>
                                                <i class="bi bi-eye me-1"></i>
                                                <%= t('common.show_safety_inspection') %>
                                            <% end %>
                                            <%= link_to edit_safety_inspection_path(safety_inspection.id), class: "conesst-btn conesst-btn-warning" do %>
                                                <i class="bi bi-pencil me-1"></i>
                                                <%= t('common.edit') %>
                                            <% end %>
                                            <%= link_to ver_informe_inspeccion_path(safety_inspection.id), class: "conesst-btn" do %>
                                                <i class="bi bi-file-text me-1"></i>
                                                Ver informe
                                            <% end %>
                                            <%= link_to pdf_informe_inspeccion_path(safety_inspection.id, format: 'pdf'), class: "conesst-btn conesst-btn-success" do %>
                                                <i class="bi bi-file-earmark-pdf me-1"></i>
                                                Ver informe PDF
                                            <% end %>
                                            <% if Current.user.level > 0 && Current.user.level < 3 %>
                                                <%= button_to safety_inspection, method: :delete, class: "conesst-btn conesst-btn-danger", form_class: "d-inline", data: {turbo_confirm: "¿Está seguro de eliminar este registro? Esta acción no se puede deshacer."} do %>
                                                    <i class="bi bi-trash me-1"></i>
                                                    Eliminar
                                                <% end %>
                                            <% end %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% end %>
                    </div>
                <% else %>
                    <div class="text-center py-4">
                        <i class="bi bi-clipboard-x fs-1 text-muted"></i>
                        <p class="text-muted mt-2 mb-0">
                            No hay inspecciones de seguridad registradas.
                        </p>
                    </div>
                <% end %>
            </div>
        </div>
        <div class="conesst-actions">
            <%= link_to request.referer || root_path, class: "conesst-btn" do %>
                <i class="bi bi-arrow-left me-1"></i>
                Retornar
            <% end %>
        </div>
    </div>
<% end %>