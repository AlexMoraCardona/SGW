<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-clipboard-x fs-4"></i>
          <div>
            <h2 class="conesst-card-header-title mb-0">
              Participantes Reprobados
            </h2>
            <div class="conesst-card-header-subtitle">
              Detalle de las respuestas incorrectas de la evaluación
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <% respuestas_incorrectas = @det_repros.where("correct = ?", 0) %>
      <% if respuestas_incorrectas.present? %>
        <div class="conesst-table-wrapper d-none d-md-block">
          <table class="conesst-table table-hover">
            <thead>
              <tr>
                <th>Pregunta</th>
                <th>Respuesta del participante</th>
                <th>Respuesta correcta</th>
              </tr>
            </thead>
            <tbody>
              <% respuestas_incorrectas.each do |det_repro| %>
                <tr>
                  <td>
                    <div class="fw-semibold">
                      <%= det_repro.exam_question.question %>
                    </div>
                  </td>
                  <td>
                    <span class="text-danger">
                      <%= det_repro.answer_user %>
                    </span>
                  </td>
                  <td>
                    <span class="text-success fw-semibold">
                      <%= det_repro.exam_question.good_answe %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="d-md-none">
          <% respuestas_incorrectas.each_with_index do |det_repro, index| %>
            <div class="conesst-card mb-3">
              <div class="conesst-card-header">
                <div class="d-flex justify-content-between align-items-center gap-2">
                  <div class="fw-semibold">
                    Pregunta <%= index + 1 %>
                  </div>
                  <span class="badge text-bg-danger">
                    Incorrecta
                  </span>
                </div>
              </div>
              <div class="conesst-card-body">
                <div class="mb-3">
                  <div class="small text-muted mb-1">
                    <i class="bi bi-question-circle me-1"></i>
                    Pregunta
                  </div>
                  <div class="fw-semibold">
                    <%= det_repro.exam_question.question %>
                  </div>
                </div>
                <div class="mb-3">
                  <div class="small text-muted mb-1">
                    <i class="bi bi-person-x me-1"></i>
                    Respuesta del participante
                  </div>
                  <div class="text-danger">
                    <%= det_repro.answer_user %>
                  </div>
                </div>
                <div>
                  <div class="small text-muted mb-1">
                    <i class="bi bi-check-circle me-1"></i>
                    Respuesta correcta
                  </div>
                  <div class="text-success fw-semibold">
                    <%= det_repro.exam_question.good_answe %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-check-circle fs-1 text-success"></i>
          <h5 class="mt-3">
            No hay respuestas incorrectas
          </h5>
          <p class="text-muted mb-0">
            No se encontraron respuestas incorrectas para este participante.
          </p>
        </div>
      <% end %>
      <div class="conesst-actions mt-4">
        <%= link_to :back, class: "conesst-btn conesst-btn-primary" do %>
          <i class="bi bi-arrow-left me-1"></i>
          Retornar
        <% end %>
      </div>
    </div>
  </div>
</div>