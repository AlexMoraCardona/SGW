<div class="conesst-page">
  <div class="mb-3">
    <%= link_to root_path, class: "d-inline-block" do %>
      <%= image_tag "LogoConesst202305232.png", width: 100, height: 100, alt: "CONESST" %>
    <% end %>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-clipboard2-check fs-5"></i>
        <div>
          <h2 class="mb-0">
            Encuesta medidas de prevención y control de peligros y riesgos por parte de los trabajadores
          </h2>
          <small class="text-muted">
            Información registrada en la encuesta de prevención y control
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <% if @admin_extent_danger.present? %>
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <div class="border rounded p-3 h-100 bg-light">
              <div class="small text-muted mb-1">
                <i class="bi bi-building me-1"></i>
                Empresa
              </div>
              <div class="fw-semibold">
                <%= @entity.business_name if @entity.present? %>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="border rounded p-3 h-100 bg-light">
              <div class="small text-muted mb-1">
                <i class="bi bi-calendar3 me-1"></i>
                Fecha
              </div>
              <div class="fw-semibold">
                <%= @admin_extent_danger.date_creation %>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="border rounded p-3 h-100 bg-light">
              <div class="small text-muted mb-1">
                <i class="bi bi-person me-1"></i>
                Nombre completo
              </div>
              <div class="fw-semibold">
                <%= @admin_extent_danger.user.name %>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="border rounded p-3 h-100 bg-light">
              <div class="small text-muted mb-1">
                <i class="bi bi-person-vcard me-1"></i>
                Número de documento de identidad
              </div>
              <div class="fw-semibold">
                <%= @admin_extent_danger.user.nro_document %>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-4">
          <div class="conesst-card-header rounded-top">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-briefcase fs-5"></i>
              <div>
                <h5 class="mb-0">Información laboral</h5>
              </div>
            </div>
          </div>
          <div class="border border-top-0 rounded-bottom p-3">
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <div class="small text-muted">Tipo de contrato</div>
                <div class="fw-semibold">
                  <%= AdminExtentDanger.label_type_contract(@admin_extent_danger.type_contract) %>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="small text-muted">Cargo</div>
                <div class="fw-semibold">
                  <%= @admin_extent_danger.post %>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="small text-muted">Unidad / Área</div>
                <div class="fw-semibold">
                  <%= @admin_extent_danger.area %>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="small text-muted">
                  ¿Ha recibido capacitación de peligros y riesgos?
                </div>
                <div class="fw-semibold">
                  <%= AdminExtentDanger.label_received_training(@admin_extent_danger.received_training) %>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-4">
          <div class="conesst-card-header rounded-top">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-shield-exclamation fs-5"></i>
              <div>
                <h5 class="mb-0">Antecedentes de accidentalidad</h5>
              </div>
            </div>
          </div>
          <div class="border border-top-0 rounded-bottom p-3">
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <div class="small text-muted">
                  ¿Ha sufrido algún incidente, accidente o enfermedad laboral?
                </div>
                <div class="fw-semibold">
                  <%= AdminExtentDanger.label_suffered_accident(@admin_extent_danger.suffered_accident) %>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="small text-muted">
                  ¿Cuál incidente, accidente o enfermedad laboral?
                </div>
                <div class="fw-semibold">
                  <%= @admin_extent_danger.cual_suffered_accident %>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-4">
          <div class="conesst-card-header rounded-top">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-person-check fs-5"></i>
              <div>
                <h5 class="mb-0">Elementos de protección personal</h5>
              </div>
            </div>
          </div>
          <div class="border border-top-0 rounded-bottom p-3">
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <div class="small text-muted">
                  ¿Usa elementos de protección personal?
                </div>
                <div class="fw-semibold">
                  <%= AdminExtentDanger.label_epp(@admin_extent_danger.epp) %>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="small text-muted">
                  ¿Cuáles?
                </div>
                <div class="fw-semibold">
                  <%= @admin_extent_danger.epp_cuales %>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-4">
          <div class="conesst-card-header rounded-top">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-tools fs-5"></i>
              <div>
                <h5 class="mb-0">Equipos y propuestas de control</h5>
              </div>
            </div>
          </div>
          <div class="border border-top-0 rounded-bottom p-3">
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <div class="small text-muted">
                  ¿Qué equipos opera?
                </div>
                <div class="fw-semibold">
                  <%= @admin_extent_danger.equipment_operates %>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="small text-muted">
                  Propuestas de control
                </div>
                <div class="fw-semibold">
                  <%= @admin_extent_danger.control_proposal %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle fs-5"></i>
        <div>
          <h4 class="mb-0">
            Peligros y riesgos identificados
          </h4>
          <small class="text-muted">
            Respuestas en las que el usuario indicó estar expuesto
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <% if @form_preventions.present? %>
        <% exposed_preventions = @form_preventions.where("exposed = ?", 1) %>
        <% if exposed_preventions.present? %>
          <div class="conesst-table-wrapper">
            <table class="conesst-table">
              <thead>
                <tr>
                  <th>Peligro / Riesgo</th>
                  <th>Descripción Peligro / Riesgo</th>
                  <th class="text-center">Exposición</th>
                </tr>
              </thead>
              <tbody>
                <% exposed_preventions.each do |form_prevention| %>
                  <tr>
                    <td data-label="Peligro / Riesgo">
                      <%= form_prevention.clasification_danger.name %>
                    </td>
                    <td data-label="Descripción Peligro / Riesgo">
                      <%= form_prevention.clasification_danger_detail.name %>
                    </td>
                    <td data-label="Exposición" class="text-center">
                      <%= FormPrevention.label_exposed(form_prevention.exposed) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="alert alert-light border mb-0">
            <i class="bi bi-info-circle me-1"></i>
            No se identificaron peligros o riesgos a los que el usuario indique estar expuesto.
          </div>
        <% end %>
      <% else %>
        <div class="alert alert-light border mb-0">
          <i class="bi bi-info-circle me-1"></i>
          No hay respuestas registradas para esta encuesta.
        </div>
      <% end %>
    </div>
  </div>
  <div class="conesst-actions">
    <%= link_to admin_extent_dangers_path, class: "conesst-btn conesst-btn-success" do %>
      <i class="bi bi-arrow-left me-1"></i>
      <%= t('common.return') %>
    <% end %>
  </div>
</div>