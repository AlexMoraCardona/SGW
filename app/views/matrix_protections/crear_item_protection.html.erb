<div class="container-fluid px-2 px-md-4 py-3">
    <div class="card shadow-sm mx-auto" style="max-width: 1100px;">
        <div class="card-header bg-light border-bottom">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-check fs-4 text-primary"></i>
                <h5 class="mb-0">Agregar Elemento de Protección Personal</h5>
            </div>
        </div>
        <div class="card-body p-3 p-md-4">
            <%= form_with model: @matrix_protection_item do |form| %>
                <% if @matrix_protection_item.errors.any? %>
                    <div class="alert alert-danger" role="alert">
                        <div class="fw-bold mb-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            Se encontraron los siguientes errores:
                        </div>
                        <ul class="mb-0 ps-3">
                            <% @matrix_protection_item.errors.full_messages.each do |error| %>
                                <li><%= error %></li>
                            <% end %>
                        </ul>
                    </div>
                <% end %>
                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-shield-check text-primary me-1"></i>
                        Elemento de Protección
                    </label>
                    <%= form.collection_select(:protection_element_id, @protection_elements.order(id: :asc), :id, :name, { prompt: '-- Seleccionar Elemento de Protección --' }, { class: "form-select" }) %>
                </div>
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt text-primary"></i>
                            <%= t('.areas') %>
                            <span data-bs-toggle="tooltip" title="Especificar las zonas de uso." class="text-secondary" style="cursor: help;">
                                <i class="bi bi-question-circle"></i>
                            </span>
                        </label>
                        <%= form.select(:areas, options_for_select(@company_areas.map { |area| [area.name, area.name] }),{},{multiple: true, include_blank: false, class: "form-select", size: 6}) %>
                        <div class="form-text">
                            <i class="bi bi-info-circle me-1"></i>
                            Puede seleccionar varias zonas.
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold d-flex align-items-center gap-2">
                            <i class="bi bi-person-check text-primary"></i>
                            <%= t('.personal_induction') %>
                            <span data-bs-toggle="tooltip" title="Especificar si se requiere inducción personal." class="text-secondary" style="cursor: help;">                <i class="bi bi-question-circle"></i></span>
                        </label>
                        <%= form.select(:personal_induction, [['N/A', 0], ['NO', 1], ['SI', 2]], {}, { class: "form-select" }) %>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold d-flex align-items-center gap-2">
                            <i class="bi bi-file-earmark-text text-primary"></i>
                            <%= t('.date_sheet') %>
                            <span data-bs-toggle="tooltip" title="Especificar si existe ficha técnica." class="text-secondary" style="cursor: help;">                <i class="bi bi-question-circle"></i></span>
                        </label>
                        <%= form.select(:date_sheet, [['N/A', 0], ['NO', 1], ['SI', 2]], {}, { class: "form-select" }) %>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold d-flex align-items-center gap-2">
                              <i class="bi bi-box-seam text-primary"></i>
                              <%= t('.delivery_format') %>
                              <span data-bs-toggle="tooltip" title="Especificar si existe formato de entrega." class="text-secondary" style="cursor: help;">
                                <i class="bi bi-question-circle"></i>
                              </span>
                        </label>
                        <%= form.select(:delivery_format, [['N/A', 0], ['NO', 1], ['SI', 2]], {}, { class: "form-select" }) %>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold d-flex align-items-center gap-2">
                              <i class="bi bi-hourglass-split text-primary"></i>
                              <%= t('.durability') %>
                              <span data-bs-toggle="tooltip" title="Especificar la durabilidad del elemento de protección." class="text-secondary" style="cursor: help;">
                                    <i class="bi bi-question-circle"></i>
                              </span>
                        </label>
                        <%= form.text_field :durability, class: "form-control", placeholder: "Ingrese la durabilidad del elemento" %>
                    </div>
                </div>
                <!-- CAMPO OCULTO -->
                <%= form.hidden_field :matrix_protection_id, value: params[:id].to_i %>
                <!-- BOTONERA -->
                <div class="border-top pt-3 mt-4">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i>
                            <%= t('common.submit') %>
                        </button>
                        <%= link_to matrix_protections_path(entity_id: Current.user.entity), class:"btn btn-secondary" do %>
                            <i class="bi bi-arrow-left-circle"></i>
                            Retornar
                        <% end %>
                    </div>
                </div>
            <% end %>
        </div>
      </div>
  <!-- ========================================================= -->
  <!-- LISTADO DE ELEMENTOS                                     -->
  <!-- ========================================================= -->
  <div class="card shadow-sm mx-auto mt-4" style="max-width: 1100px;">
        <!-- Encabezado -->
        <div class="card-header bg-light">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-fill-check fs-4 text-primary"></i>
                    <h5 class="mb-0">
                        Elementos de Protección Personal
                    </h5>
            </div>
        </div>
        <div class="card-body p-2 p-md-4">
            <% if @matrix_protection_items.present? %>
                <!-- La tabla permite desplazamiento horizontal en celular -->
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>
                                    <i class="bi bi-shield-check me-1"></i>
                                    Elemento de Protección
                                </th>
                                <th class="text-center">
                                    <i class="bi bi-image me-1"></i>
                                    Imagen
                                </th>
                                <th class="text-center">
                                    <i class="bi bi-pencil-square"></i>
                                    Editar
                                </th>
                                <th class="text-center">
                                    <i class="bi bi-trash"></i>
                                    Eliminar
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <% @matrix_protection_items.each do |matrix_protection_item| %>
                                <tr>
                                    <td>
                                        <span class="fw-semibold">
                                            <%= matrix_protection_item.protection_element.name %>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <% if matrix_protection_item.protection_element.img_elem.attached? %>
                                            <% if matrix_protection_item.protection_element.img_elem.image? %>
                                                <%= image_tag(matrix_protection_item.protection_element.img_elem, class: "img-fluid rounded", style: "max-width: 90px; max-height: 90px; object-fit: contain;" ) %>
                                            <% end %>
                                        <% else %>
                                            <%= image_tag("avatar.jpg", class: "img-fluid rounded", style: "width: 70px; height: 70px; object-fit: cover;" ) %>
                                        <% end %>
                                    </td>
                                    <td class="text-center">
                                        <% if Current.user.level > 0 && Current.user.level < 4 %>
                                            <%= link_to edit_matrix_protection_item_path(matrix_protection_item), class: "btn btn-warning btn-sm text-white me-2", title: "Editar", data: { bs_toggle: "tooltip" } do %>
                                                <i class="bi bi-pencil"></i><span class="d-none d-md-inline"> Editar</span>
                                            <% end %>
                                        <% end %>    
                                    </td>
                                    <td class="text-center">
                                        <% if Current.user.level > 0 && Current.user.level < 4 %>
                                            <%= link_to matrix_protection_item, class: "btn btn-danger", title: "Eliminar", data: {turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar este registro? Esta acción no se puede deshacer.", bs_toggle: "tooltip"} do %>
                                                <i class="bi bi-trash"></i><span class="d-none d-md-inline">Eliminar</span>
                                            <% end %>
                                        <% end %>    
                                    </td>
                                </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>
            <% else %>
                <div class="alert alert-info text-center mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                          No hay elementos de protección personal registrados.
                </div>
            <% end %>
        </div>
    </div>
</div>
