<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-pen fs-5"></i>
        <div>
          <h4 class="mb-0">
            Firma autorizada del Responsable
          </h4>
          <small class="text-muted">
            Confirmación de autorización de la firma del responsable de la inspección.
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @safety_inspection do |form| %>
        <% if @safety_inspection.errors.any? %>
          <div class="alert alert-danger mb-4" role="alert">
            <div class="fw-semibold mb-2">
              <i class="bi bi-exclamation-triangle me-1"></i>
              Se encontraron los siguientes errores:
            </div>
            <ul class="mb-0">
              <% @safety_inspection.errors.full_messages.each do |error| %>
                <li>
                  <%= error %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="row g-3 mb-4">
          <div class="col-12">
            <div class="border rounded p-3 bg-light">
              <div class="small text-muted mb-1">
                <i class="bi bi-person me-1"></i>
                Responsable
              </div>
              <div class="fw-semibold">
                <%= @safety_inspection.name_user(@safety_inspection.user_responsible) %>
              </div>
            </div>
          </div>
        </div>
        <div class="row g-3 mb-4">
          <div class="col-12">
            <label class="form-label fw-semibold">
              <i class="bi bi-pen me-1"></i>
              Firma autorizada del Responsable
            </label>
            <div class="d-flex flex-wrap gap-4 mt-2">
              <div class="form-check">
                <%= form.radio_button(:firm_responsible, 0, class: "form-check-input") %>
                <%= form.label(:firm_responsible, "No", value: 0, class: "form-check-label") %>
              </div>
              <div class="form-check">
                <%= form.radio_button(:firm_responsible, 1, class: "form-check-input") %>
                <%= form.label(:firm_responsible, "Sí", value: 1, class: "form-check-label") %>
              </div>
            </div>
          </div>
        </div>
        <%= form.hidden_field(:date_firm_responsible, value: Time.now) %>
        <div class="conesst-actions mt-4">
          <%= form.submit(t('common.submit'), class: "conesst-btn conesst-btn-primary") %>
          <%= link_to(request.referer || root_path, class: "conesst-btn") do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>