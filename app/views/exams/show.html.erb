<div class="conesst-page">
    <div class="mb-3">
        <%= link_to root_path, class: "d-inline-block" do %>
            <%= image_tag "LogoConesst202305232.png", width: 100, height: 100, alt: "CONESST" %>
        <% end %>
    </div>
    <% if params[:entity_id].present? %>
        <%= render 'historico_evaluaciones' %>
    <% else %>
        <div class="conesst-card">
            <div class="conesst-card-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clipboard-data fs-4"></i>
                    <div>
                        <h2 class="mb-0">
                            Informe Evaluaciones
                        </h2>
                        <small class="text-muted">
                            Consulta histórica de evaluaciones por entidad
                        </small>
                    </div>
                </div>
            </div>
            <div class="conesst-card-body">
                <%= form_with model: @entity, method: :get do |form| %>
                    <div class="row g-3">
                        <div class="col-12 col-md-7">
                            <% if Current.user.level == 1 %>
                                <%= form.label :entity_id, "Entidad", class: "form-label fw-semibold" %>
                                <%= form.collection_select :entity_id, @entities, :id, :business_name, { prompt: "-- Seleccionar Entidad --" }, { class: "form-control input-sm select2" } %>
                            <% else %>
                                <%= form.label :entity_id, "Entidad", class: "form-label fw-semibold" %>
                                <div class="form-control bg-light">
                                    <%= @entities.business_name %>
                                </div>
                                <%= form.hidden_field :entity_id, value: @entities.id.to_i %>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-actions mt-4">
                        <%= form.submit "Consultar", class: "conesst-btn conesst-btn-primary" %>
                    </div>
                <% end %>
            </div>
        </div>
    <% end %>
</div>
