<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-briefcase-medical fs-5"></i>
        <div>
          <h4 class="mb-0">
            LISTA DE CHEQUEO BOTIQUÍN DE PRIMEROS AUXILIOS
          </h4>
          <small class="text-muted">
            Registro y verificación de los elementos del botiquín
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @kit do |form| %>
        <% if @kit.errors.any? %>
          <div class="alert alert-danger mb-4" role="alert">
            <div class="fw-semibold mb-2">
              <i class="bi bi-exclamation-triangle me-1"></i>
              Se encontraron los siguientes errores:
            </div>
            <ul class="mb-0">
              <% @kit.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="mb-4">
          <div class="fw-semibold mb-3">
            <i class="bi bi-info-circle me-1"></i>
            Información general
          </div>
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <%= form.label :date_creation, class: "form-label fw-semibold" %>
              <%= form.date_field :date_creation, class: "form-control" %>
            </div>
            <div class="col-12 col-md-6">
              <%= form.label :area, class: "form-label fw-semibold" %>
              <%= form.text_field :area, class: "form-control", required: true %>
            </div>
          </div>
        </div>
        <div class="mb-4">
          <div class="fw-semibold mb-2">
            <i class="bi bi-box-seam me-1"></i>
            Tipo de botiquín
          </div>
          <div class="d-flex flex-wrap gap-4">
            <div class="form-check">
              <%= form.radio_button :type_kit, 0, required: true, class: "form-check-input" %>
              <%= form.label :type_kit, "Tipo A", value: 0, class: "form-check-label" %>
            </div>
            <div class="form-check">
              <%= form.radio_button :type_kit, 1, required: true, class: "form-check-input" %>
              <%= form.label :type_kit, "Tipo B", value: 1, class: "form-check-label" %>
            </div>
            <div class="form-check">
              <%= form.radio_button :type_kit, 2, required: true, class: "form-check-input" %>
              <%= form.label :type_kit, "Tipo C", value: 2, class: "form-check-label" %>
            </div>
          </div>
        </div>
        <div class="mb-4">
          <div class="fw-semibold mb-2">
            <i class="bi bi-geo-alt me-1"></i>
            Clasificación del botiquín
          </div>
          <div class="d-flex flex-wrap gap-4">
            <div class="form-check">
              <%= form.radio_button :clasification_kit, 0, required: true, class: "form-check-input" %>
              <%= form.label :clasification_kit, "Portátil", value: 0, class: "form-check-label" %>
            </div>
            <div class="form-check">
              <%= form.radio_button :clasification_kit, 1, required: true, class: "form-check-input" %>
              <%= form.label :clasification_kit, "Fijo", value: 1, class: "form-check-label" %>
            </div>
          </div>
        </div>
        <div class="fw-semibold mb-3">
          <i class="bi bi-list-check me-1"></i>
          Verificación de elementos
        </div>
        <div class="border rounded p-3 mb-3">
          <%= form.label :gauze, class: "form-label fw-semibold" %>
