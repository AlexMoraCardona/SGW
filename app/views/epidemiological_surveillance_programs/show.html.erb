              aria-expanded="false"
              aria-controls="collapseTiemposSVE">

        <i class="bi bi-clock-history me-2"></i>
        <strong>Tiempos de atención</strong>

      </button>

    </h2>

    <div id="collapseTiemposSVE"
         class="accordion-collapse collapse"
         aria-labelledby="headingTiemposSVE"
         data-bs-parent="#sveIndicadoresAccordion">

      <div class="accordion-body">

        <!-- ======================================================= -->
<!-- TIEMPOS DE ATENCIÓN -->
<!-- ======================================================= -->

<div class="row g-3">

  <!-- DÍAS PROMEDIO HASTA EL PRIMER SEGUIMIENTO -->
  <div class="col-12 col-sm-6 col-xl-6">

    <div class="card h-100 shadow-sm border-0">

      <div class="card-body">

        <div class="d-flex align-items-center justify-content-between">

          <div>
            <div class="text-muted small">
              Días promedio hasta el primer seguimiento
            </div>

            <div class="fs-2 fw-bold">
              <%= @average_days_to_first_follow_up %>
            </div>

            <div class="text-muted small">
              Días desde la apertura del caso
            </div>
          </div>

          <div class="fs-1 text-primary">
            <i class="bi bi-hourglass-split"></i>
          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- DÍAS PROMEDIO DE ATENCIÓN DEL CASO -->
  <div class="col-12 col-sm-6 col-xl-6">

    <div class="card h-100 shadow-sm border-0">

      <div class="card-body">

        <div class="d-flex align-items-center justify-content-between">

          <div>
            <div class="text-muted small">
              Días promedio de atención del caso
            </div>

            <div class="fs-2 fw-bold">
              <%= @average_case_attention_days %>
            </div>

            <div class="text-muted small">
              Días desde apertura hasta cierre
            </div>
          </div>

          <div class="fs-1 text-success">
            <i class="bi bi-calendar2-check"></i>
          </div>

        </div>

      </div>

    </div>

  </div>

</div>

      </div>

    </div>

  </div>


  <!-- ======================================================= -->
  <!-- 4. ANÁLISIS Y DISTRIBUCIÓN -->
  <!-- ======================================================= -->

  <div class="accordion-item shadow-sm border-0 mb-2">

    <h2 class="accordion-header" id="headingAnalisisSVE">

      <button class="accordion-button collapsed"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#collapseAnalisisSVE"
              aria-expanded="false"
              aria-controls="collapseAnalisisSVE">

        <i class="bi bi-bar-chart-line me-2"></i>
        <strong>Análisis y distribución</strong>

      </button>

    </h2>

    <div id="collapseAnalisisSVE"
         class="accordion-collapse collapse"
         aria-labelledby="headingAnalisisSVE"
         data-bs-parent="#sveIndicadoresAccordion">

      <div class="accordion-body">

        <!-- ======================================================= -->
<!-- ANÁLISIS Y DISTRIBUCIÓN -->
<!-- ======================================================= -->

<div class="row g-3">

  <!-- ===================================================== -->
  <!-- DISTRIBUCIÓN DE CASOS POR ESTADO -->
  <!-- ===================================================== -->

  <div class="col-12 col-lg-6">

    <div class="card h-100 shadow-sm border-0">

      <div class="card-body">

        <div class="d-flex align-items-center mb-3">
          <i class="bi bi-bar-chart-line text-primary fs-4 me-2"></i>

          <h6 class="mb-0 fw-bold">
            Distribución de casos por estado
          </h6>
        </div>

        <%= column_chart @cases_by_status,
              height: "300px",
              legend: false,
              library: {
                plugins: {
                  legend: {
                    display: false
                  }
                }
              } %>

      </div>

    </div>

  </div>


  <!-- ===================================================== -->
  <!-- PORCENTAJE DE CASOS POR ESTADO -->
  <!-- ===================================================== -->

  <div class="col-12 col-lg-6">

    <div class="card h-100 shadow-sm border-0">

      <div class="card-body">

        <div class="d-flex align-items-center mb-3">
          <i class="bi bi-pie-chart text-success fs-4 me-2"></i>

          <h6 class="mb-0 fw-bold">
            Porcentaje de casos por estado
          </h6>
        </div>

        <%= pie_chart @cases_by_status,
              donut: true,
              height: "300px" %>

      </div>

    </div>

  </div>


  <!-- ===================================================== -->
  <!-- CASOS POR FUENTE DE IDENTIFICACIÓN -->
  <!-- ===================================================== -->

  <div class="col-12 col-lg-6">

    <div class="card h-100 shadow-sm border-0">

      <div class="card-body">

        <div class="d-flex align-items-center mb-3">
          <i class="bi bi-diagram-3 text-info fs-4 me-2"></i>

          <h6 class="mb-0 fw-bold">
            Casos por fuente de identificación
          </h6>
        </div>

        <%= pie_chart @cases_by_source,
              donut: true,
              height: "300px" %>

      </div>

    </div>

  </div>


  <!-- ===================================================== -->
  <!-- SEGUIMIENTOS POR TIPO -->
  <!-- ===================================================== -->

  <div class="col-12 col-lg-6">

    <div class="card h-100 shadow-sm border-0">

      <div class="card-body">

        <div class="d-flex align-items-center mb-3">
          <i class="bi bi-list-check text-primary fs-4 me-2"></i>

          <h6 class="mb-0 fw-bold">
            Seguimientos por tipo
          </h6>
        </div>

        <%= column_chart @follow_ups_by_type,
              height: "300px",
              legend: false %>

      </div>

    </div>

  </div>


  <!-- ===================================================== -->
  <!-- CASOS POR ÁREA -->
  <!-- ===================================================== -->

  <div class="col-12 col-lg-6">

    <div class="card h-100 shadow-sm border-0">

      <div class="card-body">

        <div class="d-flex align-items-center mb-3">
          <i class="bi bi-building text-warning fs-4 me-2"></i>

          <h6 class="mb-0 fw-bold">
            Casos por área
          </h6>
        </div>

        <%= column_chart @cases_by_area,
              height: "300px",
              legend: false %>

      </div>

    </div>

  </div>


  <!-- ===================================================== -->
  <!-- CASOS POR CARGO -->
  <!-- ===================================================== -->

  <div class="col-12 col-lg-6">

    <div class="card h-100 shadow-sm border-0">

      <div class="card-body">

        <div class="d-flex align-items-center mb-3">
          <i class="bi bi-person-badge text-secondary fs-4 me-2"></i>

          <h6 class="mb-0 fw-bold">
            Casos por cargo
          </h6>
        </div>

        <%= column_chart @cases_by_position,
              height: "300px",
              legend: false %>

      </div>

    </div>

  </div>


  <!-- ===================================================== -->
  <!-- EVOLUCIÓN DE CASOS SVE -->
  <!-- ===================================================== -->

  <div class="col-12">

    <div class="card shadow-sm border-0">

      <div class="card-body">

        <div class="d-flex align-items-center mb-3">
          <i class="bi bi-graph-up-arrow text-success fs-4 me-2"></i>

          <h6 class="mb-0 fw-bold">
            Evolución de casos SVE
          </h6>
        </div>

        <%= line_chart @cases_by_month,
              height: "320px",
              curve: true,
              points: true,
              legend: false %>

      </div>

    </div>

  </div>

</div>

      </div>

    </div>

  </div>

</div>

<!-- ========================================================= -->
<!-- FIN ACORDEÓN INDICADORES SVE -->
<!-- ========================================================= -->

  <!-- BOTONERA -->
  <div class="d-flex flex-column flex-sm-row
              justify-content-center
              align-items-center
              gap-2 mb-4">

    <%= link_to edit_epidemiological_surveillance_program_path(
                  @epidemiological_surveillance_program
                ),
                class: "btn btn-outline-secondary" do %>

      <i class="bi bi-pencil me-1"></i>
      Editar

    <% end %>


    <%= link_to epidemiological_surveillance_programs_path,
                class: "btn btn-outline-primary" do %>

      <i class="bi bi-arrow-left me-1"></i>
      Volver

    <% end %>

  </div>

</div>