<div class="conesst-page">
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-check2-square fs-5"></i>
        <div>
          <h5 class="mb-0">Agregar compromiso</h5>
          <small class="text-muted">
            Registre los compromisos acordados durante la reunión
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @meeting_commitment do |form| %>
        <% @meeting_commitment.errors.full_messages.each do |error| %>
          <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <%= error %>
          </div>
        <% end %>
        <%= form.hidden_field :meeting_minute_id, value: params[:id].to_s %>
        <div class="row g-3">
          <div class="col-12 col-md-4 col-lg-3">
            <%= form.label :number, "Número", class: "form-label fw-semibold" %>
            <%= form.number_field :number, class: "form-control",  min: 1 %>
          </div>
          <div class="col-12 col-md-8 col-lg-9">
            <%= form.label :commitment, "Compromiso", class: "form-label fw-semibold" %>
            <%= form.text_field :commitment, class: "form-control" %>
          </div>
          <div class="col-12 col-md-6">
            <%= form.label :user_id, "Responsable", class: "form-label fw-semibold" %>
            <%= form.collection_select :user_id, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccionar responsable --" }, { class: "form-select" } %>
          </div>
          <div class="col-12 col-md-6 col-lg-3">
            <%= form.label :date_commitment, "Fecha acordada", class: "form-label fw-semibold" %>
            <%= form.date_field :date_commitment, class: "form-control", required: true %>
          </div>
          <div class="col-12 col-lg-3">
            <%= form.label :state_commitment, "Resultado esperado", class: "form-label fw-semibold" %>
            <%= form.text_field :state_commitment, class: "form-control" %>
          </div>
        </div>
        <div class="conesst-actions mt-4">
          <%= form.submit t('common.submit'), class: "conesst-btn conesst-btn-primary" %>
          <%= link_to meeting_minutes_path, class: "conesst-btn" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-list-check fs-5"></i>
        <div>
          <h5 class="mb-0">
            Compromisos acordados en esta reunión
          </h5>
          <small class="text-muted">
            Seguimiento de los compromisos registrados
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <div class="conesst-table-wrapper">
        <table class="conesst-table">
          <thead>
            <tr>
              <th>Compromiso</th>
              <th>Responsable</th>
              <th>Fecha acordada</th>
              <th>Resultado esperado</th>
              <th class="text-center">Editar</th>
              <th class="text-center">Eliminar</th>
            </tr>
          </thead>
          <tbody>
            <% @meeting_commitments.each do |meeting_commitment| %>
              <tr>
                <td data-label="Compromiso">
                  <%= meeting_commitment.commitment %>
                </td>
                <td data-label="Responsable">
                  <%= meeting_commitment.responsible %>
                </td>
                <td data-label="Fecha acordada">
                  <%= meeting_commitment.date_commitment %>
                </td>
                <td data-label="Resultado esperado">
                  <%= meeting_commitment.state_commitment %>
                </td>
                <td data-label="Editar" class="text-center">
                  <%= link_to edit_meeting_commitment_path(meeting_commitment), class: "conesst-btn conesst-btn-primary" do %>                    <i class="bi bi-pencil-square me-1"></i>
                    <%= t('common.edit') %>
                  <% end %>
                </td>
                <td data-label="Eliminar" class="text-center">
                  <%= button_to meeting_commitment,  method: :delete, class: "btn btn-sm btn-danger", form: {data: {turbo_confirm: "¿Está seguro de eliminar este compromiso?"}} do %>
                    <i class="bi bi-trash me-1"></i>
                    Eliminar
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>