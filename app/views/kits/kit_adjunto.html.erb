<div class="conesst-page">
  <% if @kit.present? %>
    <% if @kit.kit_fotos.attached? %>
      <div class="conesst-card mb-4">
        <div class="conesst-card-header">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-paperclip fs-5"></i>
            <div>
              <h5 class="mb-0">
                Archivos adjuntos
              </h5>
              <small class="text-muted">
                Botiquín de primeros auxilios
              </small>
            </div>
          </div>
        </div>
        <div class="conesst-card-body">
          <div class="row g-3" data-controller="previews">
            <% @kit.kit_fotos.each do |file| %>
              <div class="col-12 col-md-6 col-lg-4">
                <% if file.image? %>
                  <div class="border rounded p-3 h-100">
                    <div class="text-center">
                      <div class="small fw-semibold text-break mb-3">
                        <i class="bi bi-image me-1"></i>
                        <%= file.blob.filename %>
                      </div>
                      <%= image_tag file, data: { previews_target: "preview" }, class: "img-fluid rounded mb-3" %>
                      <div class="d-flex flex-wrap justify-content-center gap-2">
                        <%= link_to rails_blob_path(file, disposition: "attachment"), class: "conesst-btn conesst-btn-success" do %>
                          <i class="bi bi-download me-1"></i>
                          Descargar
                        <% end %>
                        <%= link_to purge_attachment_path(file), data: {'turbo-method': :delete, 'turbo-confirm': '¿Está seguro de eliminar este registro? Esta acción no se puede deshacer.'},  class: "btn btn-sm btn-danger" do %>
                          <i class="bi bi-trash me-1"></i>
                          Borrar
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% elsif file.video? %>
                  <div class="border rounded p-3 h-100">
                    <div class="text-center">
                      <div class="small fw-semibold text-break mb-3">
                        <i class="bi bi-camera-video me-1"></i>
                        <%= file.blob.filename %>
                      </div>
                      <%= video_tag url_for(file), controls: true, class: "w-100 rounded mb-3" %>
                      <div class="d-flex flex-wrap justify-content-center gap-2">
                        <%= link_to rails_blob_path(file, disposition: "attachment"), class: "conesst-btn conesst-btn-success" do %>
                          <i class="bi bi-download me-1"></i>
                          Descargar
                        <% end %>
                        <%= link_to purge_attachment_path(file), data: {'turbo-method': :delete, 'turbo-confirm': '¿Está seguro de eliminar este registro? Esta acción no se puede deshacer.'}, class: "btn btn-sm btn-danger" do %>
                          <i class="bi bi-trash me-1"></i>
                          Borrar
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% elsif file.audio? %>
                  <div class="border rounded p-3 h-100">
                    <div class="text-center">
                      <div class="small fw-semibold text-break mb-3">
                        <i class="bi bi-volume-up me-1"></i>
                        <%= file.blob.filename %>
                      </div>
                      <%= audio_tag url_for(file), controls: true, class: "w-100 mb-3" %>
                      <div class="d-flex flex-wrap justify-content-center gap-2">
                        <%= link_to rails_blob_path(file, disposition: "attachment"), class: "conesst-btn conesst-btn-success" do %>
                          <i class="bi bi-download me-1"></i>
                          Descargar
                        <% end %>
                        <%= link_to purge_attachment_path(file), data: {'turbo-method': :delete, 'turbo-confirm': '¿Está seguro de eliminar este registro? Esta acción no se puede deshacer.'}, class: "btn btn-sm btn-danger" do %>
                          <i class="bi bi-trash me-1"></i>
                          Borrar
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% else %>
                  <div class="border rounded p-3 h-100">
                    <div class="text-center">
                      <div class="mb-3 text-break">
                        <i class="bi bi-file-earmark-text fs-3 d-block mb-2"></i>
                        <%= link_to file.filename, url_for(file), class: "text-decoration-none fw-semibold" %>
                      </div>
                      <div class="d-flex flex-wrap justify-content-center gap-2">
                        <%= link_to rails_blob_path(file, disposition: "attachment"), class: "conesst-btn conesst-btn-success" do %>
                          <i class="bi bi-download me-1"></i>
                          Descargar
                        <% end %>
                        <%= link_to purge_attachment_path(file), data: {'turbo-method': :delete, 'turbo-confirm': '¿Está seguro de eliminar este registro? Esta acción no se puede deshacer.'}, class: "btn btn-sm btn-danger" do %>
                          <i class="bi bi-trash me-1"></i>
                          Borrar
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
    <div class="conesst-card">
      <div class="conesst-card-header">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-cloud-arrow-up fs-5"></i>
          <div>
            <h5 class="mb-0">
              Adjuntar archivos
            </h5>
            <small class="text-muted">
              Puede seleccionar uno o varios archivos
            </small>
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <%= form_for @kit do |f| %>
          <div class="row g-3">
            <div class="col-12">
              <%= f.label :kit_fotos, "Archivos adjuntos", class: "form-label fw-semibold" %>
              <%= f.file_field :kit_fotos, multiple: true, class: "form-control" %>
              <div class="form-text mt-2">
                Puede seleccionar múltiples archivos al mismo tiempo.
              </div>
            </div>
          </div>
          <div class="conesst-actions mt-4">
            <%= f.submit "Subir Archivos", class: "conesst-btn conesst-btn-primary" %>
            <%= link_to request.referer || root_path, class: "conesst-btn" do %>
              <i class="bi bi-arrow-left me-1"></i>
              Retornar
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>