<div class="conesst-page">
  <div class="conesst-logo-container">
    <%= link_to root_path, class: "d-inline-block" do %>
      <%= image_tag('LogoConesst202305232.png', class: 'conesst-logo',  alt: 'CONESST') %>
    <% end %>
  </div>
  <div class="conesst-header">
    <div class="conesst-card-header-content">
      <div class="conesst-card-header-title">
        <i class="bi bi-clipboard2-check me-2"></i>
        <%= t('.title') %>
      </div>
      <div class="conesst-card-header-subtitle">
        Administración y configuración de evaluaciones
      </div>
    </div>
  </div>
  <div class="conesst-card mb-3">
    <div class="conesst-card-body">
      <div class="conesst-actions">
        <%= link_to new_adm_exam_path, class: "conesst-btn conesst-btn-primary" do %>
          <i class="bi bi-plus-circle"></i>
          <%= t('.create_adm_exam') %>
        <% end %>
      </div>
    </div>
  </div>
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div class="conesst-card-header-title">
          <i class="bi bi-list-check me-2"></i>
          Evaluaciones
        </div>
        <div class="conesst-card-header-subtitle">
          Listado de evaluaciones configuradas
        </div>
      </div>
    </div>
    <div class="conesst-card-body p-0">
      <div class="conesst-table-wrapper">
        <table class="conesst-table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>
                <%= t('.id') %>
              </th>
              <th>
                <%= t('.name') %>
              </th>
              <th>
                <%= t('.cant_questions') %>
              </th>
              <th>
                <%= t('.percentage_min') %>
              </th>
              <th>
                <%= t('.cant_attempts') %>
              </th>
              <th>
                <%= t('.time_max') %>
              </th>
              <th>
                <%= t('common.edit') %>
              </th>
            </tr>
          </thead>
          <tbody>
            <%= render partial: 'adm_exam', collection: @adm_exams %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
