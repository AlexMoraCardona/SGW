<div class="conesst-page">
    <div class="conesst-header">
        <div>
            <h1 class="conesst-title">
                <i class="bi bi-clipboard2-plus me-2"></i>
                Actividad del plan de mejoramiento
            </h1>
            <p class="conesst-subtitle">
                Registro y seguimiento de la actividad de mejora
            </p>
        </div>
    </div>
    <div class="conesst-card">
        <div class="conesst-card-header">
            <div class="conesst-card-header-content">
                <h2 class="conesst-card-header-title">
                    <i class="bi bi-pencil-square me-2"></i>
                    Información de la actividad
                </h2>
            </div>
        </div>
        <div class="conesst-card-body">
            <%= form_with model: @improvement_item do |form| %>
                <% if @improvement_item.errors.any? %>
                    <div class="alert alert-danger mb-4" role="alert">
                        <div class="fw-semibold mb-2">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Se encontraron los siguientes errores:
                        </div>
                        <ul class="mb-0">
                            <% @improvement_item.errors.full_messages.each do |error| %>
                                <li>
                                    <%= error %>
                                </li>
                            <% end %>
                        </ul>
                    </div>
                <% end %>
                <%= form.hidden_field :improvement_plan_id, value: params[:id].to_i %>
                <div class="conesst-form-section">
                    <div class="conesst-form-section-title">
                        <i class="bi bi-list-ol me-1"></i>
                        Estándar relacionado
                    </div>
                    <div class="conesst-form-grid">
                        <div class="conesst-form-group">
                            <%= form.label :action_improvement, class: "conesst-form-label" do %>
                                <span>
                                    <%= form.object.class.human_attribute_name(:action_improvement) %>
                                </span>
                                <%= image_tag "ayuda.png", width: 22, height: 22, class: "conesst-help-icon", data: {bs_toggle: "tooltip", bs_html: "true", bs_placement: "top"}, title: "Seleccione el estándar relacionado con la actividad de mejoramiento." %>
                            <% end %>
                            <%= form.collection_select(:action_improvement, @standar_detail_items.order(item_nro: :asc), :item_nro, :item_nro, {prompt: "-- Seleccionar Estándar --"}, {class: "form-select select2"}) %>
                        </div>
                    </div>
                </div>
                <div class="conesst-form-section">
                    <div class="conesst-form-section-title">
                        <i class="bi bi-box-seam me-1"></i>
                        Recursos
                    </div>
                    <div class="conesst-form-group">
                        <%= form.label :resources_improvement, class: "conesst-form-label" do %>
                            <span>
                                <%= t('.resources_improvement') %>
                            </span>
                            <%= image_tag "ayuda.png", width: 22, height: 22, class: "conesst-help-icon", data: {bs_toggle: "tooltip", bs_html: "true", bs_placement: "top"}, title: "Especificar los recursos necesarios para ejecutar la actividad." %>
                        <% end %>
                        <%= form.text_field :resources_improvement, class: "form-control", placeholder: "Ingrese los recursos necesarios" %>
                    </div>
                </div>
                <div class="conesst-form-section">
                    <div class="conesst-form-section-title">
                        <i class="bi bi-person-check me-1"></i>
                        Responsable y cumplimiento
                    </div>
                    <div class="conesst-form-grid conesst-form-grid-2">
                        <div class="conesst-form-group">
                            <%= form.label :responsible_action, class: "conesst-form-label" do %>
                                <span>
                                    <%= t('.responsible_action') %>
                                </span>
                                <%= image_tag "ayuda.png", width: 22, height: 22, class: "conesst-help-icon", data: {bs_toggle: "tooltip", bs_html: "true", bs_placement: "top"}, title: "Especificar el responsable del proceso." %>
                            <% end %>
                            <%= form.collection_select(:responsible_action, User.usuarios_empresa.order(id: :asc), :name, :name, {prompt: "-- Seleccionar responsable --"}, {class: "form-select select2"}) %>
                        </div>
                        <div class="conesst-form-group">
                            <%= form.label :percentage_compliance, class: "conesst-form-label" do %>
                                <span>
                                    <%= t('.percentage_compliance') %>
                                </span>
                                <%= image_tag "ayuda.png", width: 22, height: 22, class: "conesst-help-icon", data: {bs_toggle: "tooltip", bs_html: "true", bs_placement: "top"}, title: "Indicar el porcentaje de cumplimiento de la actividad." %>
                            <% end %>
                            <div class="input-group">
                                <%= form.number_field :percentage_compliance, class: "form-control", min: 0, max: 100, step: 1, placeholder: "0 - 100" %>
                                <span class="input-group-text">
                                    %
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="conesst-form-section">
                    <div class="conesst-form-section-title">
                        <i class="bi bi-calendar-range me-1"></i>
                        Fechas de ejecución
                    </div>
                    <div class="conesst-form-grid conesst-form-grid-2">
                        <div class="conesst-form-group">
                            <%= form.label :date_initial, class: "conesst-form-label" do %>
                                <span>
                                    <%= t('.date_initial') %>
                                </span>
                                <%= image_tag "ayuda.png", width: 22, height: 22, class: "conesst-help-icon", data: {bs_toggle: "tooltip", bs_html: "true", bs_placement: "top"}, title: "Especificar la fecha en que inicia la actividad." %>
                            <% end %>
                            <%= form.date_field :date_initial, class: "form-control", required: true %>
                        </div>
                        <div class="conesst-form-group">
                            <%= form.label :date_fin, class: "conesst-form-label" do %>
                                <span>
                                    <%= t('.date_fin') %>
                                </span>
                                <%= image_tag "ayuda.png", width: 22, height: 22, class: "conesst-help-icon", data: {bs_toggle: "tooltip", bs_html: "true", bs_placement: "top"}, title: "Especificar la fecha en que termina la actividad." %>
                            <% end %>
                            <%= form.date_field :date_fin, class: "form-control" %>
                        </div>
                    </div>
                </div>
                <div class="conesst-form-section">
                    <div class="conesst-form-section-title">
                        <i class="bi bi-chat-left-text me-1"></i>
                        Observaciones
                    </div>
                    <div class="conesst-form-group">
                        <%= form.label :observation, class: "conesst-form-label" do %>
                            <span>
                                <%= t('.observation') %>
                            </span>
                            <%= image_tag "ayuda.png", width: 22, height: 22, class: "conesst-help-icon", data: {bs_toggle: "tooltip", bs_html: "true", bs_placement: "top"}, title: "Especificar las observaciones de la actividad." %>
                        <% end %>
                        <%= form.text_area :observation, class: "form-control", rows: 4, placeholder: "Ingrese las observaciones de la actividad" %>
                    </div>
                </div>
                <div class="conesst-actions conesst-form-actions">
                    <%= form.button type: "submit", class: "conesst-btn conesst-btn-primary" do %>
                        <i class="bi bi-check-circle me-1"></i>
                        <%= t('common.submit') %>
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
</div>
