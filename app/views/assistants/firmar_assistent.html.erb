<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-pen fs-5"></i>
        <div>
          <h5 class="mb-0">Firma autorizada</h5>
          <small class="text-muted">
            Autorización de firma del asistente
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @assistant do |form| %>
        <% @assistant.errors.full_messages.each do |error| %>
          <div class="alert alert-danger mb-4" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <%= error %>
          </div>
        <% end %>
        <div class="row g-3">
          <div class="col-12">
            <div class="form-label fw-semibold">
              Nombre
            </div>
            <div class="form-control bg-light">
              <%= @assistant.name %>
            </div>
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold">
              <i class="bi bi-pen me-1"></i>
              Firma autorizada
            </label>
            <div class="d-flex flex-wrap gap-4 mt-2">
              <div class="form-check">
                <%= form.radio_button :firm_assistant, 0, class: "form-check-input", id: "firm_assistant_no" %>
                <%= form.label :firm_assistant, "No", value: 0, for: "firm_assistant_no", class: "form-check-label" %>
              </div>
              <div class="form-check">
                <%= form.radio_button :firm_assistant, 1, class: "form-check-input", id: "firm_assistant_si" %>
                <%= form.label :firm_assistant, "Sí", value: 1, for: "firm_assistant_si", class: "form-check-label" %>
              </div>
            </div>
          </div>
        </div>
        <%= form.hidden_field :date_firm, value: Time.now %>
        <div class="conesst-actions mt-4">
          <%= form.submit t('common.submit'), class: "conesst-btn conesst-btn-primary" %>
          <%= link_to meeting_minutes_path, class: "conesst-btn" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>