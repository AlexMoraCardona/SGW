<meta charset="utf-8">
<%= wicked_pdf_stylesheet_link_tag "application" %>

<style>
    @page {
        size: Letter portrait;
        margin: 12mm 10mm 12mm 10mm;
    }

    * {
        box-sizing: border-box;
    }

    body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 10px !important;
        line-height: 1.35;
        color: #000;
        margin: 0;
        padding: 0;
    }

    h1 {
        font-size: 17px !important;
        text-align: center;
        margin: 0 0 14px 0;
        font-weight: bold;
    }

    h2 {
        font-size: 12px !important;
        margin: 14px 0 7px 0;
        padding: 5px 7px;
        font-weight: bold;
        border-bottom: 1px solid #000;
    }

    h3 {
        font-size: 11px !important;
        margin: 10px 0 5px 0;
        font-weight: bold;
    }

    p {
        font-size: 10px !important;
        line-height: 1.4;
        margin: 4px 0;
    }

    table {
        font-family: Arial, Helvetica, sans-serif;
    }

    /* ==========================================
       INFORMACIÓN BÁSICA
       ========================================== */

    .info-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        margin-bottom: 10px;
    }

    .info-table td {
        border: 1px solid #777;
        padding: 6px 7px;
        font-size: 10px !important;
        line-height: 1.35;
        vertical-align: top;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    .info-table .label {
        font-weight: bold;
        width: 25%;
    }

    .info-table .value {
        width: 25%;
    }

    /* ==========================================
       CONTENIDO DE LAS SECCIONES
       ========================================== */

    .section-content {
        border: 1px solid #777;
        padding: 8px 9px;
        margin-bottom: 10px;
        font-size: 10px !important;
        line-height: 1.45;
        word-wrap: break-word;
        overflow-wrap: break-word;
        text-align: justify;
    }

    .section-content p {
        margin: 0;
        font-size: 10px !important;
        line-height: 1.45;
    }

    .text-content {
        font-size: 10px !important;
        line-height: 1.45;
        word-wrap: break-word;
        overflow-wrap: break-word;
        text-align: justify;
    }

    /* ==========================================
       PRUEBAS / AUTORIDAD
       ========================================== */

    .status-box {
        font-size: 10px !important;
        padding: 6px;
        line-height: 1.4;
    }

    /* ==========================================
       FIRMA
       ========================================== */

    .signature-container {
        text-align: center;
        margin-top: 14px;
        page-break-inside: avoid;
    }

    .signature-container img {
        display: block;
        max-width: 300px;
        max-height: 130px;
        width: auto;
        height: auto;
        margin: 0 auto 5px auto;
    }

    .signature-line {
        border-top: 1px solid #000;
        width: 70%;
        margin: 6px auto 5px auto;
    }

    .signature-name {
        font-size: 10px !important;
        font-weight: bold;
        margin-top: 5px;
    }

    /* ==========================================
       ARCHIVOS ADJUNTOS
       ========================================== */

    .attachments {
        margin-top: 8px;
    }

    .attachment {
        border: 1px solid #999;
        padding: 8px;
        margin-bottom: 9px;
        page-break-inside: avoid;
        font-size: 10px !important;
        line-height: 1.4;
    }

    .attachment img {
        display: block;
        max-width: 100%;
        max-height: 280px;
        width: auto;
        height: auto;
        margin: 6px auto;
    }

    .attachment-name {
        font-size: 10px !important;
        font-weight: bold;
        margin-bottom: 5px;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    .attachment-link {
        font-size: 9px !important;
        margin-top: 5px;
    }

    .no-attachments {
        font-size: 10px !important;
        font-style: italic;
    }

    /* ==========================================
       EVITAR CORTES INADECUADOS
       ========================================== */

    .document-section {
        page-break-inside: avoid;
    }

    table,
    tr,
    td {
        page-break-inside: avoid;
    }

    /* ==========================================
       REGLA GENERAL PARA EVITAR QUE ALGÚN
       ESTILO HEREDADO REDUZCA LA TIPOGRAFÍA
       ========================================== */

    table,
    td,
    th,
    div,
    span,
    p,
    li {
        font-family: Arial, Helvetica, sans-serif;
    }

    /* ==========================================
       TAMAÑO GENERAL DEFINITIVO
       ========================================== */

    body,
    table,
    td,
    th,
    div,
    span,
    p,
    li {
        font-size: 10px !important;
    }

    h1 {
        font-size: 17px !important;
    }

    h2 {
        font-size: 12px !important;
    }

    h3 {
        font-size: 11px !important;
    }

    /* Las imágenes no se ven afectadas por el tamaño de letra */
    img {
        max-width: 100%;
    }
</style>

<div class="document-section">


<h1>QUEJA COMITÉ DE CONVIVENCIA LABORAL</h1>

<!-- ==========================================
     INFORMACIÓN BÁSICA
     ========================================== -->

<h2>Información básica</h2>

<table class="info-table">
    <tbody>
        <tr>
            <td class="label">Nombre de quien presenta la queja</td>
            <td class="value">
                <%= @complaint.name(@complaint.user_complaint) %>
            </td>

            <td class="label">Documento</td>
            <td class="value">
                <%= @complaint.document(@complaint.user_complaint) %>
            </td>
        </tr>

        <tr>
            <td class="label">Cargo</td>
            <td class="value">
                <%= Complaint.cargo(@complaint.user_complaint) %>
            </td>

            <td class="label">Correo electrónico</td>
            <td class="value">
                <%= @complaint.email(@complaint.user_complaint) %>
            </td>
        </tr>

        <tr>
            <td class="label">Nombre de quien interpone la queja</td>
            <td class="value">
                <%= @complaint.name(@complaint.user_interpose_complaint) %>
            </td>

            <td class="label">Cargo</td>
            <td class="value">
                <%= Complaint.cargo(@complaint.user_interpose_complaint) %>
            </td>
        </tr>

        <tr>
            <td class="label">Fecha de la queja</td>
            <td class="value">
                <%= @complaint.date_complaint %>
            </td>

            <td class="label"></td>
            <td class="value"></td>
        </tr>
    </tbody>
</table>


<!-- ==========================================
     RELACIÓN DE LOS HECHOS
     ========================================== -->

<h2>Relación de los hechos</h2>

<div class="section-content text-content">
    <%= simple_format(@complaint.relationship_facts) %>
</div>


<!-- ==========================================
     PRUEBAS
     ========================================== -->

<h2>Pruebas</h2>

<div class="section-content text-content">
    <%= simple_format(@complaint.observation) %>
</div>


<!-- ==========================================
     AUTORIZACIÓN / EXISTENCIA DE PRUEBAS
     ========================================== -->

<h2>¿Cuenta con pruebas?</h2>

<div class="section-content status-box">
    <% if @complaint.have_proof.to_i == 0 %>
        NO
    <% else %>
        SÍ
    <% end %>
</div>


<!-- ==========================================
     FIRMA
     ========================================== -->

<h2>Firma de quien presenta la queja</h2>

<div class="section-content status-box">

    <% if @complaint.firm_complaint.to_i == 0 %>

        NO

    <% else %>

        <% if @user.present? &&
              @user.firm.present? &&
              @user.firm.attached? &&
              @user.firm.image? %>

            <div class="signature-container">

                <%= image_tag(
                    Evaluation.wicked_blob_path(@user.firm),
                    style: "max-width:300px; max-height:130px;"
                ) %>

                <div class="signature-line"></div>

                <div class="signature-name">
                    <%= @complaint.name(@complaint.user_complaint) %>
                </div>

            </div>

        <% else %>

            <div class="signature-container">
                <div class="signature-line"></div>

                <div class="signature-name">
                    <%= @complaint.name(@complaint.user_complaint) %>
                </div>
            </div>

        <% end %>

    <% end %>

</div>


<!-- ==========================================
     ARCHIVOS ADJUNTOS
     ========================================== -->

<h2>Archivos adjuntos</h2>

<div class="attachments">

    <% if @complaint.files_complaint.attached? %>

        <% @complaint.files_complaint.each do |file| %>

            <div class="attachment">

                <div class="attachment-name">
                    <%= file.filename.to_s %>
                </div>

                <% if file.image? %>

                    <%= image_tag(
                        Evaluation.wicked_blob_path(file),
                        style: "max-width:100%; max-height:280px;"
                    ) %>

                <% else %>

                    <div class="text-content">
                        <strong>Archivo adjunto:</strong>
                        <%= file.filename.to_s %>
                    </div>

                <% end %>

                <div class="attachment-link">
                    Archivo adjunto:
                    <%= file.filename.to_s %>
                </div>

            </div>

        <% end %>

    <% else %>

        <div class="no-attachments">
            No se adjuntaron archivos.
        </div>

    <% end %>

</div>


</div>
