<div class="container-fluid py-3">
    <div class="card shadow-sm mx-auto" style="max-width: 1100px;">
        <div class="card-header">
            <h2 class="h4 mb-0 text-center">
                <i class="bi bi-clipboard2-pulse-fill me-1"></i>
                Registro novedad del empleado
            </h2>
        </div>
        <div class="card-body">
            <%= form_with model: @event,
                data: {controller: "event-form"} do |form| %>
                    <% if @event.errors.any? %>
                        <div class="alert alert-danger" role="alert">
                        <h6 class="alert-heading">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            Se encontraron los siguientes errores:
                        </h6>
                        <ul class="mb-0">
                            <% @event.errors.full_messages.each do |error| %>
                                <li><%= error %></li>
                            <% end %>
                        </ul>
                    </div>
                <% end %>
                <div class="border rounded p-3 mb-4">
                    <h5 class="mb-3">
                        <i class="bi bi-person-fill me-1"></i>
                        Información del funcionario
                    </h5>
                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <%= form.label :user_id, class: "form-label fw-semibold" %>
                            <%= form.collection_select :user_id, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccionar funcionario --" }, { class: "form-select", required: true } %>
                        </div>
                        <div class="col-12 col-md-4">
                            <%= form.label :date_new, class: "form-label fw-semibold" %>
                            <%= form.date_field :date_new, class: "form-control", max: Date.current, required: true %>
                        </div>
                    </div>
                </div>
                <div class="border rounded p-3 mb-4">
                    <h5 class="mb-3">
                        <i class="bi bi-question-circle-fill me-1"></i>
                        Tipo de evento
                    </h5>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <%= form.label :work_accident, class: "form-label fw-semibold" %>
                                    <div class="d-flex gap-3 mt-2">
                                        <div class="form-check">
                                            <%= form.radio_button :work_accident, 0, class: "form-check-input", data: {event_form_target: "workAccident", action: "change->event-form#toggleDetails" } %>
                                            <%= form.label :work_accident, "NO", value: 0, class: "form-check-label" %>
                                        </div>
                                        <div class="form-check">
                                            <%= form.radio_button :work_accident, 1, class: "form-check-input", data: {event_form_target: "workAccident", action: "change->event-form#toggleDetails" } %>
                                            <%= form.label :work_accident, "SI", value: 1, class: "form-check-label" %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <%= form.label :mortal_accident, class: "form-label fw-semibold" %>
                                    <div class="d-flex gap-3 mt-2">
                                        <div class="form-check">
                                            <%= form.radio_button :mortal_accident, 0, class: "form-check-input", data: {event_form_target: "mortalAccident", action: "change->event-form#toggleDetails" } %>
                                            <%= form.label :mortal_accident, "NO", value: 0, class: "form-check-label" %>
                                        </div>
                                        <div class="form-check">
                                            <%= form.radio_button :mortal_accident, 1, class: "form-check-input", data: {event_form_target: "mortalAccident", action: "change->event-form#toggleDetails" } %>
                                            <%= form.label :mortal_accident, "SI", value: 1, class: "form-check-label" %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <%= form.label :occupational_disease, class: "form-label fw-semibold" %>
                                    <div class="d-flex gap-3 mt-2">
                                        <div class="form-check">
                                            <%= form.radio_button :occupational_disease, 0, class: "form-check-input", data: {event_form_target: "occupationalDisease", action: "change->event-form#toggleDisease" } %>
                                            <%= form.label :occupational_disease, "NO", value: 0, class: "form-check-label" %>
                                        </div>
                                        <div class="form-check">
                                            <%= form.radio_button :occupational_disease, 1, class: "form-check-input", data: {event_form_target: "occupationalDisease", action: "change->event-form#toggleDisease" } %>
                                            <%= form.label :occupational_disease, "SI", value: 1, class: "form-check-label" %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
