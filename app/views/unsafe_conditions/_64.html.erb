<div class="container-fluid px-2 px-md-4 py-3">
  <div class="conesst-actions-wrap d-flex flex-wrap justify-content mb-4">
    <%= link_to :back, class: "conesst-btn conesst-btn-secondary" do %>
      <i class="bi bi-arrow-left"></i>
      Retornar
    <% end %>
  </div>

  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-shield-exclamation fs-2"></i>
        <div>
          <h4 class="mb-1">Reporte de actos y condiciones inseguras</h4>
          <small class="text-muted">
            Consulta del reporte, características identificadas, evidencias y firmas.
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <div class="row g-3">
        <div class="col-12 col-md-6">
          <div class="conesst-info-card h-100">
            <div class="p-3">
              <div class="conesst-data-label">
                <i class="bi bi-calendar-event me-1"></i>
                Fecha de reporte
              </div>
              <div class="conesst-data-value">
                <%= @unsafe_condition.date_report.presence || "—" %>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="conesst-info-card h-100">
            <div class="p-3">
              <div class="conesst-data-label">
                <i class="bi bi-geo-alt me-1"></i>
                Lugar y sede del reporte
              </div>
              <div class="conesst-data-value">
                <%= @unsafe_condition.place_report.presence || "—" %>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12">
          <div class="conesst-info-card">
            <div class="p-3">
              <div class="conesst-data-label">
                <i class="bi bi-pin-map me-1"></i>
                Ubicación exacta del acto o condición insegura
              </div>
              <div class="conesst-data-value">
                <%= @unsafe_condition.exact_ubication.presence || "—" %>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="conesst-info-card h-100">
            <div class="p-3">
              <div class="conesst-data-label">
                <i class="bi bi-person me-1"></i>
                Persona que reporta
              </div>
              <div class="conesst-data-value">
                <%= @reporta&.name.presence || "—" %>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="conesst-info-card h-100">
            <div class="p-3">
              <div class="conesst-data-label">
                <i class="bi bi-briefcase me-1"></i>
                Cargo de la persona que reporta
              </div>
              <div class="conesst-data-value">
                <%= User.label_activity(@reporta.activity) if @reporta.present? %>
                <%= "—" unless @reporta.present? %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <h5 class="mb-0">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Descripción de la condición insegura
      </h5>
    </div>
    <div class="conesst-card-body">
      <div class="conesst-data-value">
        <%= simple_format(@unsafe_condition.description_condition.presence || "Sin descripción registrada") %>
      </div>
    </div>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <h5 class="mb-1">
        <i class="bi bi-list-check me-2"></i>
        Características de la condición insegura
      </h5>
      <small class="text-muted">
        Resultado registrado para cada característica.
      </small>
    </div>
    <div class="conesst-card-body">
      <div class="row g-3">
        <% [
          :equipment_condition,
          :lack_alarm,
          :floors_condition,
          :lack_cleanliness,
          :not_demarcate_areas,
          :lack_space_work,
          :gases_dusts,
          :incorrect_storage,
          :unsafe_work_design,
          :excessive_noise_levels,
          :inadequate_signage,
          :inadequate_lighting_ventilation,
          :defective_tools
        ].each do |field| %> 
          <% value = @unsafe_condition.public_send(field) %>
          <div class="col-12 col-md-6">
            <div class="conesst-info-card h-100">
              <div class="p-3">
                <div class="conesst-data-label mb-2">
                  <%= t("unsafe_conditions.unsafe_condition.#{field}") %>
                </div>
                <div class="conesst-data-value">
                  <% if value == 0 %>
                    <span>
                      <i class="bi bi-x-circle me-1"></i>
                      No
                    </span>
                  <% elsif value == 1 %>
                    <span>
                      <i class="bi bi-check-circle me-1"></i>
                      Sí
                    </span>
                  <% else %>
                    <span>Sin información</span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
        <div class="col-12">
          <div class="conesst-info-card">
            <div class="p-3">
              <div class="conesst-data-label">
                <%= t('unsafe_conditions.unsafe_condition.other_unsafe_conditions') %>
              </div>
              <div class="conesst-data-value">
                <%= @unsafe_condition.other_unsafe_conditions.presence || "—" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <h5 class="mb-0">
        <i class="bi bi-person-exclamation me-2"></i>
        Descripción del acto inseguro
      </h5>
    </div>
    <div class="conesst-card-body">
      <div class="conesst-data-value">
        <%= simple_format(@unsafe_condition.description_act_unsafe.presence || "Sin descripción registrada") %>
      </div>
    </div>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <h5 class="mb-1">
        <i class="bi bi-list-check me-2"></i>
        Características del acto inseguro
      </h5>
      <small class="text-muted">
        Resultado registrado para cada característica.
      </small>
    </div>
    <div class="conesst-card-body">
      <div class="row g-3">
        <% [
          :not_using_equipment,
          :use_wrong_tool,
          :operating_without_authorization,
          :wrong_position,
          :running_facilities,
          :heights_without_authorization,
          :using_defective_tool,
          :workplace_distractions,
          :psychoactive_substances,
          :gen_on_desk,
          :ignore_dangerous
        ].each do |field| %>
          <% value = @unsafe_condition.public_send(field) %>
          <div class="col-12 col-md-6">
            <div class="conesst-info-card h-100">
              <div class="p-3">
                <div class="conesst-data-label mb-2">
                  <%= t("unsafe_conditions.unsafe_condition.#{field}") %>
                </div>
                <div class="conesst-data-value">
                  <% if value == 0 %>
                    <span>
                      <i class="bi bi-x-circle me-1"></i>
                      No
                    </span>
                  <% elsif value == 1 %>
                    <span>
                      <i class="bi bi-check-circle me-1"></i>
                      Sí
                    </span>
                  <% else %>
                    <span>Sin información</span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
        <div class="col-12">
          <div class="conesst-info-card">
            <div class="p-3">
              <div class="conesst-data-label">
                <%= t('unsafe_conditions.unsafe_condition.other_features') %>
              </div>
              <div class="conesst-data-value">
                <%= @unsafe_condition.other_features.presence || "—" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <h5 class="mb-0">
        <i class="bi bi-lightbulb me-2"></i>
        Alternativas de solución
      </h5>
    </div>
    <div class="conesst-card-body">
      <div class="conesst-data-value">
        <%= simple_format(@unsafe_condition.alternative_soluctions.presence || "Sin alternativas de solución registradas") %>
      </div>
    </div>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <h5 class="mb-0">
        <i class="bi bi-paperclip me-2"></i>
        Archivos adjuntos
      </h5>
    </div>
    <div class="conesst-card-body">
      <% if @unsafe_condition.evidencias.attached? %>
        <div data-controller="previews">
          <div class="row g-3">
            <% @unsafe_condition.evidencias.each do |file| %>
              <div class="col-12 col-md-6 col-lg-4">
                <div class="conesst-info-card h-100">
                  <div class="p-3">
                    <div class="conesst-data-value mb-3">
                      <i class="bi bi-file-earmark me-1"></i>
                      <%= file.filename %>
                    </div>
                    <% if file.image? %>
                      <div class="mb-3">
                        <%= image_tag file, data: { previews_target: "preview" }, class: "img-fluid rounded", alt: file.filename.to_s %>
                      </div>
                    <% elsif file.video? %>
                      <div class="mb-3">
                        <%= video_tag url_for(file), controls: true, class: "img-fluid w-100 rounded" %>
                      </div>
                    <% elsif file.audio? %>
                      <div class="mb-3">
                        <%= audio_tag url_for(file), controls: true, class: "w-100" %>
                      </div>
                    <% else %>
                      <div class="mb-3">
                        <i class="bi bi-file-earmark-text fs-2"></i>
                      </div>
                    <% end %>
                    <div class="conesst-actions-wrap">
                      <%= link_to rails_blob_path(file, disposition: 'attachment'), class: "conesst-btn conesst-btn-success" do %>
                        <i class="bi bi-download me-1"></i>
                        Descargar
                      <% end %>
                      <%= link_to purge_attachment_path(file), data: {turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar el archivo?"}, class: "conesst-btn conesst-btn-danger" do %>
                        <i class="bi bi-trash me-1"></i>
                        Borrar archivo
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="conesst-empty text-center py-4">
          <i class="bi bi-folder2-open fs-1 d-block mb-2"></i>
          <p class="mb-0">No hay archivos adjuntos en este reporte.</p>
        </div>
      <% end %>
    </div>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <h5 class="mb-0">
        <i class="bi bi-pen me-2"></i>
        Responsables y firmas
      </h5>
    </div>
    <div class="conesst-card-body">
      <div class="row g-3">
        <div class="col-12 col-md-6">
          <div class="conesst-info-card h-100">
            <div class="conesst-info-card-title">
              <i class="bi bi-person-check me-2"></i>
              <%= t('unsafe_conditions.unsafe_condition.user_reports') %>
            </div>
            <div class="p-3">
              <div class="conesst-data-value mb-3">
                <%= UnsafeCondition.name_user(@unsafe_condition.user_reports) %>
              </div>
              <div class="conesst-data-label mb-2">
                Firma
              </div>
              <% if @unsafe_condition.firm_user_reports == 1 %>
                <% if @reporta.present? && @reporta.firm.attached? && @reporta.firm.image? %>
                  <%= image_tag @reporta.firm, class: "firma img-fluid", alt: "Firma de la persona que reporta" %>
                <% else %>
                  <span class="text-muted">
                    No hay imagen de firma disponible.
                  </span>
                <% end %>
              <% else %>
                <span class="text-muted">
                  Pendiente de firma.
                </span>
              <% end %>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="conesst-info-card h-100">
            <div class="conesst-info-card-title">
              <i class="bi bi-person-badge me-2"></i>
              <%= t('unsafe_conditions.unsafe_condition.user_receiving') %>
            </div>
            <div class="p-3">
              <div class="conesst-data-value mb-3">
                <%= UnsafeCondition.name_user(@unsafe_condition.user_receiving) %>
              </div>
              <div class="conesst-data-label mb-2">
                Firma
              </div>
              <% if @unsafe_condition.firm_user_receiving == 1 %>
                <% if @recibe.present? && @recibe.firm.attached? && @recibe.firm.image? %>
                  <%= image_tag @recibe.firm, class: "firma img-fluid", alt: "Firma de la persona que recibe" %>
                <% else %>
                  <span class="text-muted">
                    No hay imagen de firma disponible.
                  </span>
                <% end %>
              <% else %>
                <span class="text-muted">
                  Pendiente de firma.
                </span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>