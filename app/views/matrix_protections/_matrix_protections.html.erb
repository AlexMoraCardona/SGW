<div class="container py-4">
  <div align="left"; class="container col-12">
      <a class="navbar-brand" href="/">
          <%= image_tag 'LogoConesst202305232.png',:width => "100",  :height=>"100" %>
      </a>
  </div>

  <% if @entity.present? %>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body text-center">
        <h2 class="fw-bold text-primary mb-0">
          <i class="bi bi-building"></i>
          <%= @entity.business_name %>
        </h2>
        <div class="text-muted">
            <strong>NIT:</strong>
            <%= EvaluationRuleDetail.miles(@entity.identification_number) if @entity.identification_number.present? %>
            <% if @entity.verification_digit.present? %>
            -<%= @entity.verification_digit %>
            <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @matrix_protections.present? %>
    <% if Current.user.level > 0 && Current.user.level < 3 %>
      <div class="mb-4">
        <%= link_to new_matrix_protection_path(entity_id: @entity.id), class: "btn btn-success" do %>
          <i class="bi bi-plus-circle"></i>
          <%= t('common.create_matrix_protection') %>
        <% end %>
      </div>
    <% end %>
    <% @matrix_protections.each do |matrix_protection| %>
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-light text-dark" >
          <div class="row align-items-center">
            <div class="col-md-8">
              <h4 class="mb-0">
                <i class="bi bi-calendar3"></i>
                MATRIZ DE ELEMENTOS DE PROTECCIÓN PERSONAL <%= matrix_protection.created_at.strftime("%F") %>
              </h4> 
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
              <div class="d-grid d-md-flex justify-content-md-end gap-2">
                <% if Current.user.level > 0 && Current.user.level < 4 %>
                  <%= link_to crear_item_protection_matrix_protections_path(matrix_protection.id), class: "btn btn-success btn-sm" do %>
                    <i class="bi bi-plus-square"></i>
                    <%= t('common.create_item_matrix_protection') %>
                  <% end %>
                <% end %>
                <%= link_to matrix_protection_path(matrix_protection.id),
                    class: "btn btn-primary btn-sm text-white" do %>
                  <i class="bi bi-eye"></i>
                  <%= t('common.show_matrix_protection') %>
                <% end %>
                <%= link_to ver_matrix_protection_matrix_protections_path(matrix_protection.id, format: 'pdf'),
                    class: "btn btn-danger btn-sm" do %>
                  <i class="bi bi-file-earmark-pdf"></i>
                  PDF
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <div class="card-body">
          <div class="row mb-4">
            <div class="col-md-4">
              <strong>Fecha de creación</strong><br>
              <span class="text-muted">
                <%= matrix_protection.created_at.strftime("%F") %>
              </span>
            </div>
          </div>
          <hr>
          <h5 class="text-primary mb-3">
            <i class="bi bi-person-badge"></i>
            Representante Legal
          </h5>
          <div class="row gy-3">
            <div class="col-md-3">
              <strong><%= t('.user_legal_representative') %></strong><br>
              <%= matrix_protection.name_user(matrix_protection.user_legal_representative) %>
            </div>
            <div class="col-md-3">
              <strong><%= t('.firm_legal_representative') %></strong><br>
              <%= matrix_protection.label_firm(matrix_protection.firm_legal_representative) %>
            </div>
            <div class="col-md-3">
              <strong><%= t('.date_firm_legal_representative') %></strong><br>
              <%= matrix_protection.date_firm_legal_representative if matrix_protection.date_firm_legal_representative.present? %>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <% if matrix_protection.firm_legal_representative.to_i == 0 %>
                    <%= link_to firmar_rep_matrix_protections_path(matrix_protection.id, 1), class: "btn btn-sm fw-semibold", style: "background-color: #145a72; color: white;", title: t('common.firmar'), data: { bs_toggle: "tooltip" } do %>
                        <i class="bi bi-pen-fill me-2"></i>
                        <%= t('common.firmar') %>
                    <% end %>
                <% end %>
            </div>            
          </div>
          <hr>
          <h5 class="text-success mb-3">
            <i class="bi bi-person-workspace"></i>
            Asesor SST
          </h5>
          <div class="row gy-3">
            <div class="col-md-3">
              <strong><%= t('.user_adviser_sst') %></strong><br>
              <%= matrix_protection.name_user(matrix_protection.user_adviser_sst) %>
            </div>
            <div class="col-md-3">
              <strong><%= t('.firm_adviser_sst') %></strong><br>
              <%= matrix_protection.label_firm(matrix_protection.firm_adviser_sst) %>
            </div>
            <div class="col-md-3">
              <strong><%= t('.date_firm_adviser_sst') %></strong><br>
              <%= matrix_protection.date_firm_adviser_sst if matrix_protection.date_firm_adviser_sst.present? %>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <% if matrix_protection.firm_adviser_sst.to_i == 0 %>
                    <%= link_to firmar_adv_matrix_protections_path(matrix_protection.id, 2), class: "btn btn-sm fw-semibold", style: "background-color: #145a72; color: white;", title: t('common.firmar'), data: { bs_toggle: "tooltip" } do %>
                        <i class="bi bi-pen-fill me-2"></i>
                        <%= t('common.firmar') %>
                    <% end %>
                <% end %>
            </div>            
          </div>
          <hr>
          <h5 class="text-danger mb-3">
            <i class="bi bi-person-check"></i>
            <%= t('.user_responsible_sst') %>
          </h5>
          <div class="row gy-3">
            <div class="col-md-3">
              <strong><%= t('.user_responsible_sst') %></strong><br>
              <%= matrix_protection.name_user(matrix_protection.user_responsible_sst) %>
            </div>
            <div class="col-md-3">
              <strong><%= t('.firm_responsible_sst') %></strong><br>
              <%= matrix_protection.label_firm(matrix_protection.firm_responsible_sst) %>
            </div>
            <div class="col-md-3">
              <strong><%= t('.date_firm_responsible_sst') %></strong><br>
              <%= matrix_protection.date_firm_responsible_sst if matrix_protection.date_firm_responsible_sst.present? %>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <% if matrix_protection.firm_responsible_sst.to_i == 0 %>
                    <%= link_to firmar_res_matrix_protections_path(matrix_protection.id, 3), class: "btn btn-sm fw-semibold", style: "background-color: #145a72; color: white;", title: t('common.firmar'), data: { bs_toggle: "tooltip" } do %>
                        <i class="bi bi-pen-fill me-2"></i>
                        <%= t('common.firmar') %>
                    <% end %>
                <% end %>
            </div>            
          </div>
          <hr>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="card shadow-sm">
      <div class="card-body text-center">
        <h5 class="text-secondary mb-4">
          No existen matrices registradas.
        </h5>
        <%= link_to new_matrix_protection_path(entity_id: @entity.id),
            class: "btn btn-success" do %>
          <i class="bi bi-plus-circle"></i>
          <%= t('.create_matrix_protection') %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
