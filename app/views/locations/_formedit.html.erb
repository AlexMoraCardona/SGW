<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div>
          <div class="conesst-card-header-title">
            <i class="bi bi-geo-alt me-2"></i>
            Información de la ubicación
          </div>
          <div class="conesst-card-header-subtitle">
            Datos generales y de contacto
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @location do |form| %>
        <% @location.errors.full_messages.each do |error| %>
          <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <%= error %>
          </div>
        <% end %>
        <div class="row g-3">
          <div class="col-12 col-md-9">
            <%= form.label :name_locate, class: "form-label fw-semibold" %>
            <%= form.text_field :name_locate, class: "form-control" %>
          </div>
          <div class="col-12 col-md-3">
            <%= form.label :code_locate, class: "form-label fw-semibold" %>
            <%= form.text_field :code_locate, class: "form-control" %>
          </div>
        </div>
        <div class="row g-3 mt-1">
          <div class="col-12 col-md-4">
            <%= form.label :phone_number_entity, class: "form-label fw-semibold" %>
            <%= form.number_field :phone_number_entity, class: "form-control" %>
          </div>
          <div class="col-12 col-md-4">
            <%= form.label :cell_entity, class: "form-label fw-semibold" %>
            <%= form.number_field :cell_entity, class: "form-control" %>
          </div>
          <div class="col-12 col-md-4">
            <%= form.label :number_workers, class: "form-label fw-semibold" %>
            <%= form.number_field :number_workers, class: "form-control" %>
          </div>
        </div>
        <div class="row g-3 mt-1">
          <div class="col-12 col-md-6">
            <%= form.label :entity_address, class: "form-label fw-semibold" %>
            <%= form.text_field :entity_address, class: "form-control" %>
          </div>
          <div class="col-12 col-md-6">
            <%= form.label :entity_zone, class: "form-label fw-semibold d-block" %>
            <div class="d-flex flex-wrap gap-3 pt-1">
              <div class="form-check">
                <%= form.radio_button :entity_zone, "Rural", class: "form-check-input" %>
                <%= form.label :entity_zone_rural, t('common.rural'), class: "form-check-label" %>
              </div>
              <div class="form-check">
                <%= form.radio_button :entity_zone, "Urbana", class: "form-check-input" %>
                <%= form.label :entity_zone_urbana, t('common.urbana'), class: "form-check-label" %>
              </div>
            </div>
          </div>
        </div>
        <div class="row g-3 mt-1">
          <div class="col-12">
            <%= form.label :entity_location_code, class: "form-label fw-semibold" %>
            <%= form.collection_select :entity_location_code,  AdministrativePoliticalDivision.all.order(id: :asc), :town_center_code, :town_center_name, { prompt: "Seleccione el municipio" }, { class: "form-select" } %>
          </div>
        </div>
        <div class="conesst-actions mt-4">
          <%= form.submit t('common.submit'), class: "conesst-btn conesst-btn-primary" %>
          <%= link_to entities_path, class: "conesst-btn" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>