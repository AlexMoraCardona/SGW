<div class="container-fluid py-3">

  <div class="card shadow-sm border-0">

    <!-- ENCABEZADO -->

    <div class="card-header bg-light">

      <div class="d-flex flex-column flex-md-row
                  justify-content-between
                  align-items-md-center
                  gap-3">

        <div class="d-flex align-items-center">

          <i class="bi bi-clipboard2-pulse fs-3 me-2"></i>

          <div>

            <h4 class="mb-0">
              Aplicar encuesta
            </h4>

            <small class="text-muted">
              Diligenciamiento de encuesta de vigilancia epidemiológica
            </small>

          </div>

        </div>

        <span class="badge bg-primary fs-6">
          SVE
        </span>

      </div>

    </div>


    <div class="card-body">

      <!-- INFORMACIÓN DE LA ENCUESTA -->

      <div class="alert alert-light border">

        <div class="row g-3">

          <div class="col-12 col-md-8">

            <div class="fw-semibold text-muted small">
              ENCUESTA
            </div>

            <div class="fs-5">
              <%= @surveillance_survey.name %>
            </div>

          </div>

          <div class="col-12 col-md-4">

            <div class="fw-semibold text-muted small">
              PROGRAMA
            </div>

            <div>
              <%= @epidemiological_surveillance_program.name %>
            </div>

          </div>

        </div>

      </div>


        <%= form_with model: @surveillance_survey_response,
              url: epidemiological_surveillance_program_surveillance_survey_surveillance_survey_responses_path(
                @epidemiological_surveillance_program,
                @surveillance_survey
              ),
              local: true do |form| %>

        <%= hidden_field_tag :from_notification, params[:from_notification] %>

<!-- TRABAJADOR -->

<div class="mb-4">

  <%= form.label :user_id,
                "Trabajador",
                class: "form-label fw-semibold" %>

  <% if params[:from_notification] == "true" && @selected_user.present? %>

    <!-- ============================================== -->
    <!-- ACCESO DESDE NOTIFICACIÓN -->
    <!-- ============================================== -->

    <%= form.hidden_field :user_id,
                          value: @selected_user.id %>

    <div class="alert alert-info d-flex align-items-center mb-0">

      <i class="bi bi-person-check-fill fs-4 me-2"></i>

      <div>
        <div class="small text-muted">
          Trabajador seleccionado
        </div>

        <strong>
          <%= @selected_user.name %>
        </strong>
      </div>

    </div>

  <% else %>

    <!-- ============================================== -->
    <!-- ACCESO NORMAL -->
    <!-- ============================================== -->

    <%= form.collection_select(
          :user_id,
          @users,
          :id,
          :name,
          {
            prompt: "Seleccione el trabajador..."
          },
          {
            class: "form-select",
            required: true
          }
        ) %>

    <div class="form-text">
      Seleccione el trabajador al cual se aplicará la encuesta.
    </div>

  <% end %>

</div>
        <hr class="my-4">


        <!-- PREGUNTAS -->

        <div class="mb-4">

          <h5 class="mb-1">
            <i class="bi bi-question-circle me-1"></i>
            Preguntas
          </h5>

          <p class="text-muted small mb-0">
            Responda todas las preguntas requeridas.
          </p>

        </div>


        <% @questions.each do |question| %>

          <div class="card border mb-4">

            <div class="card-header bg-light">

              <div class="d-flex align-items-start gap-2">

                <span class="badge bg-secondary rounded-pill">
                  <%= question.position %>
                </span>

                <div class="fw-semibold">
                  <%= question.question %>

                  <% if question.required? %>
                    <span class="text-danger">*</span>
                  <% end %>

                </div>

              </div>

            </div>


            <div class="card-body">


<% if question.question_type == "open_text" %>

  <!-- TEXTO -->

  <%= text_area_tag(
        "answers[#{question.id}][answer_text]",
        nil,
        class: "form-control",
        rows: 3,
        required: question.required?,
        placeholder: "Ingrese su respuesta..."
      ) %>


<% elsif question.question_type == "boolean" %>

  <!-- SI / NO -->

  <div class="d-flex flex-column flex-sm-row gap-3">

    <div class="form-check">

      <%= radio_button_tag(
            "answers[#{question.id}][answer_boolean]",
            "true",
            false,
            class: "form-check-input",
            required: question.required?
          ) %>

      <%= label_tag(
            "answers_#{question.id}_answer_boolean_true",
            "Sí",
            class: "form-check-label"
          ) %>

    </div>


    <div class="form-check">

      <%= radio_button_tag(
            "answers[#{question.id}][answer_boolean]",
            "false",
            false,
            class: "form-check-input"
          ) %>

      <%= label_tag(
            "answers_#{question.id}_answer_boolean_false",
            "No",
            class: "form-check-label"
          ) %>

    </div>

  </div>


<% elsif question.question_type == "single_choice" %>

  <!-- UNA OPCIÓN -->

  <div class="d-flex flex-column gap-2">

    <% question.surveillance_question_options
               .where(active: true)
               .order(:position)
               .each do |option| %>

      <div class="form-check">

        <%= radio_button_tag(
              "answers[#{question.id}][option_ids][]",
              option.id,
              false,
              class: "form-check-input",
              required: question.required?
            ) %>

        <%= label_tag(
              "answers_#{question.id}_option_ids_#{option.id}",
              option.option_text,
              class: "form-check-label"
            ) %>

      </div>

    <% end %>

  </div>


<% elsif question.question_type == "multiple_choice" %>

  <!-- MÚLTIPLES OPCIONES -->

  <div class="d-flex flex-column gap-2">

    <% question.surveillance_question_options
               .where(active: true)
               .order(:position)
               .each do |option| %>

      <div class="form-check">

        <%= check_box_tag(
              "answers[#{question.id}][option_ids][]",
              option.id,
              false,
              class: "form-check-input"
            ) %>

        <%= label_tag(
              "answers_#{question.id}_option_ids_#{option.id}",
              option.option_text,
              class: "form-check-label"
            ) %>

      </div>

    <% end %>

  </div>

<% end %>




            </div>

          </div>

        <% end %>


        <!-- BOTONERA -->

        <div class="d-flex flex-wrap
                    justify-content-center
                    gap-2 mt-4">

          <%= form.submit(
                "Guardar encuesta",
                class: "btn btn-primary"
              ) do %>

            <i class="bi bi-check-circle me-1"></i>
            Guardar encuesta

          <% end %>


<% if params[:from_notification] == "true" %>

<%= link_to(
root_path,
class: "btn btn-outline-secondary"
) do %>


<i class="bi bi-house me-1"></i>
Cancelar


<% end %>

<% else %>

<%= link_to(
epidemiological_surveillance_program_surveillance_survey_path(
@epidemiological_surveillance_program,
@surveillance_survey
),
class: "btn btn-outline-secondary"
) do %>


<i class="bi bi-arrow-left me-1"></i>
Cancelar


<% end %>

<% end %>

        </div>


      <% end %>

    </div>

  </div>

</div>
