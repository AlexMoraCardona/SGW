<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div>
          <h2 class="conesst-card-header-title">
            <i class="bi bi-file-earmark-medical me-2"></i>
            <%= @allow_exam.new_record? ? "Nueva autorización de examen" : "Editar autorización de examen" %>
          </h2>
          <p class="conesst-card-header-subtitle mb-0">
            Complete la información de la autorización
          </p>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @allow_exam do |form| %>
        <% @allow_exam.errors.full_messages.each do |error| %>
          <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <%= error %>
          </div>
        <% end %>
        <div class="row g-3">
          <div class="col-12">
            <%= form.label :adm_exam_id, class: "form-label fw-semibold" %>
            <%= form.collection_select :adm_exam_id, AdmExam.all.order(id: :asc), :id, :description, { prompt: "-- Seleccionar Evaluación --" }, { class: "form-select select2" } %>
          </div>
          <div class="col-12">
            <%= form.label :entity_id, class: "form-label fw-semibold" %>
            <%= form.collection_select :entity_id, Entity.all.order(id: :asc), :id, :business_name, { prompt: "-- Seleccionar Entidad --" }, { class: "form-select select2" } %>
          </div>
          <div class="col-12 col-md-4">
            <%= form.label :date_initial, class: "form-label fw-semibold" %>
            <%= form.date_field :date_initial, class: "form-control" %>
          </div>
          <div class="col-12 col-md-4">
            <%= form.label :date_final, class: "form-label fw-semibold" %>
            <%= form.date_field :date_final, class: "form-control" %>
          </div>
          <div class="col-12">
            <%= form.label :description, class: "form-label fw-semibold" %>
            <%= form.text_area :description, class: "form-control", rows: 4 %>
          </div>
        </div>
        <%= form.hidden_field :user_id, value: Current.user.id.to_i %>
        <div class="conesst-actions mt-4">
          <%= form.submit t('common.submit'), class: "conesst-btn conesst-btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="conesst-card mt-4">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div>
          <h3 class="conesst-card-header-title">
            <i class="bi bi-people me-2"></i>
            Usuarios citados
          </h3>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <div class="mb-0">
        <%= @nom_usuarios %>
      </div>
    </div>
  </div>
</div>