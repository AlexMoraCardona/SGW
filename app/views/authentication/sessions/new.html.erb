<style>
    /* =========================================================
       CONESST - INICIO
       Diseño moderno / Responsive PC - Tablet - Celular
       ========================================================= */
    .conesst-page {
        min-height: 100vh;
        background: #f5f8fa;
    }
    /* =========================================================
       ENCABEZADO
       ========================================================= */
    .conesst-header {
        background: linear-gradient(135deg, #0090e4 0%, #006eaf 100%);
        border-radius: 0 0 28px 28px;
        padding: 18px 0 30px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, .12);
    }
    .conesst-logo {
        max-height: 90px;
        max-width: 190px;
        width: auto;
        object-fit: contain;
    }
    .top-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
    .top-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 42px;
        padding: 8px 17px;
        border: 1px solid rgba(255,255,255,.60);
        border-radius: 12px;
        color: #fff;
        text-decoration: none;
        font-size: .92rem;
        font-weight: 600;
        background: rgba(255,255,255,.08);
        transition: all .2s ease;
    }
    .top-action:hover {
        color: #0078bd;
        background: #fff;
        transform: translateY(-2px);
        box-shadow: 0 5px 13px rgba(0,0,0,.15);
    }
    .login-card {
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.30);
        border-radius: 17px;
        padding: 13px;
        backdrop-filter: blur(5px);
    }
    .login-card .form-control {
        border: none;
        border-radius: 9px;
        min-height: 39px;
        box-shadow: none;
    }
    .login-card .btn-login {
        width: 100%;
        min-height: 39px;
        border-radius: 9px;
        font-weight: 700;
    }
    .system-title {
        color: #fff;
        text-align: center;
        margin: 25px 0 0;
        font-size: clamp(1.35rem, 3vw, 2.15rem);
        font-weight: 700;
        line-height: 1.25;
    }
    .system-subtitle {
        color: rgba(255,255,255,.90);
        text-align: center;
        margin: 8px 0 0;
        font-size: .96rem;
    }
    /* =========================================================
       CONTENIDO
       ========================================================= */
    .main-content {
        padding: 35px 0 45px;
    }
    /* =========================================================
       BANNER INFORMATIVO
       ========================================================= */
    .info-banner {
        background: #fff;
        border-left: 5px solid #0090e4;
        border-radius: 16px;
        padding: 18px 22px;
        box-shadow: 0 5px 20px rgba(0,0,0,.07);

        display: flex;
        align-items: center;
        gap: 18px;
    }
    .info-banner img {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
    }
    .info-banner strong {
        color: #31566f;
        font-size: .97rem;
        line-height: 1.55;
    }
    /* =========================================================
       TITULOS
       ========================================================= */
    .section-title {
        color: #245d80;
        font-weight: 700;
        text-align: center;
        margin-bottom: 25px;
    }
    .section-title::after {
        content: "";
        display: block;
        width: 55px;
        height: 3px;
        background: #0090e4;
        margin: 10px auto 0;
        border-radius: 5px;
    }
    /* =========================================================
       SERVICIOS
       ========================================================= */
    .services-card {
        height: 100%;
        background: #fff;
        border: none;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 5px 20px rgba(0,0,0,.07);
    }
    .service-item {
        position: relative;

        display: flex;
        align-items: center;
        gap: 14px;

        padding: 11px 12px;
        margin-bottom: 5px;

        border-radius: 13px;

        color: #4169e1;
        font-weight: 600;

        cursor: pointer;

        transition:
            background .25s ease,
            transform .25s ease,
            box-shadow .25s ease;
    }
    .service-item:hover {
        background: #eef8fd;
        transform: translateX(5px);
        box-shadow: 0 5px 14px rgba(0,144,228,.10);
    }
    .service-icon {
        width: 50px;
        height: 50px;

        object-fit: contain;
        flex-shrink: 0;

        transition: transform .25s ease;
    }
    .service-item:hover .service-icon {
        transform: scale(1.08);
    }
    .service-name {
        font-size: .98rem;
    }
    /* =========================================================
       DESCRIPCIÓN DE CADA SERVICIO
       ========================================================= */
    .service-description {
        position: absolute;

        left: 78px;
        right: 10px;
        bottom: calc(100% + 8px);

        z-index: 20;

        padding: 13px 15px;

        background: #fff;
        border: 1px solid #e3edf3;
        border-radius: 12px;

        color: #506777;
        font-size: .84rem;
        font-weight: 400;
        line-height: 1.45;

        box-shadow: 0 8px 25px rgba(0,0,0,.13);

        opacity: 0;
        visibility: hidden;
        transform: translateY(8px);

        transition:
            opacity .2s ease,
            transform .2s ease,
            visibility .2s ease;

        pointer-events: none;
    }
    .service-description strong {
        display: block;
        color: #0078bd;
        margin-bottom: 4px;
    }
    .service-item:hover .service-description {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    /* =========================================================
       IMAGEN PRINCIPAL
       ========================================================= */
    /* =========================================================
       HERO - IMAGEN PRINCIPAL CONESST
       ========================================================= */
    .main-image-card {
        position: relative;
        height: 100%;
        min-height: 500px;

        overflow: hidden;

        /*
         * Fondo muy limpio para que la fotografía
         * sea la protagonista.
         */
        background:
            radial-gradient(
                circle at 70% 45%,
                #ffffff 0%,
                #ffffff 45%,
                #f3f9fc 75%,
                #e6f2f8 100%
            );

        border-radius: 24px;

        box-shadow:
            0 8px 28px rgba(0,0,0,.08);

        display: flex;
        align-items: flex-end;
        justify-content: center;

        padding: 0;

        /*
         * Importante:
         * permite que la imagen sobresalga visualmente.
         */
        overflow: hidden;
    }
    /* Círculo decorativo detrás de la persona */
    .main-image-card::before {
        content: "";
        position: absolute;
        width: 420px;
        height: 420px;
        right: -80px;
        top: 25px;
        border-radius: 50%;
        background:
            radial-gradient(
                circle,
                rgba(255,255,255,.95) 0%,
                rgba(232,246,253,.75) 60%,
                rgba(214,237,248,.20) 100%
            );
        filter: blur(2px);
        z-index: 0;
    }
    /* Segunda decoración */
    .main-image-card::after {
        content: "";
        position: absolute;
        width: 230px;
        height: 230px;
        left: -100px;
        bottom: -90px;
        border-radius: 50%;
        background: rgba(255,255,255,.75);
        filter: blur(8px);
        z-index: 0;
    }
    /* =========================================================
       FOTOGRAFÍA
       ========================================================= */
    .hero-woman {
        position: relative;
        z-index: 2;
        /*
         * Más grande que la tarjeta.
         */
        width: 125%;
        max-width: none;
        height: auto;
        max-height: 560px;
        object-fit: contain;
        /*
         * Desplazamiento para dar sensación
         * de que la persona sale de la tarjeta.
         */
        transform:
            translateX(25px)
            translateY(15px);
        /*
         * Difuminado progresivo en los bordes.
         */
        -webkit-mask-image:
            linear-gradient(
                to bottom,
                transparent 0%,
                #000 8%,
                #000 82%,
                transparent 100%
            );
        mask-image:
            linear-gradient(
                to bottom,
                transparent 0%,
                #000 8%,
                #000 82%,
                transparent 100%
            );
        transition:
            transform .5s ease,
            filter .5s ease;
    }
    /* Efecto al pasar el mouse */
    .main-image-card:hover .hero-woman {
        transform:
            translateX(25px)
            translateY(5px)
            scale(1.025);
    }
    /* =========================================================
       TEXTO HERO
       ========================================================= */
    .hero-content {
        position: absolute;
        left: 28px;
        top: 32px;
        z-index: 4;
        max-width: 290px;
    }
    .hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.90);
        color: #0078bd;
        border-radius: 30px;
        padding: 7px 13px;
        font-size: .76rem;
        font-weight: 700;
        letter-spacing: .3px;
        box-shadow:
            0 4px 12px rgba(0,0,0,.07);
    }
    .hero-content h3 {
        margin-top: 15px;
        margin-bottom: 7px;
        color: #075f91;
        font-size: clamp(1.45rem, 3vw, 2rem);
        font-weight: 800;
        line-height: 1.15;
    }
    .hero-content p {
        margin: 0;
        color: #5c7180;
        font-size: .90rem;
        line-height: 1.5;
    }
    /* =========================================================
       FRASE INFERIOR
       ========================================================= */
    .image-message {
        position: absolute;
        left: 25px;
        right: 25px;
        bottom: 20px;
        z-index: 5;
        text-align: center;
        background: rgba(255,255,255,.90);
        border: 1px solid rgba(255,255,255,.95);
        border-radius: 16px;
        padding: 13px 16px;
        box-shadow:
            0 6px 20px rgba(0,0,0,.10);
        backdrop-filter: blur(7px);
    }
    .image-message strong {
        display: block;
        color: #006eaf;
        font-size: 1rem;
    }
    .image-message span {
        display: block;
        color: #607785;
        font-size: .80rem;
        margin-top: 3px;
    }
    /* =========================================================
       TABLET
       ========================================================= */
    @media (max-width: 991.98px) {
        .main-image-card {
            min-height: 460px;
        }
        .hero-woman {
            width: 120%;
            transform:
                translateX(15px)
                translateY(10px);
        }
        .hero-content {
            left: 23px;
            top: 25px;
        }
    }
    /* =========================================================
       CELULAR
       ========================================================= */
    @media (max-width: 767.98px) {
        .main-image-card {
            min-height: 470px;

            border-radius: 20px;
        }
        .hero-content {
            left: 20px;
            right: 20px;
            top: 20px;
            max-width: none;
            text-align: center;
        }
        .hero-content h3 {
            font-size: 1.55rem;
        }
        .hero-content p {
            font-size: .84rem;
        }
        .hero-woman {
            width: 125%;
            max-height: 430px;
            transform:
                translateX(10px)
                translateY(20px);
        }
        .main-image-card:hover .hero-woman {
            transform:
                translateX(10px)
                translateY(20px)
                scale(1);
        }
        .image-message {
            left: 12px;
            right: 12px;
            bottom: 12px;
            padding: 11px 12px;
        }
    }
    <div class="main-image-card">
        <!-- =====================================================
         TEXTO HERO
         ===================================================== -->
        <div class="hero-content">
            <div class="hero-tag">
                <i class="bi bi-shield-check"></i>
                Seguridad y Salud en el Trabajo
            </div>  
            <h3>
                Protegemos lo más importante:
                <br>
                <span>las personas.</span>
            </h3>
            <p>
                Una gestión SST eficiente para acompañar
                el crecimiento y bienestar de tu empresa.
            </p>
        </div>
        <!-- =====================================================
             MUJER CON CASCO
             ===================================================== -->
        <%= image_tag 'mujer_log.png', class: "hero-woman", alt: "Profesional de Seguridad y Salud en el Trabajo" %>
        <!-- =====================================================
             MENSAJE INFERIOR
             ===================================================== -->
        <div class="image-message">
            <strong>
                CONESST
            </strong>
            <span>
                Prevención · Cumplimiento · Mejora continua
            </span>
        </div>
    </div>

    .main-image-card::before {
        content: "";
        position: absolute;
        width: 330px;
        height: 330px;
        border-radius: 50%;
        background: rgba(255,255,255,.75);
        filter: blur(30px);
        z-index: 0;
    }
    .main-image-card:hover img {
        transform: scale(1.025);
    }
    /* =========================================================
       MENSAJE SOBRE LA IMAGEN
       ========================================================= */
    .image-message {
        position: absolute;
        left: 25px;
        right: 25px;
        bottom: 25px;
        z-index: 3;
        text-align: center;
        background: rgba(255,255,255,.90);
        border: 1px solid rgba(255,255,255,.90);
        border-radius: 15px;
        padding: 13px 15px;
        box-shadow: 0 5px 18px rgba(0,0,0,.09);
        backdrop-filter: blur(6px);
    }
    .image-message strong {
        display: block;
        color: #006eaf;
        font-size: 1rem;
    }
    .image-message span {
        display: block;
        color: #607785;
        font-size: .80rem;
        margin-top: 3px;
    }
    /* =========================================================
       MENSAJE DESTACADO
       ========================================================= */
    .highlight-message {
        margin-top: 30px;
        background:
            linear-gradient(
                135deg,
                #0090e4,
                #006eaf
            );
        color: #fff;
        border-radius: 18px;
        padding: 25px;
        text-align: center;
        box-shadow: 0 7px 22px rgba(0,0,0,.10);
    }
    .highlight-message h3 {
        margin: 0;
        font-size: clamp(1.10rem, 2.5vw, 1.55rem);
        line-height: 1.45;
        font-weight: 700;
    }
    /* =========================================================
       FOOTER
       ========================================================= */
    .conesst-footer {
        background: #075f91;
        color: #fff;

        padding: 35px 0 20px;
    }
    .footer-title {
        font-weight: 700;
        font-size: 1rem;
        margin-bottom: 15px;
    }
    .contact-item {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }
    .contact-item img {
        width: 30px;
        height: 30px;
        object-fit: contain;
    }
    .contact-item a {
        color: #fff;
        text-decoration: none;
    }
    .contact-item a:hover {
        text-decoration: underline;
    }
    /* =========================================================
       BOTONERA FOOTER
       ========================================================= */
    .footer-buttons {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }
    .footer-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 10px;
        font-weight: 600;
        padding: 9px 15px;
    }
    .privacy-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
    }
    .privacy-link:hover {
        color: #fff;
        text-decoration: underline;
    }
    .footer-bottom {
        border-top: 1px solid rgba(255,255,255,.20);
        margin-top: 25px;
        padding-top: 15px;
        text-align: center;
        font-size: .82rem;
        opacity: .85;
    }
    /* =========================================================
       TABLET
       ========================================================= */
    @media (max-width: 991.98px) {
        .service-description {
            left: 72px;
        }
        .main-image-card {
            min-height: 400px;
        }
    }
    /* =========================================================
       CELULAR
       ========================================================= */
    @media (max-width: 767.98px) {
        .conesst-header {
            border-radius: 0 0 20px 20px;
            padding: 15px 0 23px;
        }
        .conesst-logo {
            max-height: 75px;
            max-width: 160px;
        }
        .top-actions {
            margin-top: 15px;
        }
        .top-action {
            flex: 1 1 45%;
            min-width: 130px;
            padding: 8px 10px;
            font-size: .84rem;
        }
        .login-card {
            margin-top: 15px;
        }
        .system-title {
            margin-top: 20px;
        }
        .system-subtitle {
            font-size: .87rem;
        }
        .main-content {
            padding-top: 25px;
        }
        .info-banner {
            align-items: flex-start;
            padding: 15px;
        }
        .info-banner img {
            width: 40px;
            height: 40px;
        }
        .services-card {
            padding: 17px;
        }
        /*
         * En celular no dependemos del hover.
         * La descripción se muestra debajo del servicio.
         */
        .service-item {
            flex-wrap: wrap;
            padding: 10px;
        }
        .service-description {
            position: static;
            width: 100%;
            margin-top: 4px;
            margin-left: 64px;
            padding: 0 5px 5px;
            background: transparent;
            border: none;
            box-shadow: none;
            opacity: 1;
            visibility: visible;
            transform: none;
            pointer-events: auto;
        }
        .service-description strong {
            display: none;
        }
        .service-item:hover {
            transform: none;
            box-shadow: none;
        }
        .service-item:hover .service-icon {
            transform: none;
        }
        .main-image-card {
            min-height: 380px;
            padding: 15px;
        }
        .main-image-card img {
            max-height: 350px;
        }
        .image-message {
            left: 15px;
            right: 15px;
            bottom: 15px;
        }
        .highlight-message {
            margin-top: 22px;
            padding: 20px 16px;
        }
        .footer-buttons {
            align-items: stretch;
        }
        .footer-button {
            justify-content: center;
        }
    }
</style>


<div class="conesst-page">
    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->
    <header class="conesst-header">
        <div class="container">
            <div class="row align-items-center g-3">
                <!-- LOGO -->
                <div class="col-12 col-md-3 text-center text-md-start">
                    <a href="/" class="d-inline-block">
                        <%= image_tag 'LogoConesst202305232.png', class: "conesst-logo", alt: "CONESST" %>
                    </a>
                </div>
                <!-- BOTONERA -->
                <div class="col-12 col-md-5">
                    <div class="top-actions">
                        <a href="/sessions/cambioclave/path" class="top-action" data-bs-toggle="tooltip" title="Cambiar contraseña">
                            <i class="bi bi-key fs-5"></i>
                            <span>Clave</span>
                        </a>
                        <a href="/users/new" class="top-action" data-bs-toggle="tooltip" title="Crear una cuenta">
                            <i class="bi bi-person-plus fs-5"></i>
                            <span>Registrarse</span>
                        </a>
                    </div>
                </div>
                <!-- LOGIN -->
                <div class="col-12 col-md-4">
                    <div class="login-card">
                        <%= form_with(url: sessions_path) do |form| %>
                            <div class="row g-2">
                                <div class="col-12 col-sm-5">
                                    <%= form.text_field :login, class: "form-control form-control-sm", required: true, placeholder: "Usuario", autocomplete: "username" %>
                                </div>
                                <div class="col-12 col-sm-5">
                                    <%= form.password_field :password, class: "form-control form-control-sm", required: true, placeholder: "Clave", autocomplete: "current-password" %>
                                </div>
                                <div class="col-12 col-sm-2">
                                    <button type="submit" class="btn btn-light btn-sm btn-login">
                                        <i class="bi bi-box-arrow-in-right"></i>
                                        <span>Ingresar</span>
                                    </button>
                                </div>
                            </div>
                        <% end %>
                    </div>
                </div>
            </div>
            <!-- TITULO -->
            <h1 class="system-title">
                Sistema de Gestión de Seguridad y Salud en el Trabajo
            </h1>
            <p class="system-subtitle">
                Gestión, seguimiento y control de la Seguridad y Salud en el Trabajo
            </p>
        </div>
    </header>

    <!-- =====================================================
         CONTENIDO
         ===================================================== -->
    <main class="main-content">
        <div class="container">
            <!-- BANNER -->
            <div class="info-banner mb-4">
                <%= image_tag 'info.png', alt: "Información" %>
                <strong>

                    ¿SABÍAS QUE UN SISTEMA DE GESTIÓN DE SEGURIDAD Y SALUD
                    EN EL TRABAJO BIEN IMPLEMENTADO NO SOLO EVITA SANCIONES,
                    SINO QUE TRANSFORMA EL BIENESTAR LABORAL Y MEJORA EL
                    DESEMPEÑO DE TU EMPRESA?

                </strong>
            </div>
            <!-- =================================================
                 SERVICIOS + FOTO
                 ================================================= -->
            <div class="row g-4 align-items-stretch">
                <!-- SERVICIOS -->
                <div class="col-12 col-lg-6">
                    <div class="services-card">
                        <h2 class="section-title">
                            Servicios ofrecidos
                        </h2>
                        <!-- DIAGNOSTICO -->
                        <div class="service-item">
                            <%= image_tag 'diagnostico.png', class: "service-icon", alt: "Diagnóstico" %>
                            <span class="service-name">
                                Diagnóstico
                            </span>
                            <div class="service-description">
                                <strong>Diagnóstico</strong>
                                Conoce el estado actual de tu SG-SST.
                                Identificamos fortalezas, oportunidades
                                de mejora y nivel de cumplimiento de tu empresa.
                            </div>
                        </div>
                        <!-- DISEÑO -->
                        <div class="service-item">
                            <%= image_tag 'diseño.png', class: "service-icon", alt: "Diseño" %>
                            <span class="service-name">
                                Diseño
                            </span>
                            <div class="service-description">
                                <strong>Diseño</strong>
                                Construimos un SG-SST adaptado a tu empresa.
                                Diseñamos procesos, procedimientos y
                                documentación de acuerdo con tus necesidades.
                            </div>
                        </div>
                        <!-- IMPLEMENTACION -->
                        <div class="service-item">
                            <%= image_tag 'implementacion.png', class: "service-icon", alt: "Implementación" %>
                            <span class="service-name">
                                Implementación
                            </span>
                            <div class="service-description">
                                <strong>Implementación</strong>
                                Llevamos el sistema a la práctica.
                                Te acompañamos en la ejecución de las
                                actividades y controles necesarios para
                                una gestión efectiva.
                            </div>
                        </div>
                        <!-- REPORTE -->
                        <div class="service-item">
                            <%= image_tag 'reporte.png', class: "service-icon", alt: "Reporte al Ministerio de Trabajo" %>
                            <span class="service-name">
                                Reporte al Ministerio de Trabajo
                            </span>
                            <div class="service-description">
                                <strong>Reporte al Ministerio de Trabajo</strong>

                                Cumple oportunamente con tus obligaciones.
                                Facilitamos la preparación y gestión de la
                                información requerida para los reportes
                                correspondientes.
                            </div>
                        </div>
                        <!-- SEGUIMIENTO -->
