<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
            color: #212529;
        }

        /* ============================
           ENCABEZADO PRINCIPAL
        ============================ */

        .encabezado-principal {
            width: 100%;
            border: 1px solid #b5b2b2;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .encabezado-principal td {
            vertical-align: middle;
        }

        /* LOGO */
        .logo {
            width: 18%;
            text-align: center;
            padding: 8px;
            border-right: 1px solid #d5d5d5;
        }

        .logo img {
            width: 75px;
            height: 75px;
            object-fit: contain;
            display: block;
            margin: 0 auto;
        }

        /* TITULO */
        .titulo {
            width: 82%;
            text-align: center;
            padding: 10px 15px;
        }

        .empresa {
            font-size: 15px;
            font-weight: bold;
            text-transform: uppercase;
            line-height: 1.3;
            margin-bottom: 6px;
        }

        .nombre-formato {
            font-size: 13px;
            font-weight: bold;
            text-transform: uppercase;
            line-height: 1.4;
        }

        /* ============================
           INFORMACIÓN DEL DOCUMENTO
        ============================ */

        .informacion {
            width: 100%;
            border: 1px solid #b5b2b2;
            border-top: none;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .informacion td {
            padding: 7px 8px;
            font-size: 11px;
            vertical-align: middle;
            border-right: 1px solid #d5d5d5;
            border-bottom: 1px solid #d5d5d5;
        }

        .informacion tr:last-child td {
            border-bottom: none;
        }

        .informacion td:last-child {
            border-right: none;
        }

        .etiqueta {
            width: 20%;
            font-weight: bold;
            background: #f3f3f3;
        }

        .valor {
            width: 30%;
            font-weight: normal;
        }

        /* ============================
           CELULAR
        ============================ */

        @media screen and (max-width: 600px) {

            .logo {
                width: 22%;
                padding: 6px;
            }

            .titulo {
                width: 78%;
                padding: 8px;
            }

            .logo img {
                width: 55px;
                height: 55px;
            }

            .empresa {
                font-size: 12px;
            }

            .nombre-formato {
                font-size: 10px;
            }

            .informacion td {
                font-size: 9px;
                padding: 5px;
            }
        }

        /* CELULARES PEQUEÑOS */
        @media screen and (max-width: 400px) {

            .logo {
                width: 25%;
            }

            .titulo {
                width: 75%;
            }

            .logo img {
                width: 48px;
                height: 48px;
            }

            .empresa {
                font-size: 10px;
            }

            .nombre-formato {
                font-size: 9px;
            }

            .informacion td {
                font-size: 8px;
                padding: 4px;
            }
        }
    </style>
</head>

<body>

    <!-- ============================
         ENCABEZADO PRINCIPAL
    ============================= -->

    <table class="encabezado-principal">
        <tr>

            <!-- LOGO -->
            <td class="logo">

                <% if @evidence&.entity&.logo.present? %>

                    <%= image_tag(
                        Evaluation.wicked_blob_path(@evidence.entity.logo),
                        width: 75,
                        height: 75,
                        alt: "Logo"
                    ) %>

                <% end %>

            </td>

            <!-- INFORMACIÓN PRINCIPAL -->
            <td class="titulo">

                <div class="empresa">
                    <%= @evidence&.entity&.business_name %>
                </div>

                <div class="nombre-formato">
                    <%= @evidence&.template&.name %>
                </div>

            </td>

        </tr>
    </table>


    <!-- ============================
         INFORMACIÓN DEL DOCUMENTO
    ============================= -->

    <table class="informacion">

        <tr>

            <td class="etiqueta">
                Código
            </td>

            <td class="valor">
                <%= @evidence&.template&.reference %>
            </td>

            <td class="etiqueta">
                Versión
            </td>

            <td class="valor">
                <%= @evidence&.template&.version %>
            </td>

        </tr>

        <tr>

            <td class="etiqueta">
                Fecha de elaboración
            </td>

            <td class="valor">
                <%= @evidence&.template&.date %>
            </td>

            <td class="etiqueta">
                Fecha de actualización
            </td>

            <td class="valor">
                <%= @evidence&.template&.date_updated %>
            </td>

        </tr>

    </table>

</body>
</html>
