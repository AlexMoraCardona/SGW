<div class="container-fluid px-2 px-md-4 py-3">
  <%= form_with model: @unsafe_condition, local: true do |form| %>
    <% if @unsafe_condition.errors.any? %>
      <div class="alert alert-danger" role="alert">
        <div class="fw-bold mb-2">
          <i class="bi bi-exclamation-triangle me-2"></i>
          Por favor, revisa los siguientes errores:
        </div>
        <ul class="mb-0">
          <% @unsafe_condition.errors.full_messages.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <div class="d-flex align-items-center gap-3">
          <i class="bi bi-shield-exclamation fs-3"></i>
          <div>
            <h4 class="mb-1">Reporte de actos y condiciones inseguras</h4>
            <small class="text-muted">
              Registra la condición o el acto inseguro identificado y sus alternativas de solución.
            </small>
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <%= form.label :place_report, class: "form-label fw-semibold" %>
            <%= form.text_field :place_report, class: "form-control", required: true, placeholder: "Lugar donde se identifica la situación" %>
          </div>

          <div class="col-12 col-md-6">
            <%= form.label :exact_ubication, class: "form-label fw-semibold" %>
            <%= form.text_area :exact_ubication, class: "form-control",  required: true, rows: 3, placeholder: "Describe la ubicación exacta" %>
          </div>
          <div class="col-12">
            <div class="conesst-info-card">
              <div class="conesst-data-label">
                <i class="bi bi-person-check me-1"></i>
                <%= form.label :user_reports %>
              </div>
              <div class="conesst-data-value">
                <%= Current.user.name %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <h5 class="mb-0">
          <i class="bi bi-exclamation-triangle me-2"></i>
          Descripción de la condición insegura
        </h5>
      </div>
      <div class="conesst-card-body">
        <%= form.text_area :description_condition, class: "form-control", rows: 4, placeholder: "Describe la condición insegura identificada..." %>
      </div>
    </div>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <h5 class="mb-1">
          <i class="bi bi-list-check me-2"></i>
          Características de la condición insegura
        </h5>
        <small class="text-muted">
          Selecciona Sí o No para cada característica.
        </small>
      </div>
      <div class="conesst-card-body">
        <div class="row g-3">
          <% [
            [:equipment_condition, :lack_alarm],
            [:floors_condition, :lack_cleanliness],
            [:not_demarcate_areas, :lack_space_work],
            [:gases_dusts, :incorrect_storage],
            [:unsafe_work_design, :excessive_noise_levels],
            [:inadequate_signage, :inadequate_lighting_ventilation],
            [:defective_tools]
          ].each do |fields| %>
            <% fields.each do |field| %>
              <div class="col-12 col-md-6">
                <div class="conesst-info-card h-100">
                  <div class="p-3">
                    <div class="fw-semibold mb-3">
                      <%= form.label field, class: "mb-0" %>
                    </div>
                    <div class="d-flex flex-wrap gap-4">
                      <div class="form-check">
                        <%= form.radio_button field, 0, class: "form-check-input" %>
                        <%= form.label "#{field}_0", "No", for: "#{form.object_name}_#{field}_0", class: "form-check-label" %>
                      </div>
                      <div class="form-check">
                        <%= form.radio_button field, 1, class: "form-check-input" %>
                        <%= form.label "#{field}_1", "Sí", for: "#{form.object_name}_#{field}_1", class: "form-check-label" %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
          <div class="col-12 col-md-6">
            <div class="conesst-info-card h-100">
              <div class="p-3">
                <%= form.label :other_unsafe_conditions, class: "form-label fw-semibold" %>
                <%= form.text_field :other_unsafe_conditions, class: "form-control", placeholder: "Especifica otra condición insegura" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <h5 class="mb-0">
          <i class="bi bi-person-exclamation me-2"></i>
          Descripción del acto inseguro
        </h5>
      </div>
      <div class="conesst-card-body">
        <%= form.text_area :description_act_unsafe, class: "form-control", rows: 4, placeholder: "Describe el acto inseguro identificado..." %>
      </div>
    </div>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <h5 class="mb-1">
          <i class="bi bi-list-check me-2"></i>
          Características del acto inseguro
        </h5>
        <small class="text-muted">
          Selecciona Sí o No para cada característica.
        </small>
      </div>
      <div class="conesst-card-body">
        <div class="row g-3">
          <% [
            [:not_using_equipment, :use_wrong_tool],
            [:operating_without_authorization, :wrong_position],
            [:running_facilities, :heights_without_authorization],
            [:using_defective_tool, :workplace_distractions],
            [:psychoactive_substances, :gen_on_desk],
            [:ignore_dangerous]
          ].each do |fields| %>
            <% fields.each do |field| %>
              <div class="col-12 col-md-6">
                <div class="conesst-info-card h-100">
                  <div class="p-3">
                    <div class="fw-semibold mb-3">
                      <%= form.label field, class: "mb-0" %>
                    </div>
                    <div class="d-flex flex-wrap gap-4">
                      <div class="form-check">
                        <%= form.radio_button field, 0, class: "form-check-input" %>
                        <%= form.label "#{field}_0", "No", for: "#{form.object_name}_#{field}_0", class: "form-check-label" %>
                      </div>
                      <div class="form-check">
                        <%= form.radio_button field, 1, class: "form-check-input" %>
                        <%= form.label "#{field}_1", "Sí", for: "#{form.object_name}_#{field}_1", class: "form-check-label" %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
          <div class="col-12 col-md-6">
            <div class="conesst-info-card h-100">
              <div class="p-3">
                <%= form.label :other_features, class: "form-label fw-semibold" %>
                <%= form.text_field :other_features, class: "form-control", placeholder: "Especifica otra característica" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <h5 class="mb-0">
          <i class="bi bi-lightbulb me-2"></i>
          Alternativas de solución
        </h5>
      </div>
      <div class="conesst-card-body">
        <%= form.text_area :alternative_soluctions, class: "form-control", rows: 4, placeholder: "Describe las acciones o alternativas propuestas para solucionar la situación..." %>
      </div>
    </div>
    <% if params[:entity_id].present? %>
      <%= form.hidden_field :entity_id, value: params[:entity_id].to_i %>
    <% else %>
      <%= form.hidden_field :entity_id, value: @entity.id.to_i if @entity.present? %>
    <% end %>
    <%= form.hidden_field :date_report, value: Time.now %>
    <%= form.hidden_field :user_receiving, value: @asesor_recibe.id if @asesor_recibe.present? %>
    <%= form.hidden_field :user_reports, value: Current.user.id if Current.user.present? %>
    <%= form.hidden_field :code, value: @template.reference if @template.present? %>
    <%= form.hidden_field :version, value: @template.version.to_i if @template.present? %>
    <div class="conesst-card mb-4">
      <div class="conesst-card-body">
        <div class="conesst-actions-wrap">
          <%= form.button type: "submit", class: "conesst-btn conesst-btn-primary" do %>
            <i class="bi bi-check-circle me-1"></i>
            <%= t('common.submit') %>
          <% end %>
          <%= link_to :back, class: "conesst-btn conesst-btn-secondary" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>