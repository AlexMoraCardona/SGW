<div class="container-fluid py-3">
  <div align="left"; class="container col-12">
    <a class="navbar-brand" href="/">
        <%= image_tag 'LogoConesst202305232.png',:width => "100",  :height=>"100" %>
    </a>
  </div>

  <div class="card shadow-sm border-0">

    <!-- ENCABEZADO -->

    <div class="card-header bg-light">

      <div class="d-flex align-items-center">

        <i class="bi bi-question-circle fs-3 me-2"></i>

        <div>

          <h4 class="mb-0">
            Ver pregunta
          </h4>

          <div class="text-muted small">
            <%= @surveillance_survey.name %>
          </div>

        </div>

      </div>

    </div>


    <div class="card-body">

      <!-- PREGUNTA -->

      <div class="mb-4">

        <label class="form-label fw-bold">
          Pregunta
        </label>

        <div class="form-control bg-light">
          <%= @surveillance_question.question %>
        </div>

      </div>


      <!-- INFORMACIÓN -->

      <div class="row">

        <div class="col-12 col-md-4 mb-3">

          <label class="form-label fw-bold">
            Tipo de pregunta
          </label>

          <div>
<div class="mb-4">

  <div class="d-flex align-items-center mb-2">

    <i class="bi bi-ui-checks-grid me-2"></i>

    <h6 class="fw-bold mb-0">
      Tipo de respuesta
    </h6>

  </div>

  <% if @surveillance_question.question_type == "open_text" %>

    <div class="alert alert-light border mb-0">

      <i class="bi bi-input-cursor-text me-2"></i>

      El trabajador deberá ingresar una respuesta de texto.

    </div>

  <% elsif @surveillance_question.question_type == "boolean" %>

    <div class="alert alert-light border mb-0">

      <i class="bi bi-toggle-on me-2"></i>

      El trabajador deberá responder:

      <strong>Sí</strong> o <strong>No</strong>.

    </div>

  <% elsif @surveillance_question.question_type == "single_choice" %>

    <div class="alert alert-light border mb-0">

      <i class="bi bi-ui-radios me-2"></i>

      El trabajador deberá seleccionar
      <strong>una sola opción</strong>.

    </div>

  <% elsif @surveillance_question.question_type == "multiple_choice" %>

    <div class="alert alert-light border mb-0">

      <i class="bi bi-ui-checks me-2"></i>

      El trabajador podrá seleccionar
      <strong>una o varias opciones</strong>.

    </div>

  <% else %>

    <div class="alert alert-warning mb-0">

      <i class="bi bi-exclamation-triangle me-2"></i>

      Tipo de pregunta no reconocido.

    </div>

  <% end %>

</div>

          </div>

        </div>


        <div class="col-12 col-md-4 mb-3">

          <label class="form-label fw-bold">
            Posición
          </label>

          <div>
            <span class="badge bg-dark">
              <%= @surveillance_question.position %>
            </span>
          </div>

        </div>


        <div class="col-12 col-md-4 mb-3">

          <label class="form-label fw-bold">
            Estado
          </label>

          <div>

            <% if @surveillance_question.active? %>

              <span class="badge bg-success">
                <i class="bi bi-check-circle me-1"></i>
                Activa
              </span>

            <% else %>

              <span class="badge bg-secondary">
                <i class="bi bi-x-circle me-1"></i>
                Inactiva
              </span>

            <% end %>

          </div>

        </div>

      </div>


      <!-- OBLIGATORIA -->

      <div class="mb-4">

        <label class="form-label fw-bold">
          Características
        </label>

        <div>

          <% if @surveillance_question.required? %>

            <span class="badge bg-warning text-dark">
              <i class="bi bi-exclamation-circle me-1"></i>
              Pregunta obligatoria
            </span>

          <% else %>

            <span class="badge bg-light text-dark border">
              Pregunta opcional
            </span>

          <% end %>

        </div>

      </div>


      <!-- OPCIONES -->

      <% if @surveillance_question_options.present? %>

        <hr class="my-4">

        <div class="d-flex align-items-center mb-3">

          <i class="bi bi-list-check fs-5 me-2"></i>

          <h5 class="mb-0">
            Opciones de respuesta
          </h5>

        </div>


        <div class="list-group">

          <% @surveillance_question_options.each do |option| %>

            <div class="list-group-item
                        d-flex
                        justify-content-between
                        align-items-center">

              <div>

                <span class="fw-semibold">
                  <%= option.position %>.
                  <%= option.option_text %>
                </span>

              </div>

            <span class="badge bg-success">
                Activa
            </span>
            </div>

          <% end %>

        </div>

      <% elsif %w[single_choice multiple_choice].include?(
        @surveillance_question.question_type
      ) %>

        <hr class="my-4">

        <div class="alert alert-warning mb-0">

          <i class="bi bi-exclamation-triangle me-1"></i>

          Esta pregunta requiere opciones de respuesta,
          pero actualmente no tiene opciones registradas.

        </div>

      <% end %>


      <!-- BOTONERA -->

      <hr class="my-4">

      <div class="d-flex flex-column flex-sm-row
                  justify-content-center
                  align-items-center
                  gap-2">

        <%= link_to(
              edit_epidemiological_surveillance_program_surveillance_survey_surveillance_question_path(
                @epidemiological_surveillance_program,
                @surveillance_survey,
                @surveillance_question
              ),
              class: "btn btn-primary"
            ) do %>

          <i class="bi bi-pencil-square me-1"></i>
          Editar

        <% end %>


        <%= link_to(
              epidemiological_surveillance_program_surveillance_survey_surveillance_questions_path(
                @epidemiological_surveillance_program,
                @surveillance_survey
              ),
              class: "btn btn-outline-secondary"
            ) do %>

          <i class="bi bi-arrow-left me-1"></i>
          Volver

        <% end %>

      </div>

    </div>

  </div>

</div>
