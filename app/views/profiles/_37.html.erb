                        </tr>
                    </thead>
                    <tbody>
                        <% @datos_genero.each do |dato| %>
                            <tr>
                                <td>
                                    <% dato[0] = Profile.labelgenero(dato[0]) %>
                                    <% @datosg.push([dato[0], ((dato[1]*100) / @cant_genero)]) if @cant_genero > 0 %>
                                    <%=  dato[0] %>
