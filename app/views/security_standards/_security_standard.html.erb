<div class="conesst-page">
  <% if @entity.present? %>
    <div class="conesst-header">
      <div class="conesst-header-content">
        <div class="conesst-logo-container">
          <i class="bi bi-building"></i>
        </div>
        <div>
          <h2 class="conesst-title mb-1">
            <%= @entity.business_name %>
          </h2>
          <% if @entity.identification_number.present? %>
            <div class="conesst-subtitle">
              NIT:
              <%= EvaluationRuleDetail.miles(@entity.identification_number) %>
              <% if @entity.verification_digit.present? %>
                -<%= @entity.verification_digit %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  <% if Current.user.level > 0 && Current.user.level < 4 %>
    <div class="conesst-actions">
      <%= link_to new_security_standard_path, class: "conesst-btn conesst-btn-primary" do %>
        <i class="bi bi-plus-circle"></i>
        <span>
          Crear estándar de seguridad
        </span>
      <% end %>
    </div>
  <% end %>
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div>
          <h3 class="conesst-card-header-title">
            <i class="bi bi-shield-check me-1"></i>
            Estándares de seguridad
          </h3>
          <div class="conesst-card-header-subtitle">
            Registro y gestión de estándares de seguridad
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card-body p-0">
      <div class="conesst-table-wrapper">
        <table class="conesst-table">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Área</th>
              <th>Usuario elaboró</th>
              <th>Firmar elaboró</th>
              <th>Firmar asesor</th>
              <th>Ver</th>
              <th><%= t('common.edit') %></th>
              <th>PDF</th>
            </tr>
          </thead>
          <tbody>
            <% @security_standards.each do |security_standard| %>
              <tr>
                <td>
                  <% if security_standard.date_standard.present? %>
                    <span class="conesst-table-main-text">
                      <%= security_standard.date_standard.strftime("%d/%m/%Y") %>
                    </span>
                  <% end %>
                </td>
                <td>
                  <span class="conesst-table-main-text">
                    <%= SecurityStandard.label_area(security_standard.code_area) %>
                  </span>
                </td>
                <td>
                  <span class="conesst-table-main-text">
                    <%= SecurityStandard.label_user(security_standard.user_elaborated) %>
                  </span>
                </td>
                <td>
                  <% if security_standard.firm_user_elaborated == 0 %>
                    <%= link_to firma_security_elaborated_path(security_standard), class: "conesst-btn conesst-btn-sm conesst-btn-warning", title: "Firmar como elaboró" do %>
                      <i class="bi bi-pen"></i>
                      <span class="d-none d-md-inline">Firmar</span>
                    <% end %>
                  <% else %>
                    <% if security_standard.date_user_elaborated.present? %>
                      <span class="conesst-table-main-text">
                        <%= security_standard.date_user_elaborated.strftime("%d/%m/%Y") %>
                      </span>
                    <% end %>
                  <% end %>
                </td>
                <td>
                  <% if security_standard.firm_user_asesor == 0 %>
                    <%= link_to firma_security_asesor_path(security_standard), class: "conesst-btn conesst-btn-sm conesst-btn-warning", title: "Firmar como asesor" do %>
                      <i class="bi bi-pen"></i>
                      <span class="d-none d-md-inline">Firmar</span>
                    <% end %>
                  <% else %>
                    <% if security_standard.date_user_asesor.present? %>
                      <span class="conesst-table-main-text">
                        <%= security_standard.date_user_asesor.strftime("%d/%m/%Y") %>
                      </span>
                    <% end %>
                  <% end %>
                </td>
                <td>
                  <%= link_to security_standard_path(security_standard), class: "conesst-btn conesst-btn-sm conesst-btn-primary", title: "Ver estándar" do %>
                    <i class="bi bi-eye"></i>
                    <span class="d-none d-md-inline">Ver</span>
                  <% end %>
                </td>
                <td>
                  <% if Current.user.level > 0 && Current.user.level < 3 %>
                    <%= link_to edit_security_standard_path(security_standard.id), class: "conesst-btn conesst-btn-sm conesst-btn-warning", title: "Editar estándar" do %>
                      <i class="bi bi-pencil-square"></i>
                      <span class="d-none d-md-inline">Editar</span>
                    <% end %>
                  <% end %>
                </td>
                <td>
                  <%= link_to ver_security_standard_path(security_standard.id, format: 'pdf'), class: "conesst-btn conesst-btn-sm conesst-btn-success", title: "Generar PDF" do %>
                    <i class="bi bi-file-earmark-pdf"></i>
                    <span class="d-none d-md-inline">PDF</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="conesst-mobile-scroll-hint d-md-none">
        <i class="bi bi-arrow-left-right me-1"></i>
        Desliza horizontalmente para ver todas las opciones
      </div>
    </div>
  </div>
</div>
