<div class="conesst-page">
    <div class="mb-3">
        <%= link_to root_path, class: "d-inline-block" do %>
            <%= image_tag "LogoConesst202305232.png",
                width: 100,
                height: 100,
                alt: "CONESST" %>
        <% end %>
    </div>
    <div class="conesst-card">
        <!-- ENCABEZADO -->
        <div class="conesst-card-header">

            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-2">
                <div>
                    <h2 class="mb-0">
                        <%= t('.title') %>
                    </h2>
                    <small class="text-muted">
                        Lista de chequeo de motocicletas
                    </small>
                </div>
                <div class="conesst-actions">
                    <%= link_to new_moto_checklist_path, class: "conesst-btn conesst-btn-primary" do %>
                        <i class="bi bi-plus-circle me-1"></i>
                        <%= t('.create_moto_checklist') %>
                    <% end %>
                </div>
            </div>
        </div>
        <div class="conesst-card-body">
            <div class="mb-4">
                <div class="fw-semibold mb-3">
                    <i class="bi bi-search me-1"></i>
                    Buscar lista de chequeo
                </div>
                <%= search_form_for @q do |f| %>
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4 col-lg-3">
                            <%= f.label :date_list, "Fecha", class: "form-label fw-semibold" %>
                            <%= f.date_field :date_list_eq, class: "form-control" %>
                        </div>
                        <div class="col-12 col-md-4 col-lg-3">
                            <%= f.label :user_id, "Conductor",  class: "form-label fw-semibold" %>
                            <%= f.select :user_id_eq, @users.pluck(:name, :id).uniq, { include_blank: "Todos" }, { class: "form-select" } %>
                        </div>
                        <div class="col-12 col-md-4 col-lg-3">
                            <%= f.label :plate_moto, "Placa", class: "form-label fw-semibold" %>
                            <%= f.search_field :plate_moto_cont, class: "form-control", placeholder: "Buscar placa..." %>
                        </div>
                        <div class="col-12 col-lg-3">
                            <div class="conesst-actions">
                                <button type="submit"
                                    class="conesst-btn conesst-btn-primary">
                                    <i class="bi bi-search me-1"></i>
                                    Buscar
                                </button>
                                <%= link_to moto_checklists_path, class: "conesst-btn" do %>
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                    Limpiar
                                <% end %>
                            </div>
                        </div>
                    </div>
                <% end %>
            </div>
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
                <div class="small text-muted">
                    <%== pagy_info(@pagy) %>
                </div>
                <div>
                    <%== pagy_bootstrap_combo_nav_js(@pagy) %>
                </div>
            </div>
            <div class="conesst-table-wrapper">
                <table class="conesst-table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">
                                <%= sort_link(@q, :date_list, default_order: :desc) %>
                            </th>
                            <th scope="col">
                                <%= sort_link(@q, :plate_moto, default_order: :desc) %>
                            </th>
                            <th scope="col">
                                <%= sort_link(@q, :user_id, default_order: :desc) %>
                            </th>
                            <th scope="col">
                                Firma
                            </th>
                            <th scope="col">
                                <%= t('.user_autoriza') %>
                            </th>
                            <th scope="col">
                                Firma
                            </th>
                            <th scope="col">
                                Adjuntos
                            </th>
                            <th scope="col">
                                <%= t('common.show') %>
                            </th>
                            <th scope="col">
                                PDF
                            </th>
                            <th scope="col">
                                Borrar
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <%= render partial: 'moto_checklist',
                            collection: @moto_checklists %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>