<div class="container-fluid px-2 px-md-4">
    <%= render 'templates/encabezado' if @template.present? %>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mb-3">
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <%= link_to ver_documental_path(@entity.id, format: 'pdf'), class: "btn btn-danger btn-sm", title: "Generar PDF", data: { bs_toggle: "tooltip" } do %>
                <i class="bi-file-earmark-pdf"></i>
                <span class="ms-1">PDF</span>
            <% end %>
            <%= link_to root_path, class:"btn btn-secondary" do %>
                <i class="bi bi-arrow-left-circle"></i>
                Retornar
            <% end %>
        </div>
    </div>
    <% if @template.present? %>
        <% format_number = @template.format_number.to_i %>
        <% plantilla = "templates/#{format_number}" %>

        <% if lookup_context.exists?(plantilla, [], true) %>
            <%= render plantilla, template: @template %>
        <% else %>
            <div class="alert alert-warning text-center my-4">
            <i class="bi bi-exclamation-triangle me-2"></i>
            La plantilla <strong>#{format_number}</strong> aún no tiene
            un formato de visualización configurado.
            </div>
        <% end %>
    <% end %>

    <%= render 'evaluation_rule_details/control_cambios' if @template_versions.present? %>
</div>

 
