<div class="container-fluid py-3 px-2 px-md-4">
  <!-- ========================================================= -->
  <!-- REGISTRAR FIRMA -->
  <!-- ========================================================= -->
  <div class="card border-0 shadow-sm mx-auto mb-4" style="max-width: 1200px;">
    <!-- ENCABEZADO -->
    <div class="card-header bg-light border-bottom py-3">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <div>
          <h5 class="mb-1 fw-bold text-secondary">
            <i class="bi bi-pen me-2"></i>
            Firma de evidencia
          </h5>
          <% if @evidence.present? && @evidence.template.present? %>
            <div class="text-muted small">
              <i class="bi bi-file-earmark-text me-1"></i>
              <%= @evidence.template.filing %>
            </div>
          <% end %>
        </div>
        <span class="badge bg-secondary px-3 py-2">
          <i class="bi bi-person-check me-1"></i>
          Firmantes
        </span>
      </div>
    </div>
    <!-- FORMULARIO -->
    <div class="card-body p-3 p-md-4">
      <%= form_with model: @firm do |form| %>
        <!-- ERRORES -->
        <% if @firm.errors.any? %>
          <div class="alert alert-danger shadow-sm" role="alert">
            <div class="d-flex align-items-start">
              <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
              <div>
                <strong>
                  No fue posible registrar la firma.
                </strong>
                <ul class="mb-0 mt-2">
                  <% @firm.errors.full_messages.each do |error| %>
                    <li><%= error %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>
        <!-- CAMPOS -->
        <div class="row g-3">
          <!-- FUNCIONARIO -->
          <div class="col-12 col-md-5">
            <%= form.label :user_id, "Funcionario", class: "form-label fw-semibold" %>
            <%= form.collection_select :user_id, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccionar funcionario --" }, { class: "form-select", required: true } %>
          </div>
          <!-- REPRESENTANTE LEGAL -->
          <div class="col-12 col-md-3">
            <label class="form-label fw-semibold d-block">
              <i class="bi bi-person-badge me-1"></i>
              Representante Legal
            </label>
            <div class="border rounded p-2 bg-light">
              <div class="form-check form-check-inline">
                <%= form.radio_button :legal_representative, 0, class: "form-check-input" %>
                <%= form.label :legal_representative_0, "NO", class: "form-check-label" %>
              </div>
              <div class="form-check form-check-inline">
                <%= form.radio_button :legal_representative, 1, class: "form-check-input" %>
                <%= form.label :legal_representative_1, "SI", class: "form-check-label" %>
              </div>
            </div>
          </div>
          <!-- CARGO -->
          <div class="col-12 col-md-4">
            <%= form.label :post, "Cargo", class: "form-label fw-semibold" %>
            <%= form.select :post,
                  [
                    ['', ''],
                    ['Representante Legal', 'Representante Legal'],
                    ['Responsable SG-SST', 'Responsable SG-SST'],
                    ['Asesor externo SG-SST', 'Asesor externo SG-SST'],
                    ['REPRESENTANTE EMPLEADOR', 'REPRESENTANTE EMPLEADOR'],
                    ['SUPLENTE REPRESENTANTE EMPLEADOR', 'SUPLENTE REPRESENTANTE EMPLEADOR'],
                    ['REPRESENTANTE EMPLEADOS', 'REPRESENTANTE EMPLEADOS'],
                    ['SUPLENTE REPRESENTANTE EMPLEADOS', 'SUPLENTE REPRESENTANTE EMPLEADOS'],
                    ['Presidente COPASST', 'Presidente COPASST'],
                    ['Secretario(a) COPASST', 'Secretario COPASST'],
                    ['Vigía SG-SST', 'Vigía SG-SST'],
                    ['Colaborador', 'Colaborador'],
                    ['COLABORADOR', 'COLABORADOR']
                  ],
                  { prompt: "-- Seleccionar cargo --" },
                  { class: "form-select" } %>
          </div>
        </div>
        <!-- EVIDENCE ID -->
        <%= form.hidden_field :evidence_id, value: params[:id].to_s %>
        <!-- BOTONERA -->
        <hr class="my-4">
        <div class="d-flex flex-column flex-sm-row justify-content-center align-items-stretch align-items-sm-center gap-2">
          <%= form.submit t('common.submit'),  class: "btn btn-primary px-4", data: {turbo_confirm: "¿Desea registrar este funcionario como firmante de la evidencia?"} do %>
          <% end %>
          <%= link_to edit_evaluation_rule_detail_path(@evidence.evaluation_rule_detail_id), class: "btn btn-outline-secondary px-4" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <!-- ========================================================= -->
  <!-- LISTADO DE FIRMANTES -->
  <!-- ========================================================= -->
  <div class="card border-0 shadow-sm mx-auto" style="max-width: 1400px;">
    <!-- ENCABEZADO -->
    <div class="card-header bg-light border-bottom py-3">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <h5 class="mb-0 fw-bold text-secondary">
          <i class="bi bi-people me-2"></i>
          Funcionarios que firman la evidencia
        </h5>
        <span class="badge bg-secondary">
          <%= @firms.count %>
          <%= @firms.count == 1 ? "firmante" : "firmantes" %>
        </span>
      </div>
    </div>
    <!-- TABLA -->
    <div class="card-body p-0">
      <% if @firms.any? %>
        <div class="table-responsive">
          <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="text-nowrap">
                  Fecha evidencia
                </th>
                <th>
                  Evidencia
                </th>
                <th>
                  Funcionario
                </th>
                <th class="text-center">
                  Rep. Legal
                </th>
                <th>
                  Cargo
                </th>
                <th class="text-center">
                  Firma
                </th>
                <th class="text-nowrap">
                  Fecha firma
                </th>
                <th class="text-center">
                  Acciones
                </th>
              </tr>
            </thead>
            <tbody>
              <% @firms.each do |firma| %>
                <tr>
                  <!-- FECHA EVIDENCIA -->
                  <td class="text-nowrap">
                    <i class="bi bi-calendar3 me-1 text-muted"></i>
                    <%= firma.evidence.date %>
                  </td>
                  <!-- EVIDENCIA -->
                  <td>
                    <div class="fw-semibold">
                      <%= firma.evidence.template.name %>
                    </div>
                  </td>
                  <!-- FUNCIONARIO -->
                  <td>
                    <div class="d-flex align-items-center">
                      <i class="bi bi-person-circle fs-4 me-2 text-secondary"></i>
                      <span class="fw-semibold">
                        <%= firma.user.name %>
                      </span>
                    </div>
                  </td>
                  <!-- REPRESENTANTE LEGAL -->
                  <td class="text-center">
                    <% if firma.legal_representative.to_i == 1 %>
                      <span class="badge bg-success">
                        <i class="bi bi-check-circle me-1"></i>
                        SI
                      </span>
                    <% else %>
                      <span class="badge bg-secondary">
                        NO
                      </span>
                    <% end %>
                  </td>
                  <!-- CARGO -->
                  <td>
                    <span class="badge bg-light text-dark border">
                      <%= firma.post %>
                    </span>
                  </td>
                  <!-- FIRMA -->
                  <td class="text-center">
                    <% if firma.label_authorize_firm.present? %>
                      <span class="badge bg-success">
                        <i class="bi bi-check-lg me-1"></i>
                        <%= firma.label_authorize_firm %>
                      </span>
                    <% else %>
                      <span class="badge bg-warning text-dark">
                        <i class="bi bi-clock me-1"></i>
                        Pendiente
                      </span>
                    <% end %>
                  </td>
                  <!-- FECHA FIRMA -->
                  <td class="text-nowrap">
                    <% if firma.date_authorize_firm.present? %>
                      <i class="bi bi-calendar-check me-1 text-muted"></i>
                      <%= firma.date_authorize_firm %>
                    <% else %>
                      <span class="text-muted">
                        —
                      </span>
                    <% end %>
                  </td>
                  <!-- ACCIONES -->
                  <td>
                    <div class="d-flex justify-content-center gap-1">
                      <!-- EDITAR -->
                      <%= link_to edit_firm_path(firma), class: "btn btn-sm btn-outline-primary", title: "Editar", data: {bs_toggle: "tooltip"} do %>
                        <i class="bi bi-pencil-square"></i>
                        <span class="d-none d-lg-inline ms-1">
                          Editar
                        </span>
                      <% end %>
                      <!-- ELIMINAR -->
                      <%= button_to firma, method: :delete, class: "btn btn-sm btn-outline-danger", title: "Eliminar", form: {data: {turbo_confirm: "¿Está seguro de eliminar este firmante?"}} do %>
                        <i class="bi bi-trash"></i>
                        <span class="d-none d-lg-inline ms-1">
                          Eliminar
                        </span>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <!-- SIN FIRMANTES -->
        <div class="text-center py-5 px-3">
          <div class="mb-3">
            <i class="bi bi-person-x display-4 text-muted"></i>
          </div>
          <h6 class="fw-semibold text-secondary">
            No hay funcionarios registrados
          </h6>
          <p class="text-muted mb-0">
            Aún no se han registrado funcionarios para firmar esta evidencia.
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
<div class="mb-4"></div>
