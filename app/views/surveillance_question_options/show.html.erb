<div class="container-fluid py-3">

  <div class="card shadow-sm border-0">

    <!-- ENCABEZADO -->

    <div class="card-header bg-light">

      <div class="d-flex flex-column flex-md-row
                  justify-content-between
                  align-items-md-center
                  gap-3">

        <div class="d-flex align-items-center">

          <i class="bi bi-list-check fs-3 me-2"></i>

          <div>

            <h4 class="mb-0">
              Opción de respuesta
            </h4>

            <small class="text-muted">
              Detalle de la opción configurada
            </small>

          </div>

        </div>


        <span class="badge bg-dark fs-6">

          Opción <%= @surveillance_question_option.position %>

        </span>

      </div>

    </div>


    <div class="card-body">

      <!-- PREGUNTA -->

      <div class="mb-4">

        <label class="form-label fw-semibold text-muted">
          Pregunta
        </label>

        <div class="border rounded p-3 bg-light">

          <%= @surveillance_question.question %>

        </div>

      </div>


      <!-- DATOS DE LA OPCIÓN -->

      <div class="row g-3">


        <!-- TEXTO -->

        <div class="col-12 col-md-8">

          <label class="form-label fw-semibold text-muted">
            Texto de la opción
          </label>

          <div class="form-control bg-light">

            <%= @surveillance_question_option.option_text %>

          </div>

        </div>


        <!-- POSICIÓN -->

        <div class="col-12 col-md-4">

          <label class="form-label fw-semibold text-muted">
            Posición
          </label>

          <div class="form-control bg-light">

            <%= @surveillance_question_option.position %>

          </div>

        </div>


        <!-- VALOR INTERNO -->

        <div class="col-12 col-md-8">

          <label class="form-label fw-semibold text-muted">
            Valor interno
          </label>

          <div class="form-control bg-light">

            <code>
              <%= @surveillance_question_option.option_value %>
            </code>

          </div>

          <div class="form-text">
            Valor utilizado internamente por el sistema.
          </div>

        </div>


        <!-- ESTADO -->

        <div class="col-12 col-md-4">

          <label class="form-label fw-semibold text-muted">
            Estado
          </label>

          <div class="mt-2">

            <% if @surveillance_question_option.active? %>

              <span class="badge bg-success fs-6">
                Activa
              </span>

            <% else %>

              <span class="badge bg-secondary fs-6">
                Inactiva
              </span>

            <% end %>

          </div>

        </div>

      </div>


      <hr class="my-4">


      <!-- INFORMACIÓN DE REGISTRO -->

      <div class="row g-3 text-muted small">

        <div class="col-12 col-md-6">

          <strong>ID:</strong>

          <%= @surveillance_question_option.id %>

        </div>

        <div class="col-12 col-md-6">

          <strong>Creada:</strong>

          <%= l(
                @surveillance_question_option.created_at,
                format: :long
              ) if @surveillance_question_option.created_at.present? %>

        </div>

        <div class="col-12 col-md-6">

          <strong>Última actualización:</strong>

          <%= l(
                @surveillance_question_option.updated_at,
                format: :long
              ) if @surveillance_question_option.updated_at.present? %>

        </div>

      </div>


      <!-- BOTONERA -->

      <div class="d-flex flex-wrap
                  justify-content-center
                  gap-2 mt-4">


        <!-- EDITAR -->

        <%= link_to(
              edit_epidemiological_surveillance_program_surveillance_survey_surveillance_question_surveillance_question_option_path(
                @epidemiological_surveillance_program,
                @surveillance_survey,
                @surveillance_question,
                @surveillance_question_option
              ),
              class: "btn btn-outline-primary"
            ) do %>

          <i class="bi bi-pencil-square me-1"></i>
          Editar

        <% end %>


        <!-- ELIMINAR -->

        <%= button_to(
              epidemiological_surveillance_program_surveillance_survey_surveillance_question_surveillance_question_option_path(
                @epidemiological_surveillance_program,
                @surveillance_survey,
                @surveillance_question,
                @surveillance_question_option
              ),
              method: :delete,
              class: "btn btn-outline-danger",
              form: {
                data: {
                  turbo_confirm:
                    "¿Está seguro de eliminar esta opción?"
                }
              }
            ) do %>

          <i class="bi bi-trash me-1"></i>
          Eliminar

        <% end %>


        <!-- VOLVER -->

        <%= link_to(
              epidemiological_surveillance_program_surveillance_survey_surveillance_question_surveillance_question_options_path(
                @epidemiological_surveillance_program,
                @surveillance_survey,
                @surveillance_question
              ),
              class: "btn btn-outline-secondary"
            ) do %>

          <i class="bi bi-arrow-left me-1"></i>
          Volver a opciones

        <% end %>

      </div>

    </div>

  </div>

</div>