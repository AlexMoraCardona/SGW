<div class="conesst-page">
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-pencil-square fs-5"></i>
        <div>
          <h4 class="mb-0">
            Editar Inspección de Seguridad
          </h4>
          <small class="text-muted">
            Actualice la información de la condición inspeccionada
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @safety_inspection_item do |form| %>
        <% if @safety_inspection_item.errors.any? %>
          <div class="alert alert-danger mb-4" role="alert">
            <div class="fw-semibold mb-2">
              <i class="bi bi-exclamation-triangle me-1"></i>
              Se encontraron los siguientes errores:
            </div>
            <ul class="mb-0">
              <% @safety_inspection_item.errors.full_messages.each do |error| %>
                <li>
                  <%= error %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="row g-3 mb-4">
          <div class="col-12 col-md-8 col-lg-5">
            <%= form.label :state_compliance, class: "form-label fw-semibold" do %>
              <%= t('.state_compliance') %>
              <button
                type="button"
                class="btn btn-sm btn-outline-secondary ms-1"
                data-bs-toggle="tooltip"
                data-bs-html="true"
                title="Seleccionar el cumplimiento de la situación o condición."
              >
                <i class="bi bi-question-circle"></i>
              </button>
            <% end %>
            <%= form.select(:state_compliance, [['N/A', 0], ['SI', 1], ['NO', 2], ['PARCIAL', 3]], {}, class: "form-select") %>
          </div>
        </div>
        <div class="mb-4">
          <%= form.label :observation, class: "form-label fw-semibold" %>
          <%= form.text_area(:observation, class: "form-control", rows: 4) %>
        </div>
        <div class="mb-4">
          <%= form.label :recommendations, class: "form-label fw-semibold" %>
          <%= form.text_area(:recommendations, class: "form-control", rows: 4) %>
        </div>
        <div class="mb-4">
          <%= form.label :proposed_intervention, class: "form-label fw-semibold" %>
          <%= form.text_area(:proposed_intervention, class: "form-control", rows: 4) %>
        </div>
        <div class="conesst-actions mt-4">
          <%= form.submit(t('common.submit'), class: "conesst-btn conesst-btn-primary") %>
          <%= link_to(safety_inspections_path(entity_id: @safety_inspection_item.safety_inspection.entity_id), class: "conesst-btn") do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-cloud-arrow-up fs-5"></i>
        <div>
          <h5 class="mb-0">
            Adjuntar Evidencias
          </h5>
          <small class="text-muted">
            Agregue imágenes, videos, audios o documentos relacionados
            con la condición inspeccionada.
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @safety_inspection_item, local: true do |f| %>
        <div class="row g-3 align-items-end">
          <div class="col-12 col-lg-8">
            <%= f.label(:inspection_evidences, "Adjuntar archivos", class: "form-label fw-semibold") %>
            <%= f.file_field(:inspection_evidences, multiple: true, class: "form-control") %>
            <div class="form-text mt-2">
              <i class="bi bi-info-circle me-1"></i>
              Puede seleccionar una o varias imágenes, videos,
              audios o documentos.
            </div>
          </div>
          <div class="col-12 col-lg-4">
            <div class="conesst-actions">
              <%= f.submit("Subir archivos", class: "conesst-btn conesst-btn-success") %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-paperclip fs-5"></i>
        <div>
          <h5 class="mb-0">
            Archivos adjuntos
          </h5>
          <small class="text-muted">
            Evidencias asociadas a esta condición de inspección.
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <% if @safety_inspection_item.inspection_evidences.attached? %>
        <div class="row g-4" data-controller="previews">
          <% @safety_inspection_item.inspection_evidences.each do |file| %>
            <div class="col-12 col-md-6 col-xl-4">
              <div class="conesst-card h-100">
                <div class="conesst-card-body text-center">
                  <% if file.image? %>
                    <%= image_tag(file, data: { previews_target: "preview" }, class: "img-fluid rounded shadow-sm mb-3", style: "max-height:300px; object-fit:contain;") %>
                  <% elsif file.video? %>
                    <%= video_tag(url_for(file), controls: true, class: "w-100 rounded shadow-sm mb-3") %>
                  <% elsif file.audio? %>
                    <div class="mb-3">
                      <i class="bi bi-file-music fs-1 text-primary"></i>
                    </div>
                    <%= audio_tag(url_for(file), controls: true, class: "w-100 mb-3") %>
                  <% else %>
                    <div class="py-3">
                      <i class="bi bi-file-earmark-text display-3 text-secondary"></i>
                    </div>
                    <h6 class="text-break mb-3">
                      <%= file.filename %>
                    </h6>
                  <% end %>
                  <% unless file.audio? || (!file.image? && !file.video?) %>
                    <p class="small text-muted text-break mb-0">
                      <i class="bi bi-file-earmark me-1"></i>
                      <%= file.filename %>
                    </p>
                  <% end %>
                </div>
                <div class="conesst-card-body pt-0">
                  <div class="conesst-actions">
                    <%= link_to(rails_blob_path(file, disposition: :attachment), class: "conesst-btn conesst-btn-success") do %>
                      <i class="bi bi-download me-1"></i>
                      Descargar
                    <% end %>
                    <%= link_to(purge_attachment_path(file), data: {turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar este registro? Esta acción no se puede deshacer."}, class: "conesst-btn") do %>
                      <i class="bi bi-trash me-1"></i>
                      Eliminar
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-folder2-open display-1 text-secondary"></i>
          <h5 class="mt-3 mb-2 text-muted">
            No existen archivos adjuntos
          </h5>
          <p class="text-muted mb-0">
            Utilice el formulario superior para cargar evidencias.
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
