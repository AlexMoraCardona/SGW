    <hr class="my-5">
    <div class="container-fluid">
        <div class="row text-center align-items-start">
            <!-- Representante Legal -->
            <div class="col-12 col-md-6 mb-5">
            <div style="height: 90px; display: flex; align-items: center; justify-content: center;">
                <% if @annual_work_plan.firm_legal_representative == 1 && @rep.present? && @rep.firm.attached? && @rep.firm.image? %>
                        <%= image_tag @rep.firm, style: "max-height:90px; max-width:100%; object-fit:contain;" %>
                <% end %>
            </div>
            <hr class="my-1">
            <strong>
                <%= @annual_work_plan.name_user(@annual_work_plan.user_legal_representative) %>
            </strong>
            <br>
            <small class="text-muted">
                Representante Legal
            </small>
        </div>
        <!-- Asesor SST -->
        <div class="col-12 col-md-6 mb-5">
            <div style="height: 90px; display: flex; align-items: center; justify-content: center;">
                <% if @annual_work_plan.firm_adviser_sst == 1 && @adv.present? && @adv.firm.attached? && @adv.firm.image? %>
                    <%= image_tag @adv.firm, style: "max-height:90px; max-width:100%; object-fit:contain;" %>
                <% end %>
            </div>
            <hr class="my-1">
            <strong>
                <%= @annual_work_plan.name_user(@annual_work_plan.user_adviser_sst) %>
