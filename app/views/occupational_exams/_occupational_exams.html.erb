<div class="container py-4">
  <div align="left"; class="container col-12">
      <a class="navbar-brand" href="/">
          <%= image_tag 'LogoConesst202305232.png',:width => "100",  :height=>"100" %>
      </a>
  </div>

  <% if @entity.present? %>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body text-center">
        <h2 class="fw-bold text-primary mb-0">
          <i class="bi bi-building"></i>
          <%= @entity.business_name %>
        </h2>
        <div class="text-muted">
            <strong>NIT:</strong>
            <%= EvaluationRuleDetail.miles(@entity.identification_number) if @entity.identification_number.present? %>
            <% if @entity.verification_digit.present? %>
                -<%= @entity.verification_digit %>
            <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @occupational_exams.present? %>
    <div class="btn-group gap-2" role="group">
        <% if Current.user.level > 0 && Current.user.level < 3 %>
            <div class="mb-4">
                <%= link_to new_occupational_exam_path(entity_id: @entity.id), class: "btn btn-success" do %>
                    <i class="bi bi-plus-circle"></i>
                    <%= t('.create_occupational_exam') %>
                <% end %>
            </div>
        <% end %>
        <div class="mb-4">
            <%= link_to :back, class:"btn btn-secondary" do %>
                <i class="bi bi-arrow-left-circle"></i>
                Retornar
            <% end %>
        </div>    
    </div>
    <% @occupational_exams.each do |occupational_exam| %>
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-light text-dark" >
          <div class="row align-items-center">
            <div class="col-md-8">
              <h4 class="mb-0">
                <i class="bi bi-calendar3"></i>
                Matriz de seguimiento exámenes ocupacionales
              </h4> 
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
              <div class="d-grid d-md-flex justify-content-md-end gap-2">
                <% if Current.user.level > 0 && Current.user.level < 4 %>
                  <%= link_to crear_item_occupational_occupational_exams_path(occupational_exam.id), class: "btn btn-success btn-sm" do %>
                    <i class="bi bi-plus-square"></i>
                    <%= t('common.create_item_occupational_occupational_exam') %>
                  <% end %>
                <% end %>
                <%= link_to occupational_exam_path(occupational_exam.id), class: "btn btn-primary btn-sm text-white" do %>
                  <i class="bi bi-eye"></i>
                  <%= t('common.show_occupational_exam') %>
                <% end %>
                <%= link_to ver_occupational_occupational_exams_path(occupational_exam.id, format: 'pdf'), class: "btn btn-danger btn-sm" do %>
                  <i class="bi bi-file-earmark-pdf"></i>
                  PDF
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <div class="card-body">
          <div class="row mb-4">
            <div class="col-md-4">
              <strong>Fecha de creación</strong><br>
              <span class="text-muted">
                <%= occupational_exam.created_at.strftime("%F") %>
              </span>
            </div>
          </div>
          <hr>
          <h5 class="text-primary mb-3">
            <i class="bi bi-person-badge"></i>
            Representante Legal
          </h5>
          <div class="row gy-3">
            <div class="col-md-3">
              <strong><%= t('.user_legal_representative') %></strong><br>
              <%= occupational_exam.name_user(occupational_exam.user_legal_representative) %>
            </div>
          </div>
          <hr>
          <h5 class="text-success mb-3">
            <i class="bi bi-person-workspace"></i>
            Asesor SST
          </h5>
          <div class="row gy-3">
            <div class="col-md-3">
              <strong><%= t('.user_adviser_sst') %></strong><br>
              <%= occupational_exam.name_user(occupational_exam.user_adviser_sst) %>
            </div>
          </div>
          <hr>
          <h5 class="text-danger mb-3">
            <i class="bi bi-person-check"></i>
            <%= t('.user_responsible_sst') %>
          </h5>
          <div class="row gy-3">
            <div class="col-md-3">
              <strong><%= t('.user_responsible_sst') %></strong><br>
              <%= occupational_exam.name_user(occupational_exam.user_responsible_sst) %>
            </div>
          </div>
          <hr>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="card shadow-sm">
      <div class="card-body text-center">
        <h5 class="text-secondary mb-4">
          No existen matrices de seguimientos de exámenes ocupacionales .
        </h5>
        <% if Current.user.level > 0 && Current.user.level < 3 %>
            <div class="mb-4">
                <%= link_to new_occupational_exam_path(entity_id: @entity.id), class: "btn btn-success" do %>
                    <i class="bi bi-plus-circle"></i>
                    <%= t('.create_occupational_exam') %>
                <% end %>
            </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
