<div class="conesst-page">
    <div class="conesst-card">
        <div class="conesst-card-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-calendar-check fs-4"></i>
                <div>
                    <h2 class="mb-0">
                         Administración y control de asistencia
                    </h2>
                </div>
            </div>
        </div>
        <div class="conesst-card-body">
            <%= form_with model: @adm_attendance do |form| %>
                <% if @adm_attendance.errors.any? %>
                    <div class="alert alert-danger" role="alert">
                        <div class="fw-semibold mb-2">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Se encontraron los siguientes errores:
                        </div>
                        <ul class="mb-0">
                            <% @adm_attendance.errors.full_messages.each do |error| %>
                                <li>
                                    <%= error %>
                                </li>
                            <% end %>
                        </ul>
                    </div>
                <% end %>
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <%= form.label :date_attendance, class: "form-label fw-semibold" %>
                        <%= form.date_field :date_attendance, class: "form-control" %>
                    </div>
                    <div class="col-12 col-md-4">
                        <%= form.label :time_initial, class: "form-label fw-semibold" %>
                        <%= form.time_field :time_initial, class: "form-control" %>
                    </div>
                    <div class="col-12 col-md-4">
                        <%= form.label :time_final, class: "form-label fw-semibold" %>
                        <%= form.time_field :time_final, class: "form-control" %>
                    </div>
                </div>
                <div class="mt-3">
                    <%= form.label :description, class: "form-label fw-semibold" %>
                    <%= form.text_field :description, class: "form-control" %>
                </div>
                <%= form.hidden_field :entity_id, value: Current.user.entity.to_i %>
                <%= form.hidden_field :user_id, value: Current.user.id.to_i %>
                <% if @template.present? %>
                    <%= form.hidden_field :code, value: @template.reference %>
                    <%= form.hidden_field :version, value: @template.version.to_i %>
                <% end %>
                <div class="conesst-actions mt-4">
                    <%= form.submit t('common.submit'), class: "conesst-btn conesst-btn-primary" %>
                    <%= link_to adm_attendances_path, class: "conesst-btn" do %>
                        <i class="bi bi-arrow-left me-1"></i>
                        Retornar
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
</div>
