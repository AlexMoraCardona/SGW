<head>
    <meta charset="utf-8">
    <%= wicked_pdf_stylesheet_link_tag "application" %>

    <style>
        @page {
            size: Letter landscape;
            margin: 10mm 7mm 10mm 7mm;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 8px;
            color: #000;
            margin: 0;
            padding: 0;
        }

        .pdf-container {
            width: 100%;
            margin: 0;
            padding: 0;
        }

        /* ==========================================
           TABLA PRINCIPAL
           ========================================== */

        .protection-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin: 0;
            padding: 0;
        }

        .protection-table th,
        .protection-table td {
            border: 1px solid #000;
            padding: 4px 3px;
            vertical-align: middle;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        /* Repetir encabezados en cada página */
        .protection-table thead {
            display: table-header-group;
        }

        .protection-table tbody {
            display: table-row-group;
        }

        /* Evita partir una fila entre páginas */
        .protection-table tr {
            page-break-inside: avoid;
        }

        /* ==========================================
           ENCABEZADOS
           ========================================== */

        .column-header {
            background: #eeeeee;
            text-align: center;
            font-weight: bold;
            font-size: 7px;
            line-height: 1.15;
            vertical-align: middle !important;
        }

        /* ==========================================
           ANCHOS DE LAS 9 COLUMNAS
           Total = 100%
           ========================================== */

        .col-area {
            width: 14%;
        }

        .col-equipment {
            width: 15%;
        }

        .col-body {
            width: 13%;
        }

        .col-image {
            width: 10%;
            text-align: center;
        }

        .col-rule {
            width: 10%;
        }

        .col-durability {
            width: 9%;
            text-align: center;
        }

        .col-sheet {
            width: 9%;
            text-align: center;
        }

        .col-delivery {
            width: 10%;
            text-align: center;
        }

        .col-induction {
            width: 10%;
            text-align: center;
        }

        /* ==========================================
           TEXTO
           ========================================== */

        .center {
            text-align: center;
        }

        .text-justify {
            text-align: justify;
        }

        /* ==========================================
           IMÁGENES DE ELEMENTOS DE PROTECCIÓN
           ========================================== */

        .protection-image {
            display: block;
            width: auto;
            max-width: 65px;
            height: auto;
            max-height: 55px;
            margin: 0 auto;
            object-fit: contain;
        }

        .avatar-mini {
            display: block;
            width: 45px;
            height: 45px;
            margin: 0 auto;
            object-fit: contain;
        }

        /* ==========================================
           FIRMAS
           ========================================== */

        .signatures {
            width: 100%;
            margin-top: 12px;
            page-break-inside: avoid;
        }

        .signature-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .signature-table td {
            border: 1px solid #000;
            text-align: center;
            vertical-align: middle;
            padding: 4px;
        }

        .signature-space {
            height: 55px;
        }

        .firma {
            display: block;
            max-width: 180px;
            height: 50px;
            margin: 0 auto;
            object-fit: contain;
        }

        .signature-name {
            font-size: 8px;
            line-height: 1.2;
            height: 25px;
            vertical-align: middle !important;
        }
    </style>
</head>


<div class="pdf-container">

    <!-- ==========================================
         MATRIZ DE ELEMENTOS DE PROTECCIÓN
         ========================================== -->

    <table class="protection-table">

        <colgroup>
            <col class="col-area">
            <col class="col-equipment">
            <col class="col-body">
            <col class="col-image">
            <col class="col-rule">
            <col class="col-durability">
            <col class="col-sheet">
            <col class="col-delivery">
            <col class="col-induction">
        </colgroup>

        <thead>

            <tr>

                <th class="column-header">
                    Área / Oficio
                </th>

                <th class="column-header">
                    Equipo de<br>
                    protección
                </th>

                <th class="column-header">
                    Parte del cuerpo<br>
                    a proteger
                </th>

                <th class="column-header">
                    Imagen
                </th>

                <th class="column-header">
                    Norma
                </th>

                <th class="column-header">
                    Durabilidad
                </th>

                <th class="column-header">
                    Ficha<br>
                    Técnica
                </th>

                <th class="column-header">
                    Formato<br>
                    de Entrega
                </th>

                <th class="column-header">
                    Inducción<br>
                    al personal
                </th>

            </tr>

        </thead>


        <tbody>

            <% @matrix_protection_items.each do |matrix_protection_item| %>

                <tr>

                    <!-- ÁREA / OFICIO -->
                    <td>
                        <%= matrix_protection_item.areas %>
                    </td>


                    <!-- EQUIPO DE PROTECCIÓN -->
                    <td>
                        <% if matrix_protection_item.protection_element.present? %>
                            <%= matrix_protection_item.protection_element.name %>
                        <% end %>
                    </td>


                    <!-- PARTE DEL CUERPO -->
                    <td>
                        <% if matrix_protection_item.protection_element.present? %>
                            <%= matrix_protection_item.protection_element.body_protect %>
                        <% end %>
                    </td>


                    <!-- IMAGEN -->
                    <td class="center">

                        <% if matrix_protection_item.protection_element.present? %>

                            <% if matrix_protection_item.protection_element.img_elem.attached? %>

                                <% if matrix_protection_item.protection_element.img_elem.image? %>

                                    <%= image_tag(
                                        matrix_protection_item.protection_element.img_elem,
                                        class: "protection-image"
                                    ) %>

                                <% end %>

                            <% else %>

                                <%= image_tag(
                                    "avatar.jpg",
                                    class: "avatar-mini"
                                ) %>

                            <% end %>

                        <% end %>

                    </td>


                    <!-- NORMA -->
                    <td>
                        <% if matrix_protection_item.protection_element.present? %>
                            <%= matrix_protection_item.protection_element.rule_protection %>
                        <% end %>
                    </td>


                    <!-- DURABILIDAD -->
                    <td class="center">
                        <%= matrix_protection_item.durability %>
                    </td>


                    <!-- FICHA TÉCNICA -->
                    <td class="center">
                        <%= MatrixProtectionItem.label(
                            matrix_protection_item.date_sheet
                        ) %>
                    </td>


                    <!-- FORMATO DE ENTREGA -->
                    <td class="center">
                        <%= MatrixProtectionItem.label(
                            matrix_protection_item.delivery_format
                        ) %>
                    </td>


                    <!-- INDUCCIÓN -->
                    <td class="center">
                        <%= MatrixProtectionItem.label(
                            matrix_protection_item.personal_induction
                        ) %>
                    </td>

                </tr>

            <% end %>

        </tbody>

    </table>


    <!-- ==========================================
         FIRMAS
         ========================================== -->

    <div class="signatures">

        <table class="signature-table">

            <colgroup>
                <col style="width: 33.33%">
                <col style="width: 33.33%">
                <col style="width: 33.34%">
            </colgroup>


            <!-- ESPACIO PARA FIRMAS -->
            <tr>

                <!-- REPRESENTANTE LEGAL -->
                <td class="signature-space">

                    <% if @matrix_protection.firm_legal_representative == 1 %>

                        <% if @rep.present? %>

                            <% if @rep.firm.attached? %>

                                <% if @rep.firm.image? %>

                                    <%= image_tag(
                                        @rep.firm,
                                        class: "firma"
                                    ) %>

                                <% end %>

                            <% end %>

                        <% end %>

                    <% end %>

                </td>


                <!-- ASESOR SST -->
                <td class="signature-space">

                    <% if @matrix_protection.firm_adviser_sst == 1 %>

                        <% if @adv.present? %>

                            <% if @adv.firm.attached? %>

                                <% if @adv.firm.image? %>

                                    <%= image_tag(
                                        @adv.firm,
                                        class: "firma"
                                    ) %>

                                <% end %>

                            <% end %>

                        <% end %>

                    <% end %>

                </td>


                <!-- RESPONSABLE SST -->
                <td class="signature-space">

                    <% if @matrix_protection.firm_responsible_sst == 1 %>

                        <% if @res.present? %>

                            <% if @res.firm.attached? %>

                                <% if @res.firm.image? %>

                                    <%= image_tag(
                                        @res.firm,
                                        class: "firma"
                                    ) %>

                                <% end %>

                            <% end %>

                        <% end %>

                    <% end %>

                </td>

            </tr>


            <!-- NOMBRES -->
            <tr>

                <td class="signature-name">

                    <% if @rep.present? %>
                        <%= @rep.name %>
                    <% end %>

                    <br>
                    Representante Legal

                </td>


                <td class="signature-name">

                    <% if @adv.present? %>
                        <%= @adv.name %>
                    <% end %>

                    <br>
                    Asesor SG-SST

                </td>


                <td class="signature-name">

                    <% if @res.present? %>
                        <%= @res.name %>
                    <% end %>

                    <br>
                    Responsable SG-SST

                </td>

            </tr>

        </table>

    </div>

</div>
