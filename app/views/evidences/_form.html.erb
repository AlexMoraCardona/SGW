              <%= form.label :year_initial, "Año", class: "form-label fw-semibold" %>
              <%= form.number_field :year_initial, class: "form-control" %>
            </div>
            <div class="col-12 col-md-6">
              <%= form.label :number_attendees, "Número de personas impactadas", class: "form-label fw-semibold" %>
              <%= form.number_field :number_attendees, class: "form-control" %>
            </div>
            <div class="col-12">
              <%= form.label :period, "La Semana de la Salud se llevó a cabo los días", class: "form-label fw-semibold" %>
              <%= form.text_field :period, class: "form-control" %>
            </div>
            <div class="col-12">
              <%= form.label :compliances, "Desarrollo de la actividad", class: "form-label fw-semibold" %>
              <%= form.rich_text_area :compliances, class: "form-control" %>
            </div>
            <div class="col-12">
              <%= form.label :goals, "Descripción registro asistencia", class: "form-label fw-semibold" %>
              <%= form.text_field :goals, class: "form-control" %>
            </div>
            <!-- ARCHIVOS -->
            <div class="col-12">
              <div class="border rounded p-3 bg-light">
                <label class="form-label fw-semibold">
                  <i class="bi bi-paperclip me-1"></i>
                  Adjuntar archivos
                </label>
                <%= form.file_field :evi_files, multiple: true, class: "form-control" %>
                <div class="form-text">
                  Puede seleccionar uno o varios archivos.
                </div>
              </div>
            </div>
          </div>
        <% end %>
        <!-- ========================================================= -->
        <!-- FORMATO 116 -->
        <!-- ========================================================= -->
        <% if @evidence.template.format_number == 116 %>
          <div class="row g-3">
            <div class="col-12 col-md-4">
              <%= form.label :date, class: "form-label fw-semibold" %>
              <%= form.date_field :date, class: "form-control" %>
            </div>
            <div class="col-12 col-md-4">
              <%= form.label :age, "Edad", class: "form-label fw-semibold" %>
              <%= form.number_field :age, class: "form-control" %>
            </div>
            <div class="col-12 col-md-4">
              <%= form.label :health_promoter_id, "EPS", class: "form-label fw-semibold" %>
              <%= form.collection_select :health_promoter_id, HealthPromoter.all.order(id: :asc), :id, :name_entity, { prompt: "-- Seleccionar EPS --" }, { class: "form-select select2" } %>
            </div>
            <div class="col-12 col-md-4">
              <%= form.label :weight, "Peso (Kg)", class: "form-label fw-semibold" %>
              <%= form.number_field :weight, class: "form-control", step: :any %>
            </div>
            <div class="col-12 col-md-8">
              <%= form.label :company_position_id, "Cargo", class: "form-label fw-semibold" %>
              <%= form.collection_select :company_position_id, CompanyPosition.where(entity_id: @evidence.entity_id).order(id: :asc), :id, :name, { prompt: "-- Seleccionar cargo --" }, { class: "form-select select2" } %>
            </div>
            <div class="col-12 col-md-6">
              <%= form.label :sede, "Sede", class: "form-label fw-semibold" %>
              <%= form.text_field :sede, class: "form-control" %>
            </div>
            <div class="col-12 col-md-6">
              <%= form.label :company_area_id, "Área", class: "form-label fw-semibold" %>
              <%= form.collection_select :company_area_id, CompanyArea.where(entity_id: @evidence.entity_id).order(id: :asc), :id, :name, { prompt: "-- Seleccionar área --" }, { class: "form-select select2" } %>
            </div>
            <div class="col-12 col-md-6">
              <%= form.label :type_employment, "Tipo de contrato", class: "form-label fw-semibold" %>
              <%= form.select :type_employment,
                    [
                      ['Contrato a Término Fijo', 0],
                      ['Contrato a término indefinido', 1],
                      ['Contrato de Obra o labor', 2],
                      ['Contrato civil por prestación de servicios', 3],
                      ['Contrato de aprendizaje', 4],
                      ['Contrato ocasional de trabajo', 5]
                    ],
                    { prompt: "-- Seleccionar tipo de contrato --" },
                    { class: "form-select" } %>
            </div>
            <div class="col-12 col-md-6">
              <%= form.label :medical_treatment, "Tratamiento médico", class: "form-label fw-semibold" %>
              <%= form.select :medical_treatment, [['NO', 0], ['SI', 1]], { prompt: "-- Seleccionar --" }, { class: "form-select" } %>
            </div>
            <div class="col-12 col-md-6">
              <%= form.label :boss_name, "Nombre del jefe", class: "form-label fw-semibold" %>
              <%= form.text_field :boss_name,  class: "form-control" %>
            </div>
            <div class="col-12">
              <%= form.label :diagnosis, "Diagnóstico", class: "form-label fw-semibold" %>
              <%= form.text_area :diagnosis, class: "form-control", rows: 3 %>
            </div>
            <div class="col-12">
              <%= form.label :type_treatment, "Tipo de tratamiento", class: "form-label fw-semibold" %>
              <%= form.text_area :type_treatment, class: "form-control", rows: 3 %>
            </div>
            <div class="col-12">
              <%= form.label :compliances, "Funciones del cargo", class: "form-label fw-semibold" %>
              <%= form.rich_text_area :compliances, class: "form-control" %>
            </div>
            <div class="col-12">
              <%= form.label :status_compliance, "Estado de cumplimiento", class: "form-label fw-semibold" %>
              <%= form.text_area :status_compliance, class: "form-control", rows: 3 %>
            </div>
            <div class="col-12">
              <%= form.label :observations, "Observaciones", class: "form-label fw-semibold" %>
              <%= form.text_area :observations, class: "form-control", rows: 3 %>
            </div>
            <div class="col-12">
              <%= form.label :collaborator_commitment, "Compromiso del colaborador", class: "form-label fw-semibold" %>
              <%= form.text_area :collaborator_commitment, class: "form-control", rows: 3 %>
            </div>
            <div class="col-12">
              <%= form.label :entity_commitment, "Compromiso de la empresa", class: "form-label fw-semibold" %>
              <%= form.text_area :entity_commitment, class: "form-control", rows: 3 %>
            </div>
          </div>
        <% end %>
        <!-- ========================================================= -->
        <!-- FORMATO 117 -->
        <!-- ========================================================= -->
        <% if @evidence.template.format_number == 117 %>
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <%= form.label :number_officials, "Número de representantes del empleador", class: "form-label fw-semibold" %>
              <%= form.number_field :number_officials, class: "form-control" %>
            </div>
            <div class="col-12 col-md-6">
              <%= form.label :number_attendees, "Número de representantes de los trabajadores", class: "form-label fw-semibold" %>
              <%= form.number_field :number_attendees, class: "form-control" %>
            </div>
          </div>
        <% end %>
        <!-- ========================================================= -->
        <!-- BOTONERA -->
        <!-- ========================================================= -->
        <hr class="my-4">
        <div class="d-flex flex-column flex-sm-row justify-content-center align-items-stretch align-items-sm-center gap-2">
          <%= form.submit "Guardar cambios", class: "btn btn-primary px-4", data: { turbo_confirm: "¿Desea guardar los cambios?" } %>
            <%= link_to :back,  class: "btn btn-outline-secondary px-4" do %>
                <i class="bi bi-arrow-left me-1"></i>
                Retornar
            <% end %>
          <% end %>
        </div>
    </div>
  </div>
</div>
<!-- ESPACIADO FINAL -->
<div class="mb-4"></div>

