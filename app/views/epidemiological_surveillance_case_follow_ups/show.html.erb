<div class="container-fluid px-2 px-md-4 py-3">
  <div class="card shadow-sm">
    <!-- ENCABEZADO -->
    <div class="card-header bg-light">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div>
          <h5 class="mb-1">
            <i class="bi bi-clipboard2-check me-2"></i>
            Detalle del seguimiento
          </h5>
          <small class="text-muted">
            Caso SVE #<%= @epidemiological_surveillance_case.id %>
          </small>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <%= link_to(epidemiological_surveillance_program_epidemiological_surveillance_case_epidemiological_surveillance_case_follow_ups_path(@epidemiological_surveillance_program, @epidemiological_surveillance_case), class: "btn btn-outline-secondary btn-sm") do %>
            <i class="bi bi-arrow-left me-1"></i>
            Volver
          <% end %>
          <%= link_to(edit_epidemiological_surveillance_program_epidemiological_surveillance_case_epidemiological_surveillance_case_follow_up_path(@epidemiological_surveillance_program, @epidemiological_surveillance_case, @follow_up), class: "btn btn-outline-primary btn-sm") do %>
            <i class="bi bi-pencil-square me-1"></i>
            Editar
          <% end %>
        </div>
      </div>
    </div>
    <!-- INFORMACIÓN -->
    <div class="card-body">
      <div class="row g-3">
        <!-- FECHA -->
        <div class="col-12 col-md-6">
          <div class="border rounded p-3 h-100">
            <small class="text-muted d-block">
              Fecha del seguimiento
            </small>
            <strong>
              <i class="bi bi-calendar3 me-1"></i>
              <% if @follow_up.follow_up_date.present? %>
                <%= l(@follow_up.follow_up_date, format: :long) %>
              <% else %>
                No registrada
              <% end %>
            </strong>
          </div>
        </div>
        <!-- RESPONSABLE -->
        <div class="col-12 col-md-6">
          <div class="border rounded p-3 h-100">
            <small class="text-muted d-block">
              Responsable
            </small>
            <strong>
              <i class="bi bi-person me-1"></i>
              <%= @follow_up.user&.name || "No registrado" %>
            </strong>
          </div>
        </div>
        <!-- TIPO -->
        <div class="col-12 col-md-6">
          <div class="border rounded p-3 h-100">
            <small class="text-muted d-block">
              Tipo de seguimiento
            </small>
            <div class="mt-1">
              <% if @follow_up.follow_up_type == "initial_evaluation" %>
                <span class="badge bg-info text-dark">
                  Evaluación inicial
                </span>
              <% elsif @follow_up.follow_up_type == "follow_up" %>
                <span class="badge bg-primary">
                  Seguimiento
                </span>
              <% elsif @follow_up.follow_up_type == "visit" %>
                <span class="badge bg-success">
                  Visita
                </span>
              <% elsif @follow_up.follow_up_type == "phone_contact" %>
                <span class="badge bg-secondary">
                  Contacto telefónico
                </span>
              <% elsif @follow_up.follow_up_type == "document_review" %>
                <span class="badge bg-warning text-dark">
                  Revisión documental
                </span>
              <% elsif @follow_up.follow_up_type == "closure" %>
                <span class="badge bg-dark">
                  Cierre
                </span>
              <% else %>
                <span class="badge bg-light text-dark border">
                  <%= @follow_up.follow_up_type %>
                </span>
              <% end %>
            </div>
          </div>
        </div>
        <!-- ESTADO -->
        <div class="col-12 col-md-6">
          <div class="border rounded p-3 h-100">
            <small class="text-muted d-block">
              Estado
            </small>
            <div class="mt-1">
              <% if @follow_up.status == "identified" %>
                <span class="badge bg-secondary">
                  Identificado
                </span>
              <% elsif @follow_up.status == "in_evaluation" %>
                <span class="badge bg-warning text-dark">
                  En evaluación
                </span>
              <% elsif @follow_up.status == "in_follow_up" %>
                <span class="badge bg-primary">
                  En seguimiento
                </span>
              <% elsif @follow_up.status == "closed" %>
                <span class="badge bg-success">
                  Cerrado
                </span>
              <% elsif @follow_up.status == "not_case" %>
                <span class="badge bg-dark">
                  No es caso
                </span>
              <% else %>
                <span class="badge bg-light text-dark border">
                  <%= @follow_up.status %>
                </span>
              <% end %>
            </div>
          </div>
        </div>
        <!-- RESULTADO -->
        <div class="col-12">
          <div class="border rounded p-3">
            <small class="text-muted d-block mb-2">
              Resultado
            </small>
            <% if @follow_up.result.present? %>
              <div class="mb-0">
                <%= simple_format(@follow_up.result) %>
              </div>
            <% else %>
              <span class="text-muted">
                No se registró resultado.
              </span>
            <% end %>
          </div>
        </div>
        <!-- OBSERVACIONES -->
        <div class="col-12">
          <div class="border rounded p-3">
            <small class="text-muted d-block mb-2">
              Observaciones
            </small>
            <% if @follow_up.observations.present? %>
              <div class="mb-0">
                <%= simple_format(@follow_up.observations) %>
              </div>
            <% else %>
              <span class="text-muted">
                No se registraron observaciones.
              </span>
            <% end %>
          </div>
        </div>
        <!-- PRÓXIMO SEGUIMIENTO -->
        <div class="col-12 col-md-6">
          <div class="border rounded p-3 h-100">
            <small class="text-muted d-block">
              Próximo seguimiento
            </small>
            <strong>
              <% if @follow_up.next_follow_up_date.present? %>
                <i class="bi bi-calendar-event me-1"></i>
                <%= l(@follow_up.next_follow_up_date, format: :long) %>
              <% else %>
                <span class="text-muted">
                  No programado
                </span>
              <% end %>
            </strong>
          </div>
        </div>
        <!-- FECHA DE CREACIÓN -->
        <div class="col-12 col-md-6">
          <div class="border rounded p-3 h-100">
            <small class="text-muted d-block">
              Registro creado
            </small>
            <strong>
              <i class="bi bi-clock me-1"></i>
              <%= l(@follow_up.created_at, format: :long) %>
            </strong>
          </div>
        </div>
      </div>
    </div>
    <!-- ===================================== -->
    <!-- EVIDENCIAS / ARCHIVOS ADJUNTOS -->
    <!-- ===================================== -->
    <div class="card shadow-sm mt-4">
      <div class="card-header bg-light">
        <h6 class="mb-0"><i class="bi bi-paperclip me-2"></i>Evidencias / archivos adjuntos</h6>
      </div>
      <div class="card-body">
        <% if @follow_up.follow_up_files.attached? %>
          <div class="list-group">
            <% @follow_up.follow_up_files.each do |file| %>
              <div class="list-group-item">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                  <!-- INFORMACIÓN DEL ARCHIVO -->
                  <div class="d-flex align-items-center">
                    <% if file.image? %>
                        <i class="bi bi-image text-success fs-4 me-3"></i>
                    <% elsif file.content_type == "application/pdf" %>
                      <i class="bi bi-file-earmark-pdf text-danger fs-4 me-3"></i>
                    <% else %>
                      <i class="bi bi-file-earmark-text text-primary fs-4 me-3"></i>
                    <% end %>
                    <div>
                      <div class="fw-semibold">
                        <%= file.filename %>
                      </div>
                      <small class="text-muted">
                        <%= number_to_human_size(file.byte_size) %>
                      </small>
                    </div>
                  </div>
                  <!-- BOTONES -->
                  <div class="d-flex flex-wrap gap-2">
                    <%= link_to(rails_blob_path(file, disposition: "inline"), target: "_blank", rel: "noopener", class: "btn btn-outline-primary btn-sm") do %>
                      <i class="bi bi-eye me-1"></i>
                      Ver
                    <% end %>
                    <%= link_to(rails_blob_path(file, disposition: "attachment"), class: "btn btn-outline-secondary btn-sm") do %>
                      <i class="bi bi-download me-1"></i>
                      Descargar
                    <% end %>
                    <%= button_to(destroy_attachment_epidemiological_surveillance_program_epidemiological_surveillance_case_epidemiological_surveillance_case_follow_up_path(@epidemiological_surveillance_program, @epidemiological_surveillance_case, @follow_up), method: :delete, params: { attachment_id: file.id }, class: "btn btn-outline-danger btn-sm", data: {turbo_confirm: "¿Está seguro de eliminar este archivo?"}) do %>
                      <i class="bi bi-trash me-1"></i>
                      Eliminar
                    <% end %>                
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center text-muted py-3">
            <i class="bi bi-paperclip fs-3 d-block mb-2"></i>
            No hay archivos adjuntos para este seguimiento.
          </div>
        <% end %>
      </div>
    </div>
    <!-- PIE -->
    <div class="card-footer bg-light">
      <div class="d-flex flex-wrap justify-content-between gap-2">
        <%= link_to(epidemiological_surveillance_program_epidemiological_surveillance_case_epidemiological_surveillance_case_follow_ups_path(@epidemiological_surveillance_program, @epidemiological_surveillance_case), class: "btn btn-outline-secondary") do %>
          <i class="bi bi-arrow-left me-1"></i>
          Volver al historial
        <% end %>
        <%= link_to(epidemiological_surveillance_program_epidemiological_surveillance_case_path(@epidemiological_surveillance_program, @epidemiological_surveillance_case), class: "btn btn-outline-primary") do %>
          <i class="bi bi-folder2-open me-1"></i>
          Ver caso SVE
        <% end %>
      </div>
    </div>
  </div>
</div>