<div class="conesst-page">
    <div class="conesst-header">
        <div class="conesst-header-content">
            <div>
                <h1 class="conesst-title">
                    Perfil Sociodemográfico
                </h1>
                <p class="conesst-subtitle mb-0">
                    <%= @entity.business_name %>
                </p>
            </div>
        </div>
    </div>
    <%= form_with model: @profile do |form| %>
        <% if @profile.errors.any? %>
            <div class="alert alert-danger shadow-sm mb-4" role="alert">
                <div class="fw-bold mb-2">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Se encontraron los siguientes errores:
                </div>
                <ul class="mb-0">
                    <% @profile.errors.full_messages.each do |error| %>
                        <li><%= error %></li>
                    <% end %>
                </ul>
            </div>
        <% end %>
        <div class="conesst-card mb-4">
            <div class="conesst-card-header">
                <div class="conesst-card-header-content">
                    <div>
                        <h2 class="conesst-card-header-title">
                            <i class="bi bi-info-circle me-2"></i>
                            Información de la encuesta
                        </h2>
                        <p class="conesst-card-header-subtitle">
                            Antes de iniciar, lea cuidadosamente la siguiente información.
                        </p>
                    </div>
                </div>
            </div>
            <div class="conesst-card-body">
                <div class="conesst-rich-text-content">
                    <p>
                        <strong>1.</strong>
                        En el siguiente formato deberá contestar una serie de preguntas
                        las cuales están relacionadas con su vida personal, lo que nos
                        ayudará a recolectar datos y así poder enfocar nuestras actividades
                        empresariales a su bienestar.
                    </p>
                    <p>
                        <strong>2. ¿Por qué se realiza?</strong>
                        El empleador tiene el deber de conocer su población trabajadora
                        y poder orientar sus actividades o posibles beneficios, esto se
                        realiza según el Decreto 1072 de 2015.
                    </p>
                    <p class="mb-0">
                        <strong>3. ¿Quién tendrá acceso?</strong>
                        El personal de Seguridad y Salud en el Trabajo, será el responsable
                        de velar por la información allí suministrada y de realizar dicho informe.
                    </p>
                </div>
            </div>
        </div>
        <div class="conesst-card mb-4">
            <div class="conesst-card-header">
                <div class="conesst-card-header-content">
                    <div>
                        <h2 class="conesst-card-header-title">
                            <i class="bi bi-person-vcard me-2"></i>
                            Información personal
                        </h2>
                        <p class="conesst-card-header-subtitle">
                            Información básica del trabajador.
                        </p>
                    </div>
                </div>
            </div>
            <div class="conesst-card-body">
                <div class="conesst-form-grid-2">
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-gender-ambiguous me-2"></i>
                            <%= form.label :gender %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "Masculino"], [1, "Femenino"], [2, "No binario"], [3, "Otro"]].each do |value, label| %>
                                <div class="col-12 col-sm-6">
                                    <div class="form-check">
                                        <%= form.radio_button :gender, value, class: "form-check-input", required: true %>
                                        <%= form.label :gender, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-droplet me-2"></i>
                            <%= form.label :blood_type %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "A+"], [1, "A-"], [2, "B+"], [3, "B-"], [4, "AB+"], [5, "AB-"], [6, "O+"], [7, "O-"]].each do |value, label| %>
                                <div class="col-6 col-sm-3">
                                    <div class="form-check">
                                        <%= form.radio_button :blood_type, value, class: "form-check-input", required: true %>
                                        <%= form.label :blood_type, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-calendar3 me-2"></i>
                            <%= form.label :age %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "18-27"], [1, "28-37"], [2, "38-47"], [3, "48-57"], [4, "58-67"], [5, "Mayor de 67"]].each do |value, label| %>
                                <div class="col-12 col-sm-6">
                                    <div class="form-check">
                                        <%= form.radio_button :age, value, class: "form-check-input", required: true %>
                                        <%= form.label :age, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-speedometer2 me-2"></i>
                            <%= form.label :weight %>
                        </div>
                        <div class="conesst-form-group">
                            <%= form.number_field :weight, class: "form-control", step: 1, max: 1000, min: 1 %>
                            <div class="form-text">
                                Peso en kilos, números enteros.
                            </div>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-arrows-vertical me-2"></i>
                            <%= form.label :height %>
                        </div>
                        <div class="conesst-form-group">
                            <%= form.number_field :height, class: "form-control", step: 1, max: 250, min: 1 %>
                            <div class="form-text">
                                Estatura en centímetros sin puntos ni comas.
                            </div>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-heart me-2"></i>
                            <%= form.label :civil_status %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "Soltero (a)"], [1, "Casado (a)"], [2, "Unión libre"], [3, "Viudo (a)"], [4, "Divorciado/ separado (a)"]].each do |value, label| %>
                                <div class="col-12">
                                    <div class="form-check">
                                        <%= form.radio_button :civil_status, value, class: "form-check-input", required: true %>
                                        <%= form.label :civil_status, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-mortarboard me-2"></i>
                            <%= form.label :education_level %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "Primaria"], [1, "Secundaria"], [2, "Técnico"], [3, "Tecnólogo"], [4, "Profesional"], [5, "Posgrado"]].each do |value, label| %>
                                <div class="col-12 col-sm-6">
                                    <div class="form-check">
                                        <%= form.radio_button :education_level, value, class: "form-check-input", required: true %>
                                        <%= form.label :education_level, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-building me-2"></i>
                            <%= form.label :area_work %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "Administrativa"], [1, "Operativa"]].each do |value, label| %>
                                <div class="col-12 col-sm-6">
                                    <div class="form-check">
                                        <%= form.radio_button :area_work, value, class: "form-check-input", required: true %>
                                        <%= form.label :area_work, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-person-badge me-2"></i>
                            <%= form.label :post_actual %>
                        </div>
                        <%= form.text_field :post_actual, class: "form-control" %>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-file-earmark-text me-2"></i>
                            <%= form.label :contract_type %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "Contrato a Término Fijo"], [1, "Contrato a término indefinido"], [2, "Contrato de Obra o labor"], [3, "Contrato civil por prestación de servicios"], [4, "Contrato de aprendizaje"], [5, "Contrato ocasional de trabajo"]].each do |value, label| %>
                                <div class="col-12">
                                    <div class="form-check">
                                        <%= form.radio_button :contract_type, value, class: "form-check-input", required: true %>
                                        <%= form.label :contract_type, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-clock me-2"></i>
                            <%= form.label :Antiquity %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "Diurno"], [1, "Nocturno"], [2, "Mixto"]].each do |value, label| %>
                                <div class="col-12 col-sm-4">
                                    <div class="form-check">
                                        <%= form.radio_button :Antiquity, value, class: "form-check-input", required: true %>
                                        <%= form.label :Antiquity, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-envelope me-2"></i>
                            <%= form.label :email_name %>
                        </div>
                        <%= form.email_field :email_name, class: "form-control" %>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-cash-coin me-2"></i>
                            <%= form.label :salary_range %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "De 1 a 2 SMLMV"], [1, "De 3 a 4 SMLMV"], [2, "Mas de 4 SMLMV"]].each do |value, label| %>
                                <div class="col-12">
                                    <div class="form-check">
                                        <%= form.radio_button :salary_range, value, class: "form-check-input", required: true %>
                                        <%= form.label :salary_range, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="conesst-card mb-4">
            <div class="conesst-card-header">
                <div class="conesst-card-header-content">
                    <div>
                        <h2 class="conesst-card-header-title">
                            <i class="bi bi-shield-check me-2"></i>
                            Seguridad social y entidad bancaria
                        </h2>
                    </div>
                </div>
            </div>
            <div class="conesst-card-body">
                <div class="conesst-form-grid-2">
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-hospital me-2"></i>
                            <%= form.label :health_promoter_id %>
                        </div>
                        <%= form.collection_select :health_promoter_id, HealthPromoter.all.order(id: :asc), :id, :name_entity, {}, { class: "form-select" } %>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-piggy-bank me-2"></i>
                            <%= form.label :pension_fund_id %>
                        </div>
                        <%= form.collection_select :pension_fund_id, PensionFund.all.order(id: :asc), :id, :fund, {}, { class: "form-select" } %>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-wallet2 me-2"></i>
                            <%= form.label :cessation_fund_id %>
                        </div>
                        <%= form.collection_select :cessation_fund_id, CessationFund.all.order(id: :asc), :id, :name, {}, { class: "form-select" } %>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-shield-plus me-2"></i>
                            <%= form.label :occupational_risk_manager_id %>
                        </div>
                        <%= form.collection_select :occupational_risk_manager_id, OccupationalRiskManager.all.order(id: :asc), :id, :name, {}, { class: "form-select" } %>
                    </div>
                    <div class="conesst-form-section conesst-form-section-full">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-bank me-2"></i>
                            <%= form.label :head_family %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "Banco de Bogotá"], [1, "Banco Popular"], [2, "Itaú Colombia"], [3, "Bancolombia"], [4, "Citibanck"], [5, "GNB Sudameris"], [6, "BBVA"], [7, "Banco de Occidente"], [8, "Banco Caja Social"], [9, "Davivienda"], [10, "Colpatria"], [11, "Banco Agrario"], [12, "Banco AV Villas"], [13, "Ban100"], [14, "Bancamia"], [15, "Banco W"], [16, "Coomeva"], [17, "Banco Falabella"], [18, "Banco Pichincha"], [19, "Banco Santander"], [20, "Banco Mundo Mujer"], [21, "Lulubank"], [22, "Nubank"], [23, "Otro"]].each do |value, label| %>
                                <div class="col-12 col-sm-6 col-lg-4">
                                    <div class="form-check">
                                        <%= form.radio_button :head_family, value, class: "form-check-input", required: true %>
                                        <%= form.label :head_family, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="conesst-card mb-4">
            <div class="conesst-card-header">
                <div class="conesst-card-header-content">
                    <div>
                        <h2 class="conesst-card-header-title">
                            <i class="bi bi-geo-alt me-2"></i>
                            Contacto y ubicación
                        </h2>
                    </div>
                </div>
            </div>
            <div class="conesst-card-body">
                <div class="conesst-form-grid-2">
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-person-lines-fill me-2"></i>
                            <%= form.label :emergency_contact %>
                        </div>
                        <%= form.text_field :emergency_contact, class: "form-control" %>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-telephone me-2"></i>
                            <%= form.label :phone_emergency_contact %>
                        </div>
                        <%= form.text_field :phone_emergency_contact, class: "form-control" %>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-pin-map me-2"></i>
                            <%= form.label :administrative_political_division_id %>
                        </div>
                        <%= form.collection_select :administrative_political_division_id, AdministrativePoliticalDivision.where("department_code = ?", "05").order(town_center_name: :asc), :id, :name_with_initial_corto, { prompt: "Seleccione un municipio" }, { class: "form-select", required: true } %>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-house me-2"></i>
                            <%= form.label :address %>
                        </div>
                        <%= form.text_field :address, class: "form-control" %>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-signpost me-2"></i>
                            <%= form.label :neighborhood %>
                        </div>
                        <%= form.text_field :neighborhood, class: "form-control" %>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-phone me-2"></i>
                            <%= form.label :phone %>
                        </div>
                        <%= form.text_field :phone, class: "form-control" %>
                    </div>
                </div>
            </div>
        </div>
        <div class="conesst-card mb-4">
            <div class="conesst-card-header">
                <div class="conesst-card-header-content">
                    <div>
                        <h2 class="conesst-card-header-title">
                            <i class="bi bi-house-heart me-2"></i>
                            Información familiar y vivienda
                        </h2>
                    </div>
                </div>
            </div>
            <div class="conesst-card-body">
                <div class="conesst-form-grid-2">
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-buildings me-2"></i>
                            <%= form.label :stratum_socioeconomic %>
                        </div>
                        <div class="row g-2">
                            <% (1..6).each do |estrato| %>
                                <div class="col-4 col-sm-2">
                                    <div class="form-check">
                                        <%= form.radio_button :stratum_socioeconomic, estrato - 1, class: "form-check-input", required: true %>
                                        <%= form.label :stratum_socioeconomic, estrato, value: estrato - 1, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-house-door me-2"></i>
                            <%= form.label :housing_type %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "Propia"], [1, "Arrendada"], [2, "Familiar"]].each do |value, label| %>
                                <div class="col-12 col-sm-4">
                                    <div class="form-check">
                                        <%= form.radio_button :housing_type, value, class: "form-check-input", required: true %>
                                        <%= form.label :housing_type, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section conesst-form-section-full">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-lightning-charge me-2"></i>
                            <%= form.label :basic_housing_services %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "Energía, acueducto, alcantarillado"], [1, "Energía, gas, acueducto, alcantarillado"], [2, "Energía, gas, acueducto, alcantarillado, internet"]].each do |value, label| %>
                                <div class="col-12">
                                    <div class="form-check">
                                        <%= form.radio_button :basic_housing_services, value, class: "form-check-input", required: true %>
                                        <%= form.label :basic_housing_services, label, value: value,  class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-people me-2"></i>
                            <%= form.label :has_children %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "Si"], [1, "No"]].each do |value, label| %>
                                <div class="col-6">
                                    <div class="form-check">
                                        <%= form.radio_button :has_children, value, class: "form-check-input", required: true %>
                                        <%= form.label :has_children, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-person-hearts me-2"></i>
                            <%= form.label :number_children %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "Ninguno"], [1, "1"], [2, "2"], [3, "Más de 2"]].each do |value, label| %>
                                <div class="col-6 col-sm-3">
                                    <div class="form-check">
                                        <%= form.radio_button :number_children, value, class: "form-check-input", required: true %>
                                        <%= form.label :number_children, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-person-plus me-2"></i>
                            <%= form.label :number_people_charge %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "Ninguna"], [1, "1-2"], [2, "3-4"], [3, "5-6"]].each do |value, label| %>
                                <div class="col-6 col-sm-3">
                                    <div class="form-check">
                                        <%= form.radio_button :number_people_charge, value, class: "form-check-input", required: true %>
                                        <%= form.label :number_people_charge, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-universal-access me-2"></i>
                            <%= form.label :live_people_disability %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "Si"], [1, "No"]].each do |value, label| %>
                                <div class="col-6">
                                    <div class="form-check">
                                        <%= form.radio_button :live_people_disability, value,  class: "form-check-input", required: true %>
                                        <%= form.label :live_people_disability, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <div class="conesst-form-section">
                        <div class="conesst-form-section-title">
                            <i class="bi bi-person-wheelchair me-2"></i>
                            <%= form.label :type_disability %>
                        </div>
                        <div class="row g-2">
                            <% [[0, "Visual"], [1, "Auditiva"], [2, "Física"], [3, "Mental"], [4, "Múltiple"], [5, "N/A"]].each do |value, label| %>
                                <div class="col-6 col-sm-4">
                                    <div class="form-check">
                                        <%= form.radio_button :type_disability, value, class: "form-check-input", required: true %>
                                        <%= form.label :type_disability, label, value: value, class: "form-check-label" %>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="conesst-card mb-4">
            <div class="conesst-card-header">
                <div class="conesst-card-header-content">
                    <div>
                        <h2 class="conesst-card-header-title">
