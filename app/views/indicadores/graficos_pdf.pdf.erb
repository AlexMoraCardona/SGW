<head>
  <meta charset="UTF-8">
  <%= wicked_pdf_stylesheet_link_tag "application" %>
  <%= wicked_pdf_javascript_include_tag "chartkick_pdf" %>
</head>
<body>
<div class="container col-11"> 
    <div style="text-align:center;">
        <h2 class="display-5">INDICADORES  <%= @entity.business_name if @entity.present? %></h2>
    </div>  
    <hr> 
    <div><br></div>
    <div style="text-align:justify">
        <p><strong>Contenido de indicadores</strong></p>
        <p>
            <ul>
                <li>Frecuencia de Accidentalidad</li>
                <li>Severidad de Accidentalidad</li>
                <li>Ausentismo por causa médica</li>
                <li>Prevalencia de enfermedad laboral</li>
                <li>Incidencia de enfermedad laboral</li>
                <li>Proporción de accidentes de trabajos mortales</li>
                <li>Intervención de peligros y riesgos gestionados</li>
                <li>Porcentaje de cobertura en capacitaciones</li>
                <li>Porcentaje de trabajadores capacitados</li>
                <li>Autoevaluación del SG-SST</li>
                <li>Ejecución de Acciones Preventivas AP, Acciones Correctivas AC, y de Mejora</li>
                <li>Cumplimiento legal</li>
                <li>Cumplimiento del plan de trabajo anual</li>
                <li>Porcentaje de actividades intervenidas del plan de mejoramiento</li>
                <li>Porcentaje de trabajadores que participaron en la encuesta de perfil sociodemográficos</li>
                <li>Indicador asignación de recursos</li>
                <li>Indicador de investigación de incidentes y/o accidentes</li>
                <li>Indicadores Mínimos de SST (Res. 0312/2019, artículo 30)</li>
            </ul>
        </p>
    </div>
    <div><br></div>
