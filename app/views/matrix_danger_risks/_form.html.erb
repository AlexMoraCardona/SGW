<div class="card shadow-sm border-0">
  <div class="card-body">
    <%= form_with model: @matrix_danger_risk do |form| %>
      <% if @matrix_danger_risk.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @matrix_danger_risk.errors.full_messages.each do |error| %>
              <li><%= error %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="mb-4">
        <label class="form-label fw-semibold">
          Representante Legal
          <button type="button" class="btn btn-link p-0 ms-1" data-bs-toggle="tooltip" title="Seleccione el nombre del Representante Legal.">
            <%= image_tag "ayuda.png", width: 22 %>
          </button>
        </label>
        <%= form.collection_select :user_legal_representative, User.usuarios_empresa.order(:id), :id, :name, {}, class: "form-select" %>
      </div>

      <div class="mb-4">
        <label class="form-label fw-semibold">
          Asesor SST
          <button type="button" class="btn btn-link p-0 ms-1" data-bs-toggle="tooltip" title="Seleccione el nombre del Asesor SST.">
            <%= image_tag "ayuda.png", width: 22 %>
          </button>
        </label>
        <%= form.collection_select :user_adviser_sst, User.usuarios_empresa.order(:id), :id, :name, {}, class: "form-select" %>
      </div>

      <div class="mb-4">
        <label class="form-label fw-semibold">
          Responsable SST
          <button type="button" class="btn btn-link p-0 ms-1" data-bs-toggle="tooltip" title="Seleccione el nombre del Responsable SST.">
            <%= image_tag "ayuda.png", width: 22 %>
          </button>
        </label>
        <%= form.collection_select :user_responsible_sst, User.usuarios_empresa.order(:id), :id, :name, {}, class: "form-select" %>
      </div>
      <%= form.hidden_field :entity_id, value: params[:entity_id].to_i if params[:entity_id].present? %>
      <%= form.hidden_field :code, value: @template.reference if @template.present? %>
      <%= form.hidden_field :version, value: @template.version if @template.present? %>
      <hr>
      <div class="d-grid gap-2 d-md-flex justify-content-md-end">
        <%= form.button type: :submit, class: "btn btn-success" do %>
          <i class="bi bi-check-circle"></i>
          Guardar
        <% end %>

        <%= link_to :back, class: "btn btn-secondary" do %>
          <i class="bi bi-arrow-left-circle"></i>
          Retornar
        <% end %>
      </div>
    <% end %>
  </div>
</div>

 