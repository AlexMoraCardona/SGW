<div class="conesst-page">
  <div class="mb-3">
    <%= link_to root_path, class: "d-inline-block" do %>
      <%= image_tag "LogoConesst202305232.png", width: 100, height: 100, alt: "CONESST" %>
    <% end %>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-heart-pulse fs-5"></i>
        <div>
          <h4 class="mb-0">
            INSPECCIÓN DE BOTIQUÍN DE PRIMEROS AUXILIOS
          </h4>
          <small class="text-muted">
            Consulta y administración de inspecciones de botiquines
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <% if params[:entity_id].present? || @entity.present? %>
        <%= render "kits" %>
      <% else %>
        <%= form_with model: @kit, method: :get do |form| %>
          <div class="row g-3">
            <div class="col-12 col-md-8 col-lg-7">
              <%= form.label :entity_id, "Empresa", class: "form-label fw-semibold" %>
              <% if @entities.present? %>
                <%= form.collection_select :entity_id,
                                           @entities.order(id: :asc),
                                           :id,
                                           :business_name,
                                           { prompt: "-- Seleccionar Entidad --" },
                                           { class: "form-select select2" } %>

              <% else %>
                <div class="form-control bg-light">
                  <%= @entity.business_name %>
                </div>
                <%= form.hidden_field :entity_id, value: @entity.id %>
              <% end %>
            </div>
          </div>
          <div class="conesst-actions mt-4">
            <button type="submit"
                    class="conesst-btn conesst-btn-primary">
              <i class="bi bi-search me-1"></i>
              Consultar
            </button>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>