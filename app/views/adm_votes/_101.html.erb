<div class="conesst-page">
    <div class="container-fluid px-2 px-md-3">
        <%= link_to adm_votes_path(entity_id: @adm_vote.entity_id), class: "conesst-btn btn-sm btn-outline-secondary" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
        <% end %>
        <div class="conesst-card mb-4">
            <div class="card-body p-2 p-md-4">
                <div class="table-responsive mt-3">
                    <table class="table table-bordered text-center align-middle mb-0">
                        <tbody>
                            <tr>
                                <td class="py-3">
                                    <h5 class="fw-bold mb-0 text-break">
                                        <%= @adm_vote.titulo_vote %>
                                    </h5>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="conesst-card mb-4">
            <div class="conesst-card-header">
                <div class="conesst-card-header-content">
                    <h2 class="conesst-card-header-title">
                        <i class="bi bi-bar-chart-line me-2"></i>
                        Resultado de votaciones
                    </h2>
                    <p class="conesst-card-header-subtitle">
                        Consolidado de votos obtenidos por cada candidato.
                    </p>
                </div>
            </div>
            <div class="card-body p-2 p-md-4">
                <% if @candidate_votes.present? %>
                    <div class="d-none d-md-block">
                        <div class="conesst-table-wrapper">
                            <table class="table table-hover table-bordered align-middle conesst-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Nombre del candidato</th>
                                        <th class="text-center">Cantidad de votos</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% @candidate_votes.each do |candidato| %>
                                        <tr>
                                            <td class="text-break">
                                                <%= candidato.user&.name %>
                                            </td>
                                            <td class="text-center fw-semibold">
                                                <%= Vote.conteo(candidato.id, @adm_vote.id) %>
                                            </td>
                                        </tr>
                                    <% end %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="d-md-none">
                        <div class="row g-3">
                            <% @candidate_votes.each do |candidato| %>
                                <div class="col-12">
                                    <div class="card border shadow-sm">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-start gap-2">
                                                <div class="flex-grow-1 min-w-0">
                                                    <div class="small text-muted mb-1">
                                                        Candidato
                                                    </div>
                                                    <div class="fw-semibold text-break">
                                                        <%= candidato.user&.name %>
                                                    </div>
                                                </div>
                                                <div class="text-center flex-shrink-0">
                                                    <div class="small text-muted mb-1">
                                                        Votos
                                                    </div>
                                                    <span class="badge rounded-pill text-bg-primary fs-6">
                                                        <%= Vote.conteo(candidato.id, @adm_vote.id) %>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    </div>
                <% else %>
                    <div class="text-center py-4">
                        <i class="bi bi-clipboard-data fs-1 text-muted"></i>
                        <p class="text-muted mt-2 mb-0">
                            No hay resultados de votación disponibles.
                        </p>
                    </div>
                <% end %>
            </div>
        </div>
        <div class="conesst-card mb-4">
            <div class="conesst-card-header">
                <div class="conesst-card-header-content">
                    <h2 class="conesst-card-header-title">
                        <i class="bi bi-people me-2"></i>
                        Resumen de participación
                    </h2>
                </div>
            </div>
            <div class="card-body p-3 p-md-4">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="card h-100 border shadow-sm">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center gap-3">
                                    <i class="bi bi-person-check fs-2 text-primary"></i>
                                    <div class="min-w-0">
                                        <div class="text-muted small">
                                            Total de empleados hábiles
                                        </div>
                                        <div class="fs-3 fw-bold">
                                            <%= Vote.totalhabiles(@adm_vote.id) %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="card h-100 border shadow-sm">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center gap-3">
                                    <i class="bi bi-check2-circle fs-2 text-success"></i>
                                    <div class="min-w-0">
                                        <div class="text-muted small">
                                            Total de empleados que votaron
                                        </div>
                                        <div class="fs-3 fw-bold">
                                            <%= Vote.totalvotaron(@adm_vote.id) %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>