                </td>
            </tr>
        </table>
    <% end %>    
    <div><br></div>
    <!-- Gráfico anual -->
    <% if @datos_frecuencia_accidentalidadañog.present? %>
        <div style="text-align:center">
            <canvas id="chart-1" width="600" height="350"></canvas>
            <script>
                var datos = <%= raw @datos_frecuencia_accidentalidadañog.to_json %>;                        var labels = datos.map(function(item) {return item[0];});
                var valores = datos.map(function(item) {return item[1];});
                var ctx = document.getElementById("chart-1").getContext("2d");
                new Chart(ctx, {type: "bar", data: {labels: labels, datasets: [{label: "Frecuencia de accidentalidad anual", data: valores, borderWidth: 2, fill: false}]},
                options: {responsive: false, animation: false, legend: {display: true},
                title: {display: true, text: "Frecuencia de accidentalidad anual"},
                scales: {xAxes: [{scaleLabel: {display: true, labelString: "Periodo"}}],
                         yAxes: [{ticks: {beginAtZero: true}, scaleLabel: {display: true, labelString: "Indicador"}}]}
                    }
                });
            </script>
        </div>
    <% end %>
