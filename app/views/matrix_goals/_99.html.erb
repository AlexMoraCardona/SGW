<div class="card shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>No.</th>
                        <th>OBJETIVO</th>
                        <th>META </th>
                        <th>NOMBRE INDICADOR</th>
                        <th>FORMULA DEL INDICADOR</th>
                        <th>ANÁLISIS</th>
                        <th>RESPONSABLE</th>
                        <th>FRECUENCIA DE ANÁLISIS</th>
                        <th>INDICADOR</th>
                    </tr>   
                </thead>
                <% cant = 0 %>  
                <% @matrix_goal_items.each do |matrix_goal_item| %>             
                    <tbody>
                        <% cant += 1 %>
                        <tr>
                            <td><%= cant %></td>
                            <td><%= matrix_goal_item.objetives %></td>
                            <td><%= matrix_goal_item.meta %>%</td>
                            <td><%= matrix_goal_item.indicator.name %></td>
                            <td><%= matrix_goal_item.indicator.formula %></td>
                            <td><%= matrix_goal_item.indicator.interpretation %></td>
                            <td><%= matrix_goal_item.indicator.responsible_management %></td>
                            <td><%= Indicator.label_periodicidad(matrix_goal_item.indicator.periodicity) %></td>
                            <td style="text-align:center"><%= MatrixGoal.label_dato(matrix_goal_item.indicator_id, @report_official) if @report_official.present? %>%</td>
                        </tr> 
                    </body>
                <% end %>
            </table>
        </div>
    </div>
    <hr class="my-5">
    <div class="container-fluid">
        <div class="row text-center align-items-start">
            <!-- Representante Legal -->
            <div class="col-12 col-md-4 mb-5">
            <div style="height: 90px; display: flex; align-items: center; justify-content: center;">
                <% if @matrix_goal.firm_representante == 1 && @rep.present? && @rep.firm.attached? && @rep.firm.image? %>
                        <%= image_tag @rep.firm, style: "max-height:90px; max-width:100%; object-fit:contain;" %>
                <% end %>
            </div>
            <hr class="my-1">
            <strong>
                <%= @rep.name %>
            </strong>
            <br>
            <small class="text-muted">
                Representante Legal
            </small>
        </div>
        <!-- Asesor SST -->
        <div class="col-12 col-md-4 mb-5">
            <div style="height: 90px; display: flex; align-items: center; justify-content: center;">
                <% if @matrix_goal.firm_asesor == 1 && @adv.present? && @adv.firm.attached? && @adv.firm.image? %>
                    <%= image_tag @adv.firm, style: "max-height:90px; max-width:100%; object-fit:contain;" %>
                <% end %>
            </div>
            <hr class="my-1">
            <strong>
                <%= @adv.name %>
            </strong>
            <br>
            <small class="text-muted">
                Asesor SG-SST
            </small>
        </div>
        <!-- Responsable SG-SST -->
        <div class="col-12 col-md-4 mb-5">
            <div style="height: 90px; display: flex; align-items: center; justify-content: center;">
                <% if @matrix_goal.firm_responsible == 1 && @res.present? && @res.firm.attached? && @res.firm.image? %>
                    <%= image_tag @res.firm, style: "max-height:90px; max-width:100%; object-fit:contain;" %>
                <% end %>
            </div>
            <hr class="my-1">
            <strong>
                <%= @res.name %>
            </strong>
            <br>
            <small class="text-muted">
                Responsable SG-SST
            </small>
        </div>
    </div>
</div>
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <%= link_to matrix_goals_path(entity_id: @matrix_goal.entity.id), class:"btn btn-secondary" do %>
                <i class="bi bi-arrow-left-circle"></i>Retornar
            <% end %>
            <%= link_to ver_matrix_goal_path(@matrix_goal.id, format: 'pdf'), class: "btn btn-danger btn-sm" do %>
                <i class="bi bi-file-earmark-pdf"></i>
                PDF
            <% end %>
        </div>
    </div>
</div>
