<style>
    .change-page {
        width: 100%;
        max-width: 1150px;
        margin: 0 auto;
        padding: 15px;
        font-family: Arial, Helvetica, sans-serif;
        color: #212529;
    }

    /* =========================================================
       ENCABEZADO
       ========================================================= */

    .change-header {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 14px 18px;
        margin-bottom: 18px;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-left: 5px solid #00aae4;
        border-radius: 10px;
    }

    .change-header-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #00aae4;
        color: white;
        border-radius: 10px;
        font-size: 24px;
    }

    .change-header-content {
        min-width: 0;
    }

    .change-header-title {
        margin: 0;
        font-size: 21px;
        font-weight: 700;
        color: #212529;
    }

    .change-header-subtitle {
        margin: 3px 0 0;
        font-size: 13px;
        color: #6c757d;
    }

    /* =========================================================
       TARJETA DE SELECCIÓN
       ========================================================= */

    .change-card {
        width: 100%;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        margin-bottom: 18px;
        overflow: hidden;
    }

    .change-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 15px;
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }

    .change-card-header-icon {
        width: 34px;
        height: 34px;
        min-width: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #00aae4;
        color: white;
        border-radius: 8px;
        font-size: 17px;
    }

    .change-card-title {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
        color: #212529;
    }

    .change-card-body {
        padding: 18px;
    }

    /* =========================================================
       CAMPO EMPRESA
       ========================================================= */

    .change-field {
        max-width: 700px;
    }

    .change-label {
        display: block;
        margin-bottom: 7px;
        font-size: 12px;
        font-weight: 700;
        color: #495057;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .change-select {
        width: 100%;
        min-height: 42px;
        border: 1px solid #ced4da;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 14px;
        background-color: #ffffff;
        color: #212529;
    }

    .change-select:focus {
        border-color: #00aae4;
        box-shadow: 0 0 0 0.2rem rgba(0, 170, 228, 0.15);
        outline: none;
    }

    .change-company {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 42px;
        padding: 9px 12px;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .change-company i {
        color: #00aae4;
        font-size: 18px;
        flex-shrink: 0;
    }

    /* =========================================================
       BOTÓN
       ========================================================= */

    .change-actions {
        margin-top: 15px;
        display: flex;
        align-items: center;
    }

    .change-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 8px 18px;
        border: 0;
        border-radius: 8px;
        background-color: #00aae4;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .change-btn:hover {
        background-color: #008fbd;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .change-btn:active {
        transform: translateY(0);
    }

    /* =========================================================
       RESPONSIVE TABLET
       ========================================================= */

    @media (max-width: 768px) {

        .change-page {
            padding: 10px;
        }

        .change-header {
            padding: 12px;
            gap: 10px;
            margin-bottom: 12px;
        }

        .change-header-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            font-size: 21px;
        }

        .change-header-title {
            font-size: 18px;
        }

        .change-header-subtitle {
            font-size: 12px;
        }

        .change-card {
            margin-bottom: 12px;
            border-radius: 10px;
        }

        .change-card-header {
            padding: 9px 12px;
        }

        .change-card-body {
            padding: 13px;
        }

        .change-field {
            max-width: 100%;
        }
    }

    /* =========================================================
       RESPONSIVE CELULAR
       ========================================================= */

    @media (max-width: 576px) {

        .change-page {
            padding: 7px;
        }

        .change-header {
            padding: 10px;
            border-left-width: 4px;
            border-radius: 8px;
        }

        .change-header-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
            border-radius: 8px;
            font-size: 19px;
        }

        .change-header-title {
            font-size: 16px;
        }

        .change-header-subtitle {
            font-size: 10px;
        }

        .change-card-header {
            padding: 8px 10px;
        }

        .change-card-header-icon {
            width: 30px;
            height: 30px;
            min-width: 30px;
            font-size: 15px;
        }

        .change-card-title {
            font-size: 13px;
        }

        .change-card-body {
            padding: 11px;
        }

        .change-label {
            font-size: 10px;
            margin-bottom: 5px;
        }

        .change-select,
        .change-company {
            min-height: 40px;
            font-size: 13px;
        }

        .change-btn {
            padding: 8px 15px;
            font-size: 12px;
        }
    }

    /* =========================================================
       CELULARES PEQUEÑOS
       ========================================================= */

    @media (max-width: 400px) {

        .change-page {
            padding: 5px;
        }

        .change-header-title {
            font-size: 15px;
        }

        .change-header-subtitle {
            font-size: 9px;
        }

        .change-card-body {
            padding: 9px;
        }

        .change-select,
        .change-company {
            font-size: 12px;
        }
    }
</style>

<div class="change-page">


<!-- =====================================================
     ENCABEZADO
     ===================================================== -->

<div class="change-header">

    <div class="change-header-icon">
        <i class="bi bi-arrow-repeat"></i>
    </div>

    <div class="change-header-content">

        <h1 class="change-header-title">
            Gestión del Cambio
        </h1>

        <p class="change-header-subtitle">
            Administración y seguimiento de los cambios organizacionales
        </p>

    </div>

</div>


<!-- =====================================================
     CONTENIDO
     ===================================================== -->

<% if params[:entity_id].present? || @entity.present? %>

    <%= render 'change_management' %>

<% else %>

    <div class="change-card">

        <div class="change-card-header">

            <div class="change-card-header-icon">
                <i class="bi bi-building"></i>
            </div>

            <h2 class="change-card-title">
                Seleccionar empresa
            </h2>

        </div>


        <div class="change-card-body">

            <%= form_with model: @entity, method: :get do |form| %>

                <div class="change-field">

                    <label class="change-label">
                        Empresa
                    </label>

                    <% if @entities.present? %>

                        <%= form.collection_select(
                            :entity_id,
                            @entities.order(id: :asc),
                            :id,
                            :business_name,
                            { prompt: '-- Seleccionar empresa --' },
                            { class: 'change-select select2' }
                        ) %>

                    <% else %>

                        <div class="change-company">

                            <i class="bi bi-building"></i>

                            <span>
                                <%= @entity.business_name %>
                            </span>

                        </div>

                        <%= form.hidden_field(
                            :entity_id,
                            value: @entity.id
                        ) %>

                    <% end %>

                </div>


                <div class="change-actions">

                    <button type="submit" class="change-btn">

                        <i class="bi bi-search"></i>

                        Consultar

                    </button>

                </div>

            <% end %>

        </div>

    </div>

<% end %>


</div>
