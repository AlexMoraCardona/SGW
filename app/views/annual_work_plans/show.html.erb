<div class="container-fluid mb-4">
    <div class="row align-items-center">
        <div class="col-12 col-lg-2 text-center mb-3 mb-lg-0">
            <% if @annual_work_plan.entity.logo.present? %>
                <%= image_tag @annual_work_plan.entity.logo, class: "img-fluid", style: "max-height:90px;" %>
            <% end %>
        </div>
        <div class="col-12 col-lg-7 text-center">
            <h3 class="fw-bold mb-2">
                PLAN ANUAL DE TRABAJO  <%= @annual_work_plan.year if @annual_work_plan.present? %>
            </h3>
            <h5 class="mb-1">
                <%= @annual_work_plan.entity.business_name %>
            </h5>
            <small class="text-muted">
                NIT: <%= @annual_work_plan.entity.identification_number %>-<%= @annual_work_plan.entity.verification_digit if @annual_work_plan.entity.verification_digit.present? %>
            </small>
        </div>
        <div class="col-12 col-lg-3">
            <div class="row">
                <div class="col-7 fw-bold">Fecha creación:</div>
                <div class="col-5"><%= @template.date %></div>
            </div>
            <div class="row">
                <div class="col-7 fw-bold">Actualización:</div>
                <div class="col-5"><%= @template.date_updated %></div>
            </div>
            <div class="row">
                <div class="col-7 fw-bold">Versión:</div>
                <div class="col-5"><%= @template.version %></div>
            </div>
            <div class="row">
                <div class="col-7 fw-bold">Código:</div>
                <div class="col-5"><%= @template.reference %></div>
            </div>
        </div>
    </div>
</div>
<hr>
<div class="card shadow">
