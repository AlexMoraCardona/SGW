<tr>
    <td>
        <%= adm_attendance.date_attendance %>
    </td>
    <td>
        <%= adm_attendance.entity.business_name %>
    </td>
    <td>
        <%= adm_attendance.description %>
    </td>
    <td>
        <%= link_to edit_adm_attendance_path(adm_attendance), class: "conesst-btn conesst-btn-primary", title: t('common.edit') do %>
            <i class="bi bi-pencil-square"></i>
            <span class="d-none d-lg-inline">
                <%= t('common.edit') %>
            </span>
        <% end %>
    </td>
    <td>
            <% @cant_reg = AdmAttendance.contador(adm_attendance.id) %>
            <%= link_to seleccion_participantes_path(adm_attendance.id), class: "conesst-btn conesst-btn-primary" do %>
                <i class="bi bi-people me-1"></i>
                Participantes <%= @cant_reg %>
            <% end %>
    </td>
    <td>
        <%= link_to adm_attendance_pdf_path(adm_attendance.id, format: "pdf"), class: "conesst-btn conesst-btn-primary", title: "PDF" do %>
            <i class="bi bi-file-earmark-pdf"></i>
            <span class="d-none d-lg-inline">PDF</span>
        <% end %>
    </td>
    <td>
        <% @attendances = AdmAttendance.asistentes(adm_attendance.id) %>
        <% @count_registrados = 0 %>
        <% @count_registrados = @attendances.count if @attendances.present? %>
        <button
            class="conesst-btn conesst-btn-primary position-relative"
            data-bs-toggle="modal"
            data-bs-target="#exampleModal<%= adm_attendance.id %>">

            <i class="bi bi-person-check me-1"></i>
            Registrados

            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success">
                <%= @count_registrados %>+
            </span>
        </button>
        <div class="modal fade" id="exampleModal<%= adm_attendance.id %>" tabindex="-1" aria-labelledby="exampleModalLabel<%= adm_attendance.id %>" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5
                            class="modal-title"
                            id="exampleModalLabel<%= adm_attendance.id %>">
                            <i class="bi bi-person-check me-2"></i>
                            Asistencia
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <% if @attendances.present? %>
                            <div class="conesst-table-wrapper">
                                <table class="conesst-table">
                                    <thead>
                                        <tr>
                                            <th>Documento</th>
                                            <th>Nombre</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% @attendances.each do |attendance| %>
                                            <tr>
                                                <td>
                                                    <%= attendance.user.nro_document %>
                                                </td>
                                                <td>
                                                    <%= attendance.user.name %>
                                                </td>
                                            </tr>
                                        <% end %>
                                    </tbody>
                                </table>
                            </div>
                        <% else %>
                            <div class="alert alert-light text-center mb-0">
                                No hay participantes registrados.
                            </div>
                        <% end %>
                    </div>
                    <div class="modal-footer">
                        <button
                            type="button"
                            class="conesst-btn"
                            data-bs-dismiss="modal">

                            <i class="bi bi-x-circle me-1"></i>
                            Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </td>
    <td>
        <% @ca = AdmAttendance.pendientes(adm_attendance.id) %>
        <% @cant = 0 %>
        <% @cant = @ca.count if @ca.present? %>
        <button
            class="conesst-btn conesst-btn-warning position-relative"
            data-bs-toggle="modal"
            data-bs-target="#exampleModalp<%= adm_attendance.id %>">

            <i class="bi bi-person-exclamation me-1"></i>
            Pendientes

            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                <%= @cant %>-
            </span>

        </button>
        <div
            class="modal fade"
            id="exampleModalp<%= adm_attendance.id %>"
            tabindex="-1"
            aria-labelledby="exampleModalLabelp<%= adm_attendance.id %>"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5
                            class="modal-title"
                            id="exampleModalLabelp<%= adm_attendance.id %>">
                            <i class="bi bi-person-exclamation me-2"></i>
                            Pendientes
                        </h5>
                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        </button>
                    </div>
                    <div class="modal-body">
                        <% if @ca.present? %>
                            <div class="conesst-table-wrapper">
                                <table class="conesst-table">
                                    <thead>
                                        <tr>
                                            <th>Nombre</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% @ca.each do |nombre| %>
                                            <tr>
                                                <td>
                                                    <%= nombre %>
                                                </td>
                                            </tr>
                                        <% end %>
                                    </tbody>
                                </table>
                            </div>
                        <% else %>
                            <div class="alert alert-light text-center mb-0">
                                No hay participantes pendientes.
                            </div>
                        <% end %>
                    </div>
                    <div class="modal-footer">
                        <button
                            type="button"
                            class="conesst-btn"
                            data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i>
                            Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </td>
</tr>
