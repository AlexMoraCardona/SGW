
<div class="conesst-page">
  <div class="conesst-header">
    <div class="conesst-header-content">
      <div class="d-flex align-items-center gap-3">
        <%= link_to root_path, class: "d-inline-flex align-items-center" do %>
          <%= image_tag "LogoConesst202305232.png", class: "conesst-logo", alt: "CONESST" %>
        <% end %>
        <div>
          <h1 class="conesst-title mb-1">
            Perfil Sociodemográfico
          </h1>
          <% if @entity.present? %>
            <p class="conesst-subtitle mb-0">
              <i class="bi bi-building me-1"></i>
              <%= @entity.business_name %>
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <% if params[:entity_id].present? || @entity.present? %>
    <%= render "profile" %>
  <% else %>
    <div class="conesst-card">
      <div class="conesst-card-header">
        <div class="conesst-card-header-content">
          <h2 class="conesst-card-header-title">
            <i class="bi bi-building-check me-2"></i>
            Seleccionar empresa
          </h2>
          <p class="conesst-card-header-subtitle">
            Seleccione la entidad para consultar el perfil sociodemográfico.
          </p>
        </div>
      </div>
      <div class="conesst-card-body">
        <%= form_with model: @entity, method: :get do |form| %>
          <div class="conesst-form-group">
            <%= form.label :entity_id, "Empresa", class: "conesst-form-label" %>
            <% if @entities.present? %>
              <%= form.collection_select :entity_id, @entities.order(id: :asc), :id, :business_name, { prompt: "-- Seleccionar entidad --" }, { class: "form-select select2" } %>
            <% else %>
              <div class="conesst-form-control-static">
                <i class="bi bi-building me-2"></i>
                <%= @entity.business_name %>
              </div>
              <%= form.hidden_field :entity_id, value: @entity.id %>
            <% end %>
          </div>
          <div class="conesst-form-actions mt-4">
            <%= form.submit "Consultar", class: "conesst-btn conesst-btn-primary", data: { disable_with: "Consultando..." } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
