<tr>
  <td>
    <span class="conesst-table-main-text">
      <%= view_video.date_view %>
    </span>
  </td>
  <td>
    <span class="conesst-table-main-text">
      <%= highlight(view_video.name_view, params.dig(:q, :name_view_cont)) %>
    </span>
  </td>
  <td>
    <span class="conesst-table-main-text">
      <%= view_video.user_id %>
    </span>
  </td>
  <td>
    <span class="conesst-table-main-text">
      <i class="bi bi-person me-1 text-muted"></i>
      <%= view_video.user.name %>
    </span>
  </td>
  <td>
    <span class="conesst-badge">
      <%= ViewVideo.label_type(view_video.type_presentation) %>
    </span>
  </td>
</tr>
