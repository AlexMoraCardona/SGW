<div class="conesst-page">
  <div class="conesst-header">
    <div class="conesst-card-header-content">
      <div class="conesst-card-header-title">
        <i class="bi bi-clipboard2-check me-2"></i>
        <%= @adm_exam.new_record? ? "Crear evaluación" : "Editar evaluación" %>
      </div>
      <div class="conesst-card-header-subtitle">
        Configuración de la evaluación y sus parámetros
      </div>
    </div>
  </div>
  <div class="conesst-card">
    <div class="conesst-card-body">
      <%= form_with model: @adm_exam do |form| %>
        <% if @adm_exam.errors.any? %>
          <div class="alert alert-danger mb-4" role="alert">
            <div class="fw-semibold mb-2">
              <i class="bi bi-exclamation-triangle me-2"></i>
              No fue posible guardar la evaluación.
            </div>
            <ul class="mb-0 ps-3">
              <% @adm_exam.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="conesst-form-section">
          <div class="conesst-form-section-title">
            <i class="bi bi-info-circle me-2"></i>
            Información de la evaluación
          </div>
          <div class="conesst-form-grid conesst-form-grid-2">
            <div class="conesst-form-group">
              <%= form.label :name, class: "conesst-form-label" do %>
                Nombre
              <% end %>
              <%= form.text_field :name, class: "form-control", placeholder: "Ingrese el nombre de la evaluación" %>
            </div>
            <div class="conesst-form-group">
              <%= form.label :description, class: "conesst-form-label" do %>
                Descripción
              <% end %>
              <%= form.text_field :description, class: "form-control", placeholder: "Ingrese una descripción de la evaluación" %>
            </div>
          </div>
        </div>
        <div class="conesst-form-section">
          <div class="conesst-form-section-title">
            <i class="bi bi-sliders me-2"></i>
            Parámetros de la evaluación
          </div>
          <div class="conesst-form-grid conesst-form-grid-2">
            <div class="conesst-form-group">
              <%= form.label :cant_questions, class: "conesst-form-label" do %>
                Cantidad de preguntas
              <% end %>
              <%= form.number_field :cant_questions, class: "form-control",  min: 1 %>
            </div>
            <div class="conesst-form-group">
              <%= form.label :percentage_min, class: "conesst-form-label" do %>
                Porcentaje mínimo
              <% end %>
              <%= form.number_field :percentage_min, class: "form-control", step: 0.01 %>
            </div>
            <div class="conesst-form-group">
              <%= form.label :cant_attempts, class: "conesst-form-label" do %>
                Cantidad de intentos
              <% end %>
              <%= form.number_field :cant_attempts, class: "form-control", min: 1 %>
            </div>
            <div class="conesst-form-group">
              <%= form.label :time_max, class: "conesst-form-label" do %>
                Tiempo máximo
              <% end %>
              <%= form.number_field :time_max, class: "form-control",  min: 1 %>
            </div>
          </div>
        </div>
        <div class="conesst-form-section">
          <div class="conesst-form-section-title">
            <i class="bi bi-image me-2"></i>
            Imagen de la evaluación
          </div>
          <div class="conesst-form-grid">
            <div class="conesst-form-group">
              <%= form.label :img_exam, class: "conesst-form-label" do %>
                Imagen
              <% end %>
              <%= form.file_field :img_exam, class: "form-control", accept: "image/*", capture: "environment" %>
            </div>
          </div>
        </div>
        <%= form.hidden_field :code, value: @template.reference if @template.present? %>
        <%= form.hidden_field :version, value: @template.version.to_i if @template.present? %>
        <div class="conesst-form-actions">
          <button type="submit" class="conesst-btn conesst-btn-primary">
            <i class="bi bi-check-circle"></i>
            <%= t('common.submit') %>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
