<div class="container-fluid px-2 px-md-4 py-3">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-calendar3 me-2"></i>
                Plan de Trabajo Anual
            </h5>
        </div>
        <div class="card-body p-3 p-md-4">
            <%= form_with model: @annual_work_plan do |form| %>
                <% if @annual_work_plan.errors.any? %>
                    <div class="alert alert-danger" role="alert">
                        <div class="fw-bold mb-2">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Se encontraron los siguientes errores:
                        </div>
                        <ul class="mb-0">
                            <% @annual_work_plan.errors.full_messages.each do |error| %>
                                <li><%= error %></li>
                            <% end %>
                        </ul>
                    </div>
                <% end %>
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <%= form.label :year, class: "form-label fw-semibold" do %>
                            <i class="bi bi-calendar-event me-1"></i>
                            Año
                        <% end %>
                        <div class="input-group">
                            <%= form.number_field :year, class: "form-control", placeholder: "Ej. 2026", min: 2000, max: 2100 %>
                            <button type="button" class="btn btn-light" data-bs-toggle="tooltip" data-bs-html="true" title="Ingrese el año del Plan de Trabajo Anual.">
                                <%= image_tag 'ayuda.png', width: 22, height: 22, alt: "Ayuda" %>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-12 col-md-4">
                        <%= form.label :user_legal_representative, class: "form-label fw-semibold" do %>
                            <i class="bi bi-person-badge me-1"></i>
                            Representante Legal
                        <% end %>
                        <div class="input-group">
                            <%= form.collection_select :user_legal_representative, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccionar Representante Legal --" }, { class: "form-select" } %>
                            <button type="button" class="btn btn-light" data-bs-toggle="tooltip" data-bs-html="true" title="Seleccione el nombre del Representante Legal.">
                                <%= image_tag 'ayuda.png', width: 22, height: 22, alt: "Ayuda" %>
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <%= form.label :user_adviser_sst, class: "form-label fw-semibold" do %>
                            <i class="bi bi-person-workspace me-1"></i>
                            Asesor SST
                        <% end %>
                        <div class="input-group">
                            <%= form.collection_select :user_adviser_sst, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccionar Asesor SST --" }, { class: "form-select" } %>
                            <button type="button" class="btn btn-light" data-bs-toggle="tooltip" data-bs-html="true" title="Seleccione el nombre del Asesor SST.">
                                    <%= image_tag 'ayuda.png', width: 22, height: 22, alt: "Ayuda" %>
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <%= form.label :user_responsible_sst, class: "form-label fw-semibold" do %>
                            <i class="bi bi-person-check me-1"></i>
                            Responsable SST
                        <% end %>
                        <div class="input-group">
                            <%= form.collection_select :user_responsible_sst, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccionar Responsable SST --" }, { class: "form-select" } %>
                            <button type="button" class="btn btn-light" data-bs-toggle="tooltip" data-bs-html="true" title="Seleccione el nombre del Responsable SST.">
                                <%= image_tag 'ayuda.png', width: 22, height: 22, alt: "Ayuda" %>
                            </button>
                        </div>
                    </div>
                </div>
                <%= form.hidden_field :entity_id, value: params[:entity_id].to_i %>
                <%= form.hidden_field :code, value: @template.reference if @template.present? %>
                <%= form.hidden_field :version, value: @template.version.to_i if @template.present? %>
                <%= form.hidden_field :date_create, value: @template.date if @template.present? %>
                <%= form.hidden_field :date_update, value: @template.date_updated if @template.present? %>
                <div class="border-top mt-4 pt-3">
                    <div class="d-flex flex-column flex-md-row justify-content-center gap-2">
                        <%= form.button type: :submit, class: "btn btn-success" do %>
                            <i class="bi bi-check-circle"></i>
                            Guardar
                        <% end %>
                        <%= link_to :back, class: "btn btn-secondary" do %>
                            <i class="bi bi-arrow-left-circle"></i>
                            Retornar
                        <% end %>
                    </div>
                </div>
            <% end %>
        </div>
  </div>
</div>
