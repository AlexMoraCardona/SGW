<div class="conesst-card mb-3">
    <div class="conesst-card-header">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-calendar-check fs-5"></i>
            <div>
                <div class="fw-semibold">
                    <%= adm_attendance.date_attendance %>
                </div>
                <small class="text-muted">
                    <%= adm_attendance.entity.business_name %>
                </small>
            </div>
        </div>
    </div>
    <div class="conesst-card-body">
        <div class="mb-3">
            <div class="text-muted small mb-1">
                <i class="bi bi-card-text me-1"></i>
                Descripción
            </div>
            <div class="fw-semibold">
                <%= adm_attendance.description %>
            </div>
        </div>
        <div class="mb-3">
            <% @cant_reg = AdmAttendance.contador(adm_attendance.id) %>
            <div class="text-muted small mb-1">
                <i class="bi bi-people me-1"></i>
                Participantes
            </div>
            <% if @cant_reg > 0 %>
                <button
                    class="conesst-btn conesst-btn-primary position-relative"
                    disabled>
                    <i class="bi bi-people me-1"></i>
                    Participantes
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success">
                        <%= @cant_reg %>+
                    </span>
                </button>
            <% else %>
                <%= link_to seleccion_participantes_path(adm_attendance.id), class: "conesst-btn conesst-btn-primary" do %>
                    <i class="bi bi-people me-1"></i>
                    Ingresar participantes
                <% end %>
            <% end %>
        </div>
        <div class="mb-3">
            <% @attendances = AdmAttendance.asistentes(adm_attendance.id) %>
            <% @count_registrados = 0 %>
            <% @count_registrados = @attendances.count if @attendances.present? %>
            <div class="text-muted small mb-1">
                <i class="bi bi-person-check me-1"></i>
                Participantes registrados
            </div>
            <button
                class="conesst-btn conesst-btn-success position-relative"
                data-bs-toggle="modal"
                data-bs-target="#exampleModalMobile<%= adm_attendance.id %>">

                <i class="bi bi-person-check me-1"></i>
                Registrados

                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success">
                    <%= @count_registrados %>+
                </span>

            </button>
            <div
                class="modal fade"
                id="exampleModalMobile<%= adm_attendance.id %>"
                tabindex="-1"
                aria-labelledby="exampleModalMobileLabel<%= adm_attendance.id %>"
                aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5
                                class="modal-title"
                                id="exampleModalMobileLabel<%= adm_attendance.id %>">

                                <i class="bi bi-person-check me-2"></i>
                                Asistencia
                            </h5>
                            <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                            </button>
                        </div>
                        <div class="modal-body">
                            <% if @attendances.present? %>
                                <div class="conesst-table-wrapper">
                                    <table class="conesst-table">
                                        <thead>
                                            <tr>
                                                <th>Documento</th>
                                                <th>Nombre</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% @attendances.each do |attendance| %>
                                                <tr>
                                                    <td>
                                                        <%= attendance.user.nro_document %>
                                                    </td>
                                                    <td>
                                                        <%= attendance.user.name %>
                                                    </td>
                                                </tr>
                                            <% end %>
                                        </tbody>
                                    </table>
                                </div>
                            <% else %>
                                <div class="alert alert-light text-center mb-0">
                                    No hay participantes registrados.
                                </div>
                            <% end %>
                        </div>
                        <div class="modal-footer">
                            <button
                                type="button"
                                class="conesst-btn"
                                data-bs-dismiss="modal">
                                <i class="bi bi-x-circle me-1"></i>
                                Cerrar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="mb-3">
            <% @ca = AdmAttendance.pendientes(adm_attendance.id) %>
            <% @cant = 0 %>
            <% @cant = @ca.count if @ca.present? %>
            <div class="text-muted small mb-1">
                <i class="bi bi-person-exclamation me-1"></i>
                Participantes pendientes
            </div>
            <button
                class="conesst-btn conesst-btn-warning position-relative"
                data-bs-toggle="modal"
                data-bs-target="#exampleModalpMobile<%= adm_attendance.id %>">
                <i class="bi bi-person-exclamation me-1"></i>
                Pendientes
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= @cant %>-
                </span>
            </button>
            <div
                class="modal fade"
                id="exampleModalpMobile<%= adm_attendance.id %>"
                tabindex="-1"
                aria-labelledby="exampleModalpMobileLabel<%= adm_attendance.id %>"
                aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5
                                class="modal-title"
                                id="exampleModalpMobileLabel<%= adm_attendance.id %>">

                                <i class="bi bi-person-exclamation me-2"></i>
                                Pendientes

                            </h5>
                            <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                            </button>
                        </div>
                        <div class="modal-body">
                            <% if @ca.present? %>
                                <div class="conesst-table-wrapper">
                                    <table class="conesst-table">
                                        <thead>
                                            <tr>
                                                <th>Nombre</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% @ca.each do |nombre| %>
                                                <tr>
                                                    <td>
                                                        <%= nombre %>
                                                    </td>
                                                </tr>
                                            <% end %>
                                        </tbody>
                                    </table>
                                </div>
                            <% else %>
                                <div class="alert alert-light text-center mb-0">
                                    No hay participantes pendientes.
                                </div>
                            <% end %>
                        </div>
                        <div class="modal-footer">
                            <button
                                type="button"
                                class="conesst-btn"
                                data-bs-dismiss="modal">
                                <i class="bi bi-x-circle me-1"></i>
                                Cerrar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="conesst-actions mt-3">
            <%= link_to edit_adm_attendance_path(adm_attendance), class: "conesst-btn conesst-btn-primary" do %>
                <i class="bi bi-pencil-square me-1"></i>
                <%= t('common.edit') %>
            <% end %>
            <%= link_to adm_attendance_pdf_path(adm_attendance.id, format: "pdf"), class: "conesst-btn conesst-btn-primary" do %>
                <i class="bi bi-file-earmark-pdf me-1"></i>
                PDF
            <% end %>
        </div>
    </div>
</div>
