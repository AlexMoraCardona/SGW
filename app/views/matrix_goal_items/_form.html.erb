<div class="container-fluid py-3">
    <div class="text-center text-md-start">
        <%= link_to root_path, class: "d-inline-block" do %>
            <%= image_tag 'LogoConesst202305232.png', width: 100, height: 100, class: "img-fluid", alt: "Logo CONESST" %>
        <% end %>
    </div>
</div>

<div class="container-fluid px-2 px-md-4 pb-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-bullseye me-2"></i>
                Meta del indicador
            </h5>
        </div>
        <div class="card-body p-3 p-md-4">
            <%= form_with model: @matrix_goal_item do |form| %>
                <% if @matrix_goal_item.errors.any? %>
                    <div class="alert alert-danger">
                        <div class="fw-bold mb-2">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Se encontraron los siguientes errores:
                        </div>
                        <ul class="mb-0">
                            <% @matrix_goal_item.errors.full_messages.each do |error| %>
                                <li><%= error %></li>
                            <% end %>
                        </ul>
                    </div>
                <% end %>
                <div class="row g-3">
                    <div class="col-12 col-md-8">
                        <%= form.label :indicator_id, "Seleccionar Indicador", class: "form-label fw-semibold" %>
                        <%= form.collection_select :indicator_id,  Indicator.all.order(id: :asc), :id, :name, { prompt: '-- Seleccionar Indicador --' }, { class: 'form-select select2' } %>
                    </div>
                    <div class="col-12 col-md-4">
                        <%= form.label :meta, "Meta (%)", class: "form-label fw-semibold" %>
                        <%= form.number_field :meta, in: 0.00..100.0,  step: 0.01,  class: "form-control", placeholder: "Ej. 95.00" %>
                    </div>
                </div>
                <div class="mt-3">
                    <%= form.label :objetives, "Objetivo", class: "form-label fw-semibold" %>
                    <%= form.text_area :objetives, class: "form-control", rows: 4, placeholder: "Describa el objetivo..." %>
                </div>
                <%= form.hidden_field :matrix_goal_id, value: params[:id].to_i %>
                <div class="border-top mt-4 pt-3">
                    <div class="d-flex flex-column flex-md-row justify-content-center gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i>
                            <%= t('common.submit') %>
                        </button>
                        <%= link_to matrix_goals_path(entity_id: Current.user.entity), class:"btn btn-secondary" do %>
                            <i class="bi bi-arrow-left-circle"></i>
                            Retornar
                        <% end %>
                    </div>
                </div>
            <% end %>
        </div>
    </div>
</div>

