<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-fire-extinguisher fs-5"></i>
        <div>
          <h4 class="mb-0">
            LISTA DE CHEQUEO INSPECCIÓN DE EXTINTORES
          </h4>
          <small class="text-muted">
            Registre las condiciones encontradas durante la inspección
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @extinguisher do |form| %>
        <% if @extinguisher.errors.any? %>
          <div class="alert alert-danger mb-4" role="alert">
            <div class="fw-semibold mb-2">
              <i class="bi bi-exclamation-triangle me-1"></i>
              Se encontraron los siguientes errores:
            </div>
            <ul class="mb-0">
              <% @extinguisher.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="row g-3 mb-3">
          <div class="col-12 col-md-6 col-lg-4">
            <%= form.label :nro, class: "form-label fw-semibold" %>
            <%= form.number_field :nro, class: "form-control", required: true %>
          </div>
        </div>
        <div class="border rounded p-3 mb-4">
          <%= form.label :type_extinguisher, class: "form-label fw-semibold mb-3" %>
          <div class="d-flex flex-column gap-2">
            <div class="form-check">
              <%= form.radio_button :type_extinguisher, 0, required: true, class: "form-check-input", id: "type_extinguisher_0" %>
              <%= form.label :type_extinguisher, "Extintor H2O", value: 0, class: "form-check-label", for: "type_extinguisher_0" %>
            </div>
            <div class="form-check">
              <%= form.radio_button :type_extinguisher, 1, required: true, class: "form-check-input", id: "type_extinguisher_1" %>
              <%= form.label :type_extinguisher, "Extintor CO2", value: 1, class: "form-check-label", for: "type_extinguisher_1" %>
            </div>
            <div class="form-check">
              <%= form.radio_button :type_extinguisher, 2, required: true, class: "form-check-input", id: "type_extinguisher_2" %>
              <%= form.label :type_extinguisher, "Extintor Multiproposito ABC", value: 2, class: "form-check-label", for: "type_extinguisher_2" %>
            </div>
            <div class="form-check">
              <%= form.radio_button :type_extinguisher, 3, required: true, class: "form-check-input", id: "type_extinguisher_3" %>
              <%= form.label :type_extinguisher, "Extintor Solkaflam", value: 3, class: "form-check-label", for: "type_extinguisher_3" %>
            </div>
            <div class="form-check">
              <%= form.radio_button :type_extinguisher, 4, required: true, class: "form-check-input", id: "type_extinguisher_4" %>
              <%= form.label :type_extinguisher, "Extintor Clase D", value: 4, class: "form-check-label", for: "type_extinguisher_4" %>
            </div>
            <div class="form-check">
              <%= form.radio_button :type_extinguisher, 5, required: true, class: "form-check-input", id: "type_extinguisher_5" %>
              <%= form.label :type_extinguisher, "Extintor Tipo K", value: 5, class: "form-check-label", for: "type_extinguisher_5" %>
            </div>
          </div>
        </div>
        <div class="row g-3 mb-4">
          <div class="col-12 col-md-6">
            <%= form.label :ability, class: "form-label fw-semibold" %>
            <%= form.text_field :ability, class: "form-control", required: true %>
          </div>
        </div>
        <div class="conesst-card mb-4">
          <div class="conesst-card-header">
            <div>
              <h5 class="mb-0">
                Condiciones del extintor
              </h5>
              <small class="text-muted">
                Seleccione el estado correspondiente para cada elemento
              </small>
            </div>
          </div>
          <div class="conesst-card-body">
            <% inspection_fields = [:ring, :pressure_gauge, :barrette, :handle, :valve, :hose, :nozzle, :cylindrical_body, :decal, :medium, :signaling, :location] %>
            <div class="row g-3">
              <% inspection_fields.each do |field| %>
                <div class="col-12 col-md-6 col-lg-4">
                  <div class="border rounded p-3 h-100">
                    <%= form.label field, class: "form-label fw-semibold mb-3" %>
                    <div class="d-flex flex-wrap gap-3">
                      <div class="form-check">
                        <%= form.radio_button field, 0, required: true, class: "form-check-input", id: "#{field}_0" %>
                        <%= form.label field, "NA", value: 0, class: "form-check-label", for: "#{field}_0" %>
                      </div>
                      <div class="form-check">
                        <%= form.radio_button field, 1, required: true, class: "form-check-input", id: "#{field}_1" %>
                        <%= form.label field, "NT", value: 1, class: "form-check-label", for: "#{field}_1" %>
                      </div>
                      <div class="form-check">
                        <%= form.radio_button field, 2, required: true, class: "form-check-input", id: "#{field}_2" %>
                        <%= form.label field, "B", value: 2, class: "form-check-label", for: "#{field}_2" %>
                      </div>
                      <div class="form-check">
                        <%= form.radio_button field, 3, required: true, class: "form-check-input", id: "#{field}_3" %>
                        <%= form.label field, "M", value: 3, class: "form-check-label", for: "#{field}_3" %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <div class="conesst-card mb-4">
          <div class="conesst-card-header">
            <div>
              <h5 class="mb-0">
                Ubicación y control
              </h5>
              <small class="text-muted">
                Información adicional de la inspección
              </small>
            </div>
          </div>
          <div class="conesst-card-body">
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <%= form.label :area_location, class: "form-label fw-semibold" %>
                <%= form.text_field :area_location, class: "form-control", required: true %>
              </div>
              <div class="col-12 col-md-6">
                <%= form.label :date_vec_carga, class: "form-label fw-semibold" %>
                <%= form.date_field :date_vec_carga, class: "form-control", required: true %>
              </div>
              <div class="col-12">
                <%= form.label :observation, class: "form-label fw-semibold" %>
                <%= form.text_field :observation, class: "form-control" %>
              </div>
            </div>
          </div>
        </div>
        <%= form.hidden_field :adm_extinguisher_id, value: params[:id].to_i %>
        <div class="conesst-actions mt-4">
          <%= form.submit t('common.submit'), class: "conesst-btn conesst-btn-primary" %>
          <%= link_to request.referer || root_path, class: "conesst-btn" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>