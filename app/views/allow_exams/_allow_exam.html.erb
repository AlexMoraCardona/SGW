<tr>
  <td><%= allow_exam.id %></td>
  <td>
    <%= allow_exam.entity.business_name %>
  </td>
  <td>
    <%= allow_exam.description %>
  </td>
  <td>
    <%= allow_exam.user.name %>
  </td>
  <td class="text-center">
    <%= link_to seleccionar_usuarios_examen_path(allow_exam), class: "conesst-btn conesst-btn-primary" do %>
      <i class="bi bi-people me-1"></i>
      Participantes
    <% end %>
  </td>
  <td class="text-center">
    <%= link_to edit_allow_exam_path(allow_exam), class: "conesst-btn conesst-btn-primary" do %>
      <i class="bi bi-pencil-square me-1"></i>
      <%= t('common.edit') %>
    <% end %>
  </td>
  <td class="text-center">
    <%= button_to allow_exam, method: :delete, class: "btn btn-sm btn-danger", form: {data: {turbo_confirm: "¿Está seguro de eliminar esta autorización?"}} do %>
      <i class="bi bi-trash me-1"></i>
      Eliminar
    <% end %>
  </td>
</tr>