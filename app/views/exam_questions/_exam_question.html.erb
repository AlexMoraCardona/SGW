<tr>
  <td>
    <span class="conesst-table-main-text">
      <%= exam_question.number %>
    </span>
  </td>
  <td>
    <span class="conesst-table-main-text">
      <%= exam_question.adm_exam.description %>
    </span>
  </td>
  <td>
    <span class="conesst-table-main-text text-break">
      <%= exam_question.question %>
    </span>
  </td>
  <td>
    <%= link_to edit_exam_question_path(exam_question),
        class: "conesst-btn conesst-btn-warning conesst-btn-sm",
        title: t('common.edit') do %>
      <i class="bi bi-pencil-square"></i>
      <span class="d-md-none">
        <%= t('common.edit') %>
      </span>
    <% end %>
  </td>
</tr>
