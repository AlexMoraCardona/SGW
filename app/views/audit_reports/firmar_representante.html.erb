<div class="conesst-page">
    <div class="conesst-card">
        <div class="conesst-card-body">
            <%= form_with model: @audit_report do |form| %>
                <% if @audit_report.errors.any? %>
                    <div class="alert alert-danger audit-signature-errors" role="alert">
                        <div class="fw-semibold mb-2">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            No fue posible guardar la información.
                        </div>
                        <ul class="mb-0">
                            <% @audit_report.errors.full_messages.each do |error| %>
                                <li><%= error %></li>
                            <% end %>
                        </ul>
                    </div>
                <% end %>   
                <div class="audit-signature-section">
                    <div class="audit-signature-section-title">
                        <i class="bi bi-person-badge"></i>
                        <span>Representante Legal</span>
                    </div>
                    <div class="audit-signature-user">
                        <div class="audit-signature-user-icon">
                            <i class="bi bi-person"></i>
                        </div>
                        <div class="audit-signature-user-info">
                            <span class="audit-signature-label">
                                Representante Legal responsable
                            </span>
                            <strong>
                                <%= @audit_report.name_user(@audit_report.user_representante) %>
                            </strong>
                        </div>
                    </div>
                </div>
                <div class="audit-signature-section">
                    <div class="audit-signature-section-title">
                        <i class="bi bi-pen"></i>
                        <span>Firma autorizada del Representante</span>
                    </div>
                    <div class="audit-signature-question">
                        ¿El Representante Legal autoriza el uso de su firma en el informe?
                    </div>
                    <div class="audit-signature-options">
                        <label class="audit-signature-option">
                            <%= form.radio_button :firm_representante, 0 %>
                            <span class="audit-signature-option-content">
                                <i class="bi bi-x-circle"></i>
                                <span>
                                    <strong>No</strong>
                                    <small>No autoriza la firma</small>
                                </span>
                            </span>
                        </label>
                        <label class="audit-signature-option">
                            <%= form.radio_button :firm_representante, 1 %>
                            <span class="audit-signature-option-content">
                                <i class="bi bi-check-circle"></i>
                                <span>
                                    <strong>Sí</strong>
                                    <small>Autoriza la firma</small>
                                </span>
                            </span>
                        </label>
                    </div>
                </div>
                <%= form.hidden_field :date_firm_representante, value: Time.now %>
                <div class="conesst-actions audit-signature-actions">
                    <%= form.button type: "submit", class: "conesst-btn conesst-btn-primary", title: t('common.submit') do %>
                        <i class="bi bi-check-circle"></i>
                        <span><%= t('common.submit') %></span>
                    <% end %>
                    <%= link_to :back, class: "conesst-btn conesst-btn-warning", title: "Retornar" do %>
                        <i class="bi bi-arrow-left"></i>
                        <span>Retornar</span>
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
</div>
