<div class="container-fluid py-3">
  <div class="row">
    <div class="col-12 text-center text-md-start">
      <%= link_to root_path, class: "d-inline-block" do %>
        <%= image_tag "LogoConesst202305232.png", width: 100, height: 100, class: "img-fluid", alt: "Logo CONESST" %>
      <% end %>
    </div>
  </div>
</div>

<div class="container-fluid px-3 px-md-4 px-lg-5 pb-4">
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
      <div class="row align-items-center g-3">
        <div class="col-12 col-md">
          <h2 class="mb-0 text-center text-md-start">
            <%= t(".title") %>
          </h2>
        </div>
        <% if Current.user.level > 0 && Current.user.level < 3 %>
          <div class="col-12 col-md-auto text-center">
            <%= link_to new_indicator_path,
                  class: "btn btn-primary d-inline-flex align-items-center justify-content-center gap-2 px-4 py-2" do %>
              <i class="bi bi-plus-circle"></i>
              <span><%= t(".create_indicator") %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0">
          <thead class="table-dark">
            <tr>
              <th scope="col" class="px-3 py-3">
                <%= t(".name") %>
              </th>
              <th scope="col" class="px-3 py-3">
                <%= t(".description") %>
              </th>
              <th scope="col" class="text-center px-3 py-3">
                <%= t("common.show") %>
              </th>
              <% if Current.user.level > 0 && Current.user.level < 3 %>
                <th scope="col" class="text-center px-3 py-3">
                  <%= t("common.edit") %>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <%= render partial: "indicator", collection: @indicators %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
