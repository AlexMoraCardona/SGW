         class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-primary text-white py-3">
        <h2 class="h4 mb-0">
          <i class="bi bi-clipboard-data me-2"></i>
          Indicadores Mínimos de SST
        </h2>
        <small>
          Resolución 0312 de 2019, artículo 30
        </small>
      </div>
      <!-- Contenido -->
      <div class="card-body">
        <div class="alert alert-info text-center mb-4">
          <h4 class="mb-0">
            <i class="bi bi-calendar3 me-2"></i>
            Indicadores mínimos del año
            <strong><%= @year %></strong>
            - Resolución 0312
          </h4>
        </div>
        <!-- Tabla responsive -->
        <div class="table-responsive">
          <table class="table table-bordered table-hover align-middle text-center">
            <thead class="table-dark">
              <tr>
                <th class="text-start">
                  Indicadores
                </th>
                <th>Enero</th>
                <th>Febrero</th>
                <th>Marzo</th>
                <th>Abril</th>
                <th>Mayo</th>
                <th>Junio</th>
                <th>Julio</th>
                <th>Agosto</th>
                <th>Septiembre</th>
                <th>Octubre</th>
                <th>Noviembre</th>
                <th>Diciembre</th>
                <th>Total</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="text-start fw-semibold">
                  Número de accidentes laborales en el mes
                </td>
                <% for j in 1...13 %>
                  <td>
                    <%= @report_official.dato_total_work_accidents(@report_official, j) if @report_official.present? %>
