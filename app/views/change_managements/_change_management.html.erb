<% if @entity.present? %>
  <div class="conesst-card mb-3">
    <div class="conesst-card-body">
      <div class="d-flex align-items-start gap-2">
        <i class="bi bi-building fs-5 text-primary flex-shrink-0"></i>
        <div class="min-w-0">
          <div class="conesst-card-header-title">
            <%= @entity.business_name %>
          </div>
          <% if @entity.identification_number.present? %>
            <div class="conesst-card-header-subtitle mt-1">
              NIT:
              <%= EvaluationRuleDetail.miles(@entity.identification_number) %>
              <% if @entity.verification_digit.present? %>
                -<%= @entity.verification_digit %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
<div class="conesst-card">
  <div class="conesst-card-header">
    <div class="conesst-card-header-content">
      <div class="conesst-card-header-title">
        <i class="bi bi-arrow-repeat me-2"></i>
        Gestión del Cambio
      </div>
      <div class="conesst-card-header-subtitle">
        Listado de gestiones del cambio registradas
      </div>
    </div>
    <% if Current.user.level > 0 && Current.user.level < 4 %>
      <div class="conesst-actions">
        <%= link_to new_change_management_path, class: "conesst-btn conesst-btn-primary" do %>
          <i class="bi bi-plus-circle"></i>
          <span>Crear Gestión del cambio</span>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="conesst-card-body p-0">
    <% if @change_managements.present? %>
      <div class="conesst-table-wrapper">
        <table class="conesst-table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Área</th>
              <th>Usuario elaboró</th>
              <th>Planeación</th>
              <th>Firmar</th>
              <th>Ver</th>
              <th><%= t('common.edit') %></th>
              <th>PDF</th>
            </tr>
          </thead>
          <tbody>
            <% @change_managements.each do |change_management| %>
              <tr>
                <td>
                  <span class="conesst-table-main-text">
                    <% if change_management.date_change.present? %>
                      <%= change_management.date_change.strftime("%F") %>
                    <% else %>
                      —
                    <% end %>
                  </span>
                </td>
                <td>
                  <span class="conesst-table-main-text">
                    <%= ChangeManagement.label_area(change_management.code_area) %>
                  </span>
                </td>
                <td>
                  <span class="conesst-table-main-text">
                    <i class="bi bi-person me-1 text-muted"></i>
                    <%= ChangeManagement.label_user(change_management.user_elaborated) %>
                  </span>
                </td>
                <td>
                  <% if Current.user.level > 0 && Current.user.level < 3 %>
                    <%= link_to crear_item_paso_cambio_path(change_management), class: "conesst-btn conesst-btn-warning conesst-btn-sm" do %>
                      <i class="bi bi-list-check"></i>
                      <span>Crear planeación</span>
                    <% end %>
                  <% end %>
                </td>
                <td>
                  <% if change_management.firm_user_elaborated == 0 %>
                    <%= link_to firma_analisis_cambio_path(change_management), class: "conesst-btn conesst-btn-warning conesst-btn-sm" do %>
                      <i class="bi bi-pen"></i>
                      <span>Firmar</span>
                    <% end %>
                  <% else %>
                    <span class="conesst-status-badge text-success">
                      <i class="bi bi-check-circle-fill me-1"></i>
                      <%= change_management.date_user_elaborated.strftime("%F") if change_management.date_user_elaborated.present? %>
                    </span>
                  <% end %>
                </td>
                <td>
                  <%= link_to change_management_path(change_management), class: "conesst-btn conesst-btn-primary conesst-btn-sm", title: "Ver gestión" do %>
                    <i class="bi bi-eye"></i>
                    <span class="d-md-none">Ver</span>
                  <% end %>
                </td>
                <td>
                  <% if Current.user.level > 0 && Current.user.level < 3 %>
                    <%= link_to edit_change_management_path(change_management.id), class: "conesst-btn conesst-btn-warning conesst-btn-sm", title: "Editar gestión" do %>
                      <i class="bi bi-pencil-square"></i>
                      <span class="d-md-none">Editar</span>
                    <% end %>
                  <% end %>
                </td>
                <td>
                  <%= link_to ver_analysis_cambio_path(change_management.id, format: 'pdf'), class: "conesst-btn conesst-btn-success conesst-btn-sm", title: "Generar PDF" do %>
                    <i class="bi bi-file-earmark-pdf"></i>
                    <span class="d-md-none">PDF</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="conesst-empty-state">
        <i class="bi bi-inbox"></i>
        <div class="conesst-empty-state-title">
          No hay gestiones del cambio registradas
        </div>
        <div class="conesst-empty-state-text">
          Cuando se registre una gestión del cambio,
          aparecerá en este listado.
        </div>
      </div>
    <% end %>
  </div>
</div>
