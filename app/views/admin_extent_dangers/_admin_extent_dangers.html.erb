<% if @entity.present? %>
  <!-- Encabezado de la empresa -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3 p-md-4">
      <div class="d-flex align-items-start gap-3">
        <div class="text-primary fs-2 flex-shrink-0">
          <i class="bi bi-building"></i>
        </div>
        <div class="min-w-0">
          <h2 class="h5 fw-semibold mb-1 text-break">
            <%= @entity.business_name %>
          </h2>
          <% if @entity.identification_number.present? %>
            <div class="text-muted small">
              <i class="bi bi-card-text me-1"></i>
              NIT:
              <%= EvaluationRuleDetail.miles(@entity.identification_number) %><% if @entity.verification_digit.present? %>-<%= @entity.verification_digit %><% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<% if @admin_extent_dangers.present? %>
  <!-- Título de resultados -->
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div>
      <h3 class="h6 fw-semibold mb-1">
        <i class="bi bi-shield-check me-1 text-primary"></i>
        Medidas de prevención y control
      </h3>
      <p class="text-muted small mb-0">
        Registros diligenciados por los trabajadores
      </p>
    </div>
    <span class="badge rounded-pill text-bg-light border">
      <%= @admin_extent_dangers.size %>
      <%= @admin_extent_dangers.size == 1 ? "registro" : "registros" %>
    </span>
  </div>
  <!-- ========================================================= -->
  <!-- VISTA PARA PC / TABLET -->
  <!-- ========================================================= -->
  <div class="d-none d-md-block">
    <div class="card border-0 shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="text-center">
                <%= t('.id') %>
              </th>
              <th scope="col">
                NIT Entidad
              </th>
              <th scope="col">
                Entidad
              </th>
              <th scope="col">
                Usuario
              </th>
              <th scope="col">
                <%= t('.date_creation') %>
              </th>
              <th scope="col" class="text-center">
                Acciones
              </th>
            </tr>
          </thead>
          <tbody>
            <% @admin_extent_dangers.each do |admin_extent_danger| %>
              <tr>
                <td class="text-center fw-semibold">
                  <%= admin_extent_danger.id %>
                </td>
                <td class="text-nowrap">
                  <%= EvaluationRuleDetail.miles(admin_extent_danger.entity.identification_number) if admin_extent_danger.entity.identification_number.present? %>
                </td>
                <td>
                  <span class="fw-semibold">
                    <%= admin_extent_danger.entity.business_name %>
                  </span>
                </td>
                <td>
                  <i class="bi bi-person me-1 text-muted"></i>
                  <%= admin_extent_danger.user.name %>
                </td>
                <td class="text-nowrap">
                  <%= admin_extent_danger.date_creation %>
                </td>
                <td>
                  <div class="d-flex justify-content-center gap-1 flex-wrap">
                    <%= link_to matrix_prevention_admin_extent_dangers_path(admin_extent_danger), class: "btn btn-sm btn-outline-primary", title: "Ver matriz", data: { bs_toggle: "tooltip" } do %>
                      <i class="bi bi-grid-3x3-gap"></i>
                      <span class="d-none d-lg-inline ms-1">Matriz</span>
                    <% end %>
                    <%= link_to matrix_vista_admin_extent_dangers_path(admin_extent_danger, format: "pdf"), class: "btn btn-sm btn-outline-danger", title: "Generar PDF", data: { bs_toggle: "tooltip" } do %>
                      <i class="bi bi-file-earmark-pdf"></i>
                      <span class="d-none d-lg-inline ms-1">PDF</span>
                    <% end %>
                    <%= link_to admin_extent_danger_path(admin_extent_danger), class: "btn btn-sm btn-outline-secondary", title: "Ver encuesta", data: { bs_toggle: "tooltip" } do %>
                      <i class="bi bi-ui-checks"></i>
                      <span class="d-none d-lg-inline ms-1">Encuesta</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <!-- ========================================================= -->
  <!-- VISTA PARA CELULAR -->
  <!-- ========================================================= -->
  <div class="d-md-none">
    <% @admin_extent_dangers.each do |admin_extent_danger| %>
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-3">
          <!-- Cabecera del registro -->
          <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
            <div class="d-flex align-items-center gap-2 min-w-0">
              <div class="text-primary fs-4 flex-shrink-0">
                <i class="bi bi-shield-check"></i>
              </div>
              <div class="min-w-0">
                <div class="fw-semibold text-break">
                  <%= admin_extent_danger.entity.business_name %>
                </div>
                <div class="text-muted small">
                  Registro #<%= admin_extent_danger.id %>
                </div>
              </div>
            </div>
          </div>
          <!-- Información -->
          <div class="bg-light rounded p-3 mb-3">
            <div class="row g-2">
              <div class="col-12">
                <div class="small text-muted">
                  <i class="bi bi-card-text me-1"></i>
                  NIT
                </div>
                <div class="fw-semibold text-break">
                  <%= EvaluationRuleDetail.miles(admin_extent_danger.entity.identification_number) if admin_extent_danger.entity.identification_number.present? %>
                  <% if admin_extent_danger.entity.verification_digit.present? %>
                    -<%= admin_extent_danger.entity.verification_digit %>
                  <% end %>
                </div>
              </div>
              <div class="col-12">
                <div class="small text-muted">
                  <i class="bi bi-person me-1"></i>
                  Usuario
                </div>
                <div class="fw-semibold text-break">
                  <%= admin_extent_danger.user.name %>
                </div>
              </div>
              <div class="col-12">
                <div class="small text-muted">
                  <i class="bi bi-calendar3 me-1"></i>
                  <%= t('.date_creation') %>
                </div>
                <div class="fw-semibold">
                  <%= admin_extent_danger.date_creation %>
                </div>
              </div>
            </div>
          </div>
          <!-- Botonera -->
          <div class="d-flex flex-wrap justify-content-center gap-2">
            <%= link_to matrix_prevention_admin_extent_dangers_path(admin_extent_danger), class: "btn btn-sm btn-outline-primary px-3", title: "Ver matriz" do %>
              <i class="bi bi-grid-3x3-gap me-1"></i>
              Matriz
            <% end %>
            <%= link_to matrix_vista_admin_extent_dangers_path(admin_extent_danger, format: "pdf"), class: "btn btn-sm btn-outline-danger px-3", title: "Generar PDF" do %>
              <i class="bi bi-file-earmark-pdf me-1"></i>
              PDF
            <% end %>
            <%= link_to admin_extent_danger_path(admin_extent_danger), class: "btn btn-sm btn-outline-secondary px-3", title: "Ver encuesta" do %>
              <i class="bi bi-ui-checks me-1"></i>
              Encuesta
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <!-- Sin registros -->
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5 px-3">
      <div class="text-muted fs-1 mb-3">
        <i class="bi bi-shield-x"></i>
      </div>
      <h3 class="h6 fw-semibold">
        No hay medidas registradas
      </h3>
      <p class="text-muted small mb-0 mx-auto" style="max-width: 600px;">
        No presenta ninguna medida de prevención y control de peligros
        y riesgos diligenciada por parte de los trabajadores.
      </p>
    </div>
  </div>
<% end %>
