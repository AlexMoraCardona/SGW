
<tr>
  <td>
    <span class="conesst-table-main-text">
      <%= adm_exam.id %>
    </span>
  </td>

  <td>
    <span class="conesst-table-main-text">
      <%= adm_exam.name %>
    </span>
  </td>

  <td>
    <span class="conesst-table-main-text">
      <%= adm_exam.cant_questions %>
    </span>
  </td>

  <td>
    <span class="conesst-table-main-text">
      <%= adm_exam.percentage_min %>
    </span>
  </td>

  <td>
    <span class="conesst-table-main-text">
      <%= adm_exam.cant_attempts %>
    </span>
  </td>

  <td>
    <span class="conesst-table-main-text">
      <%= adm_exam.time_max %>
    </span>
  </td>

  <td>
    <%= link_to edit_adm_exam_path(adm_exam),
        class: "conesst-btn conesst-btn-warning conesst-btn-sm",
        title: t('common.edit') do %>

      <i class="bi bi-pencil-square"></i>

      <span class="d-md-none">
        <%= t('common.edit') %>
      </span>

    <% end %>
  </td>
</tr>
