<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-person-gear fs-5"></i>
        <div>
          <h5 class="mb-0">Editar asistente</h5>
          <small class="text-muted">
            Actualización de la información del participante de la reunión
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @meeting_attendee do |form| %>
        <% @meeting_attendee.errors.full_messages.each do |error| %>
          <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <%= error %>
          </div>
        <% end %>
        <div class="row g-3">
          <div class="col-12">
            <div class="form-label fw-semibold">
              Nombre
            </div>
            <div class="form-control bg-light">
              <%= @meeting_attendee.name %>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <%= form.label :post, "Cargo", class: "form-label fw-semibold" %>
            <%= form.text_field :post, class: "form-control" %>
          </div>
          <div class="col-12 col-md-6">
            <%= form.label :process_area, "Área / Proceso", class: "form-label fw-semibold" %>
            <%= form.text_field :process_area, class: "form-control" %>
          </div>
        </div>
        <div class="conesst-actions mt-4">
          <%= form.submit t('common.submit'), class: "conesst-btn conesst-btn-primary" %>
          <%= link_to request.referer || meeting_minutes_path, class: "conesst-btn" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>