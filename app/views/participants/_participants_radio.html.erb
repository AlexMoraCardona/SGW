<div class="p-3 bg-light rounded-3">
  <label class="form-label fw-semibold mb-2">
    <%= label %>
  </label>
  <div class="d-flex gap-4">
    <div class="form-check">
      <%= form.radio_button field, 0, class: "form-check-input", id: "#{field}_no" %>
      <%= form.label field, "NO", value: 0, for: "#{field}_no", class: "form-check-label" %>
    </div>
    <div class="form-check">
      <%= form.radio_button field,  1, class: "form-check-input", id: "#{field}_yes" %>
      <%= form.label field, "SI", value: 1, for: "#{field}_yes", class: "form-check-label" %>
    </div>
  </div>
</div>
