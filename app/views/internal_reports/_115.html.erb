<div class="container-fluid px-2 px-md-3 py-3">
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <i class="bi bi-clipboard2-pulse me-2"></i>
      Información del incidente o accidente
    </div>
    <div class="conesst-card-body">
      <div class="row g-3">
        <div class="col-12 col-md-6">
          <div class="conesst-info-card h-100">
            <div class="conesst-data-label">
              <i class="bi bi-exclamation-diamond me-1"></i>
              Tipo de evento
            </div>
            <div class="conesst-data-value">
              <%= InternalReport.label_type_report(@internal_report.type_report) %>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="conesst-info-card h-100">
            <div class="conesst-data-label">
              <i class="bi bi-calendar-event me-1"></i>
              Fecha de ocurrencia
            </div>
            <div class="conesst-data-value">
              <%= @internal_report.date_report if @internal_report.date_report.present? %>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="conesst-info-card h-100">
            <div class="conesst-data-label">
              <i class="bi bi-clock me-1"></i>
              Hora de ocurrencia
            </div>
            <div class="conesst-data-value">
              <%= @internal_report.time_report.strftime("%T") if @internal_report.time_report.present? %>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="conesst-info-card h-100">
            <div class="conesst-data-label">
              <i class="bi bi-geo-alt me-1"></i>
              Lugar del incidente o accidente
            </div>
            <div class="conesst-data-value text-break">
              <%= @internal_report.place %>
            </div>
          </div>
        </div>
        <div class="col-12">
          <div class="conesst-info-card">
            <div class="conesst-data-label">
              <i class="bi bi-card-text me-1"></i>
              Descripción del incidente o accidente
            </div>
            <div class="conesst-data-value text-break">
              <%= @internal_report.description %>
            </div>
          </div>
        </div>
        <div class="col-12">
          <div class="conesst-info-card">
            <div class="conesst-data-label">
              <i class="bi bi-person me-1"></i>
              Nombre de la persona accidentada
            </div>
            <div class="conesst-data-value text-break">
              <%= @internal_report.name_person %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <i class="bi bi-paperclip me-2"></i>
      Registro fotográfico y archivos adjuntos
    </div>
    <div class="conesst-card-body">
      <% if @internal_report.imagenes_reports.attached? %>
        <div data-controller="previews">
          <div class="row g-3">
            <% @internal_report.imagenes_reports.each do |file| %>
              <div class="col-12 col-md-6 col-xl-4">
                <div class="conesst-info-card h-100">
                  <div class="conesst-info-card-title text-break">
                    <i class="bi bi-file-earmark me-2"></i>
                    <%= file.filename %>
                  </div>
                  <div class="mt-3">
                    <% if file.image? %>
                      <%= image_tag file, data: { previews_target: "preview" }, class: "image_inv img-fluid", alt: file.filename.to_s %>
                    <% elsif file.video? %>
                      <%= video_tag url_for(file), controls: true, class: "w-100" %>
                    <% elsif file.audio? %>
                      <%= audio_tag url_for(file), controls: true, class: "w-100" %>
                    <% else %>
                      <div class="text-break">
                        <i class="bi bi-file-earmark-text me-2"></i>
                        <%= link_to file.filename, url_for(file), class: "text-break" %>
                      </div>
                    <% end %>
                  </div>
                  <div class="conesst-actions-wrap d-flex flex-wrap mt-3">
                    <%= link_to rails_blob_path(file, disposition: "attachment"), class: "conesst-btn conesst-btn-success" do %>
                      <i class="bi bi-download"></i>
                      Descargar archivo
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="conesst-empty">
          <i class="bi bi-folder2-open me-2"></i>
          Este reporte no tiene archivos adjuntos.
        </div>
      <% end %>
    </div>
  </div>
  <div class="conesst-card mb-4">
    <div class="conesst-card-header">
      <i class="bi bi-pen me-2"></i>
      Usuario que realiza el reporte
    </div>
    <div class="conesst-card-body">
      <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
          <div class="conesst-info-card text-center">
            <div class="mb-3">
              <% if @internal_report.firm_user == 1 %>
                <% if @usuario.present? && @usuario.firm.attached? && @usuario.firm.image? %>
                  <div class="d-flex justify-content-center align-items-end" style="min-height: 90px;">
                    <%= image_tag @usuario.firm, class: "firma" %>
                  </div>
                <% else %>
                  <div style="min-height: 90px;"></div>
                <% end %>
              <% else %>
                <div style="min-height: 90px;"></div>
              <% end %>
              <hr class="mx-auto" style="max-width: 280px;">
            </div>
            <div class="fw-bold mb-2">
              <%= @usuario.name if @usuario.present? %>
            </div>
            <div class="mb-2">
              <%= @usuario.cargo_rol if @usuario.present? %>
            </div>
            <% if @usuario.present? %>
              <div class="mb-2">
                <%= @usuario.document.abbreviation if @usuario.document.present? %>:
                <%= Firm.miles(@usuario.nro_document) %>
              </div>
            <% end %>
            <% if @usuario.present? && @usuario.level == 2 %>
              <div class="mb-2">
                <strong>Licencia:</strong>
                <%= @usuario.license %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="conesst-actions-wrap d-flex flex-wrap justify-content-center mb-4">
    <%= link_to :back, class: "conesst-btn conesst-btn-secondary" do %>
      <i class="bi bi-arrow-left"></i>
      Retornar
    <% end %>
  </div>
</div>