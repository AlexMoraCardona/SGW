<div class="container-fluid px-2 px-md-3 mb-4">
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <!-- ==================================== ==============
     ENCABEZADO
    ================================================== -->
    <div class="card-header bg-light border-0 py-3 px-3 px-md-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <div class="d-flex align-items-center">
          <div class="bg-white rounded-circle shadow-sm p-2 me-3">
            <i class="bi bi-paperclip fs-5 text-secondary"></i>
          </div>
          <div>
            <h5 class="mb-1 fw-bold text-dark">
              Archivos adjuntos
            </h5>
            <small class="text-muted">
              Documentos y archivos asociados a esta evaluación
            </small>
          </div>
        </div>
        <% if @evaluation_rule_detail.files.attached? %>
          <span class="badge rounded-pill text-bg-secondary px-3 py-2">
            <i class="bi bi-files me-1"></i>
            <%= @evaluation_rule_detail.files.count %>
          </span>
        <% end %>
      </div>
    </div>
    <!-- ==================================================
       CONTENIDO
      ================================================== -->
    <div class="card-body p-3 p-md-4">
      <% if @evaluation_rule_detail.files.attached? %>
        <div class="row g-3">
          <% @evaluation_rule_detail.files.each do |file| %>
            <div class="col-12 col-md-6 col-xl-4">
              <div class="card h-100 border rounded-4 shadow-sm overflow-hidden">
                <!-- ==================================================
                   ARCHIVO
                   ================================================== -->
                <div class="card-body p-3">
                  <% if file.image? %>
                    <!-- IMAGEN -->
                    <div class="text-center mb-3">
                      <div class="bg-light rounded-3 p-2">
                        <%= image_tag file, data: { previews_target: "preview" }, class: "img-fluid rounded-3", style: "max-height: 280px; width: 100%; object-fit: contain;" %>
                      </div>
                    </div>
                  <% elsif file.video? %>
                    <!-- VIDEO -->
                    <div class="mb-3">
                      <div class="bg-dark rounded-3 overflow-hidden">
                        <%= video_tag url_for(file), controls: true, class: "w-100", style: "max-height: 280px;" %>
                      </div>
                    </div>
                  <% elsif file.audio? %>
                    <!-- AUDIO -->
                    <div class="text-center mb-3">
                      <div class="bg-light rounded-3 p-4">
                        <i class="bi bi-file-earmark-music display-5 text-secondary"></i>
                        <div class="mt-3">
                          <%= audio_tag url_for(file), controls: true, class: "w-100" %>
                        </div>
                      </div>
                    </div>
                  <% else %>
                    <!-- OTROS DOCUMENTOS -->
                    <div class="text-center mb-3">
                      <div class="bg-light rounded-3 p-4">
                        <% if file.content_type == "application/pdf" %>
                          <i class="bi bi-file-earmark-pdf display-4 text-danger"></i>
                        <% elsif file.content_type.to_s.include?("word") %>
                          <i class="bi bi-file-earmark-word display-4 text-primary"></i>
                        <% elsif file.content_type.to_s.include?("excel") || file.content_type.to_s.include?("spreadsheet") %>
                          <i class="bi bi-file-earmark-spreadsheet display-4 text-success"></i>
                        <% elsif file.content_type.to_s.include?("zip") || file.content_type.to_s.include?("compressed") %>
                          <i class="bi bi-file-earmark-zip display-4 text-warning"></i>
                        <% else %>
                          <i class="bi bi-file-earmark display-4 text-secondary"></i>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                  <!-- ==================================================
                     INFORMACIÓN DEL ARCHIVO
                  ================================================== -->
                  <div class="mb-3">
                    <div class="fw-semibold text-dark text-break">
                      <i class="bi bi-file-earmark me-1 text-secondary"></i>
                      <%= file.filename %>
                    </div>
                    <div class="small text-muted mt-1">
                      <%= file.content_type.presence || "Tipo de archivo no disponible" %>
                    </div>
                  </div>
                  <!-- ==================================================
                     BOTONERA
                    ================================================== -->
                  <div class="d-flex flex-wrap gap-2">
                    <!-- Descargar -->
                    <%= link_to rails_blob_path(file, disposition: "attachment"), class: "btn btn-sm btn-outline-primary rounded-pill px-3", title: "Descargar archivo" do %>
                      <i class="bi bi-download me-1"></i>
                      Descargar
                    <% end %>
                    <!-- Eliminar -->
                    <% if Current.user.level > 0 && Current.user.level < 3 %>
                      <%= link_to purge_attachment_path(file),  data: {"turbo-method": :delete, "turbo-confirm": "¿Está seguro de eliminar el archivo?"}, class: "btn btn-sm btn-outline-danger rounded-pill px-3", title: "Eliminar archivo" do %>
                        <i class="bi bi-trash me-1"></i>
                        Eliminar
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <!-- ==================================================
         ESTADO VACÍO
         ================================================== -->
        <div class="text-center py-5">
          <div class="mb-3">
            <i class="bi bi-paperclip display-5 text-muted"></i>
          </div>
          <h6 class="fw-bold text-secondary mb-1">
            No hay archivos adjuntos
          </h6>
          <p class="text-muted small mb-0">
            Esta evaluación no tiene archivos adjuntos actualmente.
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
