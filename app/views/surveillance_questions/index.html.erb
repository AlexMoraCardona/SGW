<div class="container-fluid py-3">
  <div align="left"; class="container col-12">
    <a class="navbar-brand" href="/">
        <%= image_tag 'LogoConesst202305232.png',:width => "100",  :height=>"100" %>
    </a>
  </div>

  <!-- ENCABEZADO -->
  <div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-light">

      <div class="d-flex flex-column flex-md-row
                  justify-content-between
                  align-items-md-center
                  gap-3">

        <div>

          <div class="d-flex align-items-center">

            <i class="bi bi-list-check fs-3 me-2"></i>

            <h4 class="mb-0">
              Preguntas de la encuesta
            </h4>

          </div>

          <div class="text-muted mt-1">
            <strong>
              <%= @surveillance_survey.name %>
            </strong>
          </div>

          <div class="small text-muted">
            Programa:
            <%= @epidemiological_surveillance_program.name %>
          </div>

        </div>

        <!-- NUEVA PREGUNTA -->

        <div>

          <%= link_to(
                new_epidemiological_surveillance_program_surveillance_survey_surveillance_question_path(
                  @epidemiological_surveillance_program,
                  @surveillance_survey
                ),
                class: "btn btn-primary"
              ) do %>

            <i class="bi bi-plus-circle me-1"></i>
            Nueva pregunta

          <% end %>

        </div>

      </div>

    </div>

  </div>


  <!-- LISTADO -->

  <% if @surveillance_questions.present? %>

    <div class="row g-3">

      <% @surveillance_questions.each do |question| %>

        <div class="col-12 col-md-6 col-xl-4">

          <div class="card h-100 shadow-sm border-0">

            <div class="card-body d-flex flex-column">

              <!-- ENCABEZADO DE LA PREGUNTA -->

              <div class="d-flex justify-content-between
                          align-items-start gap-2 mb-3">

                <div>

                  <span class="badge bg-dark mb-2">
                    Pregunta <%= question.position %>
                  </span>

                  <h5 class="card-title mb-0">

                    <%= question.question %>

                  </h5>

                </div>

              </div>


              <!-- TIPO -->

              <div class="mb-2">

                <strong>
                  <i class="bi bi-ui-checks me-1"></i>
                  Tipo:
                </strong>

                <% case question.question_type %>
                <% when "open_text" %>

                  <span class="badge bg-secondary">
                    Texto abierto
                  </span>

                <% when "boolean" %>

                  <span class="badge bg-info text-dark">
                    Sí / No
                  </span>

                <% when "single_choice" %>

                  <span class="badge bg-primary">
                    Selección única
                  </span>

                <% when "multiple_choice" %>

                  <span class="badge bg-success">
                    Selección múltiple
                  </span>

                <% end %>

              </div>


              <!-- OPCIONES -->

              <% if question.question_type.in?(
                   ["single_choice", "multiple_choice"]
                 ) %>

                <div class="small text-muted mb-2">

                  <i class="bi bi-list-ul me-1"></i>

                  <strong>
                    Opciones:
                  </strong>

                  <%= question.surveillance_question_options.size %>

                </div>

              <% end %>


              <!-- REQUERIDA -->

              <div class="small mb-2">

                <strong>
                  <i class="bi bi-asterisk me-1"></i>
                  Obligatoria:
                </strong>

                <% if question.required? %>

                  <span class="badge bg-success">
                    Sí
                  </span>

                <% else %>

                  <span class="badge bg-secondary">
                    No
                  </span>

                <% end %>

              </div>


              <!-- ESTADO -->

              <div class="small mb-3">

                <strong>
                  <i class="bi bi-toggle-on me-1"></i>
                  Estado:
                </strong>

                <% if question.active? %>

                  <span class="badge bg-success">
                    Activa
                  </span>

                <% else %>

                  <span class="badge bg-secondary">
                    Inactiva
                  </span>

                <% end %>

              </div>


              <!-- BOTONERA -->

              <div class="mt-auto">

                <div class="d-flex flex-wrap
                            justify-content-center
                            gap-2">

                  <!-- VER -->

                  <%= link_to(
                        epidemiological_surveillance_program_surveillance_survey_surveillance_question_path(
                          @epidemiological_surveillance_program,
                          @surveillance_survey,
                          question
                        ),
                        class: "btn btn-outline-primary btn-sm",
                        title: "Ver pregunta"
                      ) do %>

                    <i class="bi bi-eye"></i>
                    Ver

                  <% end %>


                  <!-- EDITAR -->

                  <%= link_to(
                        edit_epidemiological_surveillance_program_surveillance_survey_surveillance_question_path(
                          @epidemiological_surveillance_program,
                          @surveillance_survey,
                          question
                        ),
                        class: "btn btn-outline-secondary btn-sm",
                        title: "Editar pregunta"
                      ) do %>

                    <i class="bi bi-pencil"></i>
                    Editar

                  <% end %>


                  <!-- OPCIONES -->

                  <% if question.question_type.in?(
                       ["single_choice", "multiple_choice"]
                     ) %>

<%= link_to(
      epidemiological_surveillance_program_surveillance_survey_surveillance_question_surveillance_question_options_path(
        @epidemiological_surveillance_program,
        @surveillance_survey,
        question
      ),
      class: "btn btn-outline-success btn-sm",
      title: "Administrar opciones"
    ) do %>

  <i class="bi bi-list-ul"></i>
  Opciones

<% end %>
                  <% end %>


                  <!-- ELIMINAR -->

                  <%= button_to(
                        epidemiological_surveillance_program_surveillance_survey_surveillance_question_path(
                          @epidemiological_surveillance_program,
                          @surveillance_survey,
                          question
                        ),
                        method: :delete,
                        class: "btn btn-outline-danger btn-sm",
                        form: {
                          data: {
                            turbo_confirm:
                              "¿Está seguro de eliminar esta pregunta?"
                          }
                        },
                        title: "Eliminar pregunta"
                      ) do %>

                    <i class="bi bi-trash"></i>
                    Eliminar

                  <% end %>

                </div>

              </div>

            </div>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <!-- SIN PREGUNTAS -->

    <div class="card shadow-sm border-0">

      <div class="card-body text-center py-5">

        <i class="bi bi-question-circle display-4 text-muted"></i>

        <h5 class="mt-3">
          No hay preguntas registradas
        </h5>

        <p class="text-muted">
          Esta encuesta todavía no tiene preguntas configuradas.
        </p>

        <%= link_to(
              new_epidemiological_surveillance_program_surveillance_survey_surveillance_question_path(
                @epidemiological_surveillance_program,
                @surveillance_survey
              ),
              class: "btn btn-primary"
            ) do %>

          <i class="bi bi-plus-circle me-1"></i>
          Crear primera pregunta

        <% end %>

      </div>

    </div>

  <% end %>


  <!-- VOLVER -->

  <div class="d-flex justify-content-center mt-4">

    <%= link_to(
          epidemiological_surveillance_program_surveillance_surveys_path(
            @epidemiological_surveillance_program
          ),
          class: "btn btn-outline-primary"
        ) do %>

      <i class="bi bi-arrow-left me-1"></i>
      Volver a encuestas

    <% end %>

  </div>

</div>