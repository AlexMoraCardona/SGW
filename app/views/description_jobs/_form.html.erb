<div class="conesst-page" style="width: 100%; max-width: 100%; min-width: 0; box-sizing: border-box;">
  <%= form_with model: @description_job do |form| %>
    <% if @description_job.errors.any? %>
      <div class="alert alert-danger" role="alert">
        <h6 class="fw-bold">
          <i class="bi bi-exclamation-triangle me-2"></i>
          No fue posible guardar la descripción del cargo
        </h6>
        <ul class="mb-0 ps-3">
          <% @description_job.errors.full_messages.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <div class="conesst-card-header-content">
          <div style="min-width: 0;">
            <h5 class="conesst-card-header-title">
              <i class="bi bi-briefcase me-2"></i>
              Información general del cargo
            </h5>
            <p class="conesst-card-header-subtitle mb-0">
              Identificación, área y estado de la descripción.
            </p>
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <div class="row g-3">
          <div class="col-12 col-md-4">
            <%= form.label :state_job, class: "form-label fw-semibold" %>
            <%= form.select :state_job,
                [['NO VIGENTE', 0], ['VIGENTE', 1]],
                {},
                { class: "form-select" } %>
          </div>
          <div class="col-12 col-md-8">
            <%= form.label :name_job, class: "form-label fw-semibold" %>
            <%= form.text_field :name_job, class: "form-control", placeholder: "Nombre del cargo" %>
          </div>
          <div class="col-12 col-md-6">
            <%= form.label :area, "Área", class: "form-label fw-semibold" %>
            <% if @company_areas.present? %>
              <%= form.collection_select :area, @company_areas, :id, :name, { prompt: "-- Seleccione el área --" }, { class: "form-select" } %>
            <% else %>
              <div class="form-control bg-light text-muted">
                No hay áreas disponibles.
              </div>
            <% end %>
          </div>
          <div class="col-12 col-md-6">
            <%= form.label :immediate_boss, class: "form-label fw-semibold" %>
            <%= form.text_field :immediate_boss, class: "form-control", placeholder: "Nombre del jefe inmediato" %>
          </div>
          <div class="col-12">
            <%= form.label :objetive_job, "Objetivo del cargo", class: "form-label fw-semibold" %>
            <%= form.text_area :objetive_job, class: "form-control", rows: 3, placeholder: "Describe el objetivo principal del cargo" %>
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <div class="conesst-card-header-content">
          <div style="min-width: 0;">
            <h5 class="conesst-card-header-title">
              <i class="bi bi-person-vcard me-2"></i>
              Perfil del cargo
            </h5>
            <p class="conesst-card-header-subtitle mb-0">
              Formación, experiencia, condiciones y competencias requeridas.
            </p>
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <%= form.label :academic_training, class: "form-label fw-semibold" %>
            <%= form.text_field :academic_training, class: "form-control", placeholder: "Formación académica requerida" %>
          </div>
          <div class="col-12 col-md-6">
            <%= form.label :experience, class: "form-label fw-semibold" %>
            <%= form.text_field :experience, class: "form-control", placeholder: "Experiencia requerida" %>
          </div>
          <div class="col-12 col-md-6">
            <%= form.label :salary_range, class: "form-label fw-semibold" %>
            <%= form.text_field :salary_range, class: "form-control", placeholder: "Rango salarial" %>
          </div>
          <div class="col-12 col-md-6">
            <%= form.label :type_contract, class: "form-label fw-semibold" %>
            <%= form.text_field :type_contract, class: "form-control", placeholder: "Tipo de contrato" %>
          </div>
          <div class="col-12">
            <%= form.label :working_hours, class: "form-label fw-semibold" %>
            <%= form.text_field :working_hours, class: "form-control",  placeholder: "Horario o jornada laboral" %>
          </div>
          <div class="col-12">
            <%= form.label :required_knowledge, class: "form-label fw-semibold" %>
            <%= form.rich_text_area :required_knowledge, class: "form-control" %>
          </div>
          <div class="col-12">
            <%= form.label :competencies, class: "form-label fw-semibold" %>
            <%= form.rich_text_area :competencies, class: "form-control" %>
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <div class="conesst-card-header-content">
          <div style="min-width: 0;">
            <h5 class="conesst-card-header-title">
              <i class="bi bi-list-check me-2"></i>
              Funciones y responsabilidades
            </h5>
            <p class="conesst-card-header-subtitle mb-0">
              Actividades y responsabilidades asociadas al cargo.
            </p>
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <div class="mb-4">
          <%= form.label :job_functions, "Funciones del cargo", class: "form-label fw-semibold" %>
          <%= form.rich_text_area :job_functions, class: "form-control" %>
        </div>
        <div>
          <%= form.label :roles_responsibilities, "Roles y responsabilidades de Seguridad y Salud en el Trabajo", class: "form-label fw-semibold" %>
          <%= form.rich_text_area :roles_responsibilities, class: "form-control" %>
        </div>
      </div>
    </div>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <div class="conesst-card-header-content">
          <div style="min-width: 0;">
            <h5 class="conesst-card-header-title">
              <i class="bi bi-shield-check me-2"></i>
              Seguridad y salud en el trabajo
            </h5>
            <p class="conesst-card-header-subtitle mb-0">
              Peligros, riesgos asociados y elementos de protección personal.
            </p>
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <div class="mb-4">
          <%= form.label :risks_steps, "Peligros y riesgos asociados", class: "form-label fw-semibold" %>
          <%= form.grouped_collection_select(:risks_steps, ClasificationDanger.order(:name), :clasification_danger_details, :name, :id, :name, { prompt: "Seleccione los peligros y riesgos" }, { multiple: true, class: "form-select", style: "min-height: 130px;" }) %>
          <div class="form-text">
            Puedes seleccionar varios peligros y riesgos.
          </div>
        </div>
        <div>
          <%= label_tag :epp_requested, "Elementos de Protección Personal", class: "form-label fw-semibold" %>
          <%= select_tag :epp_requested, options_from_collection_for_select(@protection_elements, :id, :name, @description_job.try(:epp_requested)), multiple: true, class: "form-select select2 w-100", prompt: "-- Seleccione los EPP --" %>
          <div class="form-text">
            Selecciona los elementos de protección personal requeridos para el cargo.
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <div class="conesst-card-header-content">
          <div style="min-width: 0;">
            <h5 class="conesst-card-header-title">
              <i class="bi bi-heart-pulse me-2"></i>
              Evaluaciones médicas ocupacionales
            </h5>
            <p class="conesst-card-header-subtitle mb-0">
              Tipos de evaluación y énfasis médicos requeridos.
            </p>
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <%= form.label :type_evaluation, "Tipo de evaluación", class: "form-label fw-semibold" %>
            <%= form.rich_text_area :type_evaluation, class: "form-control" %>
          </div>
          <div class="col-12 col-md-6">
            <%= form.label :enfasis, "Énfasis", class: "form-label fw-semibold" %>
            <%= form.rich_text_area :enfasis, class: "form-control" %>
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <div class="conesst-card-header-content">
          <div style="min-width: 0;">
            <h5 class="conesst-card-header-title">
              <i class="bi bi-chat-left-text me-2"></i>
              Observaciones
            </h5>
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <%= form.label :observations, "Observaciones adicionales", class: "form-label fw-semibold" %>
        <%= form.text_area :observations, class: "form-control", rows: 4, placeholder: "Escribe aquí las observaciones adicionales del cargo" %>
      </div>
    </div>
    <div class="conesst-card mb-4">
      <div class="conesst-card-header">
        <div class="conesst-card-header-content">
          <div style="min-width: 0;">
            <h5 class="conesst-card-header-title">
              <i class="bi bi-people me-2"></i>
              Responsables de la descripción
            </h5>
            <p class="conesst-card-header-subtitle mb-0">
              Selecciona las personas responsables de elaborar, revisar y aprobar.
            </p>
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <div class="row g-3">
          <div class="col-12 col-md-4">
            <%= form.label :user_elaboro, "Elaboró", class: "form-label fw-semibold" %>
            <%= form.collection_select :user_elaboro, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccione el responsable --" }, { class: "form-select" } %>
          </div>
          <div class="col-12 col-md-4">
            <%= form.label :user_reviso, "Revisó", class: "form-label fw-semibold" %>
            <%= form.collection_select :user_reviso, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccione el responsable --" }, { class: "form-select" } %>
          </div>
          <div class="col-12 col-md-4">
            <%= form.label :user_aprobo, "Aprobó", class: "form-label fw-semibold" %>
            <%= form.collection_select :user_aprobo, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccione el responsable --" }, { class: "form-select" } %>
          </div>
        </div>
      </div>
    </div>
    <% if params[:entity_id].present? %>
      <%= form.hidden_field :entity_id,  value: params[:entity_id].to_i %>
    <% elsif @entity&.id.present? %>
      <%= form.hidden_field :entity_id, value: @entity.id %>
    <% end %>
    <div class="conesst-card mb-4">
      <div class="conesst-card-body">
        <div class="conesst-actions">
          <button type="submit" class="conesst-btn conesst-btn-primary">
            <i class="bi bi-check-circle me-2"></i>
            <%= t('common.submit') %>
          </button>
          <%= link_to :back, class: "conesst-btn", style: "background-color: #6c757d; color: #fff; text-decoration: none;" do %>
            <i class="bi bi-arrow-left me-2"></i>
            Retornar
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>