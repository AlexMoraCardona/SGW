<div class="conesst-page">
    <!-- Retornar -->
    <div class="conesst-actions mb-3">
        <%= link_to request.referer || root_path, class: "conesst-btn" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
        <% end %>
    </div>
  <%= link_to ver_inspeccion_pdf_path(@safety_inspection.id, format: 'pdf'), class: "conesst-btn conesst-btn-success" do %>
    <i class="bi bi-file-earmark-pdf me-1"></i>
    Ver informe PDF
  <% end %>

    <!-- Información de la inspección -->
    <div class="conesst-card">
        <div class="conesst-card-header">
            <div>
                <h5 class="mb-0">
                    <i class="bi bi-clipboard-check me-1"></i>
                    Información de la Inspección
                </h5>
            </div>
        </div>

        <div class="conesst-card-body">

            <div class="row g-3">

                <!-- Fecha -->
                <div class="col-12 col-lg-6">
                    <div class="border rounded p-3 h-100">

                        <div class="fw-bold text-secondary mb-2">
                            <i class="bi bi-calendar3 me-1"></i>
                            Fecha de realización de la inspección
                        </div>

                        <div>
                            <%= @safety_inspection.date_inspection if @safety_inspection.present? %>
                        </div>

                    </div>
                </div>


                <!-- Lugar -->
                <div class="col-12 col-lg-6">
                    <div class="border rounded p-3 h-100">

                        <div class="fw-bold text-secondary mb-2">
                            <i class="bi bi-geo-alt me-1"></i>
                            Lugar de la inspección
                        </div>

                        <div>
                            <%= @safety_inspection.place_inspection if @safety_inspection.present? %>
                        </div>

                    </div>
                </div>


                <!-- Área -->
                <div class="col-12">
                    <div class="border rounded p-3">

                        <div class="fw-bold text-secondary mb-2">
                            <i class="bi bi-building me-1"></i>
                            Área de trabajo a inspeccionar
                        </div>

                        <div>
                            <%= @safety_inspection.area_inspection if @safety_inspection.present? %>
                        </div>

                    </div>
                </div>

            </div>

        </div>
    </div>


    <!-- Contenido de la inspección -->
    <div class="conesst-card mt-3">

        <div class="conesst-card-body">

            <!-- Convenciones -->
            <div class="alert alert-info mb-4">

                <div class="fw-semibold mb-2">
                    <i class="bi bi-info-circle me-1"></i>
                    Convenciones de cumplimiento
                </div>

                <div class="d-flex flex-column flex-md-row gap-2 gap-md-4">

                    <span>
                        <strong>SI:</strong>
                        Cumple totalmente
                    </span>

                    <span>
                        <strong>NO:</strong>
                        No cumple
                    </span>

                    <span>
                        <strong>PARCIAL:</strong>
                        Cumple parcialmente.
                        Especifique en observaciones cuáles no cumplen.
                    </span>

                </div>

            </div>


            <% tipos_inspeccion = {
                1  => "GENERAL: PASILLOS, ESCALERAS Y ÁREAS COMUNES - CONDICIONES DE ORDEN Y ASEO",
                2  => "CONDICIONES LOCATIVAS",
                3  => "OFICINAS Y/O BODEGAS - CONDICIONES DE CARGA FÍSICA",
                4  => "CONDICIONES LOCATIVAS",
                5  => "CONDICIONES ORDEN Y ASEO",
                6  => "CONDICIONES FÍSICAS",
                7  => "CONDICIONES ELÉCTRICAS",
                8  => "ALMACENAMIENTO DE MATERIALES",
                9  => "PRODUCTOS QUÍMICOS Y SUSTANCIAS PELIGROSAS",
                10 => "SANEAMIENTO BÁSICO",
                11 => "PLAN DE EMERGENCIAS",
                12 => "ELEMENTOS DE PROTECCIÓN PERSONAL",
                13 => "ENTORNO AMBIENTAL"
            } %>


            <% tipos_inspeccion.each do |tipo_id, titulo| %>

                <div class="conesst-card mb-3">

                    <div class="conesst-card-header">

                        <div class="fw-semibold">
                            <i class="bi bi-list-check me-1"></i>
                            <%= titulo %>
                        </div>

                    </div>


                    <div class="conesst-card-body p-0">

                        <div class="conesst-table-wrapper">

                            <table class="conesst-table table-hover">

                                <thead>
                                    <tr>

                                        <th scope="col">
                                            Situación o condición a inspeccionar
                                        </th>

                                        <th scope="col">
                                            Cumplimiento
                                        </th>

                                        <th scope="col">
                                            Observaciones
                                        </th>

                                    </tr>
                                </thead>


                                <tbody>

                                    <% if @safety_inspection_items.present? %>

                                        <% @safety_inspection_items.each do |safety_inspection_item| %>

                                            <% if safety_inspection_item.situation_condition.type_condition_inspection.id == tipo_id %>

                                                <tr>

                                                    <td data-label="Situación o condición">
                                                        <%= safety_inspection_item.situation_condition.name %>
                                                    </td>


                                                    

<td data-label="Cumplimiento">

  <% if safety_inspection_item.state_compliance.to_i == 0 %>

    <span class="badge bg-secondary">
      N/A
    </span>

  <% elsif safety_inspection_item.state_compliance.to_i == 1 %>

    <span class="badge bg-success">
      SI
    </span>

  <% elsif safety_inspection_item.state_compliance.to_i == 2 %>

    <span class="badge bg-danger">
      NO
    </span>

  <% elsif safety_inspection_item.state_compliance.to_i == 3 %>

    <span class="badge bg-warning text-dark">
      PARCIAL
    </span>

  <% else %>

    <span class="badge bg-light text-dark border">
      SIN DEFINIR
    </span>

  <% end %>

</td>
                                                   


                                                    <td data-label="Observaciones">

                                                        <% if safety_inspection_item.observation.present? %>

                                                            <%= safety_inspection_item.observation %>

                                                        <% else %>

                                                            <span class="text-muted">
                                                                Sin observaciones
                                                            </span>

                                                        <% end %>

                                                    </td>

                                                </tr>

                                            <% end %>

                                        <% end %>

                                    <% else %>

                                        <tr>

                                            <td colspan="3" class="text-center text-muted py-4">

                                                <i class="bi bi-inbox me-1"></i>
                                                No existen registros para mostrar.

                                            </td>

                                        </tr>

                                    <% end %>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            <% end %>


            <!-- Observaciones generales -->
            <div class="conesst-card mt-3">

                <div class="conesst-card-header">

                    <div class="fw-semibold">
                        <i class="bi bi-chat-left-text me-1"></i>
                        Observaciones generales
                    </div>

                </div>

                <div class="conesst-card-body">

                    <%= @safety_inspection.productivity_affectation if @safety_inspection.present? %>

                </div>

            </div>


            <!-- Nota -->
            <div class="alert alert-warning mt-3 mb-0">

                <div class="fw-semibold">

                    <i class="bi bi-exclamation-triangle me-1"></i>

                    NOTA

                </div>

                <div class="mt-1">

                    LAS SITUACIONES O CONDICIONES INSPECCIONADAS QUE NO CUMPLEN
                    O SON PARCIALES, DEBEN SER REPORTADAS AL RESPONSABLE DEL
                    SG-SST PARA SUS RESPECTIVAS MEDIDAS DE CONTROL.

                </div>

            </div>

        </div>

    </div>


    <!-- Firma del responsable -->
    <div class="conesst-card mt-3">

        <div class="conesst-card-header">

            <div class="text-center w-100">

                <h5 class="mb-0">
                    <i class="bi bi-pen me-1"></i>
                    Firma del responsable de la inspección
                </h5>

            </div>

        </div>


        <div class="conesst-card-body">

            <div class="row justify-content-center">

                <div class="col-12 col-lg-8 text-center">


                    <!-- Nombre -->
                    <div class="mb-4">

                        <div class="fw-semibold text-secondary mb-1">
                            Nombre
                        </div>

                        <div>
                            <%= @user_responsable.name if @user_responsable.present? %>
                        </div>

                    </div>


                    <!-- Cargo -->
                    <div class="mb-4">

                        <div class="fw-semibold text-secondary mb-1">
                            Cargo
                        </div>

                        <div>
                            <%= @user_responsable.cargo_rol if @user_responsable.present? %>
                        </div>

                    </div>


                    <!-- Firma -->
                    <div class="mb-4">

                        <div class="fw-semibold text-secondary mb-2">
                            Firma
                        </div>


                        <% if @safety_inspection.firm_responsible == 1 %>

                            <% if @user_responsable.firm.attached? %>

                                <% if @user_responsable.firm.image? %>

                                    <div class="mt-3">

                                        <%= image_tag @user_responsable.firm,
                                                      class: "img-fluid",
                                                      style: "max-height:150px;" %>

                                    </div>

                                <% end %>

                            <% else %>

                                <div class="border rounded p-4 text-center text-muted">

                                    <i class="bi bi-pen me-1"></i>
                                    No existe firma registrada.

                                </div>

                            <% end %>

                        <% else %>

                            <div class="border-bottom mt-5"></div>

                        <% end %>

                    </div>


                    <!-- Documento -->
                    <div class="mb-3">

                        <%= @user_responsable.document.abbreviation %>:
                        <%= Firm.miles(@user_responsable.nro_document) %>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Retornar -->
    <div class="conesst-actions mt-3">

        <%= link_to request.referer || root_path,
                    class: "conesst-btn" do %>

            <i class="bi bi-arrow-left me-1"></i>
            Retornar

        <% end %>

    </div>

</div>