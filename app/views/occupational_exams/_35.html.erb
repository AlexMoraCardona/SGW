<div class="row">
    <div class="col-12 col-md-6">
        <% if @occupational_exam.present? %>  
            <%= form_with url: occupational_exam_path(@occupational_exam.id), method: :get do |form| %>
                <h5 scope="col">Filtrar por Empleado: </h5>
                <%= form.collection_select :user_application, @empleados, :id, :name, { prompt: '--Seleccionar Empleado--' },
                    { class: 'form-control input-sm select2' , onChange: 'this.form.requestSubmit()', value: params[:id] } if @empleados.present? %>
                    <%= form.hidden_field :entity_id, :value => @occupational_exam.entity_id, class: "form-control" if @occupational_exam.present? %>
                <% end %> 
            <% end %>     
    </div>  
    <div class="col-12 col-md-6">
        <% if @occupational_exam.present? %> 
                <%= form_with url: occupational_exam_path(@occupational_exam.id), method: :get do |form| %>
                    <h5 scope="col">Filtrar Estado:</h5>
                    <%= form.select :state_exam,[['Todos'],['Pendiente'], ['Realizado'], ['Cancelado']],{ prompt: '--Seleccionar--' },
                    { class: 'form-control input-sm select2' , onChange: 'this.form.requestSubmit()', value: params[:state_exam] }  %>
                    <%= form.hidden_field :entity_id, :value => @occupational_exam.entity_id, class: "form-control" if @occupational_exam.present? %>
                <% end %> 
            <% end %>     
    </div>
</div>         
<div class="card shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>FECHA EXAMEN</th>
                        <th>FECHA DE VENCIMIENTO</th>
                        <th>TIPO DE EXAMEN</th>
                        <th>APELLIDOS Y NOMBRES  </th>
                        <th>CARGO  </th>
                        <th>CONCEPTO  </th>
                        <th>DIRECCIONAMIENTO A EPS, ARL, o IPS   </th>
                        <th>RECOMENDACIONES MEDICAS  </th>
                        <th>RESTRICCIONES MEDICAS  </th>
                        <th>ESTADO DEL EXAMEN</th>
                        <th>ÉNFASIS</th>
                        <th>EDITAR</th>
                        <th>ELIMINAR</th>
                    </tr>   
                </thead>
                <% @occupational_exam_items.each do |occupational_exam_item| %>             
                    <tbody>
                        <tr>
                            <td><%= occupational_exam_item.fec_exam %></td>
                            <td><%= occupational_exam_item.fec_venc %></td>
                            <td><%= occupational_exam_item.label_exam_type(occupational_exam_item.exam_type) %></td>
                            <td><%= occupational_exam_item.name %></td>
                            <td><%= occupational_exam_item.post %></td>
                            <td><%= occupational_exam_item.concept %></td>
                            <td><%= occupational_exam_item.addressing %></td>
                            <td><%= occupational_exam_item.recommendations %></td>
                            <td><%= occupational_exam_item.restrictions %></td>
                            <td><%= OccupationalExamItem.label_state_exam(occupational_exam_item.state_exam) %></td>
                            <td><%= occupational_exam_item.emphasis %></td>
                            <td style=" text-align:center;">
                                <% if Current.user.level > 0 && Current.user.level < 4 %>
                                    <%= link_to edit_occupational_exam_item_path(occupational_exam_item), class:"btn btn-warning btn-sm" do %>
                                        <i class="bi bi-pencil-square"></i>
                                    <% end %>                    
                                <% end %>    
                            </td>
                            <td style="text-align:center;">
                                <% if Current.user.level > 0 && Current.user.level < 4 %>
                                    <%= button_to occupational_exam_item_path(occupational_exam_item), method: :delete, class:"btn btn-danger btn-sm", form: {data: {turbo_confirm:"¿Desea eliminar este registro? Esta acción no se puede deshacer."}} do %>
                                        <i class="bi bi-trash"></i>
                                    <% end %>
                                <% end %>    
                            </td>
                        </tr> 
                    </body>
                <% end %>
            </table>
        </div>
    </div>
    <hr class="my-5">
</div>
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <%= link_to occupational_exams_path(entity_id: @occupational_exam.entity.id), class:"btn btn-secondary" do %>
                <i class="bi bi-arrow-left-circle"></i>Retornar
            <% end %>
            <%= link_to ver_occupational_occupational_exams_path(@occupational_exam.id, format: 'pdf'), class:"btn btn-danger" do %>
                <i class="bi bi-file-earmark-pdf"></i>PDF
            <% end %> 
        </div>
    </div>
</div>
