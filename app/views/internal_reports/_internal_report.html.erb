<style>
.internal-report-actions {
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  width: 100%;
  margin-top: 12px;
}

.internal-report-actions > a,
.internal-report-actions > form {
  display: flex !important;
  width: 100%;
  min-width: 0;
  margin: 0 !important;
}

.internal-report-actions > a,
.internal-report-actions > form > button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  width: 100%;
  min-height: 42px;
  padding: 9px 6px;
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
  font-size: 0.85rem;
}

@media (min-width: 768px) {
  .internal-report-index .internal-report-actions {
    display: flex !important;
    flex-wrap: wrap;
    justify-content: center;
  }

  .internal-report-index .internal-report-actions > a,
  .internal-report-index .internal-report-actions > form {
    width: auto;
  }
}
</style>
<% if @entity.present? %>
    <div class="conesst-company-header">
        <div class="conesst-company-icon">
            <i class="bi bi-building"></i>
        </div>
        <div class="flex-grow-1">
            <h5 class="conesst-company-title">
                <%= @entity.business_name %>
            </h5>
            <div class="conesst-company-nit">
                <strong>NIT:</strong>
                <%= EvaluationRuleDetail.miles(@entity.identification_number) if @entity.identification_number.present? %><%= "-#{@entity.verification_digit}" if @entity.verification_digit.present? %>
            </div>
        </div>
    </div>
<% end %>
<% if Current.user.level > 0 && Current.user.level < 4 %>
    <div class="d-flex justify-content-center justify-content-md-start mb-3">
        <%= link_to new_internal_report_path, class: "conesst-btn conesst-btn-primary" do %>
            <i class="bi bi-plus-circle"></i>
            Crear reporte
        <% end %>
    </div>
<% end %>
<% if @internal_reports.present? %>
    <% if Current.user.level > 0 && Current.user.level < 4 %>
        <% reports_to_display = @internal_reports %>
    <% else %>
        <% reports_to_display = @internal_reports.select { |report| report.user == Current.user.id } %>
    <% end %>
    <% if reports_to_display.present? %>
        <div class="d-none d-md-block">
            <div class="conesst-table-wrapper">
                <table class="table conesst-table">
                    <thead>
                        <tr>
                            <th>Fecha investigación</th>
                            <th>Tipo de evento</th>
                            <th>Empleado</th>
                            <th class="text-center">Firma</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% reports_to_display.each do |internal_report| %>
                            <tr>
                                <td>
                                    <%= internal_report.date_report.strftime("%Y-%m-%d") if internal_report.date_report.present? %>
                                </td>
                                <td>
                                    <%= InternalReport.label_type_report(internal_report.type_report) %>
                                </td>
                                <td>
                                    <%= internal_report.name_person %>
                                </td>
                                <td class="text-center">
                                    <% if internal_report.firm_user.to_i == 0 %>
                                        <%= link_to firma_internal_report_path(internal_report.id), class: "conesst-btn conesst-btn-warning" do %>
                                            <i class="bi bi-pen"></i>
                                            <%= t('common.firmar') %>
                                        <% end %>
                                    <% else %>
                                        <span class="conesst-signed">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            <%= internal_report.date_user.strftime("%Y-%m-%d") if internal_report.date_user.present? %>
                                        </span>
                                    <% end %>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap justify-content-center gap-2 conesst-actions-wrap">
                                        <%= link_to internal_report_path(internal_report), class: "conesst-btn conesst-btn-primary" do %>
                                            <i class="bi bi-eye"></i>
                                            Ver
                                        <% end %>
                                        <%= link_to edit_internal_report_path(internal_report.id), class: "conesst-btn conesst-btn-warning" do %>
                                            <i class="bi bi-pencil-square"></i>
                                            Editar
                                        <% end %>
                                        <%= button_to internal_report, method: :delete, class: "conesst-btn conesst-btn-danger", form: { class: "d-inline" }, data: {turbo_confirm: "¿Está seguro de eliminar este reporte?"} do %>
                                            <i class="bi bi-trash"></i>
                                            Eliminar
                                        <% end %>
                                        <%= link_to ver_reporte_interno_path(internal_report.id, format: :pdf), class: "conesst-btn conesst-btn-success" do %>
                                            <i class="bi bi-file-earmark-pdf"></i>
                                            PDF
                                        <% end %>
                                    </div>
                                </td>
                            </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="d-md-none">
            <% reports_to_display.each do |internal_report| %>
                <div class="conesst-card conesst-audit-card mb-3">
                    <%# Encabezado de cada reporte %>
                    <div class="conesst-card-header">
                        <div class="conesst-audit-header">
                            <div class="flex-grow-1">
                                <div class="conesst-audit-label">
                                    REPORTE DE ACCIDENTE O INCIDENTE
                                </div>
                                <div class="fw-bold text-break">
                                    <i class="bi bi-person me-1"></i>
                                    <%= internal_report.name_person.presence || "Empleado sin nombre" %>
                                </div>
                            </div>
                            <% if internal_report.date_report.present? %>
                                <div class="conesst-audit-date">
                                    <i class="bi bi-calendar3"></i>
                                    <%= internal_report.date_report.strftime("%Y-%m-%d") %>
                                </div>
                            <% end %>
                        </div>
                    </div>
                    <%# Información del reporte %>
                    <div class="conesst-card-body">
                        <div class="conesst-info-card mb-3">
                            <div class="conesst-info-card-title">
                                <i class="bi bi-clipboard2-pulse"></i>
                                Información del evento
                            </div>
                            <div class="conesst-data-label">
                                Tipo de evento
                            </div>
                            <div class="conesst-data-value text-break">
                                <%= InternalReport.label_type_report(internal_report.type_report) %>
                            </div>
                        </div>
                        <%# Estado de firma %>
                        <div class="conesst-info-card mb-3">
                            <div class="conesst-info-card-title">
                                <i class="bi bi-pen"></i>
                                Estado de firma
                            </div>
                            <% if internal_report.firm_user.to_i == 0 %>
                                <%= link_to firma_internal_report_path(internal_report.id), class: "conesst-btn conesst-btn-warning" do %>
                                    <i class="bi bi-pen"></i>
                                    <%= t('common.firmar') %>
                                <% end %>
                            <% else %>
                                <div class="conesst-signed">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Firmado
                                    <% if internal_report.date_user.present? %>
                                        - <%= internal_report.date_user.strftime("%Y-%m-%d") %>
                                    <% end %>
                                </div>
                            <% end %>
                        </div>
                        <%# Acciones del reporte %>
                        <h6 class="conesst-section-title">
                            <div>
                                <i class="bi bi-gear"></i>
                                Acciones del reporte
                            </div>
                        </h6>
                        <div class="internal-report-actions">
                            <%= link_to internal_report_path(internal_report), class: "conesst-btn conesst-btn-primary" do %>
                                <i class="bi bi-eye"></i>
                                Ver
                            <% end %>
                            <%= link_to edit_internal_report_path(internal_report.id), class: "conesst-btn conesst-btn-warning" do %>
                                <i class="bi bi-pencil-square"></i>
                                Editar
                            <% end %>
                            <%= button_to internal_report, method: :delete, class: "conesst-btn conesst-btn-danger", form: { class: "d-inline" }, data: {turbo_confirm: "¿Está seguro de eliminar este reporte?"} do %>
                                <i class="bi bi-trash"></i>
                                Eliminar
                            <% end %>
                            <%= link_to ver_reporte_interno_path(internal_report.id, format: :pdf), class: "conesst-btn conesst-btn-success" do %>
                                <i class="bi bi-file-earmark-pdf"></i>
                                PDF
                            <% end %>
                        </div>
                    </div>
                </div>
            <% end %>
        </div>
    <% else %>
        <div class="conesst-empty">
            <i class="bi bi-clipboard-x"></i>
            <h4>Sin reportes disponibles</h4>
            <p>No hay reportes internos para mostrar.</p>
        </div>
    <% end %>
<% else %>
    <div class="conesst-empty">
        <i class="bi bi-clipboard-x"></i>
        <h4>Sin reportes registrados</h4>
        <p>Aún no se han registrado reportes internos.</p>
    </div>
<% end %>