<div class="container-fluid py-3">
  <!-- ENCABEZADO -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="d-flex align-items-center">
          <i class="bi bi-gear-wide-connected fs-3 me-2"></i>
          <div>
            <h4 class="mb-0">
              Configuraciones SVE
            </h4>
            <small class="text-muted">
              Plantillas para programas de vigilancia epidemiológica
            </small>
          </div>
        </div>
        <div class="d-flex flex-wrap justify-content-center justify-content-md-end gap-2">
          <%= link_to new_surveillance_configuration_path, class: "btn btn-primary" do %>
            <i class="bi bi-plus-circle me-1"></i>
            Nueva configuración
          <% end %>
          <%= link_to epidemiological_surveillance_programs_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Programas SVE
          <% end %>
        </div>
      </div>
    </div>
  </div>


  <!-- LISTADO -->
  <div class="card shadow-sm border-0">
    <div class="card-body">
      <% if @surveillance_configurations.present? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Configuración</th>
                <th class="text-center">
                  Preguntas
                </th>
                <th class="text-center">
                  Estado
                </th>
                <th class="text-center">
                  Acciones
                </th>
              </tr>
            </thead>
            <tbody>
              <% @surveillance_configurations.each do |configuration| %>
                <tr>
                  <!-- NOMBRE -->
                  <td>
                    <div class="fw-semibold">
                      <i class="bi bi-gear me-1"></i>
                      <%= configuration.name %>
                    </div>
                  </td>
                  <!-- PREGUNTAS -->
                  <td class="text-center">
                    <span class="badge bg-secondary">
                      <%= configuration.surveillance_configuration_questions.size %>
                    </span>
                  </td>
                  <!-- ESTADO -->
                  <td class="text-center">
                    <% if configuration.active? %>
                      <span class="badge bg-success">
                        <i class="bi bi-check-circle me-1"></i>
                        Activa
                      </span>
                    <% else %>
                      <span class="badge bg-secondary">
                        <i class="bi bi-x-circle me-1"></i>
                        Inactiva
                      </span>
                    <% end %>
                  </td>
                  <!-- ACCIONES -->
                  <td>
                    <div class="d-flex flex-wrap justify-content-center gap-1">
                      <%= link_to configuration, class: "btn btn-sm btn-outline-primary", title: "Ver configuración" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>
                      <%= link_to edit_surveillance_configuration_path(configuration), class: "btn btn-sm btn-outline-warning", title: "Editar configuración" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                      <%= link_to configuration,  data: {turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar esta configuración?"}, class: "btn btn-sm btn-outline-danger", title: "Eliminar configuración" do %>
                        <i class="bi bi-trash"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-gear-wide-connected display-5 text-muted"></i>
          <h5 class="mt-3">
            No hay configuraciones SVE
          </h5>
          <p class="text-muted">
            Cree la primera configuración para comenzar a definir las preguntas de los programas SVE.
          </p>

          <%= link_to new_surveillance_configuration_path, class: "btn btn-primary" do %>
            <i class="bi bi-plus-circle me-1"></i>
            Crear configuración
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
