<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-pen fs-5"></i>
        <div>
          <h4 class="mb-0">Firma del Usuario Responsable</h4>
          <small class="text-muted">
            Autorización de la firma del responsable de la lista de chequeo
          </small>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @kit do |form| %>
        <% if @kit.errors.any? %>
          <div class="alert alert-danger mb-4" role="alert">
            <div class="fw-semibold mb-2">
              <i class="bi bi-exclamation-triangle me-1"></i>
              Se encontraron los siguientes errores:
            </div>
            <ul class="mb-0">
              <% @kit.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="row g-3">
          <div class="col-12">
            <div class="form-label fw-semibold">
              <i class="bi bi-person me-1"></i>
              Usuario Responsable
            </div>
            <div class="form-control bg-light">
              <%= @kit.user.name %>
            </div>
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold">
              <i class="bi bi-pen me-1"></i>
              Firma autorizada del Usuario Responsable
            </label>
            <div class="d-flex flex-wrap gap-4 mt-2">
              <div class="form-check">
                <%= form.radio_button :firm_user,  0,  class: "form-check-input", id: "firm_user_no" %>
                <%= form.label :firm_user, "No", value: 0,  class: "form-check-label", for: "firm_user_no" %>
              </div>
              <div class="form-check">
                <%= form.radio_button :firm_user, 1, class: "form-check-input", id: "firm_user_si" %>
                <%= form.label :firm_user, "Sí", value: 1, class: "form-check-label", for: "firm_user_si" %>
              </div>
            </div>
          </div>
          <div class="col-12">
            <%= form.label :post, class: "form-label fw-semibold" %>
            <%= form.text_field :post, class: "form-control" %>
          </div>
        </div>
        <%= form.hidden_field :date_firm_user, value: Time.current %>
        <div class="conesst-actions mt-4">
          <%= form.submit t('common.submit'), class: "conesst-btn conesst-btn-primary" %>
          <%= link_to request.referer || root_path, class: "conesst-btn" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>