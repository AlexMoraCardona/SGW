
<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div>
          <div class="conesst-card-header-title">
            <i class="bi bi-clipboard-check me-2"></i>
            Lista de chequeo
          </div>
          <div class="conesst-card-header-subtitle">
            Consulta y verificación de la lista de chequeo
          </div>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <div class="conesst-table-wrapper mb-4">
        <table class="conesst-table">
          <tbody>
            <tr>
              <td data-label="Lista de chequeo">
                <strong><%= @list.check_list.name %></strong>
              </td>
              <td data-label="Empresa">
                <%= @list.entity.business_name %>
              </td>
              <td data-label="Fecha">
                <%= @list.created_at.strftime("%Y-%m-%d") %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <% if @lists.present? %>
        <div class="conesst-table-wrapper">
          <table class="conesst-table">
            <thead>
              <tr>
                <th>Ítem</th>
                <th>Verificación</th>
                <th class="text-center">Cumple</th>
                <th class="text-center">No cumple</th>
                <th class="text-center">No aplica</th>
                <th>Observaciones</th>
                <th class="text-center">Editar</th>
              </tr>
            </thead>
            <tbody>
              <% @lists.group_by(&:clasification).each do |cla, det| %>
                <% nivel = CheckListItem.label_clasification(cla) %>
                <tr class="table-light">
                  <td colspan="7">
                    <strong>
                      <i class="bi bi-list-check me-1"></i>
                      <%= nivel %>
                    </strong>
                  </td>
                </tr>
                <% det.each do |d| %>
                  <tr>
                    <td data-label="Ítem">
                      <%= d.check_list_item.item %>
                    </td>
                    <td data-label="Verificación">
                      <%= d.check_list_item.name %>
                    </td>
                    <td data-label="Cumple" class="text-center">
                      <% if d.state == 0 %>
                        <strong>X</strong>
                      <% end %>
                    </td>
                    <td data-label="No cumple" class="text-center">
                      <% if d.state == 1 %>
                        <strong>X</strong>
                      <% end %>
                    </td>
                    <td data-label="No aplica" class="text-center">
                      <% if d.state == 2 %>
                        <strong>X</strong>
                      <% end %>
                    </td>
                    <td data-label="Observaciones">
                      <%= d.observation %>
                    </td>
                    <td data-label="Editar" class="text-center">
                      <%= link_to edit_list_path(d.id), class: "conesst-btn conesst-btn-primary" do %>
                        <i class="bi bi-pencil-square me-1"></i>
                        Editar
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
      <div class="conesst-actions mt-4">
        <%= link_to check_lists_path, class: "conesst-btn conesst-btn-primary" do %>
          <i class="bi bi-arrow-left me-1"></i>
          Retornar
        <% end %>
      </div>
    </div>
  </div>
</div>