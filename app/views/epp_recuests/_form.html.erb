<div class="conesst-page">
  <% if @epp_recuest.present? %>
    <div class="conesst-card">
      <div class="conesst-card-header">
        <div class="conesst-card-header-content">
          <div class="conesst-card-header-title">
            <i class="bi bi-shield-check me-2"></i>
            Solicitud elemento de protección personal
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <%= form_with model: @epp_recuest do |form| %>
          <% if @epp_recuest.errors.any? %>
            <div class="alert alert-danger" role="alert">
              <div class="fw-bold mb-1">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Se encontraron los siguientes errores:
              </div>
              <ul class="mb-0">
                <% @epp_recuest.errors.full_messages.each do |error| %>
                  <li><%= error %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <div class="conesst-form-group mb-3">
            <%= form.label :protection_element_id, class: "conesst-form-label" do %>
              <span>
                Elemento de protección personal
                <%= image_tag "ayuda.png", width: 22, height: 22, class: "ms-1", data: {bs_toggle: "tooltip", bs_html: "true"}, title: "Seleccione EPP." %>
              </span>
            <% end %>
            <% if @protection_elements.present? %>
              <%= form.collection_select(:protection_element_id, @protection_elements, :id, :name, { prompt: "-- Seleccionar EPP --" }, { class: "form-select", required: true }) %>
            <% end %>
          </div>
          <div class="conesst-form-group mb-3">
            <%= form.label :cantidad, "Cantidad", class: "conesst-form-label" %>
            <%= form.number_field :cantidad, class: "form-control", step: 1, max: 10, min: 1, required: true %>
          </div>
          <div class="conesst-form-group mb-3">
            <%= form.label :observation, class: "conesst-form-label" do %>
              <span>
                Observaciones
                <%= image_tag "ayuda.png", width: 22, height: 22, class: "ms-1", data: {bs_toggle: "tooltip", bs_html: "true"}, title: "Ingresar información en caso de requerir. Ejemplo: talla, medida, color, etc." %>
              </span>
            <% end %>
            <%= form.text_field :observation, class: "form-control" %>
          </div>
          <% if Current.user.level > 0 && Current.user.level < 4 %>
            <div class="conesst-form-group mb-3">
              <%= form.label :state_recuest, class: "conesst-form-label" do %>
                <span>
                  Estado de la solicitud
                  <%= image_tag "ayuda.png", width: 22, height: 22, class: "ms-1", data: {bs_toggle: "tooltip", bs_html: "true"}, title: "Ingresar el estado de la solicitud." %>
                </span>
              <% end %>
              <div class="d-flex flex-wrap gap-3 mt-2">
                <div class="form-check">
                  <%= form.radio_button :state_recuest, 0, class: "form-check-input", id: "state_recuest_pendiente" %>
                  <%= form.label :state_recuest, "Pendiente", value: 0, class: "form-check-label", for: "state_recuest_pendiente" %>
                </div>
                <div class="form-check">
                  <%= form.radio_button :state_recuest, 1, class: "form-check-input", id: "state_recuest_gestionado" %>
                  <%= form.label :state_recuest, "Gestionado", value: 1, class: "form-check-label", for: "state_recuest_gestionado" %>
                </div>
              </div>
            </div>
          <% end %>
          <%= form.hidden_field :entity_id, value: params[:entity_id].to_i %>
          <%= form.hidden_field :user_id, value: Current.user.id.to_i %>
          <%= form.hidden_field :date_recuest, value: Time.now %>
          <div class="conesst-actions">
            <button type="submit" class="conesst-btn conesst-btn-primary">
              <i class="bi bi-check-circle"></i>
              <span><%= t("common.submit") %></span>
            </button>
            <%= link_to epp_recuests_path, class: "conesst-btn conesst-btn-secondary" do %>
              <i class="bi bi-arrow-left"></i>
              <span>Retornar</span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>