<table class="pdf-table">
    <tbody>
       <% @assistants.each do |firma| %>
            <tr>
                <td class="pdf-cell-left pdf-col-60">
                    <div class="pdf-space"></div>
                    <div class="pdf-space"></div>
                    <div class="pdf-text">
                        __________________________________
                    </div>
                    <div class="pdf-text">
                        <strong>
                            <%= firma.name %>
                        </strong>
                    </div>
                    <div class="pdf-text">
                        <%= firma.post %>
                    </div>
                    <% if firma.user.level == 2 %>
                        <div class="pdf-text">
                            Licencia: <%= firma.user.license %>
                        </div>
                    <% end %>
                </td>
                <td class="pdf-col-40">
                </td>
            </tr>
        <% end %>
    </tbody>
</table>
<div class="pdf-space"></div>