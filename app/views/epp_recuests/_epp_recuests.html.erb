<style>
  .epp-page {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0 auto;
    padding: 12px;
    box-sizing: border-box;
  }

  .epp-page *,
  .epp-page *::before,
  .epp-page *::after {
    box-sizing: border-box;
  }

  .epp-page .epp-main-card {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0;
  }

  .epp-page .epp-company-title {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .epp-page .epp-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
  }

  .epp-page .epp-pagination-info {
    overflow-wrap: anywhere;
  }

  .epp-page .epp-desktop {
    display: block;
    width: 100%;
    min-width: 0;
  }

  .epp-page .epp-table-wrapper {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .epp-page .epp-table {
    width: 100%;
    min-width: 1050px;
    margin-bottom: 0;
    border-collapse: separate;
    border-spacing: 0;
  }

  .epp-page .epp-table th,
  .epp-page .epp-table td {
    vertical-align: middle;
    padding: 10px;
  }

  .epp-page .epp-mobile {
    display: none;
  }

  .epp-page .epp-mobile-card {
    width: 100%;
    min-width: 0;
    margin: 0 0 14px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #e1e8ee;
    border-radius: 12px;
    box-shadow: 0 2px 7px rgba(0, 0, 0, 0.05);
  }

  .epp-page .epp-mobile-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    padding: 12px;
    background: #f5f9fc;
    border-bottom: 1px solid #e1e8ee;
  }

  .epp-page .epp-mobile-header-main {
    flex: 1;
    min-width: 0;
  }

  .epp-page .epp-mobile-date {
    font-size: 0.82rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .epp-page .epp-mobile-status {
    flex-shrink: 0;
    max-width: 45%;
    padding: 5px 8px;
    border-radius: 8px;
    background: #e6f3fc;
    color: #075f91;
    font-size: 0.78rem;
    font-weight: 600;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .epp-page .epp-mobile-body {
    padding: 12px;
    min-width: 0;
  }

  .epp-page .epp-mobile-field {
    margin-bottom: 12px;
    min-width: 0;
  }

  .epp-page .epp-mobile-field:last-child {
    margin-bottom: 0;
  }

  .epp-page .epp-mobile-label {
    display: block;
    margin-bottom: 3px;
    color: #687782;
    font-size: 0.76rem;
    font-weight: 600;
  }

  .epp-page .epp-mobile-value {
    color: #263746;
    font-size: 0.92rem;
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .epp-page .epp-mobile-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid #e9eef2;
  }

  .epp-page .epp-mobile-actions > a,
  .epp-page .epp-mobile-actions > form {
    display: flex;
    width: 100%;
    min-width: 0;
    margin: 0;
  }

  .epp-page .epp-mobile-actions .conesst-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    min-width: 0;
    min-height: 42px;
    padding: 8px 6px;
    font-size: 0.83rem;
    line-height: 1.25;
    text-align: center;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .epp-page .epp-mobile-actions > form > button {
    width: 100%;
  }

  @media (max-width: 767.98px) {
    .epp-page {
      padding: 6px;
    }

    .epp-page .epp-main-card {
      border-radius: 12px;
    }

    .epp-page .epp-main-card > .conesst-card-header,
    .epp-page .epp-main-card > .conesst-card-body {
      padding: 12px;
    }

    .epp-page .epp-company-title {
      font-size: 1rem;
      line-height: 1.4;
    }

    .epp-page .epp-actions {
      justify-content: center;
    }

    .epp-page .epp-actions .conesst-btn {
      justify-content: center;
      max-width: 100%;
    }

    .epp-page .epp-desktop {
      display: none !important;
    }

    .epp-page .epp-mobile {
      display: block !important;
      width: 100%;
      min-width: 0;
    }

    .epp-page .epp-mobile-card {
      margin-right: 0;
      margin-left: 0;
    }
  }

  @media (min-width: 768px) {
    .epp-page {
      padding: 16px;
    }

    .epp-page .epp-desktop {
      display: block !important;
    }

    .epp-page .epp-mobile {
      display: none !important;
    }
  }
</style>

<div class="epp-page">
  <% if @entity.present? %>
    <div class="conesst-card epp-main-card">
      <div class="conesst-card-header">
        <div class="conesst-card-header-content">
          <div class="conesst-card-header-title epp-company-title">
            <i class="bi bi-building me-2"></i>
            <%= @entity.business_name %>
          </div>
          <div class="text-muted small">
            <strong>NIT:</strong>
            <%= EvaluationRuleDetail.miles(@entity.identification_number) if @entity.identification_number.present? %><%= "-#{@entity.verification_digit}" if @entity.verification_digit.present? %>
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <div class="conesst-actions epp-actions">
          <%= link_to new_epp_recuest_path(entity_id: @entity.id), class: "conesst-btn conesst-btn-primary" do %>
            <i class="bi bi-plus-circle"></i>
            <span>Solicitar EPP</span>
          <% end %>
        </div>
        <div class="mt-3 mb-3 epp-pagination-info">
          <%== pagy_info(@pagy) %>
        </div>
        <div class="d-flex justify-content-center mb-3">
          <%== pagy_bootstrap_combo_nav_js(@pagy) %>
        </div>
        <% if @epp_recuests.present? %>
          <div class="epp-desktop">
            <div class="epp-table-wrapper">
              <table class="table table-hover conesst-table epp-table">
                <thead>
                  <tr>
                    <th scope="col">Fecha solicitud</th>
                    <th scope="col">
                      <%= sort_link(@q, :state_recuest, default_order: :desc) %>
                    </th>
                    <th scope="col">
                      <%= sort_link(@q, :user_id, default_order: :desc) %>
                    </th>
                    <th scope="col">EPP solicitado</th>
                    <th scope="col">Cantidad</th>
                    <th scope="col">Fecha entrega</th>
                    <th scope="col">Observaciones</th>
                    <th scope="col">Cumplido</th>
                    <th scope="col">Eliminar</th>
                  </tr>
                </thead>
                <tbody>
                  <% @epp_recuests.each do |epp_recuest| %>
                    <tr>
                      <td>
                        <%= epp_recuest.date_recuest %>
                      </td>
                      <td>
                        <%= EppRecuest.label_state_recuest(epp_recuest.state_recuest) %>
                      </td>
                      <td>
                        <%= epp_recuest.user.name %>
                      </td>
                      <td>
                        <%= epp_recuest.protection_element.name %>
                      </td>
                      <td>
                        <%= epp_recuest.cantidad %>
                      </td>
                      <td>
                        <%= epp_recuest.date_delivery %>
                      </td>
                      <td>
                        <%= epp_recuest.observation %>
                      </td>
                      <td>
                        <% if Current.user.level > 0 && Current.user.level < 4 %>
                          <%= link_to edit_epp_recuest_path(epp_recuest), class: "conesst-btn conesst-btn-warning conesst-btn-sm", title: "Editar solicitud" do %>
                            <i class="bi bi-pencil-square"></i>
                            <span>Editar</span>
                          <% end %>
                        <% end %>
                      </td>
                      <td>
                        <% if Current.user.level > 0 && Current.user.level < 4 %>
                          <%= button_to epp_recuest, method: :delete,  class: "conesst-btn conesst-btn-danger conesst-btn-sm", form: {data: {turbo_confirm: "¿Está seguro de eliminar esta solicitud?"}}, title: "Eliminar solicitud" do %>
                            <i class="bi bi-trash"></i>
                            <span>Eliminar</span>
                          <% end %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
          <div class="epp-mobile">
            <% @epp_recuests.each do |epp_recuest| %>
              <article class="epp-mobile-card">
                <div class="epp-mobile-header">
                  <div class="epp-mobile-header-main">
                    <span class="epp-mobile-label">
                      <i class="bi bi-calendar3 me-1"></i>
                      Fecha de solicitud
                    </span>
                    <div class="epp-mobile-date">
                      <%= epp_recuest.date_recuest.presence || "Sin fecha" %>
                    </div>
                  </div>
                  <div class="epp-mobile-status">
                    <%= EppRecuest.label_state_recuest(epp_recuest.state_recuest) %>
                  </div>
                </div>
                <div class="epp-mobile-body">
                  <div class="epp-mobile-field">
                    <span class="epp-mobile-label">
                      <i class="bi bi-person me-1"></i>
                      Usuario
                    </span>
                    <div class="epp-mobile-value">
                      <%= epp_recuest.user&.name || "Sin usuario" %>
                    </div>
                  </div>
                  <div class="epp-mobile-field">
                    <span class="epp-mobile-label">
                      <i class="bi bi-shield-check me-1"></i>
                      EPP solicitado
                    </span>
                    <div class="epp-mobile-value fw-semibold">
                      <%= epp_recuest.protection_element&.name || "Sin elemento registrado" %>
                    </div>
                  </div>
                  <div class="epp-mobile-field">
                    <span class="epp-mobile-label">
                      <i class="bi bi-box-seam me-1"></i>
                      Cantidad
                    </span>
                    <div class="epp-mobile-value">
                      <%= epp_recuest.cantidad %>
                    </div>
                  </div>
                  <div class="epp-mobile-field">
                    <span class="epp-mobile-label">
                      <i class="bi bi-calendar-check me-1"></i>
                      Fecha de entrega
                    </span>
                    <div class="epp-mobile-value">
                      <%= epp_recuest.date_delivery.presence || "Pendiente" %>
                    </div>
                  </div>
                  <% if epp_recuest.observation.present? %>
                    <div class="epp-mobile-field">
                      <span class="epp-mobile-label">
                        <i class="bi bi-chat-left-text me-1"></i>
                        Observaciones
                      </span>
                      <div class="epp-mobile-value">
                        <%= epp_recuest.observation %>
                      </div>
                    </div>
                  <% end %>
                  <% if Current.user.level > 0 && Current.user.level < 4 %>
                    <div class="epp-mobile-actions">
                      <%= link_to edit_epp_recuest_path(epp_recuest), class: "conesst-btn conesst-btn-warning" do %>
                        <i class="bi bi-pencil-square"></i>
                        <span>Editar</span>
                      <% end %>
                      <%= button_to epp_recuest, method: :delete, class: "conesst-btn conesst-btn-danger", form: {data: {turbo_confirm: "¿Está seguro de eliminar esta solicitud?"}} do %>
                        <i class="bi bi-trash"></i>
                        <span>Eliminar</span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="conesst-empty">
            <i class="bi bi-shield-check"></i>
            <h5>Sin solicitudes registradas</h5>
            <p>No hay solicitudes de EPP para mostrar.</p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>