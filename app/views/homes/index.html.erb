                                height: "42",
                                width: "42",
                                class: "indicator-image" %>

                        </div>

                        <div class="indicator-label">
                            Actos inseguros
                        </div>

                        <div class="indicator-value">

                            <%= MatrixCondition.total_actos_inseguros(@entity.id) %>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- ACTOS INTERVENIDOS -->
                <!-- ================================================= -->

                <div class="col-6">

                    <div class="indicator-card indicator-mini">

                        <div class="indicator-icon-box icon-success">

                            <%= image_tag "icointervencioninseguros.png",
                                height: "42",
                                width: "42",
                                class: "indicator-image" %>

                        </div>

                        <div class="indicator-label">
                            Actos intervenidos
                        </div>

                        <div class="indicator-value text-success">

                            <%= MatrixCondition.si_actos_inseguros(@entity.id) %>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- TOTAL PELIGROS / RIESGOS -->
                <!-- ================================================= -->

                <div class="col-6">

                    <div class="indicator-card indicator-mini">

                        <div class="indicator-icon-box icon-danger">

                            <%= image_tag "icopeligro.png",
                                height: "42",
                                width: "42",
                                class: "indicator-image" %>

                        </div>

                        <div class="indicator-label">
                            Total peligros / riesgos
                        </div>

                        <div class="indicator-value">

                            <%= MatrixDangerRisk.total_peligros_riesgos(@entity.id) %>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- PELIGROS / RIESGOS INTERVENIDOS -->
                <!-- ================================================= -->

                <div class="col-6">

                    <div class="indicator-card indicator-mini">

                        <div class="indicator-icon-box icon-success">

                            <%= image_tag "icolistadopeligro.png",
                                height: "42",
                                width: "42",
                                class: "indicator-image" %>

                        </div>

                        <div class="indicator-label">
                            Peligros / riesgos intervenidos
                        </div>

                        <div class="indicator-value text-success">

                            <%= MatrixDangerRisk.inter_peligros_riesgos(@entity.id) %>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- CAPACITACIONES -->
                <!-- ================================================= -->

                <div class="col-12">

                    <div class="indicator-card">

                        <div class="indicator-section-title">

                            <span class="indicator-section-icon training-icon">
                                <i class="bi bi-mortarboard-fill"></i>
                            </span>

                            <span>
                                Capacitaciones
                            </span>

                        </div>


                        <% @capacitaciones = Training.capacitaciones(@entity.id) %>


                        <% if @capacitaciones.present? %>

                            <div class="mt-3">

                                <% if @capacitaciones[0].present? %>

                                    <a
                                        data-bs-toggle="tooltip"
                                        title="<%= @capacitaciones[0][0] %>"
                                        class="text-decoration-none">

                                        <div
                                            class="progress mb-3"
                                            role="progressbar"
                                            aria-valuenow="<%= @capacitaciones[0][1] %>"
                                            aria-valuemin="0"
                                            aria-valuemax="100"
                                            style="height:22px;">

                                            <div
                                                class="progress-bar bg-danger overflow-visible text-dark fw-semibold"
                                                style="width:<%= @capacitaciones[0][1] %>%">

                                                <%= @capacitaciones[0][0] %>
                                                -
                                                <%= @capacitaciones[0][1] %>%

                                            </div>

                                        </div>

                                    </a>

                                <% end %>


                                <% if @capacitaciones[1].present? %>

                                    <a
                                        data-bs-toggle="tooltip"
                                        title="<%= @capacitaciones[1][0] %>"
                                        class="text-decoration-none">

                                        <div
                                            class="progress mb-3"
                                            role="progressbar"
                                            aria-valuenow="<%= @capacitaciones[1][1] %>"
                                            aria-valuemin="0"
                                            aria-valuemax="100"
                                            style="height:22px;">

                                            <div
                                                class="progress-bar bg-success overflow-visible text-dark fw-semibold"
                                                style="width:<%= @capacitaciones[1][1] %>%">

                                                <%= @capacitaciones[1][0] %>
                                                -
                                                <%= @capacitaciones[1][1] %>%

                                            </div>

                                        </div>

                                    </a>

                                <% end %>


                                <% if @capacitaciones[2].present? %>

                                    <a
                                        data-bs-toggle="tooltip"
                                        title="<%= @capacitaciones[2][0] %>"
                                        class="text-decoration-none">

                                        <div
                                            class="progress"
                                            role="progressbar"
                                            aria-valuenow="<%= @capacitaciones[2][1] %>"
                                            aria-valuemin="0"
                                            aria-valuemax="100"
                                            style="height:22px;">

                                            <div
                                                class="progress-bar bg-success overflow-visible text-dark fw-semibold"
                                                style="width:<%= @capacitaciones[2][1] %>%">

                                                <%= @capacitaciones[2][0] %>
                                                -
                                                <%= @capacitaciones[2][1] %>%

                                            </div>

                                        </div>

                                    </a>

                                <% end %>

                            </div>

                        <% else %>

                            <div class="text-center text-body-secondary small py-3">

                                <i class="bi bi-info-circle me-1"></i>
                                No hay información de capacitaciones.

                            </div>

                        <% end %>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- CLASIFICACIÓN POR GÉNERO -->
                <!-- ================================================= -->

                <div class="col-12">

                    <div class="indicator-card">

                        <div class="indicator-section-title">

                            <span class="indicator-section-icon gender-icon">
                                <i class="bi bi-gender-ambiguous"></i>
                            </span>

                            <span>
                                Clasificación por género
                            </span>

                        </div>


                        <div class="row align-items-center mt-2">


                            <!-- GRÁFICO -->

                            <div class="col-6 text-center">

                                <% if @datos_sex.present? %>

                                    <%= pie_chart @datos_sex,
                                        download: {
                                            filename: "Sexo",
                                            background: "#FFFFFF"
                                        },
                                        prefix: "Cantidad: ",
                                        donut: true,
                                        label: true,
                                        width: "150px",
                                        height: "150px",
                                        legend: false,
                                        loading: "Cargando..." %>

                                <% else %>

                                    <div class="text-body-secondary small py-4">
                                        Sin información
                                    </div>

                                <% end %>

                            </div>


                            <!-- RESUMEN -->

                            <div class="col-6">

                                <% if @datos_sex.present? %>

                                    <div class="gender-summary">

                                        <% @datos_sex.each do |genero, cantidad| %>

                                            <div class="gender-item">

                                                <div class="gender-label">

                                                    <span class="gender-dot"></span>

                                                    <%= genero %>

                                                </div>

                                                <span class="badge text-bg-light border">
                                                    <%= cantidad %>
                                                </span>

                                            </div>

                                        <% end %>

                                    </div>


                                    <div class="gender-total mt-2">

                                        <span>
                                            <i class="bi bi-people-fill me-1"></i>
                                            Total
                                        </span>

                                        <strong>
                                            <%= @datos_sex.sum do |item| item[0].to_s.split(":").last.to_i end %>
                                        </strong>

                                    </div>

                                <% else %>

                                    <div class="text-center text-body-secondary small">
                                        Sin información
                                    </div>

                                <% end %>

                            </div>

                        </div>

                    </div>

                </div>


            </div>

        </div>

    </div>

</div>




    </div>
</div> 
<br>
