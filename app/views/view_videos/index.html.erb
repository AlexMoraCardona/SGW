
<div class="conesst-page">
  <div class="conesst-logo-container">
    <%= link_to root_path, class: "d-inline-block" do %>
      <%= image_tag('LogoConesst202305232.png', class: 'conesst-logo', alt: 'CONESST') %>
    <% end %>
  </div>
  <div class="conesst-header">
    <div class="conesst-card-header-content">
      <div class="conesst-card-header-title">
        <i class="bi bi-play-circle me-2"></i>
        <%= t('.title') %>
      </div>
      <div class="conesst-card-header-subtitle">
        Consulta y seguimiento de videos visualizados
      </div>
    </div>
  </div>
  <div class="conesst-card mb-3">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div class="conesst-card-header-title">
          <i class="bi bi-search me-2"></i>
          Buscar registros
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= search_form_for @q do |f| %>
        <div class="conesst-form-grid conesst-form-grid-2">
          <div class="conesst-form-group">
            <%= f.label :name_view_cont, class: "conesst-form-label" do %>
              Nombre del video
            <% end %>
            <%= f.search_field :name_view_cont, class: "form-control" %>
          </div>
          <div class="conesst-form-group">
            <%= f.label :user_id_eq, class: "conesst-form-label" do %>
              Usuario ID
            <% end %>
            <%= f.number_field :user_id_eq, class: "form-control" %>
          </div>
        </div>
        <div class="conesst-form-actions">
          <button type="submit" class="conesst-btn conesst-btn-primary">
            <i class="bi bi-search"></i>
            Buscar
          </button>
        </div>
      <% end %>
    </div>
  </div>
  <div class="conesst-card mb-3">
    <div class="conesst-card-body">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <div class="small text-muted">
          <%== pagy_info(@pagy) %>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
          <div>
            <%== pagy_bootstrap_combo_nav_js(@pagy) %>
          </div>
          <%= link_to view_videos_path(format: 'pdf'), class: 'conesst-btn conesst-btn-success' do %>
            <i class="bi bi-file-earmark-pdf"></i>
            PDF
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div class="conesst-card-header-title">
          <i class="bi bi-table me-2"></i>
          Videos visualizados
        </div>
      </div>
    </div>
    <div class="conesst-card-body p-0">
      <div class="conesst-table-wrapper">
        <table class="conesst-table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>
                <%= sort_link(@q, :date_view, default_order: :desc) %>
              </th>
              <th>
                <%= sort_link(@q, :name_view, default_order: :desc) %>
              </th>
              <th>
                Usuario ID
              </th>
              <th>
                <%= sort_link(@q, :user_id, default_order: :desc) %>
              </th>
              <th>
                <%= sort_link(@q, :type_presentation, default_order: :desc) %>
              </th>
            </tr>
          </thead>
          <tbody>
            <%= render partial: 'view_video', collection: @view_videos %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="conesst-card mt-3">
    <div class="conesst-card-body">
      <div class="d-flex flex-column align-items-center gap-2">
        <div class="small text-muted text-center">
          <%== pagy_info(@pagy) %>
        </div>
        <div>
          <%== pagy_bootstrap_combo_nav_js(@pagy) %>
        </div>
      </div>
    </div>
  </div>
</div>
