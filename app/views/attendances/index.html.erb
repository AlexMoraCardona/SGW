<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div class="conesst-card-header-title">
          <i class="bi bi-calendar-check me-2"></i>
          <%= t(".title") %>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <% if @attendances.present? %>
        <div class="conesst-table-wrapper">
          <table class="conesst-table table-hover">
            <thead>
              <tr>
                <th scope="col">Fecha</th>
                <th scope="col">Capacitación</th>
                <th scope="col">Asistió</th>
                <th scope="col">Fecha firma asistencia</th>
              </tr>
            </thead>
            <tbody>
              <% @attendances.each do |attendance| %>
                <tr>
                  <td data-label="Fecha">
                    <%= attendance.adm_attendance.date_attendance %>
                  </td>
                  <td data-label="Capacitación">
                    <%= attendance.adm_attendance.description %>
                  </td>
                  <td data-label="Asistió">
                    <% if attendance.confirm_attendance == 1 %>
                      <%= image_tag("caritafeliz.png", class: "carita-mini", alt: "Asistencia registrada", title: "Asistencia registrada") %>
                    <% else %>
                      <%= link_to registrar_asistencia_path(id: attendance.id), class: "conesst-btn conesst-btn-primary" do %>
                        <i class="bi bi-check-circle"></i>
                        <span>Registrar asistencia</span>
                      <% end %>
                    <% end %>
                  </td>
                  <td data-label="Fecha firma asistencia">
                    <%= attendance.date_attendance %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-light border text-center mb-0">
          <i class="bi bi-info-circle me-2"></i>
          No hay registros de asistencia disponibles.
        </div>
      <% end %>
    </div>
  </div>
</div>