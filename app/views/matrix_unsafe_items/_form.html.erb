
<div class="container-fluid px-2 px-md-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <h5 class="mb-0 text-center text-md-start">
                    Ver reporte acto/condición insegura
                </h5> 
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <%= link_to unsafe_condition_path(@matrix_unsafe_item.unsafe_condition_id), class: "btn btn-sm btn-primary", title: t('common.show'), data: { bs_toggle: "tooltip" } do %>
                        <i class="bi bi-eye-fill me-1"></i>
                        <span class="d-none d-sm-inline"><%= t('common.show') %></span>
                    <% end %>
                    <%= link_to matrix_condition_path(@matrix_unsafe_item.matrix_condition_id), class: "btn btn-sm btn-secondary", title: t('common.return'), data: { bs_toggle: "tooltip" } do %>
                        <i class="bi bi-arrow-left-circle me-1"></i>
                        <span class="d-none d-sm-inline"><%= t('common.return') %></span>
                    <% end %>
                </div>
            </div>
        </div>
        <!-- INFORMACIÓN DEL REPORTANTE -->
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <div class="fw-semibold text-secondary">
                        Usuario que reporta
                    </div>
                    <div class="mt-1">
                        <%= MatrixUnsafeItem.name_user(@matrix_unsafe_item.user_reporta) %>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="fw-semibold text-secondary">
                        Cargo del usuario que reporta
                    </div>
                    <div class="mt-1">
                        <%= CompanyPosition.name_cargo(@matrix_unsafe_item.cargo_reporta) %>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="fw-semibold text-secondary">
                        Correo del usuario que reporta
                    </div>
                    <div class="mt-1 text-break">
                        <%= @matrix_unsafe_item.correo_reporta %>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- FORMULARIO PRINCIPAL -->
    <%= form_with model: @matrix_unsafe_item do |form| %>
        <% if @matrix_unsafe_item.errors.any? %>
            <div class="alert alert-danger shadow-sm" role="alert">
                <div class="fw-semibold mb-2">
                    Se encontraron los siguientes errores:
                </div>
                <ul class="mb-0">
                    <% @matrix_unsafe_item.errors.full_messages.each do |error| %>
                        <li><%= error %></li>
                    <% end %>
                </ul>
            </div>
        <% end %>
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    Información del reporte
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <%= form.label :date_item, class: "form-label fw-semibold" %>
                        <%= form.date_field :date_item, class: "form-control" %>
                    </div>
                    <div class="col-12 col-md-4">
                        <%= form.label :sede, class: "form-label fw-semibold" %>
                        <%= form.text_field :sede, class: "form-control" %>
                    </div>
                    <div class="col-12 col-md-4">
                        <%= form.label :exact_ubication, class: "form-label fw-semibold" %>
                        <%= form.text_field :exact_ubication, class: "form-control" %>
                    </div>
                    <div class="col-12">
                        <%= form.label :description_usafe, class: "form-label fw-semibold" %>
                        <%= form.text_area :description_usafe, class: "form-control", rows: 3 %>
                    </div>
                    <div class="col-12">
                        <%= form.label :solution_usafe, class: "form-label fw-semibold" %>
                        <%= form.text_area :solution_usafe, class: "form-control", rows: 3 %>
                    </div>
                    <div class="col-12 col-md-6">
                        <%= form.label :clasification_unsafe, class: "form-label fw-semibold d-block" %>
                            <div class="d-flex flex-wrap gap-3">
                                <div class="form-check">
                                    <%= form.radio_button :clasification_unsafe, 0, class: "form-check-input" %>
                                    <%= form.label :clasification_unsafe_0, "Condición", class: "form-check-label" %>
                                </div>
                                <div class="form-check">
                                    <%= form.radio_button :clasification_unsafe, 1, class: "form-check-input" %>
                                    <%= form.label :clasification_unsafe_1, "Acto", class: "form-check-label" %>
                                </div>
                            </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <%= form.label :tip_action, class: "form-label fw-semibold d-block" %>
                            <div class="d-flex flex-wrap gap-3">
                                <div class="form-check">
                                    <%= form.radio_button :tip_action, 0, class: "form-check-input" %>
                                    <%= form.label :tip_action_0, "Preventiva", class: "form-check-label" %>
                                </div>
                                <div class="form-check">
                                    <%= form.radio_button :tip_action, 1, class: "form-check-input" %>
                                    <%= form.label :tip_action_1, "Correctiva", class: "form-check-label" %>
                                </div>
                                <div class="form-check">
                                    <%= form.radio_button :tip_action, 2, class: "form-check-input" %>
                                    <%= form.label :tip_action_2, "Mejora", class: "form-check-label" %>
                                </div>
                            </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <%= form.label :state_unsafe,  class: "form-label fw-semibold d-block" %>
                            <div class="d-flex flex-wrap gap-3">
                                <div class="form-check">
                                    <%= form.radio_button :state_unsafe, 0, class: "form-check-input" %>
                                    <%= form.label :state_unsafe_0, "Abierta", class: "form-check-label" %>
                                </div>
                                <div class="form-check">
                                    <%= form.radio_button :state_unsafe, 1, class: "form-check-input" %>
                                    <%= form.label :state_unsafe_1, "Cerrada", class: "form-check-label" %>
                                </div>
                            </div>
                    </div>
                    <div class="col-12">
                        <%= form.label :observations,  class: "form-label fw-semibold" %>
                        <%= form.text_area :observations, class: "form-control", rows: 3 %>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-label fw-semibold">
                            Usuario que recibe
                        </div>
                        <div class="form-control bg-light">
                            <%= MatrixUnsafeItem.name_user(@matrix_unsafe_item.user_recibe) %>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <%= form.label :date_intervencion, class: "form-label fw-semibold" %>
                        <%= form.date_field :date_intervencion, class: "form-control" %>
                    </div>
                </div>
            </div>
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <%= form.button type: :submit, class: "btn btn-success" do %>
                    <i class="bi bi-check-circle"></i>
                    Guardar
                <% end %>

                <%= link_to :back, class: "btn btn-secondary" do %>
                    <i class="bi bi-arrow-left-circle"></i>
                    Retornar
                <% end %>
            </div>
        </div>
    <% end %>
    <!-- ARCHIVOS ADJUNTOS -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-paperclip me-2"></i>
                    Adjuntar archivos
            </h5>
        </div>
        <div class="card-body">
            <%= form_for @matrix_unsafe_item do |f| %>
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-8">
                        <%= f.label :registros, "Archivos", class: "form-label fw-semibold" %>
                        <%= f.file_field :registros, multiple: true, class: "form-control" %>
                    </div>
                    <div class="col-12 col-md-4">
                        <%= f.submit "Subir archivos", class: "btn btn-success w-100" %>
                    </div>
                </div>
            <% end %>
        </div>
    </div>
</div>

<div class="container-fluid px-2 px-md-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <h5 class="mb-0">
                    <i class="bi bi-folder2-open me-2"></i>
                    Archivos adjuntos - Antes
                </h5>
            </div>
        </div>
        <div class="card-body">
            <!-- DESCRIPCIÓN -->
            <% if @unsafe_condition.present? %>
                <% if @unsafe_condition.description_condition.present? || @unsafe_condition.description_act_unsafe.present? %>
                    <div class="alert alert-light border mb-4">
                        <% if @unsafe_condition.description_condition.present? %>
                            <div class="mb-2">
                                <strong>Condición insegura:</strong><br>
                                <%= @unsafe_condition.description_condition %>
                            </div>
                        <% end %>
                        <% if @unsafe_condition.description_act_unsafe.present? %>
                            <div>
                                <strong>Acto inseguro:</strong><br>
                                <%= @unsafe_condition.description_act_unsafe %>
                            </div>
                        <% end %>
                    </div>
                <% end %>
            <% end %>
            <!-- ARCHIVOS -->
            <% if @unsafe_condition.present? && @unsafe_condition.evidencias.attached? %>
                <div data-controller="previews">
                    <div class="row g-3">
                        <% @unsafe_condition.evidencias.each do |file| %>
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="card h-100 border shadow-sm">
                                    <!-- CONTENIDO DEL ARCHIVO -->
                                    <div class="card-body text-center">
                                        <% if file.image? %>
                                            <%= image_tag file, data: { previews_target: "preview" }, class: "img-fluid rounded", style: "max-height: 300px; object-fit: contain;" %>
                                        <% elsif file.video? %>
                                            <%= video_tag url_for(file), controls: true, class: "w-100 rounded", style: "max-height: 300px;" %>
                                        <% elsif file.audio? %>
                                            <div class="py-4">
                                                <i class="bi bi-file-earmark-music display-4 text-secondary"></i>
                                                <div class="mt-3">
                                                    <%= file.filename %>
                                                </div>
                                                <audio controls class="w-100 mt-3">
                                                    <source src="<%= url_for(file) %>">
                                                </audio>
                                            </div>
                                        <% else %>
                                            <div class="py-4">
                                                <i class="bi bi-file-earmark display-4 text-secondary"></i>
                                                <div class="mt-3 text-break">
                                                    <%= file.filename %>
                                                </div>
                                            </div>
                                        <% end %>
                                    </div>
                                    <!-- NOMBRE -->
                                    <div class="card-footer bg-white">
                                        <div class="small text-muted text-center text-break mb-3">
                                            <i class="bi bi-paperclip me-1"></i>
                                            <%= file.filename %>
                                        </div>
                                        <!-- BOTONERA -->
                                        <div class="d-flex flex-wrap justify-content-center gap-2">
                                            <%= link_to purge_attachment_path(file), data: {'turbo-method': :delete, 'turbo-confirm': '¿Está seguro de eliminar el archivo?'}, class: "btn btn-sm btn-outline-danger", title: "Borrar archivo", data_bs_toggle: "tooltip" do %>
                                                <i class="bi bi-trash3-fill me-1"></i>
                                                <span class="d-none d-sm-inline">
                                                    Borrar
                                                </span>
                                            <% end %>
                                            <%= link_to rails_blob_path(file, disposition: 'attachment'), class: "btn btn-sm btn-outline-success", title: "Descargar archivo", data_bs_toggle: "tooltip" do %>
                                                <i class="bi bi-download me-1"></i>
                                                <span class="d-none d-sm-inline">
                                                    Descargar
                                                </span>
                                            <% end %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% end %>
                    </div>
                </div>
            <% else %>
                <div class="alert alert-secondary text-center mb-0">
                    <i class="bi bi-info-circle me-2"></i>
                        No hay archivos adjuntos para este reporte.
                </div>
            <% end %>
        </div>
    </div>
    <!-- ===================================================== -->
    <!-- ARCHIVOS ADJUNTOS DESPUÉS -->
    <!-- ===================================================== -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-center gap-2">
                <h5 class="mb-0">
                    <i class="bi bi-folder2-open me-2"></i>
                    Archivos adjuntos - Después
                </h5>
            </div>
        </div>
        <div class="card-body">
            <% if @matrix_unsafe_item.registros.attached? %>
                <div data-controller="previews">
                    <div class="row g-3">
                        <% @matrix_unsafe_item.registros.each do |file| %>
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="card h-100 border shadow-sm">
                                    <!-- CONTENIDO DEL ARCHIVO -->
                                    <div class="card-body text-center">
                                    <% if file.image? %>
                                        <%= image_tag file, data: { previews_target: "preview" }, class: "img-fluid rounded", style: "max-height: 300px; object-fit: contain;" %>
                                    <% elsif file.video? %>
                                        <%= video_tag url_for(file), controls: true, class: "w-100 rounded", style: "max-height: 300px;" %>
                                    <% elsif file.audio? %>
                                        <div class="py-4">
                                            <i class="bi bi-file-earmark-music
                                            display-4 text-secondary"></i>
                                            <div class="mt-3 text-break">
                                                <%= file.filename %>
                                            </div>
                                            <audio controls class="w-100 mt-3">
                                                <source src="<%= url_for(file) %>">
                                            </audio>
                                        </div>
                                    <% else %>
                                        <div class="py-4">
                                            <i class="bi bi-file-earmark display-4 text-secondary"></i>
                                            <div class="mt-3 text-break">
                                                <%= file.filename %>
                                            </div>
                                        </div>
                                    <% end %>
                                </div>
                                <!-- NOMBRE Y BOTONES -->
                                <div class="card-footer bg-white">
                                    <div class="small text-muted text-center text-break mb-3">
                                        <i class="bi bi-paperclip me-1"></i>
                                        <%= file.filename %>
                                    </div>
                                    <div class="d-flex flex-wrap justify-content-center gap-2">
                                        <%= link_to purge_attachment_path(file), data: {'turbo-method': :delete, 'turbo-confirm': '¿Está seguro de eliminar el archivo?' }, class: "btn btn-sm btn-outline-danger", title: "Borrar archivo", data_bs_toggle: "tooltip" do %>
                                            <i class="bi bi-trash3-fill me-1"></i>
                                            <span class="d-none d-sm-inline">
                                                Borrar
                                            </span>
                                        <% end %>
                                        <%= link_to rails_blob_path(file, disposition: 'attachment'), class: "btn btn-sm btn-outline-success", title: "Descargar archivo", data_bs_toggle: "tooltip" do %>
                                            <i class="bi bi-download me-1"></i>
                                            <span class="d-none d-sm-inline">
                                                Descargar
                                            </span>
                                        <% end %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% end %>
                </div>
            </div>
            <% else %>
                <div class="alert alert-secondary text-center mb-0">
                    <i class="bi bi-info-circle me-2"></i>
                          No hay archivos adjuntos para este reporte.
                </div>
            <% end %>
        </div>
    </div>
</div>
