<div class="conesst-page">
  <div class="conesst-logo-container">
    <%= link_to root_path, class: "d-inline-block" do %>
      <%= image_tag(
        'LogoConesst202305232.png',
        class: 'conesst-logo',
        alt: 'CONESST'
      ) %>
    <% end %>
  </div>
  <div class="conesst-header">
    <div class="conesst-card-header-content">
      <div class="conesst-card-header-title">
        <i class="bi bi-car-front me-2"></i>
        <%= t('.title') %>
      </div>
      <div class="conesst-card-header-subtitle">
        Consulta y administración de listas de chequeo de automóviles
      </div>
    </div>
  </div>
  <div class="conesst-card mb-3">
    <div class="conesst-card-body">
      <div class="conesst-actions">
        <%= link_to new_car_checklist_path, class: "conesst-btn conesst-btn-primary" do %>
          <i class="bi bi-plus-circle"></i>
          <%= t('.create_car_checklist') %>
        <% end %>
      </div>
    </div>
  </div>
  <div class="conesst-card mb-3">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div class="conesst-card-header-title">
          <i class="bi bi-search me-2"></i>
          Buscar listas de chequeo
        </div>
        <div class="conesst-card-header-subtitle">
          Filtra los registros por fecha, usuario o placa
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= search_form_for @q do |f| %>
        <div class="conesst-form-grid conesst-form-grid-2">
          <div class="conesst-form-group">
            <%= f.label :date_list, class: "conesst-form-label" do %>
              <%= t('.date_list') %>
            <% end %>
            <%= f.date_field :date_list_eq, class: "form-control" %>
          </div>
          <div class="conesst-form-group">
            <%= f.label :user_id, class: "conesst-form-label" do %>
              <%= t('.user_id') %>
            <% end %>
            <%= f.select(:user_id_eq, @users.pluck(:name, :id).uniq, { include_blank: true }, { class: "form-select" }) %>
          </div>
          <div class="conesst-form-group">
            <%= f.label :plate_car, class: "conesst-form-label" do %>
              <%= t('.plate_car') %>
            <% end %>
            <%= f.search_field :plate_car_cont, class: "form-control", placeholder: "Buscar por placa" %>
          </div>
        </div>
        <div class="conesst-form-actions mt-3">
          <button type="submit" class="conesst-btn conesst-btn-primary">
            <i class="bi bi-search"></i>
            Buscar
          </button>
        </div>
      <% end %>
    </div>
  </div>
  <div class="conesst-card mb-3">
    <div class="conesst-card-body">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <div class="small text-muted">
          <%== pagy_info(@pagy) %>
        </div>
        <div>
          <%== pagy_bootstrap_combo_nav_js(@pagy) %>
        </div>
      </div>
    </div>
  </div>
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div class="conesst-card-header-title">
          <i class="bi bi-clipboard-check me-2"></i>
          Listas de chequeo
        </div>
        <div class="conesst-card-header-subtitle">
          Registros de prechequeos operacionales de automóviles
        </div>
      </div>
    </div>
    <div class="conesst-card-body p-0">
      <div class="conesst-table-wrapper">
        <table class="conesst-table">
          <thead>
            <tr>
              <th scope="col">
                <%= sort_link(@q, :date_list, default_order: :desc) %>
              </th>
              <th scope="col">
                <%= sort_link(@q, :plate_car, default_order: :desc) %>
              </th>
              <th scope="col">
                <%= sort_link(@q, :user_id, default_order: :desc) %>
              </th>
              <th scope="col">
                Firma
              </th>
              <th scope="col">
                <%= t('.user_autoriza') %>
              </th>
              <th scope="col">
                Firma
              </th>
              <th scope="col">
                Adjuntos
              </th>
              <th scope="col">
                <%= t('common.show') %>
              </th>
              <th scope="col">
                PDF
              </th>
              <th scope="col">
                Borrar
              </th>
            </tr>
          </thead>
          <tbody>
            <%= render partial: 'car_checklist', collection: @car_checklists %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
