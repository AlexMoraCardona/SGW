<style>

/* ==========================================================
   CONESST - MENÚ PRINCIPAL RESPONSIVE
   Compatible con PC, Android y Safari/iPhone
   ========================================================== */

.conesst-menu {
    width: 100%;
}

/* ----------------------------------------------------------
   GRID PRINCIPAL
   ---------------------------------------------------------- */

.conesst-menu table,
.conesst-menu tbody,
.conesst-menu tr {
    display: contents;
}

.conesst-menu td {
    width: auto !important;
    border: 0 !important;
    padding: .5rem !important;
    vertical-align: top;
}

.conesst-menu td > a {
    width: 100%;
    min-height: 145px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: 1.25rem;

    text-align: center;
    text-decoration: none;

    color: var(--bs-body-color);
    background: var(--bs-body-bg);

    border: 1px solid var(--bs-border-color);
    border-radius: 1rem;

    box-shadow: 0 .125rem .35rem rgba(0,0,0,.08);

    transition:
        transform .18s ease,
        box-shadow .18s ease,
        border-color .18s ease,
        background-color .18s ease;
}

.conesst-menu td > a:hover {
    transform: translateY(-4px);

    box-shadow: 0 .5rem 1.25rem rgba(0,0,0,.12);

    border-color: var(--bs-primary);

    background-color: var(--bs-light);
}

.conesst-menu td > a svg,
.conesst-menu td > a i {
    width: 55px;
    height: 55px;

    margin-bottom: .75rem;

    font-size: 3.2rem;

    transition: transform .18s ease;
}

.conesst-menu td > a:hover svg,
.conesst-menu td > a:hover i {
    transform: scale(1.08);
}

.conesst-menu td > a div {
    font-size: 1rem;
    font-weight: 600;
    text-align: center;
}

.conesst-menu td img[src*="imagen_menu2"] {
    max-width: 150px;
    width: 100%;
    height: auto;
    object-fit: contain;
}


/* ==========================================================
   OFFCANVAS
   IMPORTANTE:
   Los offcanvas deben estar fuera de .table-responsive
   ========================================================== */

.conesst-offcanvas {
    width: min(390px, 90vw) !important;

    background-color: #fff !important;
    color: var(--bs-body-color);

    z-index: 1055;
}

/* Cabecera */

.conesst-offcanvas .offcanvas-header {
    flex-shrink: 0;

    background-color: #f8f9fa;

    border-bottom: 1px solid #dee2e6;

    padding: 1rem 1.25rem;
}

.conesst-offcanvas .offcanvas-title {
    font-weight: 700;
    font-size: 1.1rem;
}

/* Botón cerrar */

.conesst-offcanvas .btn-close {
    margin: 0;
    padding: .75rem;

    opacity: .7;
}

.conesst-offcanvas .btn-close:hover {
    opacity: 1;
}


/* ==========================================================
   CUERPO DEL MENÚ
   ========================================================== */

.conesst-offcanvas .offcanvas-body {

    /*
     * Fundamental para Safari/iPhone.
     */
    overflow-y: auto;
    overflow-x: hidden;

    /*
     * Permite desplazamiento suave en iOS.
     */
    -webkit-overflow-scrolling: touch;

    /*
     * Evita que el gesto de scroll se propague
     * innecesariamente al documento.
     */
    overscroll-behavior: contain;

    padding: 1rem 1.25rem 2rem;

    /*
     * Permite que flexbox calcule correctamente
     * el área desplazable.
     */
    min-height: 0;
}


/* Descripción */

.conesst-offcanvas-description {
    font-size: .9rem;
    color: #6c757d;

    line-height: 1.45;

    margin-bottom: 1rem;
}


/* ==========================================================
   ENLACES DEL MENÚ
   ========================================================== */

.conesst-offcanvas .menu-links {
    display: flex;
    flex-direction: column;

    gap: .35rem;

    margin-top: .75rem;
}

.conesst-offcanvas .menu-links a {
    display: block;

    width: 100%;

    padding: .75rem .9rem;

    border-radius: .65rem;

    color: #212529;

    text-decoration: none;

    line-height: 1.35;

    white-space: normal;

    overflow-wrap: anywhere;

    word-break: normal;

    transition:
        background-color .15s ease,
        transform .15s ease;
}

.conesst-offcanvas .menu-links a:hover {
    background-color: #f1f3f5;

    transform: translateX(4px);
}

.conesst-offcanvas .menu-links a:active {
    background-color: #e9ecef;
}

.conesst-offcanvas .menu-links a i {
    margin-right: .5rem;
}


/* ==========================================================
   TABLET
   ========================================================== */

@media (max-width: 1199.98px) {

    .conesst-menu {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: .5rem;
    }
}


/* ==========================================================
   CELULAR
   ========================================================== */

@media (max-width: 767.98px) {

    .conesst-menu {
        grid-template-columns: 1fr;
    }

    .conesst-menu td {
        padding: .35rem !important;
    }

    .conesst-menu td > a {
        min-height: 115px;

        padding: 1rem;
    }

    .conesst-menu td > a svg,
    .conesst-menu td > a i {
        width: 45px;
        height: 45px;

        font-size: 2.6rem;

        margin-bottom: .5rem;
    }

    .conesst-menu td > a div {
        font-size: .95rem;
    }

    .conesst-offcanvas {
        width: 88vw !important;
        max-width: 390px;
    }

    .conesst-offcanvas .offcanvas-body {
        padding: .9rem 1rem 2rem;

        /*
         * Refuerzo específico para iPhone.
         */
        -webkit-overflow-scrolling: touch;
        overflow-y: auto;
    }

    .conesst-offcanvas .menu-links a {
        padding: .8rem .75rem;

        font-size: .95rem;
    }
}


/* ==========================================================
   IPHONE / SAFARI
   ========================================================== */

@supports (-webkit-touch-callout: none) {

    .conesst-offcanvas .offcanvas-body {
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }
}

  /* Panel de indicadores */
  .conesst-indicators {
    width: 100%;
  }

  .conesst-indicators > table {
    width: 100%;
  }

  .conesst-indicators img.image_peq {
    max-width: 90px;
    height: auto;
  }

/* =========================================================
   CONESST - DASHBOARD DE INDICADORES
   ========================================================= */

.conesst-indicators {
    border-radius: 1rem;
    overflow: hidden;
    background: #f8f9fa;
}

.conesst-indicators .card-header {
    border-bottom: 1px solid #e9ecef !important;
}


/* ---------------------------------------------------------
   ICONO DEL TÍTULO
   --------------------------------------------------------- */

.dashboard-title-icon {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #e7f1ff;
    color: #0d6efd;
    font-size: 1.3rem;
}


/* ---------------------------------------------------------
   TARJETAS
   --------------------------------------------------------- */

.conesst-indicators .indicator-card {
    height: 100%;
    padding: 1rem;
    background: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: .9rem;
    transition: transform .18s ease,
                box-shadow .18s ease;
}

.conesst-indicators .indicator-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 .35rem 1rem rgba(0, 0, 0, .08);
}


/* ---------------------------------------------------------
   TÍTULOS DE SECCIÓN
   --------------------------------------------------------- */

.indicator-section-title {
    display: flex;
    align-items: center;
    gap: .6rem;
    font-size: .92rem;
    font-weight: 700;
    color: #343a40;
}

.indicator-section-icon {
    width: 34px;
    height: 34px;
    min-width: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: .65rem;
    font-size: 1rem;
}


/* Colores de los encabezados */

.standards-icon {
    background: #d1e7dd;
    color: #198754;
}

.people-icon {
    background: #cfe2ff;
    color: #0d6efd;
}

.training-icon {
    background: #fff3cd;
    color: #997404;
}

.gender-icon {
    background: #f8d7da;
    color: #b02a37;
}


/* ---------------------------------------------------------
   ESTADO ACTUAL
   --------------------------------------------------------- */

.status-title {
    font-size: .85rem;
    font-weight: 700;
    color: #495057;
    margin-bottom: .65rem;
}

.status-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .4rem;
    padding: .45rem 0;
    border-bottom: 1px solid #f1f3f5;
}

.status-item:last-child {
    border-bottom: 0;
}

.status-label {
    font-size: .72rem;
    color: #6c757d;
    line-height: 1.2;
}


/* ---------------------------------------------------------
   ICONOS DE LOS INDICADORES
   --------------------------------------------------------- */

.indicator-icon-box {
    width: 48px;
    height: 48px;
    min-width: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: .8rem;
    margin-bottom: .65rem;
    transition: transform .18s ease;
}

.indicator-card:hover .indicator-icon-box {
    transform: scale(1.05);
}

.indicator-image {
    max-width: 42px;
    max-height: 42px;
    object-fit: contain;
}


/* Fondos coloridos */

.icon-danger {
    background: #f8d7da;
}

.icon-warning {
    background: #fff3cd;
}

.icon-info {
    background: #cff4fc;
}

.icon-purple {
    background: #e2d9f3;
}

.icon-primary {
    background: #cfe2ff;
}

.icon-orange {
    background: #ffe5d0;
}

.icon-success {
    background: #d1e7dd;
}


/* ---------------------------------------------------------
   INDICADORES PEQUEÑOS
   --------------------------------------------------------- */

.indicator-mini {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
}

.indicator-label {
    font-size: .76rem;
    line-height: 1.25;
    color: #6c757d;
    font-weight: 500;
}

.indicator-value {
    margin-top: .35rem;
    font-size: 1.55rem;
    line-height: 1;
    font-weight: 700;
    color: #212529;
}


/* ---------------------------------------------------------
   INDICADOR HORIZONTAL
   --------------------------------------------------------- */

.indicator-horizontal {
    display: flex;
    align-items: center;
    gap: .9rem;
}

.indicator-horizontal .indicator-icon-box {
    margin-bottom: 0;
}


/* ---------------------------------------------------------
   RESUMEN COLABORADORES
   --------------------------------------------------------- */

.summary-box {
    text-align: center;
    padding: .75rem .5rem;
    background: #f8f9fa;
    border-radius: .75rem;
}

.summary-icon {
    width: 38px;
    height: 38px;
    margin: 0 auto .4rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.people-summary {
    background: #cfe2ff;
    color: #0d6efd;
}

.summary-label {
    font-size: .7rem;
    color: #6c757d;
}

.summary-value {
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1.2;
    margin-top: .2rem;
}


/* ---------------------------------------------------------
   GÉNERO
   --------------------------------------------------------- */

.gender-summary {
    background: #f8f9fa;
    border-radius: .75rem;
    padding: .5rem .65rem;
}

.gender-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    padding: .35rem 0;
    border-bottom: 1px solid #e9ecef;
}

.gender-item:last-child {
    border-bottom: 0;
}

.gender-label {
    display: flex;
    align-items: center;
    gap: .4rem;
    font-size: .75rem;
    color: #495057;
}

.gender-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #0d6efd;
}

.gender-item:nth-child(2) .gender-dot {
    background: #dc3545;
}

.gender-item:nth-child(3) .gender-dot {
    background: #198754;
}

.gender-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: .45rem .65rem;
    border-radius: .65rem;
    background: #e9ecef;
    color: #495057;
    font-size: .75rem;
}


/* ---------------------------------------------------------
   CAPACITACIONES
   --------------------------------------------------------- */

.conesst-indicators .progress {
    background-color: #e9ecef;
    border-radius: 10px;
    overflow: hidden;
}

.conesst-indicators .progress-bar {
    border-radius: 10px;
    font-size: .7rem;
    padding-left: .4rem;
    padding-right: .4rem;
}


/* ---------------------------------------------------------
   BOTÓN CAMBIO DE EMPRESA
   --------------------------------------------------------- */

.conesst-indicators .btn-outline-secondary {
    transition: all .18s ease-in-out;
}

.conesst-indicators .btn-outline-secondary:hover {
    transform: translateY(-1px);
}


/* ---------------------------------------------------------
   TABLET
   --------------------------------------------------------- */

@media (max-width: 991.98px) {

    .conesst-indicators .indicator-value {
        font-size: 1.4rem;
    }

}


/* ---------------------------------------------------------
   CELULAR
   --------------------------------------------------------- */

@media (max-width: 575.98px) {

    .conesst-indicators .card-body {
        padding: .75rem;
    }

    .conesst-indicators .indicator-card {
        padding: .85rem;
    }

    .conesst-indicators .indicator-value {
        font-size: 1.35rem;
    }

    .conesst-indicators .indicator-label {
        font-size: .74rem;
    }

    .conesst-indicators .indicator-section-title {
        font-size: .85rem;
    }

    .conesst-indicators .indicator-section-icon {
        width: 32px;
        height: 32px;
        min-width: 32px;
    }

    .status-label {
        font-size: .68rem;
    }

    .summary-value {
        font-size: 1.35rem;
    }

}

.estado-badge {
  white-space: normal !important;
  overflow-wrap: break-word;
  word-break: normal;
  text-align: center;
  line-height: 1.2;
  max-width: 100%;
  padding: 0.45rem 0.7rem;
}

</style>


