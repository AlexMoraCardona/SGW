  <!-- ============================================================
       FUNCIONARIOS RELACIONADOS
       ============================================================ -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mt-4">
    <div class="card-header bg-light border-0 py-3 px-3 px-md-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <div class="d-flex align-items-center">
          <div class="bg-white rounded-circle shadow-sm p-2 me-3">
            <i class="bi bi-people-fill fs-5 text-secondary"></i>
          </div>
          <div>
            <h5 class="mb-1 fw-bold text-dark">
              Funcionarios relacionados en la evidencia
            </h5>
            <small class="text-muted">
              Personas actualmente asociadas a esta evidencia
            </small>
          </div>
        </div>
        <span class="badge rounded-pill text-bg-secondary px-3 py-2">
          <i class="bi bi-people me-1"></i>
          <%= @participants.to_a.count %>
        </span>
      </div>
    </div>
    <div class="card-body p-0">
      <% if @participants.present? %>
        <!-- ======================================================
             TABLA PC / TABLET
             ====================================================== -->
        <div class="table-responsive d-none d-md-block">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="px-4 py-3">
                  <i class="bi bi-calendar3 me-1"></i>
                  Fecha evidencia
                </th>
                <th class="py-3">
                  Nro. evidencia
                </th>
                <th class="py-3">
                  Evidencia
                </th>
                <th class="py-3">
                  Funcionario
                </th>
                <th class="text-center py-3">
                  Editar
                </th>
                <th class="text-center py-3">
                  Eliminar
                </th>
              </tr>
            </thead>
            <tbody>
            <% @participants.each do |participant| %>
                <tr>
                  <td class="px-4 text-muted">
                    <i class="bi bi-calendar-event me-1"></i>
                    <%= participant.evidence.date %>
                  </td>
                  <td>
                    <span class="badge rounded-pill text-bg-light border">
                      <%= participant.evidence_id %>
                    </span>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark">
                      <i class="bi bi-file-earmark-text text-secondary me-2"></i>
                      <%= participant.evidence.template.name %>
                    </div>
                  </td>
                  <td>
                    <div class="fw-semibold">
                      <i class="bi bi-person me-2 text-secondary"></i>
                      <%= participant.user.name %>
                    </div>
                  </td>
                  <td class="text-center">
                    <%= link_to edit_participant_path(participant), class: "btn btn-sm btn-outline-primary rounded-circle", title: "Editar funcionario" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                  </td>
                  <td class="text-center">
                    <%= button_to participant, method: :delete, class: "btn btn-sm btn-outline-danger rounded-circle", title: "Eliminar funcionario", form: {data: {turbo_confirm: "¿Está seguro de eliminar este funcionario?"}} do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <!-- ======================================================
             TARJETAS CELULAR
             ====================================================== -->
        <div class="d-md-none">
          <% @participants.each do |participant| %>
            <div class="border-bottom p-3">
              <div class="d-flex align-items-start gap-3">
                <div class="bg-light rounded-3 p-2 flex-shrink-0">
                  <i class="bi bi-person fs-5 text-secondary"></i>
                </div>
                <div class="flex-grow-1">
                  <div class="fw-semibold text-dark mb-2">
                    <%= participant.user.name %>
                  </div>
                  <div class="small text-muted mb-1">
                    <i class="bi bi-calendar3 me-1"></i>
                    <%= participant.evidence.date %>
                  </div>
                  <div class="small text-muted mb-1">
                    <i class="bi bi-hash me-1"></i>
                    Evidencia #<%= participant.evidence_id %>
                  </div>
                  <div class="small text-secondary mb-3">
                    <i class="bi bi-file-earmark-text me-1"></i>
                    <%= participant.evidence.template.name %>
                  </div>
                  <div class="d-flex flex-wrap gap-2">
                    <%= link_to edit_participant_path(participant), class: "btn btn-sm btn-outline-primary rounded-pill px-3" do %>
                      <i class="bi bi-pencil me-1"></i>
                      Editar
                    <% end %>
                    <%= button_to participant, method: :delete, class: "btn btn-sm btn-outline-danger rounded-pill px-3", form: {data: {turbo_confirm: "¿Está seguro de eliminar este funcionario?"}} do %>
                      <i class="bi bi-trash me-1"></i>
                      Eliminar
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-5 px-3">
          <div class="mb-3">
            <i class="bi bi-people display-5 text-muted"></i>
          </div>
          <h6 class="fw-bold text-secondary mb-1">
            No hay funcionarios relacionados
          </h6>
          <p class="text-muted small mb-0">
            Todavía no se han asociado funcionarios a esta evidencia.
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>



