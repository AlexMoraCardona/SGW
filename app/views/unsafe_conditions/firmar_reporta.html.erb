<div class="container col-11 col-md-9 col-lg-7 my-4">
  <div class="card shadow-sm border-0">
    <div class="card-header bg-light border-0 py-3">
      <h5 class="mb-1 fw-bold">
        <i class="bi bi-pen me-2"></i>
        Autorización de firma
      </h5>
      <p class="text-muted small mb-0">
        Configuración de la firma del usuario que reporta la condición insegura.
      </p>
    </div>
    <div class="card-body p-3 p-md-4">
      <%= form_with model: @unsafe_condition do |form| %>
        <% if @unsafe_condition.errors.any? %>
          <div class="alert alert-danger" role="alert">
            <div class="fw-bold mb-2">
              <i class="bi bi-exclamation-triangle me-2"></i>
              Se encontraron errores en el formulario
            </div>
            <ul class="mb-0 ps-3">
              <% @unsafe_condition.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="border rounded-3 p-3 mb-4">
          <div class="d-flex align-items-start gap-3">
            <div class="text-primary fs-3">
              <i class="bi bi-person-circle"></i>
            </div>
            <div class="flex-grow-1">
              <label class="form-label text-muted small mb-1">
                Usuario que reporta
              </label>
              <div class="fw-semibold">
                <%= UnsafeCondition.name_user(@unsafe_condition.user_reports) %>
              </div>
            </div>
          </div>
        </div>
        <div class="mb-4">
          <label class="form-label fw-semibold">
            <i class="bi bi-vector-pen me-2"></i>
            Firma autorizada del usuario que reporta
          </label>
          <div class="d-flex flex-wrap gap-3 mt-2">
            <div class="form-check border rounded-3 px-4 py-3 flex-grow-1">
              <%= form.radio_button :firm_user_reports, 0, class: "form-check-input", id: "firm_user_reports_no" %>
              <%= form.label :firm_user_reports, "No", for: "firm_user_reports_no", class: "form-check-label ms-1" %>
            </div>
            <div class="form-check border rounded-3 px-4 py-3 flex-grow-1">
              <%= form.radio_button :firm_user_reports, 1, class: "form-check-input", id: "firm_user_reports_si" %>
              <%= form.label :firm_user_reports, "Sí", for: "firm_user_reports_si", class: "form-check-label ms-1" %>
            </div>
          </div>
        </div>
        <%= form.hidden_field :date_firm_user_reports, value: Time.now %>
        <hr class="my-4">
        <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
          <%= form.button type: "submit", class: "btn btn-primary px-4" do %>
            <i class="bi bi-check-circle me-2"></i>
            <%= t('common.submit') %>
          <% end %>
          <%= link_to :back, class: "btn btn-outline-secondary px-4" do %>
            <i class="bi bi-arrow-left me-2"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>