<div class="container-fluid px-2 px-md-4 my-3">
    <div class="card shadow-sm mx-auto" style="max-width: 1100px;">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-heart-pulse"></i>
                Examen Ocupacional
            </h5>
        </div>
        <div class="card-body p-3 p-md-4">
            <%= form_with model: @occupational_exam do |form| %>
                <% if @occupational_exam.errors.any? %>
                    <div class="alert alert-danger" role="alert">
                        <div class="fw-bold mb-2">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            Se encontraron los siguientes errores:
                        </div>
                        <ul class="mb-0">
                            <% @occupational_exam.errors.full_messages.each do |error| %>
                                <li><%= error %></li>
                            <% end %>
                        </ul>
                    </div>
            <% end %>
            <div class="mb-4">
                <div class="d-flex align-items-center mb-2">
                    <label class="form-label fw-semibold mb-0">
                        <i class="bi bi-person-badge me-1"></i>
                        Representante Legal
                    </label>
                    <button type="button" class="btn btn-sm btn-light ms-2" data-bs-toggle="tooltip" data-bs-html="true" title="Seleccione el nombre del Representante Legal.">
                        <%= image_tag 'ayuda.png', width: 20, height: 20, alt: "Ayuda" %>
                    </button>
                </div>
                <%= form.collection_select :user_legal_representative, User.usuarios_empresa.order(id: :asc), :id, :name, {}, class: "form-select" %>
            </div>
            <!-- Asesor SST -->
            <div class="mb-4">
                <div class="d-flex align-items-center mb-2">
                    <label class="form-label fw-semibold mb-0">
                        <i class="bi bi-person-workspace me-1"></i>
                        Asesor SST
                    </label>
                    <button type="button" class="btn btn-sm btn-light ms-2" data-bs-toggle="tooltip" data-bs-html="true" title="Seleccione el nombre del Asesor SST.">
                        <%= image_tag 'ayuda.png', width: 20, height: 20, alt: "Ayuda" %>
                    </button>
                </div>
                <%= form.collection_select :user_adviser_sst, User.usuarios_empresa.order(id: :asc), :id, :name, {}, class: "form-select" %>
            </div>
            <!-- Responsable SST -->
            <div class="mb-4">
                <div class="d-flex align-items-center mb-2">
                    <label class="form-label fw-semibold mb-0">
                        <i class="bi bi-person-check me-1"></i>
                        Responsable SST
                    </label>
                    <button type="button" class="btn btn-sm btn-light ms-2" data-bs-toggle="tooltip" data-bs-html="true" title="Seleccione el nombre del Responsable SST.">
                        <%= image_tag 'ayuda.png', width: 20, height: 20, alt: "Ayuda" %>
                    </button>
                </div>
                <%= form.collection_select :user_responsible_sst,  User.usuarios_empresa.order(id: :asc), :id, :name, {}, class: "form-select" %>
            </div>
            <!-- Campos ocultos -->
            <%= form.hidden_field :entity_id, value: params[:entity_id].to_i %>
                <% if @template.present? %>
                    <%= form.hidden_field :code, value: @template.reference %>
                    <%= form.hidden_field :version, value: @template.version.to_i %>
                    <%= form.hidden_field :date_create, value: @template.date %>
                    <%= form.hidden_field :date_update, value: @template.date_updated %>
                <% end %>
                <!-- Botonera -->
                <hr class="my-4">
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i>
                        <%= t('common.submit') %>
                    </button>
                    <%= link_to :back, class: "btn btn-secondary px-4" do %>
                        <i class="bi bi-arrow-left-circle me-1"></i>
                        Retornar
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
</div>
