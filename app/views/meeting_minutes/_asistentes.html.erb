<div class="conesst-card">
  <div class="conesst-card-header">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-people fs-5"></i>
      <div>
        <h5 class="mb-0">Asistentes</h5>
        <small class="text-muted">
          Participantes de la reunión
        </small>
      </div>
    </div>
  </div>
  <div class="conesst-card-body">
    <div class="conesst-table-wrapper">
      <table class="conesst-table">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Cargo</th>
            <th>Área / Proceso</th>
          </tr>
        </thead>
        <tbody>
          <% @meeting_attendees.each do |meeting_attendee| %>
            <tr>
              <td data-label="Nombre">
                <%= meeting_attendee.name %>
              </td>
              <td data-label="Cargo">
                <%= meeting_attendee.post %>
              </td>
              <td data-label="Área / Proceso">
                <%= meeting_attendee.process_area %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>