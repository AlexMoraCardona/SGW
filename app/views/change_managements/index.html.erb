<div class="conesst-page">
  <div class="conesst-header">
    <div class="conesst-card-header-content">
      <div class="conesst-card-header-title">
        <i class="bi bi-arrow-repeat me-2"></i>
        Gestión del Cambio
      </div>
      <div class="conesst-card-header-subtitle">
        Administración y seguimiento de los cambios organizacionales
      </div>
    </div>
  </div>
  <% if params[:entity_id].present? || @entity.present? %>
    <%= render 'change_management' %>
  <% else %>
    <div class="conesst-card">
      <div class="conesst-card-header">
        <div class="conesst-card-header-content">
          <div class="conesst-card-header-title">
            <i class="bi bi-building me-2"></i>
            Seleccionar empresa
          </div>
        </div>
      </div>
      <div class="conesst-card-body">
        <%= form_with model: @entity, method: :get do |form| %>
          <div class="conesst-form-group">
            <label class="conesst-form-label">
              Empresa
            </label>
            <% if @entities.present? %>
              <%= form.collection_select(:entity_id, @entities.order(id: :asc), :id, :business_name, { prompt: '-- Seleccionar empresa --' }, { class: 'form-select select2' }) %>
            <% else %>
              <div class="conesst-form-control-static">
                <i class="bi bi-building me-2"></i>
                <span>
                  <%= @entity.business_name %>
                </span>
              </div>
              <%= form.hidden_field(:entity_id, value: @entity.id) %>
            <% end %>
          </div>
          <div class="conesst-form-actions">
            <button type="submit" class="conesst-btn conesst-btn-primary">
              <i class="bi bi-search"></i>
              Consultar
            </button>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
