<div class="container py-4">
  <div align="left"; class="container col-12">
      <a class="navbar-brand" href="/">
          <%= image_tag 'LogoConesst202305232.png',:width => "100",  :height=>"100" %>
      </a>
  </div>

  <% if @entity.present? %>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body text-center">
        <h2 class="fw-bold text-primary mb-0">
          <i class="bi bi-building"></i>
          <%= @entity.business_name %>
        </h2>
        <div class="text-muted">
            <strong>NIT:</strong>
            <%= EvaluationRuleDetail.miles(@entity.identification_number) if @entity.identification_number.present? %>
            <% if @entity.verification_digit.present? %>
                -<%= @entity.verification_digit %>
            <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @matrix_goals.present? %>
    <% if Current.user.level > 0 && Current.user.level < 3 %>
      <div class="mb-4">
        <%= link_to new_matrix_goal_path(entity_id: @entity.id), class: "btn btn-success" do %>
          <i class="bi bi-plus-circle"></i>
          <%= t('common.create_matrix_goal') %>
        <% end %>
      </div>
    <% end %>
    <% @matrix_goals.each do |matrix_goal| %>
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-light text-dark" >
          <div class="row align-items-center">
            <div class="col-md-8">
              <h4 class="mb-0">
                <i class="bi bi-calendar3"></i>
                MATRIZ OBJETIVOS, METAS E INDICADORES DEL SG-SST SEGURIDAD Y SALUD EN EL TRABAJO <%= matrix_goal.date_unsafe.strftime("%Y") %>
              </h4> 
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
              <div class="d-grid d-md-flex justify-content-md-end gap-2">
                <% if Current.user.level > 0 && Current.user.level < 4 %>
                  <%= link_to crear_item_goal_path(matrix_goal.id), class: "btn btn-success btn-sm" do %>
                    <i class="bi bi-plus-square"></i>
                    <%= t('common.create_item_goal') %>
                  <% end %>
                <% end %>
                <%= link_to matrix_goal_path(matrix_goal.id), class: "btn btn-primary btn-sm text-white" do %>
                  <i class="bi bi-eye"></i>
                  <%= t('common.show_matrix_goal') %>
                <% end %>
                <% if Current.user.level > 0 && Current.user.level < 4 %>
                    <%= link_to edit_matrix_goal_path(matrix_goal.id), class:"btn btn-warning btn-sm" do %>
                        <i class="bi bi-pencil-square"></i>
                        Editar
                    <% end %>                    
                <% end %>    
                <%= link_to ver_matrix_goal_path(matrix_goal.id, format: 'pdf'),
                    class: "btn btn-danger btn-sm" do %>
                  <i class="bi bi-file-earmark-pdf"></i>
                  PDF
                <% end %>
                <% if Current.user.level > 0 && Current.user.level < 3 %>
                    <%= link_to duplicar_matrix_goal_path(matrix_goal.id), class: "btn btn-success btn-sm me-2", title: "Duplicar matriz", data: { bs_toggle: "tooltip" } do %>
                        <i class="bi bi-plus-square"></i><span class="d-none d-md-inline">Duplicar Matriz</span>
                    <% end %>
                <% end %>    
              </div>
            </div>
          </div>
        </div>
        <div class="card-body">
          <div class="row mb-4">
            <div class="col-md-4">
              <strong>Fecha de creación</strong><br>
              <span class="text-muted">
                <%= matrix_goal.date_unsafe.strftime("%d/%m/%Y") %>
              </span>
            </div>
          </div>
          <hr>
          <h5 class="text-primary mb-3">
            <i class="bi bi-person-badge"></i>
            Representante Legal
          </h5>
          <div class="row gy-3">
            <div class="col-md-3">
              <strong>Representante Legal</strong><br>
              <%= matrix_goal.name_user(matrix_goal.user_representante) %>
            </div>
            <div class="col-md-3">
              <strong>Firma</strong><br>
              <%= matrix_goal.label_firm(matrix_goal.firm_representante) %>
            </div>
            <div class="col-md-3">
              <strong>Fecha</strong><br>
              <%= matrix_goal.date_firm_representante %>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <% if matrix_goal.firm_representante.to_i == 0 %>
                    <%= link_to firmar_rep_goal_path(matrix_goal.id, 1), class: "btn btn-sm fw-semibold", style: "background-color: #145a72; color: white;", title: t('common.firmar'), data: { bs_toggle: "tooltip" } do %>
                        <i class="bi bi-pen-fill me-2"></i>
                        <%= t('common.firmar') %>
                    <% end %>
                <% end %>
            </div>            
          </div>
          <hr>
          <h5 class="text-success mb-3">
            <i class="bi bi-person-workspace"></i>
            Asesor SST
          </h5>
          <div class="row gy-3">
            <div class="col-md-3">
              <strong>Asesor SST</strong><br>
              <%= matrix_goal.name_user(matrix_goal.user_asesor) %>
            </div>
            <div class="col-md-3">
              <strong>Firma</strong><br>
              <%= matrix_goal.label_firm(matrix_goal.firm_asesor) %>
            </div>
            <div class="col-md-3">
              <strong>Fecha</strong><br>
              <%= matrix_goal.date_firm_asesor %>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <% if matrix_goal.firm_asesor.to_i == 0 %>
                    <%= link_to firmar_adv_goal_path(matrix_goal.id, 2), class: "btn btn-sm fw-semibold", style: "background-color: #145a72; color: white;", title: t('common.firmar'), data: { bs_toggle: "tooltip" } do %>
                        <i class="bi bi-pen-fill me-2"></i>
                        <%= t('common.firmar') %>
                    <% end %>
                <% end %>
            </div>            
          </div>
          <hr>
          <h5 class="text-danger mb-3">
            <i class="bi bi-person-check"></i>
            Responsable SST 
          </h5>
          <div class="row gy-3">
            <div class="col-md-3">
              <strong>Responsable SST </strong><br>
              <%= matrix_goal.name_user(matrix_goal.user_responsible) %>
            </div>
            <div class="col-md-3">
              <strong>Firma</strong><br>
              <%=  matrix_goal.label_firm(matrix_goal.firm_responsible) %>
            </div>
            <div class="col-md-3">
              <strong>Fecha</strong><br>
              <%= matrix_goal.date_firm_responsible %>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <% if matrix_goal.firm_responsible.to_i == 0 %>
                    <%= link_to firmar_res_goal_path(matrix_goal.id, 3), class: "btn btn-sm fw-semibold", style: "background-color: #145a72; color: white;", title: t('common.firmar'), data: { bs_toggle: "tooltip" } do %>
                        <i class="bi bi-pen-fill me-2"></i>
                        <%= t('common.firmar') %>
                    <% end %>
                <% end %>
            </div>            
          </div>
          <hr>

        </div>
      </div>
    <% end %>
  <% else %>
    <div class="card shadow-sm">
      <div class="card-body text-center">
        <h5 class="text-secondary mb-4">
          No existen asignaciones de recursos registradas.
        </h5>
        <%= link_to new_matrix_goal_path(entity_id: @entity.id),
            class: "btn btn-success" do %>
          <i class="bi bi-plus-circle"></i>
          <%= t('common.create_matrix_goal') %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
