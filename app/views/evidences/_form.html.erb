<div class="container-fluid py-3 px-2 px-md-4">
  <div class="card border-0 shadow-sm mx-auto" style="max-width: 1200px;">
    <!-- ENCABEZADO -->
    <div class="card-header bg-light border-bottom py-3">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <div>
          <h5 class="mb-1 fw-bold text-secondary">
            <i class="bi bi-pencil-square me-2"></i>
            Actualizar evidencia
          </h5>
          <% if @evidence.present? && @evidence.template.present? %>
            <div class="text-muted small">
              <i class="bi bi-file-earmark-text me-1"></i>
              <%= @evidence.template.filing %>
            </div>
          <% end %>
        </div>
        <% if @evidence.present? && @evidence.template.present? %>
          <span class="badge bg-secondary px-3 py-2">
            Formato <%= @evidence.template.format_number %>
          </span>
        <% end %>
      </div>
    </div>
    <!-- FORMULARIO -->
    <div class="card-body p-3 p-md-4">
      <%= form_with model: @evidence do |form| %>
        <!-- ERRORES -->
        <% if @evidence.errors.any? %>
          <div class="alert alert-danger shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-start">
              <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
              <div>
                <strong>
                  No fue posible guardar la información.
                </strong>
                <ul class="mb-0 mt-2">
                  <% @evidence.errors.full_messages.each do |error| %>
                    <li><%= error %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>
