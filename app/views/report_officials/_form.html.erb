<div class="container-fluid py-3">
    <div class="card shadow-sm mx-auto" style="max-width: 900px;">
        <div class="card-header">
            <h2 class="h4 mb-0 text-center">
                Registro de funcionarios
            </h2>
        </div>
        <div class="card-body">
            <%= form_with model: @report_official do |form| %>
                <% if @report_official.errors.any? %>
                    <div class="alert alert-danger" role="alert">
                        <h6 class="alert-heading">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            Se encontraron los siguientes errores:
                        </h6>
                        <ul class="mb-0">
                            <% @report_official.errors.full_messages.each do |error| %>
                                <li><%= error %></li>
                            <% end %>
                        </ul>
                    </div>
                <% end %>
                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <%= form.label :entity_id, class: "form-label fw-semibold" %>
                            <div class="form-control bg-light">
                                <i class="bi bi-building me-1"></i>
                                <%= @entity.business_name if @entity.present? %>
                            </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <%= form.label :year, class: "form-label fw-semibold" %>
                            <%= form.number_field :year, class: "form-control", step: 1, max: 2050, min: 2024, required: true %>
                    </div>
                    <div class="col-12 col-md-6">
                        <%= form.label :month, class: "form-label fw-semibold" %>
                        <%= form.number_field :month, class: "form-control", step: 1, max: 12, min: 1, required: true %>
                    </div>
                </div>

                <div class="border rounded p-3 mb-4">
                    <h5 class="mb-3">
                        <i class="bi bi-people-fill me-1"></i>
                        Cantidad de funcionarios
                    </h5>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <%= form.label :number_oficial, class: "form-label" %>
                            <%= form.number_field :number_oficial, class: "form-control", value: form.object.number_oficial || 0, step: 1, max: 1000, min: 0, required: true %>
                        </div>
                        <div class="col-12 col-md-6">
                            <%= form.label :number_oficial_independent, class: "form-label" %>
                            <%= form.number_field :number_oficial_independent, class: "form-control", value: form.object.number_oficial_independent || 0, step: 1, max: 1000, min: 0, required: true %>
                        </div>
                        <div class="col-12 col-md-6">
                            <%= form.label :number_oficial_student, class: "form-label" %>
                            <%= form.number_field :number_oficial_student, class: "form-control", value: form.object.number_oficial_student || 0, step: 1, max: 1000, min: 0, required: true %>
                        </div>
                        <div class="col-12 col-md-6">
                            <%= form.label :number_oficial_temporary, class: "form-label" %>
                            <%= form.number_field :number_oficial_temporary, class: "form-control", value: form.object.number_oficial_temporary || 0, step: 1, max: 1000, min: 0, required: true %>
                        </div>
                        <div class="col-12 col-md-6">
                            <%= form.label :number_oficial_cooperative, class: "form-label" %>
                            <%= form.number_field :number_oficial_cooperative, class: "form-control", value: form.object.number_oficial_cooperative || 0, step: 1, max: 1000, min: 0, required: true %>
                        </div>
                        <div class="col-12 col-md-6">
                            <%= form.label :number_oficial_other, class: "form-label" %>
                            <%= form.number_field :number_oficial_other, class: "form-control", value: form.object.number_oficial_other || 0, step: 1, max: 1000, min: 0, required: true %>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        <%= form.label :working_days_month, class: "form-label fw-semibold" %>
                        <%= form.number_field :working_days_month, class: "form-control", value: form.object.working_days_month || 0, step: 1, max: 31, min: 1, required: true %>
                    </div>
                </div>

                <%= form.hidden_field :user_reports, value: Current.user.id %>
                <%= form.hidden_field :date, value: Time.now %>
                <%= form.hidden_field :entity_id, value: @entity.id if @entity.present? %>

                <div class="border-top pt-3 mt-4">
                    <div class="d-grid d-md-flex justify-content-md-end gap-2">
                        <%= form.button type: "submit", class: "btn btn-primary btn-sm" do %>
                            <i class="bi bi-floppy-fill me-1"></i>
                            <%= t('common.submit') %>
                        <% end %>

                        <%= link_to report_officials_path, class: "btn btn-secondary btn-sm" do %>
                            <i class="bi bi-arrow-left me-1"></i>
                            Retornar
                        <% end %>
                    </div>
                </div>
            <% end %>
        </div>
    </div>
</div>
