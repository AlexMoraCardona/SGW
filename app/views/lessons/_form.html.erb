<div class="conesst-page">
  <div class="conesst-header">
    <div>
      <h1 class="conesst-title">
        <i class="bi bi-journal-plus me-2"></i>
        <%= @lesson.persisted? ? "Editar lección" : "Crear lección" %>
      </h1>
      <p class="conesst-subtitle">
        Registre la información de la lección aprendida
      </p>
    </div>
  </div>
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div>
          <h2 class="conesst-card-header-title">
            <i class="bi bi-pencil-square me-2"></i>
            Información de la lección
          </h2>
          <p class="conesst-card-header-subtitle">
            Complete los campos requeridos
          </p>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <%= form_with model: @lesson do |form| %>
        <% if @lesson.errors.any? %>
          <div class="alert alert-danger mb-4" role="alert">
            <div class="fw-bold mb-2">
              <i class="bi bi-exclamation-triangle me-1"></i>
              No fue posible guardar la lección
            </div>
            <ul class="mb-0 ps-3">
              <% @lesson.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="conesst-form-section">
          <div class="conesst-form-section-title">
            <i class="bi bi-type me-2"></i>
            Título
          </div>
          <div class="conesst-form-group">
            <%= form.label :title, "Título de la lección", class: "conesst-form-label" %>
            <%= form.text_field :title, class: "form-control", placeholder: "Ingrese el título de la lección" %>
          </div>
        </div>
        <div class="conesst-form-section">
          <div class="conesst-form-section-title">
            <i class="bi bi-question-circle me-2"></i>
            ¿Qué sucedió?
          </div>
          <div class="conesst-form-group">
            <%= form.label :leccion_que, "Descripción del evento", class: "conesst-form-label" %>
            <%= form.rich_text_area :leccion_que %>
          </div>
        </div>
        <div class="conesst-form-section">
          <div class="conesst-form-section-title">
            <i class="bi bi-diagram-3 me-2"></i>
            Causas originadoras del evento
          </div>
          <div class="conesst-form-group">
            <%= form.label :leccion_causa, "Causas identificadas", class: "conesst-form-label" %>
            <%= form.rich_text_area :leccion_causa %>
          </div>
        </div>
        <div class="conesst-form-section">
          <div class="conesst-form-section-title">
            <i class="bi bi-lightbulb me-2"></i>
            Recomendaciones
          </div>
          <div class="conesst-form-group">
            <%= form.label :leccion_recome, "Recomendaciones y acciones de mejora", class: "conesst-form-label" %>
            <%= form.rich_text_area :leccion_recome %>
          </div>
        </div>
        <div class="conesst-form-section">
          <div class="conesst-form-section-title">
            <i class="bi bi-person-check me-2"></i>
            Responsable
          </div>
          <div class="conesst-form-group">
            <%= form.label :user_vigia, "Responsable de SG-SST", class: "conesst-form-label" %>
            <%= form.collection_select :user_vigia, User.usuarios_empresa.order(id: :asc), :id, :name, {prompt: "-- Seleccionar responsable --"}, {class: "form-select"} %>
          </div>
        </div>
        <%= form.hidden_field :user_id, value: Current.user.id if Current.user.present? %>
        <%= form.hidden_field :user_adviser_sst, value: Current.user.id if Current.user.present? %>
        <%= form.hidden_field :entity_id, value: @entity.id if @entity.present? %>
        <%= form.hidden_field :code, value: @template.reference if @template.present? %>
        <%= form.hidden_field :version, value: @template.version.to_i if @template.present? %>
        <div class="conesst-form-actions">
          <%= form.submit t("common.submit"), class: "conesst-btn conesst-btn-primary" %>
          <%= link_to :back, class: "conesst-btn" do %>
            <i class="bi bi-arrow-left me-1"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
