<div class="container-fluid py-3">
  <div align="left"; class="container col-12">
    <a class="navbar-brand" href="/">
        <%= image_tag 'LogoConesst202305232.png',:width => "100",  :height=>"100" %>
    </a>
  </div>
  <div class="card shadow-sm border-0">

    <div class="card-header bg-light">

      <div class="d-flex align-items-center gap-2">

        <i class="bi bi-pencil-square fs-4 text-primary"></i>

        <div>

          <h4 class="mb-0">Editar encuesta</h4>

          <small class="text-muted">

            Programa SVE:
            <%= @epidemiological_surveillance_program.name %>

          </small>

        </div>

      </div>

    </div>


    <div class="card-body">

      <!-- INFORMACIÓN DE LA ENCUESTA -->

      <div class="alert alert-light border mb-4">

        <div class="d-flex align-items-center gap-2">

          <i class="bi bi-ui-checks text-primary"></i>

          <div>

            <div class="small text-muted">
              Encuesta
            </div>

            <strong>
              <%= @surveillance_survey.name %>
            </strong>

          </div>

        </div>

      </div>


      <%= render "form" %>

    </div>

  </div>

</div>
