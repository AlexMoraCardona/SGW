<div class="conesst-card virtual-assistant-card">

  <div id="virtual-assistant-messages"
       class="virtual-assistant-messages">

    <div class="virtual-assistant-message virtual-assistant-message-bot">

      <div class="virtual-assistant-avatar">
        <i class="bi bi-robot"></i>
      </div>

      <div class="virtual-assistant-bubble">
        Hola <strong><%= Current.user.name %></strong> 👋
        <br>
        Soy el Asistente Virtual de CONESST.
      </div>

    </div>

  </div>

  <div class="virtual-assistant-input-container">

    <input
      type="text"
      id="virtual-assistant-input"
      class="form-control"
      placeholder="Escribe lo que necesitas..."
      autocomplete="off">

    <button
      type="button"
      id="virtual-assistant-send"
      class="conesst-btn conesst-btn-primary">

      <i class="bi bi-send"></i>
      Enviar

    </button>

  </div>

</div>