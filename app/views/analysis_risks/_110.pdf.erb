<meta charset="utf-8">
<style>
    @page {
        size: Letter landscape;
        margin: 10mm 7mm 10mm 7mm;
    }
    * {
        box-sizing: border-box;
    }
    body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px !important;
        line-height: 1.45;
        color: #000;
        margin: 0;
        padding: 0;
    }
    /* =========================================================
       TÍTULO
       ========================================================= */
    h1 {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 18px !important;
        line-height: 1.2;
        text-align: center;
        margin: 0 0 15px 0;
        padding: 0;
        font-weight: bold;
    }
    h2 {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px !important;
        line-height: 1.3;
        margin: 14px 0 7px 0;
        padding: 6px 8px;
        font-weight: bold;
        background-color: #f1f3f5;
        border-bottom: 2px solid #00aae4;
    }
    p {
        font-size: 12px !important;
        line-height: 1.45;
        margin: 4px 0;
    }
    /* =========================================================
       INFORMACIÓN GENERAL
       ========================================================= */
    .info-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        margin-bottom: 12px;
    }
    .info-table td {
        border: 1px solid #777;
        padding: 7px 8px;
        vertical-align: top;

        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px !important;
        line-height: 1.45;

        word-wrap: break-word;
        overflow-wrap: break-word;
    }
    .info-table .info-label {
        width: 28%;
        background-color: #f1f3f5;
        font-weight: bold;
    }
    .info-table .info-value {
        width: 72%;
        background-color: #fff;
    }
    /* =========================================================
       TABLA DE PASOS
       ========================================================= */
    .analysis-items-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        margin: 0;
    }
    .analysis-items-table th {
        background-color: #00aae4;
        color: #fff;
        border: 1px solid #008dbd;

        padding: 8px 6px;

        text-align: center;
        vertical-align: middle;

        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px !important;
        line-height: 1.3;
        font-weight: bold;

        word-wrap: break-word;
        overflow-wrap: break-word;
    }
    .analysis-items-table td {
        border: 1px solid #777;

        padding: 8px 8px;

        vertical-align: top;

        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px !important;
        line-height: 1.45;

        word-wrap: break-word;
        overflow-wrap: break-word;
        word-break: normal;
    }
    .analysis-items-table .col-step {
        width: 22%;
    }
    .analysis-items-table .col-action {
        width: 20%;
    }
    .analysis-items-table .col-risk {
        width: 22%;
    }
    .analysis-items-table .col-measure {
        width: 36%;
    }
    /* =========================================================
       OBSERVACIONES
       ========================================================= */
    .observations-box {
        width: 100%;
        border: 1px solid #777;
        padding: 9px 12px;
        min-height: 55px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px !important;
        line-height: 1.5;
        word-wrap: break-word;
        overflow-wrap: break-word;
        text-align: justify;
    }
    .observations-label {
        font-size: 12px !important;
        font-weight: bold;
    }
    /* =========================================================
       FIRMA
       ========================================================= */
    .signature-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        margin-top: 6px;
    }
    .signature-table td {
        border: 1px solid #777;
        padding: 12px;
        vertical-align: middle;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px !important;
        line-height: 1.5;
    }
    .signature-info {
        width: 60%;
        background-color: #f8f9fa;
    }
    .signature-image-cell {
        width: 40%;
        text-align: center;
    }
    .signature-image-cell img {
        max-width: 300px;
        max-height: 120px;
        width: auto;
        height: auto;
        object-fit: contain;
    }
    .signature-placeholder {
        color: #666;
        font-size: 12px !important;
        font-style: italic;
    }
    /* =========================================================
       CONTROL DE PÁGINAS
       ========================================================= */
    thead {
        display: table-header-group;
    }
    tbody {
        display: table-row-group;
    }
    tr {
        page-break-inside: avoid;
    }
    .document-section {
        page-break-inside: auto;
    }
    /* =========================================================
       REGLA GENERAL
       Garantiza que ningún estilo heredado reduzca la letra
       ========================================================= */
    table,
    td,
    th,
    div,
    span,
    p,
    li {
        font-family: Arial, Helvetica, sans-serif;
    }

    table,
    td,
    th,
    div,
    span,
    p,
    li {
        font-size: 12px !important;
    }

    h1 {
        font-size: 18px !important;
    }

    h2 {
        font-size: 12px !important;
    }
</style>

<div class="document-section">
    <!-- =====================================================
         TÍTULO
        ===================================================== -->
    <h1>
        ANÁLISIS DE RIESGOS
    </h1>
    <!-- =====================================================
         INFORMACIÓN GENERAL
        ====================================================== -->
    <h2>
        INFORMACIÓN GENERAL
    </h2>
    <table class="info-table">
        <tbody>
            <tr>
                <td class="info-label">
                    Fecha de elaboración
                </td>
                <td class="info-value">
                    <%= @analysis_risk.date_analysis if @analysis_risk.present? %>
                </td>
            </tr>
            <tr>
                <td class="info-label">
                    Área
                </td>
                <td class="info-value">
                    <%= AnalysisRisk.label_area(@analysis_risk.code_area) if @analysis_risk.present? %>
                </td>
            </tr>
            <tr>
                <td class="info-label">
                    Descripción de la actividad
                </td>
                <td class="info-value">
                    <%= @analysis_risk.description_activity if @analysis_risk.present? %>
                </td>
            </tr>
            <tr>
                <td class="info-label">
                    Actividad rutinaria
                </td>
                <td class="info-value">
                    <% if @analysis_risk.present? %>
                        <% if @analysis_risk.routine_activity.to_i == 0 %>
                            NO
                        <% else %>
                            SÍ
                        <% end %>
                    <% end %>
                </td>
            </tr>
            <tr>
                <td class="info-label">
                    Elementos de protección requeridos
                </td>
                <td class="info-value">
                    <%= @analysis_risk.epp_requested if @analysis_risk.present? %>
                </td>
            </tr>
            <tr>
                <td class="info-label">
                    Antecedentes de accidentes laborales relacionados con la actividad
                </td>
                <td class="info-value">
                    <%= @analysis_risk.accident if @analysis_risk.present? %>
                </td>
            </tr>
            <tr>
                <td class="info-label">
                    Herramientas e implementos a utilizar
                </td>
                <td class="info-value">
                    <%= @analysis_risk.tools_use if @analysis_risk.present? %>
                </td>
            </tr>
            <tr>
                <td class="info-label">
                    Capacitación / información relacionada con la actividad
                </td>
                <td class="info-value">
                    <%= @analysis_risk.training_activity if @analysis_risk.present? %>
                </td>
            </tr>
            <tr>
                <td class="info-label">
                    Actividades donde aplica el estándar
                </td>
                <td class="info-value">
                    <%= @analysis_risk.activity_standar if @analysis_risk.present? %>
                </td>
            </tr>
        </tbody>
    </table>
    <!-- =====================================================
         PASOS BÁSICOS DEL OFICIO
     ===================================================== -->
    <h2>
        PASOS BÁSICOS DEL OFICIO Y MEDIDAS DE PREVENCIÓN
    </h2>
    <table class="analysis-items-table">
        <colgroup>
            <col class="col-step">
            <col class="col-action">
            <col class="col-risk">
            <col class="col-measure">
        </colgroup>
        <thead>
            <tr>
                <th>
                    Pasos básicos del oficio
                </th>
                <th>
                    Acciones
                </th>
                <th>
                    Riesgos y peligros potenciales
                </th>
                <th>
                    Medidas preventivas y/o correctivas a aplicar
                </th>
            </tr>
        </thead>
        <tbody>
            <% if @analysis_risk_items.present? %>
                <% @analysis_risk_items.each do |item| %>
                    <tr>
                        <td>
                            <%= item.basic_steps %>
                        </td>
                        <td>
                            <%= item.actions_steps %>
                        </td>
                        <td>
                            <%= item.risks_steps %>
                        </td>
                        <td>
                            <%= item.measures_steps %>
                        </td>
                    </tr>
                <% end %>
            <% else %>
                <tr>
                    <td colspan="4" style="text-align:center; padding:14px; color:#666; font-size:12px !important;">
                        No se han registrado pasos para este análisis.
                    </td>
                </tr>
            <% end %>
        </tbody>
    </table>
    <!-- =====================================================
         OBSERVACIONES
        ====================================================== -->
    <h2>
        OBSERVACIONES
    </h2>
    <div class="observations-box">
        <span class="observations-label">
            Observaciones:
        </span>
        <%= @analysis_risk.observations if @analysis_risk.present? %>
    </div>
    <!-- =====================================================
         ELABORADO POR / FIRMA
        ====================================================== -->
    <h2>
        ELABORADO POR
    </h2>
    <table class="signature-table">
        <tbody>
            <tr>
                <td class="signature-info">
                    <strong>
                        Nombre:
                    </strong>
                    <%= @user.name if @user.present? %>
                    <br>
                    <strong>
                        Cargo:
                    </strong>
                    <%= @analysis_risk.history if @analysis_risk.present? %>
                </td>
                <td class="signature-image-cell">
                    <% if @analysis_risk.present? && @analysis_risk.firm_user_elaborated.to_i == 1 %>
                        <% if @user.present? && @user.firm.attached? && @user.firm.image? %>
                            <%= image_tag(Evaluation.wicked_blob_path(@user.firm), class: "firma") %>
                        <% else %>
                            <span class="signature-placeholder">
                                Firma no registrada
                            </span>
                        <% end %>
                    <% else %>
                        <span class="signature-placeholder">
                            Firma no requerida
                        </span>
                    <% end %>
                </td>
            </tr>
        </tbody>
    </table>
</div>
