<div class="card shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Nro</th>
                        <th>Año</th>
                        <th>Requisito legal/Tema</th>
                        <th>Entidad Emisora</th>
                        <th>Requisito</th>
                        <th>Número</th>
                        <th>Artículo Aplicable</th>
                        <th>Aplica</th>
                        <th>Evidencia de Cumplimiento</th>
                        <th>Responsable</th>
                        <th>Cumple</th>
                        <th>Descripción del cumplimiento</th>
                        <th>Evidencia</th>
                        <th>Editar</th>
                        <th>Eliminar</th>
                    </tr>   
                </thead>
                <% n = 0 %>
                <% @matrix_legal_items.each do |matrix_legal_item| %>    
                    <% n += 1 %>
                    <tbody>
                        <tr>
                            <td><%= n %></td>
                            <td><%= matrix_legal_item.year %></td>
                            <td><%= matrix_legal_item.risk_factor %></td>
                            <td><%= matrix_legal_item.issuing_entity %></td>
                            <td><%= matrix_legal_item.requirement %></td>
                            <td><%= matrix_legal_item.rule_name %></td>
                            <td><%= matrix_legal_item.applicable_article %></td>
                            <td><%= matrix_legal_item.label_apply(matrix_legal_item.apply) %></td>
                            <td><%= matrix_legal_item.evidence_compliance %></td>
                            <td><%= matrix_legal_item.responsible %></td>
                            <td><%= matrix_legal_item.label_meets(matrix_legal_item.meets) %></td>
                            <td>
                                <small>
                                    <button type="button" class="btn btn-light" data-bs-toggle="tooltip" data-bs-html="true" title="<%= matrix_legal_item.description_compliance %>"><%= matrix_legal_item.description_compliance.slice(0, 30) %>...</button>
                                </small>
                            </td>
                            <td><%= link_to "Descargar Archivo", rails_blob_path(matrix_legal_item.attach_evidence, disposition: 'attachment'), class: 'btn btn-sm btn-success' if matrix_legal_item.attach_evidence.attached? %></td>    
                            <td>
                                <div class="d-flex justify-content-center gap-4 mt-3">
                                    <% if Current.user.level > 0 && Current.user.level < 4 %>
                                        <%= link_to edit_matrix_legal_item_path(matrix_legal_item), class: "btn btn-warning btn-sm text-white me-2", title: "Editar", data: { bs_toggle: "tooltip" } do %>
                                            <i class="bi bi-pencil"></i><span class="d-none d-md-inline"><%= t('common.edit') %></span>
                                        <% end %>
                                     <% end  %>    
                                </div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-4 mt-3">
                                    <% if Current.user.level > 0 && Current.user.level < 4 %>
                                        <%= link_to matrix_legal_item, class: "btn btn-danger", title: "Eliminar", data: {turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar este registro? Esta acción no se puede deshacer.", bs_toggle: "tooltip"} do %>
                                            <i class="bi bi-trash"></i><span class="d-none d-md-inline">Eliminar</span>
                                        <% end %>
                                    <% end  %>    
                                </div>
                            </td>
                        </tr> 
                    </body>
                <% end %>
            </table>
        </div>
    </div>
    <hr class="my-5">
    <div class="container-fluid">
        <div class="row text-center align-items-start">
            <!-- Representante Legal -->
            <div class="col-12 col-md-4 mb-5">
            <div style="height: 90px; display: flex; align-items: center; justify-content: center;">
                <% if @matrix_legal.firm_legal_representative == 1 && @rep.present? && @rep.firm.attached? && @rep.firm.image? %>
                        <%= image_tag @rep.firm, style: "max-height:90px; max-width:100%; object-fit:contain;" %>
                <% end %>
            </div>
            <hr class="my-1">
            <strong>
                <%= @rep.name %>
            </strong>
            <br>
            <small class="text-muted">
                Representante Legal
            </small>
        </div>
        <!-- Asesor SST -->
        <div class="col-12 col-md-4 mb-5">
            <div style="height: 90px; display: flex; align-items: center; justify-content: center;">
                <% if @matrix_legal.firm_adviser_sst == 1 && @adv.present? && @adv.firm.attached? && @adv.firm.image? %>
                    <%= image_tag @adv.firm, style: "max-height:90px; max-width:100%; object-fit:contain;" %>
                <% end %>
            </div>
            <hr class="my-1">
            <strong>
                <%= @adv.name %>
            </strong>
            <br>
            <small class="text-muted">
                Asesor SG-SST
            </small>
        </div>
        <!-- Responsable SG-SST -->
        <div class="col-12 col-md-4 mb-5">
            <div style="height: 90px; display: flex; align-items: center; justify-content: center;">
                <% if @matrix_legal.firm_responsible_sst == 1 && @res.present? && @res.firm.attached? && @res.firm.image? %>
                    <%= image_tag @res.firm, style: "max-height:90px; max-width:100%; object-fit:contain;" %>
                <% end %>
            </div>
            <hr class="my-1">
            <strong>
                <%= @res.name %>
            </strong>
            <br>
            <small class="text-muted">
                Responsable SG-SST
            </small>
        </div>
    </div>
</div>
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <%= link_to matrix_legals_path(entity_id: @matrix_legal.entity.id), class:"btn btn-secondary" do %>
                <i class="bi bi-arrow-left-circle"></i>Retornar
            <% end %>
            <%= link_to ver_matrix_legal_path(@matrix_legal.id, format: 'pdf'), class:"btn btn-danger" do %>
                <i class="bi bi-file-earmark-pdf"></i>PDF
            <% end %> 
        </div>
    </div>
</div>

