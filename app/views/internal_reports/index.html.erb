<style>
  /* =========================================
     REPORTE INTERNO - CONTENEDOR PRINCIPAL
     ========================================= */

  .internal-report-index {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0 auto;
    padding: 16px 12px;
    box-sizing: border-box;
  }

  .internal-report-index *,
  .internal-report-index *::before,
  .internal-report-index *::after {
    box-sizing: border-box;
  }

  .internal-report-index .internal-report-logo {
    margin-bottom: 16px;
  }

  .internal-report-index .conesst-logo {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .internal-report-index .internal-report-main-card {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    border-radius: 14px;
  }

  .internal-report-index .internal-report-main-card > .card-header {
    min-width: 0;
  }

  .internal-report-index .internal-report-title {
    min-width: 0;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .internal-report-index .internal-report-main-card > .card-body {
    min-width: 0;
  }

  /* =========================================
     CELULARES
     ========================================= */

  @media (max-width: 767.98px) {
    .internal-report-index {
      padding: 8px 4px;
    }

    .internal-report-index .internal-report-logo {
      margin-bottom: 12px;
    }

    .internal-report-index .internal-report-main-card {
      border-radius: 12px;
    }

    .internal-report-index .internal-report-main-card > .card-header {
      padding: 12px !important;
    }

    .internal-report-index .internal-report-main-card > .card-body {
      padding: 10px !important;
    }

    .internal-report-index .internal-report-title {
      font-size: 0.98rem;
    }

    .internal-report-index .internal-report-title-icon {
      flex-shrink: 0;
      font-size: 1.35rem !important;
    }

    .internal-report-index .internal-report-company-form {
      width: 100%;
      min-width: 0;
    }

    .internal-report-index .internal-report-company-form .form-select {
      width: 100%;
      min-width: 0;
    }
  }

  /* =========================================
     ESCRITORIO
     ========================================= */

  @media (min-width: 768px) {
    .internal-report-index {
      padding: 20px 24px;
    }

    .internal-report-index .internal-report-main-card {
      border-radius: 14px;
    }
  }
</style>

<div class="internal-report-index">

  <%# Logo de CONESST %>
  <div class="internal-report-logo">
    <div class="d-flex justify-content-center justify-content-md-start align-items-center">
      <%= link_to root_path, aria: { label: "Inicio CONESST" } do %>
        <%= image_tag "LogoConesst202305232.png",
                      class: "conesst-logo",
                      alt: "Logo CONESST" %>
      <% end %>
    </div>
  </div>

  <%# Tarjeta principal %>
  <div class="card shadow-sm border-0 internal-report-main-card">

    <div class="card-header bg-light border-0 px-3 px-md-4 py-3">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-clipboard2-pulse text-primary internal-report-title-icon"></i>

        <h5 class="mb-0 fw-bold internal-report-title">
          REPORTE INTERNO DE ACCIDENTES E INCIDENTES
        </h5>
      </div>
    </div>

    <div class="card-body p-3 p-md-4">

      <% if params[:entity_id].present? || @entity.present? %>

        <%= render "internal_report" %>

      <% else %>

        <%= form_with model: @entity, method: :get, local: true do |form| %>

          <div class="row g-3 align-items-end internal-report-company-form">

            <div class="col-12">
              <%= form.label :entity_id,
                             "Empresa",
                             class: "form-label fw-semibold" %>

              <% if @entities.present? %>

                <%= form.collection_select :entity_id,
                                           @entities.order(id: :asc),
                                           :id,
                                           :business_name,
                                           { prompt: "-- Seleccionar empresa --" },
                                           {
                                             class: "form-select",
                                             required: true
                                           } %>

              <% else %>

                <p class="form-control bg-light mb-0">
                  <%= @entity.business_name %>
                </p>

                <%= form.hidden_field :entity_id, value: @entity.id %>

              <% end %>
            </div>

            <div class="col-12 d-flex justify-content-center justify-content-md-start mt-4">
              <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-search me-2"></i>
                Consultar
              </button>
            </div>

          </div>

        <% end %>

      <% end %>

    </div>
  </div>
</div>