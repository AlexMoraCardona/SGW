<div class="container-fluid px-2 px-md-4 py-3">
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
                <div class="text-center text-md-start">
                    <%= link_to root_path, class: "navbar-brand" do %>
                        <%= image_tag 'LogoConesst202305232.png', class: "img-fluid", style: "max-width: 100px; height: auto;" %>
                    <% end %>
                </div>
                <div class="text-center">
                    <h2 class="mb-0">
                        <i class="bi bi-journal-text text-primary me-2"></i>
                        Normas Legales
                    </h2>
                </div>
                <div>
                      <%= link_to matrix_legals_path(entity_id: Current.user.entity), class: "btn btn-secondary" do %>
                        <i class="bi bi-arrow-left me-1"></i>
                        Retornar
                      <% end %>
                </div>
            </div>
        </div>
    </div>
    <div class="card shadow-sm mt-4">
            <div class="card-header bg-light">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-text fs-5 text-primary"></i>
                   <h5 class="mb-0">
                        Normas legales disponibles
                    </h5>
              </div>
            </div>
            <div class="card-body p-2 p-md-4">
                <% if @legal_rules.present? %>
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>
                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                        <%= t('.risk_factor') %>
                                    </th>
                                    <th>
                                        <i class="bi bi-tags me-1"></i>
                                        <%= t('.clasification_norma') %>
                                    </th>
                                    <th>
                                        <i class="bi bi-card-text me-1"></i>
                                        <%= t('.description_compliance') %>
                                    </th>
                                    <th class="text-center">
                                        <i class="bi bi-plus-circle me-1"></i>
                                        Crear
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <% @legal_rules.each do |legal_rule| %>
                                    <tr>
                                        <td>
                                            <span class="fw-semibold">
                                                <%= legal_rule.risk_factor %>
                                            </span>
                                        </td>
                                        <td>
                                            <%= LegalRule.label_clasification_norma(legal_rule.clasification_norma) %>
                                        </td>
                                        <td>
                                            <%= legal_rule.description_compliance %>
                                        </td>
                                        <td class="text-center">
                                            <%= link_to grabar_rule_matrix_legals_path(legal_rule: legal_rule.id, matrix_legal: params[:id]), class: "btn btn-sm btn-success", title: "Crear requisito legal", data: { bs_toggle: "tooltip" } do %>
                                                <i class="bi bi-plus-circle"></i>
                                                <span class="d-none d-md-inline ms-1">
                                                    Crear requisito
                                                </span>
                                            <% end %>
                                        </td>
                                    </tr>
                                <% end %>
                            </tbody>
                        </table>
                    </div>
                <% else %>
                    <div class="alert alert-info text-center mb-0">
                          <i class="bi bi-info-circle me-1"></i>
                          No hay normas legales disponibles.
                    </div>
                <% end %>
            </div>
    </div>
</div>

