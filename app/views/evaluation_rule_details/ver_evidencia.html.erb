
<% if @evidence.present? && @evidence.template.present? %>

  <% format_number = @evidence.template.format_number.to_i %>
  <% plantilla = "evaluation_rule_details/plantillas/#{format_number}" %>

  <% if lookup_context.exists?(plantilla, [], true) %>
    <%= render plantilla, evidence: @evidence %>
  <% else %>
    <div class="alert alert-warning text-center my-4">
      <i class="bi bi-exclamation-triangle me-2"></i>
      La plantilla <strong>#{format_number}</strong> aún no tiene
      un formato de visualización configurado.
    </div>
  <% end %>

<% end %>


<%# ========================================================= %>
<%# CONTROL DE CAMBIOS - SE MUESTRA AL FINAL DE LA EVIDENCIA %>
<%# ========================================================= %>

<%= render 'evaluation_rule_details/control_cambios' if @template_versions.present? %>




