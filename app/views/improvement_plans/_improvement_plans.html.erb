<% if @entity.present? %>
    <div class="conesst-card">
        <div class="conesst-card-header">
            <div class="conesst-card-header-content">
                <div>
                    <h2 class="conesst-card-header-title">
                        <i class="bi bi-building me-2"></i>
                        <%= @entity.business_name %>
                    </h2>
                    <div class="conesst-subtitle">
                        <strong>NIT:</strong>
                        <%= EvaluationRuleDetail.miles(@entity.identification_number) if @entity.identification_number.present? %><%= "-#{@entity.verification_digit}" if @entity.verification_digit.present? %>
                    </div>
                </div>
            </div>
        </div>
    </div>
<% end %>
<% if @improvement_plans.present? %>
    <% if Current.user.level > 0 && Current.user.level < 3 %>
        <div class="conesst-actions">
            <%= link_to new_improvement_plan_path(entity_id: @entity.id), class: "conesst-btn conesst-btn-primary" do %>
                <i class="bi bi-plus-circle me-1"></i>
                <%= t('.create_improvement_plan') %>
            <% end %>
        </div>
    <% end %>
    <% @improvement_plans.each do |improvement_plan| %>
        <div class="conesst-card">
            <div class="conesst-card-header">
                <div class="conesst-card-header-content">
                    <div>
                        <h2 class="conesst-card-header-title">
                            <i class="bi bi-clipboard2-check me-2"></i>
                            Informe plan de mejoramiento SG-SST
                        </h2>
                        <div class="conesst-subtitle">
                            <i class="bi bi-calendar3 me-1"></i>
                            <strong>Fecha del plan:</strong>
                            <%= improvement_plan.date_plan %>
                        </div>
                    </div>
                </div>
            </div>
            <div class="conesst-card-body">
                <div class="conesst-actions">
                    <%= link_to crear_item_improvement_plan_path(improvement_plan.id), class: "conesst-btn" do %>
                        <i class="bi bi-plus-square me-1"></i>
                        <%= t('common.create_item_plan') %>
                    <% end %>
                    <%= link_to improvement_plan_path(improvement_plan.id), class: "conesst-btn" do %>
                        <i class="bi bi-eye me-1"></i>
                        <%= t('common.show_item_plan') %>
                    <% end %>
                    <%= link_to edit_improvement_plan_path(improvement_plan.id), class: "conesst-btn" do %>
                        <i class="bi bi-pencil-square me-1"></i>
                        <%= t('common.edit') %>
                    <% end %>
                    <%= link_to ver_improvement_plan_pdf_path(improvement_plan.id, format: 'pdf'), class: "conesst-btn" do %>
                        <i class="bi bi-file-earmark-pdf me-1"></i>
                        PDF
                    <% end %>
                </div>
                <div class="conesst-card mt-3">
                    <div class="conesst-card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-6 col-lg-3">
                                <div class="conesst-info-item">
                                    <div class="conesst-info-label">
                                        <i class="bi bi-person me-1"></i>
                                        <%= t('.user_representante') %>
                                    </div>
                                    <div class="conesst-info-value">
                                        <%= improvement_plan.name_user(improvement_plan.user_representante) %>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-lg-3">
                                <div class="conesst-info-item">
                                    <div class="conesst-info-label">
                                        <i class="bi bi-pen me-1"></i>
                                        <%= t('.firm_representante') %>
                                    </div>
                                    <div class="conesst-info-value">
                                        <%= improvement_plan.label_firm(improvement_plan.firm_representante) %>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-lg-3">
                                <div class="conesst-info-item">
                                    <div class="conesst-info-label">
                                        <i class="bi bi-calendar-check me-1"></i>
                                        <%= t('.date_firm_representante') %>
                                    </div>
                                    <div class="conesst-info-value">
                                        <%= improvement_plan.date_firm_representante %>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-lg-3">
                                <% if improvement_plan.firm_representante.to_i == 0 %>
                                    <div class="conesst-actions h-100">
                                        <%= link_to firmar_representante_improvement_plan_path(improvement_plan.id, 1), class: "conesst-btn" do %>
                                            <i class="bi bi-pen me-1"></i>
                                            <%= t('common.firmar') %>
                                        <% end %>
                                    </div>
                                <% end %>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="conesst-section-header">
                    <div>
                        <h3 class="conesst-section-title">
                            <i class="bi bi-list-check me-2"></i>
                            Actividades
                        </h3>
                        <p class="conesst-section-subtitle">
                            Actividades asociadas al plan de mejoramiento
                        </p>
                    </div>
                </div>
                <% if @improvement_items.present? %>
                    <div class="conesst-table-wrapper">
                        <div class="table-responsive">
                            <table class="conesst-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Actividad</th>
                                        <th>Fecha inicio</th>
                                        <th>Fecha final</th>
                                        <th>Cumplimiento</th>
                                        <th>Editar</th>
                                        <th>Eliminar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% @improvement_items.where(improvement_plan_id: improvement_plan.id).each do |improvement_item| %>
                                        <tr>
                                            <td data-label="ID">
                                                <%= improvement_item.id %>
                                            </td>
                                            <td data-label="Actividad">
                                                <div class="conesst-table-main-text">
                                                    <%= improvement_item.activity_plan %>
                                                </div>
                                            </td>
                                            <td data-label="Fecha inicio">
                                                <%= improvement_item.date_initial %>
                                            </td>
                                            <td data-label="Fecha final">
                                                <%= improvement_item.date_fin %>
                                            </td>
                                            <td data-label="Cumplimiento">
                                                <span class="conesst-badge">
                                                    <%= improvement_item.percentage_compliance %>%
                                                </span>
                                            </td>
                                            <td data-label="Editar">
                                                <%= link_to edit_improvement_item_path(improvement_item), class: "conesst-btn conesst-btn-sm" do %>
                                                    <i class="bi bi-pencil-square"></i>
                                                    <span>Editar</span>
                                                <% end %>
                                            </td>
                                            <td data-label="Eliminar">
                                                <%= button_to improvement_item, method: :delete, class: "conesst-btn conesst-btn-sm conesst-btn-danger", form: {data: {turbo_confirm: "¿Está seguro de eliminar esta actividad?"}} do %>
                                                    <i class="bi bi-trash"></i>
                                                    <span>Eliminar</span>
                                                <% end %>
                                            </td>
                                        </tr>
                                    <% end %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% else %>
                    <div class="conesst-empty-state">
                        <i class="bi bi-inbox"></i>
                        <div>
                            <strong>No hay actividades registradas</strong>
                            <p>
                                Este plan todavía no tiene actividades asociadas.
                            </p>
                        </div>
                    </div>
                <% end %>
            </div>
        </div>
    <% end %>
<% else %>
    <div class="conesst-card">
        <div class="conesst-card-body">
            <div class="conesst-empty-state">
                <i class="bi bi-clipboard2-x"></i>
                <div>
                    <strong>No existen planes de mejoramiento</strong>
                    <p>
                        No se han registrado planes de mejoramiento para esta empresa.
                    </p>
                </div>
            </div>
            <div class="conesst-actions">
                <%= link_to new_improvement_plan_path(entity_id: @entity.id), class: "conesst-btn conesst-btn-primary" do %>
                    <i class="bi bi-plus-circle me-1"></i>
                    <%= t('common.create_improvement_plan') %>
                <% end %>
            </div>
        </div>
    </div>
<% end %>
