<div class="conesst-page">
  <div class="conesst-card mb-3">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div>
          <div class="conesst-card-header-title">
            <i class="bi bi-building me-2"></i>
            <%= t('.title') %>
          </div>
          <div class="conesst-card-header-subtitle">
            Consulta y administración de empresas
          </div>
        </div>
        <div class="conesst-actions">
          <%= link_to new_entity_path, class: "conesst-btn conesst-btn-primary" do %>
            <i class="bi bi-plus-circle me-1"></i>
            <%= t('.create_entity') %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <div class="mb-4">
        <%= search_form_for @q do |f| %>
          <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
              <%= f.label :identification_number_eq, "Número de identificación", class: "form-label fw-semibold" %>
              <%= f.number_field :identification_number_eq, class: "form-control", placeholder: "Número de identificación" %>
            </div>
            <div class="col-12 col-md-5">
              <%= f.label :business_name_cont, "Razón social", class: "form-label fw-semibold" %>
              <%= f.search_field :business_name_cont, class: "form-control", placeholder: "Nombre de la empresa" %>
            </div>
            <div class="col-12 col-md-3">
              <button type="submit" class="conesst-btn conesst-btn-primary">
                <i class="bi bi-search me-1"></i>
                Buscar
              </button>
            </div>
          </div>
        <% end %>
      </div>
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 mb-3">
        <div>
          <%== pagy_info(@pagy) %>
        </div>
        <div>
          <%== pagy_bootstrap_combo_nav_js(@pagy) %>
        </div>
      </div>
      <div class="conesst-table-wrapper d-none d-md-block">
        <table class="conesst-table">
          <thead>
            <tr>
              <th>
                <%= sort_link(@q, :identification_number, default_order: :desc) %>
              </th>
              <th>
                <%= sort_link(@q, :business_name, default_order: :desc) %>
              </th>
              <th>
                <%= t('common.first_name') %>
              </th>
              <th>
                <%= t('common.second_name') %>
              </th>
              <th>
                <%= t('common.surname') %>
              </th>
              <th>
                <%= t('common.second_surname') %>
              </th>
              <th class="text-center">
                Acciones
              </th>
            </tr>
          </thead>
          <tbody>
            <%= render partial: 'entity', collection: @entities %>
          </tbody>
        </table>
      </div>
      <div class="d-md-none">
        <%= render partial: 'entity_mobile', collection: @entities, as: :entity %>
      </div>
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 mt-3">
        <div>
          <%== pagy_info(@pagy) %>
        </div>
        <div>
          <%== pagy_bootstrap_combo_nav_js(@pagy) %>
        </div>
      </div>
    </div>
  </div>
</div>