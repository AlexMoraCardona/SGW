<div class="conesst-page">
  <div class="mb-3">
    <%= link_to root_path, class: "d-inline-block" do %>
      <%= image_tag "LogoConesst202305232.png", width: 100, height: 100, alt: "CONESST" %>
    <% end %>
  </div>
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div>
        <h2 class="mb-0">
          <i class="bi bi-shield-check me-2"></i>
          FORMATO PARA ENTREGA DE ELEMENTOS DE PROTECCIÓN PERSONAL (EPP)
        </h2>
        <small class="text-muted">
          Consulta y administración de formatos de entrega de elementos de protección personal
        </small>
      </div>
    </div>
    <div class="conesst-card-body">
      <% if params[:entity_id].present? || @entity.present? %>
        <%= render "provides_protections" %>
      <% else %>
        <%= form_with model: @entity, method: :get do |form| %>
          <div class="row g-3">
            <div class="col-12 col-md-8 col-lg-7">
              <%= form.label :entity_id, "Empresa", class: "form-label fw-semibold" %>
              <% if @entities.present? %>
                <%= form.collection_select :entity_id, @entities.order(id: :asc), :id, :business_name, { prompt: "-- Seleccionar Entidad --" }, { class: "form-select" } %>
              <% else %>
                <div class="form-control bg-light">
                  <%= @entity.business_name %>
                </div>
                <%= form.hidden_field :entity_id, value: @entity.id %>
              <% end %>
            </div>
          </div>
          <div class="conesst-actions mt-4">
            <%= form.button type: "submit", class: "conesst-btn conesst-btn-primary" do %>
              <i class="bi bi-search me-1"></i>
              Consultar
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>