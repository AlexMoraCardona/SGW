<div class="container-fluid px-2 px-md-4 py-3">

  <div class="card shadow-sm border-0">


<div class="card-header bg-light">
  <div class="d-flex flex-column flex-md-row
              justify-content-between align-items-md-center gap-2">

    <div>
      <h4 class="mb-1">
        <i class="bi bi-pencil-square me-2"></i>
        Editar inspección SVE
      </h4>

      <small class="text-muted">
        Programa:
        <strong>
          <%= @epidemiological_surveillance_program.name %>
        </strong>
      </small>
    </div>

    <%= link_to(
          epidemiological_surveillance_program_surveillance_inspection_path(
            @epidemiological_surveillance_program,
            @surveillance_inspection
          ),
          class: "btn btn-outline-secondary btn-sm"
        ) do %>
      <i class="bi bi-arrow-left me-1"></i>
      Volver
    <% end %>

  </div>
</div>

<div class="card-body">
  <%= render "form" %>
</div>


  </div>

</div>
