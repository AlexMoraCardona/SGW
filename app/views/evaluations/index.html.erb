<div class="container-fluid px-2 px-md-4">
  <!-- ENCABEZADO -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <div class="row align-items-center g-3">
        <!-- LOGO -->
        <div class="col-12 col-md-2 text-center text-md-start">
          <%= link_to root_path, class: "d-inline-block" do %>
            <%= image_tag 'LogoConesst202305232.png', class: "img-fluid", style: "max-width: 100px; height: auto;" %>
          <% end %>
        </div>
        <!-- TÍTULO -->
        <div class="col-12 col-md-5 text-center text-md-start">
          <h2 class="mb-0 fw-semibold">
            <i class="bi bi-clipboard-check me-2"></i>
            <%= t('.title') %>
          </h2>
        </div>
        <!-- FILTRO -->
        <% if Current.user.level > 0 && Current.user.level < 3 %>
          <div class="col-12 col-md-5">
            <%= form_with model: @evaluation, method: :get, local: true do |form| %>
              <%= form.label :entity_id, "Filtrar por Entidad", class: "form-label fw-semibold mb-1" %>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="bi bi-building"></i>
                </span>
                <%= form.collection_select :entity_id, Entity.all, :id, :business_name, { prompt: '-- Seleccionar Entidad --' }, {class: 'form-select select2', onchange: 'this.form.requestSubmit()', value: params[:entity_id]} %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <!-- BARRA DE ACCIONES -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h5 class="mb-0">
        <i class="bi bi-list-check me-2"></i>
        Evaluaciones registradas
      </h5>
    </div>
    <% if Current.user.level > 0 && Current.user.level < 3 %>
      <%= link_to new_evaluation_path, class: "btn btn-primary btn-sm px-3" do %>
        <i class="bi bi-plus-circle me-1"></i>
        <%= t('.create_evaluation') %>
      <% end %>
    <% end %>
  </div>
  <!-- TABLA -->
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="text-nowrap">
                <i class="bi bi-calendar-event me-1"></i>
                <%= t('.date_evaluation') %>
              </th>
              <th scope="col">
                <i class="bi bi-building me-1"></i>
                <%= t('.entity') %>
              </th>
              <th scope="col">
                <i class="bi bi-journal-text me-1"></i>
                <%= t('.rule') %>
              </th>
              <th scope="col" class="text-center text-nowrap">
                Acciones
              </th>
            </tr>
          </thead>
          <tbody>
            <%= render partial: 'evaluation', collection: @evaluations %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
