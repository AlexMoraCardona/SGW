                <td style="border:1px solid black; width: 30%;padding: 10px;">
                    <strong>Tipo de indicador:</strong> 
                </td>
                <td style="border:1px solid black; width: 70%;padding: 10px;">
                    <%= @indicador_frecuencia_accidentalidad.type_indicator %>
                </td>
            </tr>
            <tr style="border:1px solid black;width: 100%;">
                <td style="border:1px solid black; width: 30%;padding: 10px;">
                    <strong>Personas que deben conocer el resultado:</strong> 
                </td>
