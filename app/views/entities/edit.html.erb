<div class="conesst-page">
  <div class="conesst-card">
    <div class="conesst-card-header">
      <div class="conesst-card-header-content">
        <div>
          <div class="conesst-card-header-title">
            <i class="bi bi-building me-2"></i>
            Empresa
          </div>
          <div class="conesst-card-header-subtitle">
            Administración de información y ubicaciones
          </div>
        </div>
        <div class="conesst-actions">
          <%= link_to new_location_path(params[:id]),
              class: "conesst-btn conesst-btn-primary" do %>
            <i class="bi bi-plus-circle me-1"></i>
            <%= t('common.create_location') %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="conesst-card-body">
      <% if @entity.logo.present? %>
        <div class="text-center mb-4">
          <%= image_tag @entity.logo,
              class: "img-fluid",
              style: "max-height: 120px; max-width: 250px;" %>
        </div>
      <% end %>
      <%= render 'form' %>
    </div>
  </div>
</div>