<meta charset="utf-8">
<style>
  @page {
    size: Letter portrait;
    margin: 12mm 10mm 12mm 10mm;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 10px !important;
    color: #212529;
    line-height: 1.35;
  }

  * {
    box-sizing: border-box;
  }

  .pdf-page {
    width: 100%;
  }

  /* LOGO */

  .pdf-logo {
    width: 100%;
    margin-bottom: 6px;
  }

  .pdf-logo img {
    width: 75px;
    height: 75px;
    object-fit: contain;
  }


  /* ENCABEZADO */

  .pdf-header-container {
    width: 100%;
    margin-bottom: 8px;
  }


  /* INFORMACIÓN GENERAL */

  .info-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    margin-bottom: 8px;
  }

  .info-table td {
    border: 1px solid #000;
    padding: 6px;
    vertical-align: middle;
  }

  .info-label {
    width: 30%;
    font-weight: bold;
    background: #f1f3f5;
  }

  .info-value {
    width: 70%;
    overflow-wrap: break-word;
    word-wrap: break-word;
  }


  /* SECCIONES */

  .section-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    margin-bottom: 8px;
  }


  .section-title {
    width: 100%;
    padding: 6px 7px;
    background-color: #00aae4;
    color: #ffffff;
    border: 1px solid #000;
    text-align: center;
    font-size: 10px !important;
    font-weight: bold;
    line-height: 1.3;
  }


  .section-content {
    width: 100%;
    padding: 7px;
    border: 1px solid #000;
    vertical-align: top;
    min-height: 35px;
    overflow-wrap: break-word;
    word-wrap: break-word;
  }


  /* CONTENIDO RICH TEXT */

  .section-content p {
    margin-top: 0;
    margin-bottom: 4px;
  }

  .section-content p:last-child {
    margin-bottom: 0;
  }

  .section-content ul,
  .section-content ol {
    margin-top: 3px;
    margin-bottom: 3px;
    padding-left: 18px;
  }

  .section-content h1,
  .section-content h2,
  .section-content h3,
  .section-content h4 {
    margin-top: 3px;
    margin-bottom: 4px;
  }


  /* IMPACTO DEL SISTEMA */

  .impact-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    margin-bottom: 8px;
  }

  .impact-table td {
    border: 1px solid #000;
    padding: 6px;
    vertical-align: top;
    overflow-wrap: break-word;
    word-wrap: break-word;
  }

  .impact-label {
    width: 30%;
    background: #f1f3f5;
    font-weight: bold;
  }

  .impact-value {
    width: 70%;
  }


  /* PLANEACIÓN */

  .planning-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    margin-bottom: 6px;

    page-break-inside: auto;
  }

  .planning-table thead {
    display: table-header-group;
  }

  .planning-table tr {
    page-break-inside: avoid;
    page-break-after: auto;
  }

  .planning-table th {
    padding: 5px 3px;

    background-color: #00aae4;
    color: #ffffff;

    border: 1px solid #000;

    text-align: center;
    vertical-align: middle;

    font-size: 7px !important;
    font-weight: bold;

    line-height: 1.2;
  }

  .planning-table td {
    padding: 5px 3px;

    border: 1px solid #000;

    vertical-align: top;

    font-size: 7px !important;
    line-height: 1.25;

    overflow-wrap: break-word;
    word-wrap: break-word;
  }


  /* ANCHOS DE COLUMNAS */

  .planning-activity {
    width: 27%;
  }

  .planning-responsible {
    width: 18%;
  }

  .planning-communicate {
    width: 18%;
  }

  .planning-execution {
    width: 12%;
    text-align: center;
  }

  .planning-follow {
    width: 12%;
    text-align: center;
  }

  .planning-edit {
    width: 13%;
    text-align: center;
  }


  .planning-empty {
    width: 100%;
    border: 1px dashed #777;
    padding: 10px;
    margin-bottom: 7px;

    text-align: center;

    color: #666;
    font-size: 8px;
  }


  /* BOTÓN / REFERENCIA DE PLANEACIÓN */

  .planning-action {
    margin: 5px 0 10px 0;
    text-align: left;
  }

  .planning-action span {
    display: inline-block;

    padding: 5px 8px;

    border: 1px solid #d39e00;
    border-radius: 4px;

    background-color: #ffc107;
    color: #212529;

    font-size: 8px;
    font-weight: bold;
  }


  /* FIRMA */

  .signature-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;

    margin-top: 8px;

    page-break-inside: avoid;
  }

  .signature-table td {
    border: 1px solid #000;
    padding: 7px;

    vertical-align: middle;
  }

  .signature-info {
    width: 60%;
  }

  .signature-image {
    width: 40%;
    height: 95px;

    text-align: center;
    vertical-align: middle !important;
  }

  .signature-image img {
    max-width: 190px;
    max-height: 75px;

    object-fit: contain;
  }

  .signature-title {
    font-weight: bold;
  }

  .not-signed {
    color: #666;
    font-size: 8px;
  }


  /* EVITAR CORTES */

  .avoid-break {
    page-break-inside: avoid;
  }


  /* AJUSTE PARA WKHTMLTOPDF */

  table {
    page-break-inside: auto;
  }

  td,
  th {
    page-break-inside: avoid;
  }

</style>

<div class="pdf-page">

  <!-- INFORMACIÓN GENERAL -->

  <table class="info-table">

<tr>
  <td class="info-label">
    FECHA
  </td>

  <td class="info-value">
    <%= @change_management.date_change if @change_management.present? %>
  </td>
</tr>

<tr>
  <td class="info-label">
    ÁREA
  </td>

  <td class="info-value">
    <%= ChangeManagement.label_area(@change_management.code_area) %>
  </td>
</tr>


  </table>

  <!-- DESCRIPCIÓN DEL CAMBIO -->

  <table class="section-table">


<tr>
  <td class="section-title">
    DESCRIPCIÓN DEL CAMBIO
  </td>
</tr>

<tr>
  <td class="section-content">
    <%= @change_management.description_change if @change_management.present? %>
  </td>
</tr>


  </table>

  <!-- ANÁLISIS DE RIESGOS -->

  <table class="section-table">


<tr>
  <td class="section-title">
    ANÁLISIS DE RIESGOS Y ASPECTOS / REQUISITOS LEGALES APLICABLES
  </td>
</tr>

<tr>
  <td class="section-content">
    <%= @change_management.analisys_change if @change_management.present? %>
  </td>
</tr>


  </table>

  <!-- RECOMENDACIONES -->

  <table class="section-table">


<tr>
  <td class="section-title">
    RECOMENDACIONES DEL ADMINISTRADOR DEL SG-SST
  </td>
</tr>

<tr>
  <td class="section-content">
    <%= @change_management.recomendations_change if @change_management.present? %>
  </td>
</tr>


  </table>

  <!-- ANÁLISIS DEL IMPACTO -->

  <table class="section-table">


<tr>
  <td class="section-title">
    ANÁLISIS DEL IMPACTO DEL SISTEMA
  </td>
</tr>


  </table>

  <table class="impact-table">


<tr>
  <td class="impact-label">
    PELIGROS Y RIESGOS
  </td>

  <td class="impact-value">
    <%= @change_management.dangers_change if @change_management.present? %>
  </td>
</tr>


<tr>
  <td class="impact-label">
    REQUISITOS LEGALES
  </td>

  <td class="impact-value">
    <%= @change_management.requeriment_legal if @change_management.present? %>
  </td>
</tr>


<tr>
  <td class="impact-label">
    CONTROL OPERATIVO
  </td>

  <td class="impact-value">
    <%= @change_management.operational_control if @change_management.present? %>
  </td>
</tr>


<tr>
  <td class="impact-label">
    PROCEDIMIENTOS DE TRABAJO
  </td>

  <td class="impact-value">
    <%= @change_management.work_procedure if @change_management.present? %>
  </td>
</tr>


<tr>
  <td class="impact-label">
    OTROS
  </td>

  <td class="impact-value">
    <%= @change_management.others if @change_management.present? %>
  </td>
</tr>


  </table>

  <!-- PLANEACIÓN -->

  <table class="section-table">


<tr>
  <td class="section-title">
    PLANEACIÓN DEL CAMBIO
  </td>
</tr>


  </table>

<% if @change_management_items.present? %>


<table class="planning-table">

  <colgroup>
    <col class="planning-activity">
    <col class="planning-responsible">
    <col class="planning-communicate">
    <col class="planning-execution">
    <col class="planning-follow">
    <col class="planning-edit">
  </colgroup>

  <thead>

    <tr>

      <th>
        ACTIVIDAD
      </th>

      <th>
        RESPONSABLE
      </th>

      <th>
        COMUNICAR CAMBIO A
      </th>

      <th>
        FECHA<br>EJECUCIÓN
      </th>

      <th>
        FECHA<br>SEGUIMIENTO
      </th>

      <th>
        EDITAR
      </th>

    </tr>

  </thead>

  <tbody>

    <% @change_management_items.each do |item| %>

      <tr>

        <td>
          <%= item.activity_plannig %>
        </td>

        <td>
          <%= ChangeManagement.label_user(item.responsible_planning) %>
        </td>

        <td>
          <%= item.communicate_change %>
        </td>

        <td style="text-align:center;">
          <%= item.date_execution %>
        </td>

        <td style="text-align:center;">
          <%= item.date_continue %>
        </td>

        <td style="text-align:center;">
          —
        </td>

      </tr>

    <% end %>

  </tbody>

</table>


<% else %>


<div class="planning-empty">
  No hay actividades de planeación registradas.
</div>


<% end %>

  <!-- FIRMA -->

  <table class="signature-table">


<tr>

  <td class="signature-info">

    <span class="signature-title">
      Elaborado por:
    </span>

    <%= @user.name if @user.present? %>

  </td>


  <td class="signature-image">

    <% if @change_management.firm_user_elaborated == 1 %>

      <% if @user.present? && @user.firm.attached? %>

        <% if @user.firm.image? %>

          <%= image_tag @user.firm %>

        <% end %>

      <% end %>

    <% else %>

      <span class="not-signed">
        Pendiente de firma
      </span>

    <% end %>

  </td>

</tr>


  </table>

</div>
