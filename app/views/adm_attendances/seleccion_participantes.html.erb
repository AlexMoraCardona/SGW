<div class="conesst-page">
    <div class="mb-3">
        <%= link_to root_path, class: "d-inline-block" do %>
            <%= image_tag "LogoConesst202305232.png", width: 100, height: 100, alt: "CONESST" %>
        <% end %>
    </div>
    <div class="conesst-card mb-3">
        <div class="conesst-card-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people fs-4"></i>
                <div>
                    <h2 class="mb-0">
                       Seleccionar los participantes
                    </h2>
                    <small class="text-muted">
                        Seleccione los usuarios que participarán en la asistencia
                    </small>
                </div>
            </div>
        </div>
    </div>
    <div class="conesst-card mb-3">
        <div class="conesst-card-body">
            <%= form_tag seleccion_participantes_path, method: :post do %>
                <div class="mb-3">
                    <%= label_tag :ids, "Participantes", class: "form-label fw-semibold" %>
                    <%= select_tag :ids, options_from_collection_for_select(@users, :id, :name), multiple: true, class: "form-control input-sm select2", prompt: "-- Seleccione los usuarios --" %>
                    <div class="form-text">
                        Puede seleccionar uno o varios participantes.
                    </div>
                </div>
                <div class="conesst-actions mt-4">
                    <%= submit_tag "Crear participantes", id: "citar_participantes", class: "conesst-btn conesst-btn-primary spin" %>
                    <%= link_to adm_attendances_path, class: "conesst-btn" do %>
                        <i class="bi bi-arrow-left me-1"></i>
                        Retornar
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
    <div class="conesst-card">
        <div class="conesst-card-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-check fs-4"></i>
                <div>
                    <h5 class="mb-0">
                        Participantes registrados
                    </h5>
                    <small class="text-muted">
                        Usuarios actualmente asociados a esta asistencia
                    </small>
                </div>
            </div>
        </div>
        <div class="conesst-card-body">
            <% if @attendances.present? %>
                <div class="conesst-table-wrapper d-none d-md-block">
                    <table class="conesst-table table-hover">
                        <thead>
                            <tr>
                                <th>
                                    Nombre
                                </th>
                                <th>
                                    Documento
                                </th>
                                <th>
                                    Cargo
                                </th>
                                <th>
                                    Eliminar
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <% @attendances.each do |attendance| %>
                                <tr>
                                    <td>
                                        <%= attendance.user.name %>
                                    </td>
                                    <td>
                                        <%= attendance.user.nro_document %>
                                    </td>
                                    <td>
                                        <%= User.label_activity(attendance.user.activity) if attendance.user.activity.present? %>
                                    </td>
                                    <td>
                                        <%= button_to attendance_path(attendance), method: :delete, class: "conesst-btn conesst-btn-warning", form: {data: {turbo_confirm: "¿Está seguro de eliminar este participante?"}} do %>
                                            <i class="bi bi-trash me-1"></i>
                                            Eliminar
                                        <% end %>
                                    </td>
                                </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>
                <div class="d-md-none">
                    <% @attendances.each do |attendance| %>
                        <div class="conesst-card mb-3">
                            <div class="conesst-card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <div class="fw-semibold">
                                            <i class="bi bi-person me-1"></i>
                                            <%= attendance.user.name %>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted small">
                                        Documento
                                    </span>
                                    <div>
                                        <%= attendance.user.nro_document %>
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted small">
                                        Cargo
                                    </span>
                                    <div>
                                        <%= User.label_activity(attendance.user.activity) if attendance.user.activity.present? %>
                                    </div>
                                </div>
                                <div class="conesst-actions">
                                    <%= button_to attendance_path(attendance), method: :delete, class: "conesst-btn conesst-btn-warning", form: {data: {turbo_confirm: "¿Está seguro de eliminar este participante?"}} do %>
                                        <i class="bi bi-trash me-1"></i>
                                        Eliminar
                                    <% end %>
                                </div>
                            </div>
                        </div>
                    <% end %>
                </div>
            <% else %>
                <div class="text-center py-4">
                    <i class="bi bi-person-x fs-1 text-muted"></i>
                    <p class="text-muted mt-2 mb-0">
                        No hay participantes registrados.
                    </p>
                </div>
            <% end %>
        </div>
    </div>
</div>
