<div class="conesst-page">
  <div class="conesst-header">
    <div class="conesst-card-header-content">
      <div class="conesst-card-header-title">
        <i class="bi bi-signpost-2 me-2"></i>
        Control de Ruta
      </div>
      <div class="conesst-card-header-subtitle">
        Registro y programación del control de ruta
      </div>
    </div>
  </div>
  <div class="conesst-card">
    <div class="conesst-card-body">
      <%= form_with model: @route_control do |form| %>
        <% if @route_control.errors.any? %>
          <div class="alert alert-danger mb-3" role="alert">
            <div class="fw-semibold mb-1">
              <i class="bi bi-exclamation-triangle me-1"></i>
              No fue posible guardar el control de ruta.
            </div>
            <ul class="mb-0 ps-3">
              <% @route_control.errors.full_messages.each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <% if Current.user.level > 0 && Current.user.level < 4 %>
          <div class="conesst-form-section">
            <div class="conesst-form-section-title">
              <i class="bi bi-calendar-event me-2"></i>
              Información de la ruta
            </div>
            <div class="conesst-form-grid conesst-form-grid-2">
              <div class="conesst-form-group">
                <%= form.label :date_control, class: "conesst-form-label" do %>
                  <%= t('.date_control') %>
                  <span
                    class="conesst-help-icon"
                    data-bs-toggle="tooltip"
                    data-bs-html="true"
                    title="Indicar la fecha en que se efectuará la ruta.">
                    <i class="bi bi-question-circle"></i>
                  </span>
                <% end %>
                <%= form.date_field :date_control, class: "form-control" %>
              </div>
              <div class="conesst-form-group">
                <%= form.label :vehicle_type, class: "conesst-form-label" do %>
                  Tipo de vehículo
                <% end %>
                <div class="d-flex flex-wrap gap-3 mt-2">
                  <div class="form-check">
                    <%= form.radio_button :vehicle_type, 0, class: "form-check-input", id: "vehicle_type_moto" %>
                    <%= form.label :vehicle_type, "Moto", value: 0, class: "form-check-label", for: "vehicle_type_moto" %>
                  </div>
                  <div class="form-check">
                    <%= form.radio_button :vehicle_type, 1, class: "form-check-input", id: "vehicle_type_carro" %>
                    <%= form.label :vehicle_type, "Carro", value: 1, class: "form-check-label", for: "vehicle_type_carro" %>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="conesst-form-section">
            <div class="conesst-form-section-title">
              <i class="bi bi-person-badge me-2"></i>
              Conductor
            </div>
            <div class="conesst-form-grid">
              <div class="conesst-form-group">
                <%= form.label :user_create, class: "conesst-form-label" do %>
                  Empleado conductor de la ruta
                  <span
                    class="conesst-help-icon"
                    data-bs-toggle="tooltip"
                    data-bs-html="true"
                    title="Seleccione el conductor de la ruta.">
                    <i class="bi bi-question-circle"></i>
                  </span>
                <% end %>
                <%= form.collection_select(:user_create, User.usuarios_empresa.order(id: :asc), :id, :name, { prompt: "-- Seleccionar conductor --" }, { class: "form-select" }) %>
              </div>
            </div>
          </div>
          <div class="conesst-form-section">
            <div class="conesst-form-section-title">
              <i class="bi bi-geo-alt me-2"></i>
              Lugar del control
            </div>
            <div class="conesst-form-grid">
              <div class="conesst-form-group">
                <%= form.label :place, class: "conesst-form-label" %>
                <%= form.text_field :place, class: "form-control",  placeholder: "Indique el lugar donde se realizará el control" %>
              </div>
            </div>
          </div>
        <% end %>
        <div class="conesst-form-section">
          <div class="conesst-form-section-title">
            <i class="bi bi-chat-left-text me-2"></i>
            Observaciones
          </div>
          <div class="conesst-form-grid">
            <div class="conesst-form-group">
              <%= form.label :observation, class: "conesst-form-label" %>
              <%= form.text_field :observation, class: "form-control", placeholder: "Ingrese las observaciones del control de ruta" %>
            </div>
          </div>
        </div>
        <%= form.hidden_field :user_id, value: Current.user.id %>
        <%= form.hidden_field :entity, value: Current.user.entity %>
        <%= form.hidden_field :code, value: @template.reference if @template.present? %>
        <%= form.hidden_field :version, value: @template.version.to_i if @template.present? %>
        <div class="conesst-form-actions">
          <button type="submit" class="conesst-btn conesst-btn-primary">
            <i class="bi bi-check-circle"></i>
            <%= t('common.submit') %>
          </button>
          <%= link_to route_controls_path, class: "conesst-btn conesst-btn-warning" do %>
            <i class="bi bi-arrow-left"></i>
            Retornar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
