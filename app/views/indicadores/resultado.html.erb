<div class="container-fluid py-3">
  <div class="row">
    <div class="col-12 text-center text-md-start">
      <%= link_to root_path, class: "d-inline-block" do %>
        <%= image_tag "LogoConesst202305232.png", width: 100, height: 100, class: "img-fluid", alt: "Logo CONESST" %>
      <% end %>
    </div>
  </div>
</div>
<div class="container-fluid px-3 px-md-4 px-lg-5 pb-4">
  <div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white py-3">
      <h2 class="mb-0 text-center text-md-start">
        <i class="bi bi-bar-chart-line me-2"></i>
        Indicadores
      </h2>
    </div>
    <div class="card-body p-3 p-md-4">
      <% if @entities.present? %>
        <%= form_with model: @entity do |form| %>
          <div class="row g-3 align-items-end">
            <div class="col-12 col-md-8">
              <%= form.label :entity_id, "Entidad", class: "form-label fw-semibold" %>
              <%= form.collection_select :entity_id, @entities.order(id: :asc), :id, :business_name, { prompt: "-- Seleccionar Entidad --" }, { class: "form-select" } %>
            </div>
            <div class="col-12 col-md-4">
              <%= form.button type: "submit",
                    class: "btn btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-2 py-2" do %>
                <i class="bi bi-search"></i>
                <span>Consultar</span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="alert alert-info mb-0" role="alert">
          <i class="bi bi-info-circle me-2"></i>
          No hay entidades disponibles para consultar indicadores.
        </div>
      <% end %>
    </div>
  </div>
</div>
